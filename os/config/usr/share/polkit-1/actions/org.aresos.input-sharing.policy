<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>AresOS</vendor>
  <action id="org.aresos.input-sharing.on">
    <description>Turn on mouse and keyboard sharing</description>
    <message>Authentication is required to turn on mouse and keyboard sharing</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/aresos-input-sharing-set</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">on</annotate>
  </action>
  <action id="org.aresos.input-sharing.off">
    <description>Turn off mouse and keyboard sharing</description>
    <message>Authentication is required to turn off mouse and keyboard sharing</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/aresos-input-sharing-set</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">off</annotate>
  </action>
</policyconfig>
