// Everyday account like Windows (owner, 2026-11-09): `ares` is in wheel and
// confirms admin actions with its own password. This file sorts first, so its
// answers for `ares` win over every later rule.
//
// 1. The OS image, firmware and next boot change only through the signed
//    release route or an explicit sudo, never through these session actions,
//    even with the password: rpm-ostree, systemd-sysupdate, fwupd, Bazzite's
//    own actions, modem firmware, and logind's next-boot and firmware-setup
//    choices (allowed to any active session by default). Windows stays the
//    firmware default and the boot order changes only with the owner.
// 2. Upstream rules let any wheel member do the actions below without a
//    password (Bazzite base 44.20261012.1). For `ares` they ask for it, so a
//    program running as him, such as Claude Code, cannot use them unasked.
//    CI fails if a new base adds another such grant (os/ci/polkit-check.js).
var aresosDeniedActions = [
    "org.freedesktop.ModemManager1.Firmware",
    "org.freedesktop.login1.set-reboot-parameter",
    "org.freedesktop.login1.set-reboot-to-boot-loader-entry",
    "org.freedesktop.login1.set-reboot-to-boot-loader-menu",
    "org.freedesktop.login1.set-reboot-to-firmware-setup"
];

var aresosPasswordActions = [
    "org.corectrl.helper.init",
    "org.corectrl.helperkiller.init",
    "org.fedoraproject.FirewallD1.config",
    "org.fedoraproject.FirewallD1.direct",
    "org.fedoraproject.FirewallD1.ipset",
    "org.fedoraproject.FirewallD1.policy",
    "org.fedoraproject.FirewallD1.zone",
    "org.freedesktop.Flatpak.app-install",
    "org.freedesktop.Flatpak.app-uninstall",
    "org.freedesktop.Flatpak.runtime-install",
    "org.freedesktop.Flatpak.runtime-uninstall",
    "org.freedesktop.NetworkManager.settings.modify.system",
    "org.freedesktop.bolt.authorize",
    "org.freedesktop.bolt.enroll",
    "org.freedesktop.bolt.manage",
    "org.gtk.vfs.file-operations-helper",
    "org.kde.kcontrol.kcmclock.save"
];

polkit.addRule(function(action, subject) {
    if (subject.user != "ares") {
        return polkit.Result.NOT_HANDLED;
    }
    if (action.id.indexOf("org.projectatomic.rpmostree1.") == 0 ||
        action.id.indexOf("org.freedesktop.sysupdate1.") == 0 ||
        action.id.indexOf("org.freedesktop.fwupd.") == 0 ||
        action.id.indexOf("org.bazzite.") == 0 ||
        aresosDeniedActions.indexOf(action.id) >= 0) {
        return polkit.Result.NO;
    }
    // uupd.rules lets anyone start the (masked) updater units.
    if (action.id == "org.freedesktop.systemd1.manage-units") {
        var unit = action.lookup("unit");
        if (unit == "uupd.service" || unit == "uupd-manual.service") {
            return polkit.Result.NO;
        }
    }
    if (aresosPasswordActions.indexOf(action.id) >= 0) {
        return polkit.Result.AUTH_ADMIN_KEEP;
    }
    return polkit.Result.NOT_HANDLED;
});
