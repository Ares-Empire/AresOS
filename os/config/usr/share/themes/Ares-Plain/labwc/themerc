# Ares-Plain: like Windows, but ours (labwc 0.9).
#
# The frame a Windows user already knows: the app's icon and the title at the
# left, three wide caption buttons at the right, hover fills the whole button
# and close turns red. The colours are the Empire's day palette (ivory wall,
# near-black ink, antique gold for the active window's edge).
# Design notes and the rc.xml lines this theme needs: docs/design/WINDOWS.md.

# frame: 1px, antique gold on the active window, quiet warm grey on the others
border.width: 1
window.active.border.color: #9a7a3c
window.inactive.border.color: #b9b5aa
window.active.indicator.toggled-keybind.color: #c9372c

# title bar: 36px, flat
window.titlebar.padding.width: 0
window.titlebar.padding.height: 0
window.active.title.bg: Solid
window.active.title.bg.color: #efede6
window.inactive.title.bg: Solid
window.inactive.title.bg.color: #f6f4ef
window.active.label.text.color: #1a1813
window.inactive.label.text.color: #8f8a7f
window.label.text.justify: Left

# buttons: SVG images of exactly this size (the *.svg next to this file, drawn by
# reviews/window-design-v1/draw-buttons.py in the AresOS repo)
window.button.width: 46
window.button.height: 36
window.button.spacing: 0
# only used for a button without a hover image; every button here has one
window.button.hover.bg.color: #1a181317
window.button.hover.bg.corner-radius: 0
# only used for xbm buttons; kept in step with the SVG glyphs
window.active.button.unpressed.image.color: #1a1813
window.inactive.button.unpressed.image.color: #8f8a7f

# shadow: soft, a little wider under the active window
window.active.shadow.size: 48
window.active.shadow.color: #00000070
window.inactive.shadow.size: 28
window.inactive.shadow.color: #00000040

# menus (window menu, root menu)
menu.overlap.x: 0
menu.overlap.y: 0
menu.width.min: 200
menu.width.max: 360
menu.border.width: 1
menu.border.color: #b9b5aa
menu.items.padding.x: 14
menu.items.padding.y: 7
menu.items.bg.color: #f8f7f3
menu.items.text.color: #1a1813
menu.items.active.bg.color: #e3e0d6
menu.items.active.text.color: #1a1813
menu.separator.width: 1
menu.separator.padding.width: 10
menu.separator.padding.height: 4
menu.separator.color: #d5d1c6
menu.title.bg.color: #efede6
menu.title.text.color: #5e5a50
menu.title.text.justify: Left

# on-screen display: window switcher (Alt+Tab), workspace and resize notes
osd.bg.color: #f5f3ee
osd.border.color: #b9b5aa
osd.border.width: 1
osd.label.text.color: #1a1813

osd.window-switcher.style-classic.width: 720
osd.window-switcher.style-classic.padding: 8
osd.window-switcher.style-classic.item.padding.x: 12
osd.window-switcher.style-classic.item.padding.y: 8
osd.window-switcher.style-classic.item.active.border.width: 2
osd.window-switcher.style-classic.item.active.border.color: #9a7a3c
osd.window-switcher.style-classic.item.active.bg.color: #e9e6dc
osd.window-switcher.style-classic.item.icon.size: 28

osd.window-switcher.style-thumbnail.width.max: 80%
osd.window-switcher.style-thumbnail.padding: 12
osd.window-switcher.style-thumbnail.item.width: 320
osd.window-switcher.style-thumbnail.item.height: 240
osd.window-switcher.style-thumbnail.item.padding: 10
osd.window-switcher.style-thumbnail.item.active.border.width: 2
osd.window-switcher.style-thumbnail.item.active.border.color: #9a7a3c
osd.window-switcher.style-thumbnail.item.active.bg.color: #e9e6dc
osd.window-switcher.style-thumbnail.item.icon.size: 40

# the outline drawn around the window Alt+Tab is about to pick
osd.window-switcher.preview.border.width: 1
osd.window-switcher.preview.border.color: #f5f3ee,#9a7a3c,#f5f3ee

osd.workspace-switcher.boxes.width: 22
osd.workspace-switcher.boxes.height: 22
osd.workspace-switcher.boxes.border.width: 1

# where a dragged window will snap
snapping.overlay.region.bg.color: #9a7a3c33
snapping.overlay.edge.bg.color: #9a7a3c33
snapping.overlay.region.border.width: 1
snapping.overlay.edge.border.width: 1
snapping.overlay.region.border.color: #f5f3ee,#9a7a3c,#f5f3ee
snapping.overlay.edge.border.color: #f5f3ee,#9a7a3c,#f5f3ee

magnifier.border.width: 1
magnifier.border.color: #9a7a3c
