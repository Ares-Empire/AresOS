# AresOS (brief 321): Fedora's entry with the same desktop ID, which xdg-desktop-portal needs to keep
# Deskflow's app ID, but opening the guarded launcher: TLS and the peer check on, one paired Mac.
# os/build.sh keeps Fedora's copy out of the image (RPM records it as net shared, so rpm -V stays clean).
[Desktop Entry]
Type=Application
Version=1.0
Name=Deskflow
Comment=Mouse and keyboard sharing utility
Exec=/usr/libexec/aresos-deskflow
Icon=org.deskflow.deskflow
Terminal=false
Categories=Utility;
Keywords=keyboard;mouse;sharing;network;share;
Name[zh_CN]=Deskflow
Comment[zh_CN]=键鼠共享工具
Keywords[zh_CN]=键盘;鼠标;网络;共享;
Name[ru]=Deskflow
Comment[ru]=Приложения чтобы использовать одну мышку и клавиатуру с разными устройствами
Keywords[ru]=Передача;Трансляция;barrier;input-leap;
Name[ko]=Deskflow
Comment[ko]=마우스 및 키보드 공유 유틸리티
Keywords[ko]=키보드;마우스;공유;네트워크;
