<?xml version="1.0"?>
<labwc_config>
  <core><decoration>server</decoration></core>
  <theme>
    <name>AresOS</name>
    <icon>breeze</icon>
    <fallbackAppIcon>application-x-executable</fallbackAppIcon>
    <cornerRadius>0</cornerRadius>
    <dropShadows>yes</dropShadows>
    <titlebar><layout>menu:iconify,max,close</layout></titlebar>
    <font place="ActiveWindow"><name>Jersey 10</name><size>28</size></font>
    <font place="InactiveWindow"><name>Jersey 10</name><size>28</size></font>
    <font place="MenuHeader"><name>Jersey 10</name><size>28</size></font>
    <font place="MenuItem"><name>Jersey 10</name><size>28</size></font>
    <font place="OnScreenDisplay"><name>Jersey 10</name><size>28</size></font>
  </theme>
  <keyboard>
    <!-- The recovery terminal, and the startup cover (package 23b) ends so that it can be seen. -->
    <keybind key="W-C-Escape"><action name="Execute" command="/usr/bin/aresos-terminal --recovery" /><action name="Execute" command="/usr/libexec/aresos-desktop hide-cover" /></keybind>
    <keybind key="A-F4"><action name="Close" /></keybind>
    <keybind key="A-Tab"><action name="NextWindow" /></keybind>
    <keybind key="A-S-Tab"><action name="PreviousWindow" /></keybind>
    <!-- Brightness changes only once the laptop exposes a backlight device. -->
    <keybind key="XF86MonBrightnessUp"><action name="Execute" command="/usr/libexec/aresos-level brightness-up" /></keybind>
    <keybind key="XF86MonBrightnessDown"><action name="Execute" command="/usr/libexec/aresos-level brightness-down" /></keybind>
    <keybind key="XF86AudioRaiseVolume"><action name="Execute" command="/usr/libexec/aresos-level volume-up" /></keybind>
    <keybind key="XF86AudioLowerVolume"><action name="Execute" command="/usr/libexec/aresos-level volume-down" /></keybind>
    <keybind key="XF86AudioMute"><action name="Execute" command="/usr/libexec/aresos-level mute" /></keybind>
    <keybind key="XF86AudioMicMute"><action name="Execute" command="/usr/libexec/aresos-level mic-mute" /></keybind>
  </keyboard>
  <windowSwitcher preview="yes" outlines="yes" order="focus">
    <osd show="yes" style="thumbnail" output="focused" thumbnailLabelFormat="%T" />
  </windowSwitcher>
  <mouse>
    <default />
    <context name="TitleBar">
      <mousebind direction="Up" action="Scroll"><action name="None" /></mousebind>
      <mousebind direction="Down" action="Scroll"><action name="None" /></mousebind>
    </context>
  </mouse>
  <windowRules>
    <windowRule identifier="foot"><action name="Maximize" /></windowRule>
    <!-- The desktop (package 23): a borderless maximized Minecraft window below normal apps (OS-BASE section 4). -->
    <windowRule identifier="aresos-desktop" serverDecoration="no"><action name="Maximize" /></windowRule>
    <!-- Package 40: the world is the home screen, so every app window stays above it, also after a click on the
         world. A rule of its own: the line above stays as the image checks know it. labwc applies a rule's actions
         once, when a window first maps, so the toggle cannot flip back; a restarted game is a new window. -->
    <windowRule identifier="aresos-desktop"><action name="ToggleAlwaysOnBottom" /></windowRule>
    <!-- The startup cover (package 23b): borderless, fullscreen and above the starting game until the hub is ready. -->
    <windowRule identifier="aresos.cover" serverDecoration="no"><action name="ToggleFullscreen" /><action name="ToggleAlwaysOnTop" /></windowRule>
    <!-- The black screen while a shutdown, logout or restart saves the home (package 25): borderless and above
         everything. No ToggleFullscreen: the cover asks for fullscreen itself here, one window on every output. -->
    <windowRule identifier="aresos.black" serverDecoration="no"><action name="ToggleAlwaysOnTop" /></windowRule>
  </windowRules>
</labwc_config>
