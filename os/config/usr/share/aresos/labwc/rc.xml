<?xml version="1.0"?>
<labwc_config>
  <core><decoration>server</decoration></core>
  <theme>
    <name>Ares-Crown</name>
    <icon>breeze</icon>
    <fallbackAppIcon>application-x-executable</fallbackAppIcon>
    <cornerRadius>10</cornerRadius>
    <dropShadows>yes</dropShadows>
    <titlebar><layout>menu:iconify,max,close</layout></titlebar>
    <font place="ActiveWindow"><name>Space Grotesk</name><size>13</size><weight>medium</weight></font>
    <font place="InactiveWindow"><name>Space Grotesk</name><size>13</size><weight>medium</weight></font>
    <font place="MenuHeader"><name>Space Grotesk</name><size>12</size><weight>bold</weight></font>
    <font place="MenuItem"><name>Space Grotesk</name><size>12</size></font>
    <font place="OnScreenDisplay"><name>Space Grotesk</name><size>13</size><weight>medium</weight></font>
  </theme>
  <windowSwitcher><osd style="thumbnail" /></windowSwitcher>
  <keyboard>
    <keybind key="W-C-Escape"><action name="Execute" command="/usr/bin/aresos-terminal --recovery" /></keybind>
    <keybind key="A-F4"><action name="Close" /></keybind>
    <keybind key="A-Tab"><action name="NextWindow" /></keybind>
    <!-- Brightness changes only once the laptop exposes a backlight device. -->
    <keybind key="XF86MonBrightnessUp"><action name="Execute" command="/usr/bin/brightnessctl --quiet set 5%+" /></keybind>
    <keybind key="XF86MonBrightnessDown"><action name="Execute" command="/usr/bin/brightnessctl --quiet --min-value=1 set 5%-" /></keybind>
    <keybind key="XF86AudioRaiseVolume"><action name="Execute" command="/usr/bin/wpctl set-volume --limit 1.0 @DEFAULT_AUDIO_SINK@ 5%+" /></keybind>
    <keybind key="XF86AudioLowerVolume"><action name="Execute" command="/usr/bin/wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-" /></keybind>
    <keybind key="XF86AudioMute"><action name="Execute" command="/usr/bin/wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" /></keybind>
    <keybind key="XF86AudioMicMute"><action name="Execute" command="/usr/bin/wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle" /></keybind>
  </keyboard>
  <windowRules>
    <windowRule identifier="foot"><action name="Maximize" /></windowRule>
    <!-- The desktop (package 23): a borderless maximized Minecraft window below normal apps (OS-BASE section 4). -->
    <windowRule identifier="aresos-desktop" serverDecoration="no"><action name="Maximize" /></windowRule>
  </windowRules>
</labwc_config>
