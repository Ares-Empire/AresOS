printf '\nAresOS\n\nSuper+Ctrl+Escape: recovery terminal\nCtrl+Alt+F3: separate TTY (provision a recovery password first)\n\n'
PS1='aresos \w \$ '
# His own ~/.bashrc applies after the banner, so his settings win. An error in
# it ends only its own `source`, not this shell, and the recovery terminal
# never reads it.
_aresos_terminal=${ARESOS_TERMINAL:-}
unset ARESOS_TERMINAL
if [ "$_aresos_terminal" != recovery ] && [ -f "$HOME/.bashrc" ] && [ -r "$HOME/.bashrc" ]; then
    unset _aresos_terminal
    . "$HOME/.bashrc"
fi
unset _aresos_terminal
