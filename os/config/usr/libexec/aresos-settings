#!/usr/bin/python3
"""The owner's desktop settings (package 320, COMPONENTS.md 4.7): `get`, and `set <name> <value>`.

This program owns ~/.config/aresos/settings.json ($XDG_CONFIG_HOME honoured) and the defaults, which live here and
nowhere else. The file holds a version and only the values he set, so a later change of a default reaches every
setting he never chose. No file means the defaults; a broken file or value means the defaults and one journal line
(stderr). The indicator reads the settings through this program: `get`'s JSON, or this file loaded as a module.
Not desktop.json: the supervisor keeps a different ~/.local/state/aresos/desktop.json.
"""
import json
import os
import pathlib
import subprocess
import sys
import tempfile

VERSION = 1
# The names and values are stable: the mod's set_setting will send them.
CHOICES = {
    'look': ('A', 'B', 'C'),
    'indicator-place': ('top', 'bottom'),
    'indicator-size': ('small', 'medium', 'large'),
}
DEFAULTS = {'look': 'B', 'indicator-place': 'top', 'indicator-size': 'medium'}
# Settings whose change shows the plate once, with the current volume, at the new place and size.
SHOWN = ('indicator-place', 'indicator-size')
LEVEL = '/usr/libexec/aresos-level'
LIMIT = 64 * 1024


def log(message):
    print(f'aresos-settings: {message}', file=sys.stderr, flush=True)


def path():
    config = os.environ.get('XDG_CONFIG_HOME', '')
    # The base directory specification ignores a relative value.
    base = pathlib.Path(config) if os.path.isabs(config) else pathlib.Path.home() / '.config'
    return base / 'aresos' / 'settings.json'


def chosen(file=None):
    """The values he set that are valid, and the problems found (empty when the file is fine or missing)."""
    file = file or path()
    try:
        with open(file, 'rb') as stream:
            data = stream.read(LIMIT + 1)
    except FileNotFoundError:
        return {}, []
    except OSError as error:
        return {}, [f'cannot read {file} ({error.strerror})']
    if len(data) > LIMIT:
        return {}, [f'{file} is larger than {LIMIT} bytes']
    try:
        stored = json.loads(data)
    except (UnicodeDecodeError, json.JSONDecodeError):
        return {}, [f'{file} is not JSON']
    if not isinstance(stored, dict) or stored.get('version') != VERSION or isinstance(stored.get('version'), bool):
        return {}, [f'{file} is not a version {VERSION} settings object']
    values, problems = {}, []
    for name, value in stored.items():
        if name == 'version':
            continue
        if name in CHOICES and isinstance(value, str) and value in CHOICES[name]:
            values[name] = value
        else:
            problems.append(f'{json.dumps(name)[:40]}: {json.dumps(value)[:40]} is not a setting')
    return values, problems


def load(file=None, *, report=True):
    """Every setting: his valid values over the defaults. Problems give the defaults and one journal line."""
    values, problems = chosen(file)
    if problems and report:
        log('using the defaults for: ' + '; '.join(problems))
    return {**DEFAULTS, **values}


def write(values, file=None):
    """Writes the whole file at once: a temporary file in the same folder, flushed, renamed into place."""
    file = file or path()
    file.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix='.settings.', suffix='.tmp', dir=file.parent)
    try:
        with os.fdopen(fd, 'w') as stream:
            json.dump({'version': VERSION, **dict(sorted(values.items()))}, stream, indent=2)
            stream.write('\n')
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, file)
    except BaseException:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
        raise


def show_plate():
    # The change is saved already, so a missing or failing aresos-level only means no plate. Its background
    # notifier, and the indicator it may start, outlive this call: handing them our stdout or stderr would keep a
    # caller that reads them (a terminal tool, later the shell's set_setting) waiting for up to a minute.
    try:
        subprocess.run([LEVEL, 'show-volume'], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=10, check=False)
    except (OSError, subprocess.SubprocessError) as error:
        log(f'saved, but the plate could not be shown ({error})')


def set_value(name, value, file=None):
    values, problems = chosen(file)
    if problems:
        log('replacing what is not a setting: ' + '; '.join(problems))
    values[name] = value
    write(values, file)
    if name in SHOWN:
        show_plate()


USAGE = 'usage: aresos-settings get | set <name> <value>\n' + ''.join(
    f'  {name}: {" | ".join(values)} (default {DEFAULTS[name]})\n' for name, values in CHOICES.items())


def main(argv):
    if argv == ['get']:
        print(json.dumps(load(), sort_keys=True))
        return 0
    if len(argv) == 3 and argv[0] == 'set':
        name, value = argv[1], argv[2]
        if name not in CHOICES or value not in CHOICES[name]:
            sys.stderr.write(f'aresos-settings: {name} {value} is not a setting\n{USAGE}')
            return 2
        try:
            set_value(name, value)
        except OSError as error:
            log(f'could not save {name}: {error}')
            return 1
        return 0
    sys.stderr.write(USAGE)
    return 2


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
