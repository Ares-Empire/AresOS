#!/usr/bin/python3
"""AresOS desktop supervisor: boots the session into the AresHub world (package 23).

Design: docs/design/OS-BASE.md section 5 and Appendices B1, B2 and B5.

labwc's autostart runs `aresos-desktop session`, a small keeper that runs the
supervisor (`aresos-desktop supervise`) and restarts it if it fails. The
supervisor
  - checks the image's pinned Minecraft inputs (/usr/share/aresos/minecraft),
  - creates the managed Prism instance AresDesktop and the worlds folder the
    first time, and never changes an existing instance or world,
  - starts the app helper (/usr/libexec/aresos-shell) and Prism
    (`prismlauncher --launch AresDesktop --world AresHub`) in its own systemd
    user scope,
  - learns about the real Java process from the instance's wrapper command
    (/usr/libexec/aresos-desktop-java), which asks it for the launch's
    environment, reports the JVM's PID and later its exit status,
  - learns readiness from the helper's status pipe (world_ready/heartbeat),
  - and applies B2's restart policy.

States (B2): SETUP (first start: Prism's own sign-in, then the hub is created
with the mod's AresOS button), STARTING, IN_WORLD, AUTH_REQUIRED and RECOVERY.
SETUP, AUTH_REQUIRED and RECOVERY show a foot terminal with what happened and
what to do. Restart policy: an unexpected game exit is retried after a short
backoff; three failures within five minutes or three in a row latch RECOVERY.
The latch and the counts live in ~/.local/state/aresos/desktop.json and survive
restarts of the supervisor and of the machine. Only 30 continuous healthy
minutes in the world (valid heartbeats) or the owner's `retry` reset them.
Auth states, deliberate quits and kills (memory pressure) never restart by
themselves, and nothing here ever kills a running game or repairs a world.

Socket: $XDG_RUNTIME_DIR/aresos/desktop.sock, one JSON object per line, same
user only. The wrapper sends jvm_start, jvm_started and jvm_exited; the
owner's commands (`aresos-desktop status|retry|forget-hub|reset-instance`) use
status, retry and forget_hub.
"""
import argparse
import dataclasses
import errno
import gzip
import hashlib
import json
import logging
import logging.handlers
import os
import secrets
import selectors
import shutil
import signal
import socket
import stat
import struct
import subprocess
import sys
import tempfile
import time

LOG = logging.getLogger('aresos-desktop')

SHARE = '/usr/share/aresos/minecraft'
LOCK_NAME = 'desktop.lock.json'
LOADER_UID = 'net.fabricmc.fabric-loader'
PRISM = '/usr/bin/prismlauncher'
PRISM_ROOT = '/usr/lib/prismlauncher'
SYSTEMD_RUN = '/usr/bin/systemd-run'
HELPER = '/usr/libexec/aresos-shell'
WRAPPER = '/usr/libexec/aresos-desktop-java'
SELF = '/usr/libexec/aresos-desktop'
FOOT = '/usr/bin/foot'
BASH = '/usr/bin/bash'
VIEW_RC = '/usr/share/aresos/desktop-view.bashrc'
# The message window: foot with its own app_id (not the session terminal's) and room for the longest message.
VIEW_COMMAND = [FOOT, '--title=AresOS', '--app-id=aresos.desktop', '--window-size-chars=104x32', BASH, '--rcfile',
                VIEW_RC, '-i']
# The session's PATH (package 21, JUDGMENT-CALL 9): his ~/.local/bin is never on it.
SYSTEM_PATH = '/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin'
# Never handed to Prism, the helper's apps or the views; only the game gets them, from the wrapper.
PRIVATE_ENVIRONMENT = ('ARESOS_LAUNCH_NONCE', 'ARESOS_DESKTOP_INSTANCE', 'ARESOS_SHELL_STATUS_FD',
                       'ARESOS_SHELL_SOCKET', 'NOTIFY_SOCKET', 'LISTEN_FDS', 'LISTEN_PID', 'LISTEN_FDNAMES',
                       'WATCHDOG_PID', 'WATCHDOG_USEC')
# switcheroo-control's set for NVIDIA: render this one process on NVIDIA (OS-BASE section 2).
NVIDIA_OFFLOAD = {'__NV_PRIME_RENDER_OFFLOAD': '1', '__GLX_VENDOR_LIBRARY_NAME': 'nvidia',
                  '__VK_LAYER_NV_optimus': 'NVIDIA_only'}

# B2 and B5 numbers.
START_TIMEOUT = 120.0
FAILURE_WINDOW = 300.0
MAX_FAILURES = 3
HEALTHY_RESET = 1800.0
HEARTBEAT_GAP = 20.0
BACKOFF = 5.0
PRISM_GRACE = 10.0
EXIT_REPORT_WAIT = 2.0
EARLY_PRISM_FAILURE = 3.0
HELPER_RESTART = 2.0
HELPER_BUDGET = (5, 60.0)
HEAP_MB = 3072
MIN_HEAP_MB = 512
MEMORY_HIGH = '5G'
RENDER_DISTANCE = 8
SIMULATION_DISTANCE = 5
MAX_LINE = 64 * 1024
KEEPER_BUDGET = (5, 600.0)

SETUP, STARTING, IN_WORLD, AUTH_REQUIRED, RECOVERY = 'SETUP', 'STARTING', 'IN_WORLD', 'AUTH_REQUIRED', 'RECOVERY'
SIGKILL = 9  # signal.SIGKILL, spelled out so the tests also load this file on Windows
SIGKILL_STATUSES = (-SIGKILL, 128 + SIGKILL)


# ---------------------------------------------------------------- paths


@dataclasses.dataclass(frozen=True)
class Paths:
    """Every file the supervisor touches, from HOME and XDG_RUNTIME_DIR, so tests use temporary folders."""
    home: str
    runtime: str
    share: str = SHARE

    @classmethod
    def from_environ(cls, environ=None, share=SHARE):
        environ = os.environ if environ is None else environ
        home, runtime = environ.get('HOME', ''), environ.get('XDG_RUNTIME_DIR', '')
        if not os.path.isabs(home) or not os.path.isabs(runtime):
            raise SystemExit('aresos-desktop needs an absolute HOME and XDG_RUNTIME_DIR')
        return cls(home, runtime, share)

    @property
    def prism_data(self):
        return os.path.join(self.home, '.local/share/PrismLauncher')

    @property
    def prism_config(self):
        return os.path.join(self.prism_data, 'prismlauncher.cfg')

    @property
    def instances(self):
        return os.path.join(self.prism_data, 'instances')

    def instance(self, name):
        return os.path.join(self.instances, name)

    @property
    def worlds(self):
        return os.path.join(self.home, '.local/share/aresos/worlds')

    @property
    def state_dir(self):
        return os.path.join(self.home, '.local/state/aresos')

    @property
    def state_file(self):
        return os.path.join(self.state_dir, 'desktop.json')

    @property
    def log_file(self):
        return os.path.join(self.state_dir, 'desktop.log')

    @property
    def run_dir(self):
        return os.path.join(self.runtime, 'aresos')

    @property
    def socket(self):
        return os.path.join(self.run_dir, 'desktop.sock')

    @property
    def runtime_file(self):
        return os.path.join(self.run_dir, 'desktop-runtime.json')

    @property
    def exit_file(self):
        return os.path.join(self.run_dir, 'desktop-exit.json')

    @property
    def jvm_lock(self):
        return os.path.join(self.run_dir, 'desktop.lock')

    @property
    def view_text(self):
        return os.path.join(self.run_dir, 'desktop-view.txt')


def write_atomic(path, data, mode=0o644):
    """Write a whole file or nothing: a crash leaves the old file or the new one."""
    folder = os.path.dirname(path)
    os.makedirs(folder, exist_ok=True)
    handle, temporary = tempfile.mkstemp(prefix='.' + os.path.basename(path) + '.', dir=folder)
    try:
        with os.fdopen(handle, 'wb') as output:
            output.write(data.encode('utf-8') if isinstance(data, str) else data)
            output.flush()
            os.fsync(output.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    except BaseException:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
        raise


# ---------------------------------------------------------------- pinned inputs


def load_lock(share=SHARE):
    with open(os.path.join(share, LOCK_NAME), encoding='utf-8') as source:
        lock = json.load(source)
    if lock.get('schema') != 1:
        raise ValueError(f'unknown desktop lock schema: {lock.get("schema")!r}')
    return lock


def library_file(library):
    """Prism looks up a local ("MMC-hint": "local") library as instance/libraries/<artifact>-<version>.jar."""
    _, artifact, version = library['name'].split(':')
    name = f'{artifact}-{version}.jar'
    if os.path.basename(library['url']).replace('%2B', '+') != name:
        raise ValueError(f'library URL does not end in {name}: {library["url"]}')
    return name


def loader_patch(lock):
    """The Fabric Loader component as a Prism patch whose libraries come only from the image."""
    loader = lock['fabric_loader']
    return {
        'formatVersion': 1,
        'name': 'Fabric Loader',
        'uid': LOADER_UID,
        'version': loader['version'],
        'order': 10,
        'type': 'release',
        'mainClass': loader['main_class'],
        'requires': [{'uid': 'net.minecraft', 'equals': lock['minecraft']}],
        'libraries': [{'name': library['name'], 'MMC-hint': 'local'} for library in loader['libraries']],
    }


def sha256_file(path):
    digest = hashlib.sha256()
    with open(path, 'rb') as source:
        for block in iter(lambda: source.read(1 << 20), b''):
            digest.update(block)
    return digest.hexdigest()


def pinned_files(lock, share):
    """(path in the image, pinned sha256) for every jar the instance uses."""
    files = [(os.path.join(share, 'libraries', library_file(library)), library['sha256'])
             for library in lock['fabric_loader']['libraries']]
    files += [(os.path.join(share, 'mods', mod['file']), mod['sha256']) for mod in lock['mods']]
    return files


def verify_inputs(lock, share, java_check=True):
    """Problems with the image's own inputs: a pin mismatch, a missing file, a changed patch, no Java or Prism."""
    problems = []
    for path, expected in pinned_files(lock, share):
        try:
            info = os.lstat(path)
            if not stat.S_ISREG(info.st_mode):
                problems.append(f'{path} is not a regular file')
            elif sha256_file(path) != expected:
                problems.append(f'{path} does not match its pinned SHA-256')
        except OSError as error:
            problems.append(f'{path}: {error.strerror}')
    folders = {'libraries': {library_file(library) for library in lock['fabric_loader']['libraries']},
               'mods': {mod['file'] for mod in lock['mods']}}
    for folder, expected in folders.items():
        try:
            extra = sorted(set(os.listdir(os.path.join(share, folder))) - expected)
        except OSError:
            extra = []
        if extra:
            problems.append(f'{os.path.join(share, folder)} holds unpinned files: {", ".join(extra)}')
    patch = os.path.join(share, 'patches', LOADER_UID + '.json')
    try:
        with open(patch, encoding='utf-8') as source:
            if json.load(source) != loader_patch(lock):
                problems.append(f'{patch} differs from the pinned Fabric Loader')
    except (OSError, ValueError) as error:
        problems.append(f'{patch}: {error}')
    if java_check:
        for path, what in ((lock['java']['path'], 'Java 25'), (PRISM, 'Prism Launcher')):
            if not os.access(path, os.X_OK):
                problems.append(f'{what} is missing: {path}')
    return problems


# ---------------------------------------------------------------- the managed instance


def instance_config(lock):
    # Prism reads this with QSettings; values are plain on purpose (no commas, quotes or semicolons).
    settings = [
        ('ConfigVersion', '1.3'), ('InstanceType', 'OneSix'), ('name', lock['instance']), ('iconKey', 'default'),
        ('OverrideCommands', 'true'), ('PreLaunchCommand', ''), ('WrapperCommand', WRAPPER),
        ('PostExitCommand', ''),
        ('OverrideJavaLocation', 'true'), ('JavaPath', lock['java']['path']), ('AutomaticJava', 'false'),
        ('IgnoreJavaCompatibility', 'false'),
        ('OverrideMemory', 'true'), ('MinMemAlloc', str(MIN_HEAP_MB)), ('MaxMemAlloc', str(HEAP_MB)),
        ('OverrideConsole', 'true'), ('ShowConsole', 'false'), ('AutoCloseConsole', 'true'),
        ('ShowConsoleOnError', 'false'),
        ('OverrideWindow', 'true'), ('LaunchMaximized', 'true'),
        ('OverridePerformance', 'true'), ('UseDiscreteGpu', 'false'), ('UseZink', 'false'),
        ('EnableFeralGamemode', 'false'), ('EnableMangoHud', 'false'),
        ('OverrideMiscellaneous', 'true'), ('CloseAfterLaunch', 'false'), ('QuitAfterGameStop', 'false'),
    ]
    return '[General]\n' + ''.join(f'{key}={value}\n' for key, value in settings)


# Keys the supervision depends on: without the wrapper it cannot see the game, and Java 25 is pinned.
MANAGED_SETTINGS = ('InstanceType', 'OverrideCommands', 'WrapperCommand', 'OverrideJavaLocation', 'JavaPath')


def component_pack(lock):
    return {'components': [
        {'cachedName': 'Minecraft', 'cachedVersion': lock['minecraft'], 'important': True, 'uid': 'net.minecraft',
         'version': lock['minecraft']},
        {'cachedName': 'Fabric Loader', 'cachedVersion': lock['fabric_loader']['version'], 'uid': LOADER_UID,
         'version': lock['fabric_loader']['version']}], 'formatVersion': 1}


def game_options():
    # B5: 8-chunk render and 5-chunk simulation distance; a borderless window, never exclusive fullscreen.
    return (f'renderDistance:{RENDER_DISTANCE}\nsimulationDistance:{SIMULATION_DISTANCE}\n'
            'fullscreen:false\nonboardAccessibility:false\n')


def prism_settings(lock):
    # Only what keeps Prism's first-start wizard to its sign-in page and stops it fetching a Java of its own.
    settings = [('ConfigVersion', '1.3'), ('Language', 'en_US'), ('ApplicationTheme', 'system'),
                ('IconTheme', 'pe_colored'), ('JavaPath', lock['java']['path']), ('IgnoreJavaWizard', 'true'),
                ('AutomaticJavaSwitch', 'false'), ('AutomaticJavaDownload', 'false'),
                ('UserAskedAboutAutomaticJavaDownload', 'true')]
    return '[General]\n' + ''.join(f'{key}={value}\n' for key, value in settings)


def expected_links(paths, lock):
    """Instance-relative symlinks and where they must point."""
    return {
        'patches': os.path.join(paths.share, 'patches'),
        'libraries': os.path.join(paths.share, 'libraries'),
        'minecraft/mods': os.path.join(paths.share, 'mods'),
        'minecraft/saves': paths.worlds,
    }


def provision(paths, lock):
    """Create the managed instance from the image's inputs when it does not exist yet.

    Idempotent: an existing instance (complete or not) and an existing Prism configuration are never touched. The
    instance is assembled in a hidden folder and renamed into place, so it appears whole or not at all. Returns the
    list of things it created.
    """
    created = []
    if not os.path.isdir(paths.worlds):
        os.makedirs(paths.worlds, mode=0o755, exist_ok=True)
        created.append(paths.worlds)
    os.makedirs(paths.instances, exist_ok=True)
    target = paths.instance(lock['instance'])
    if not os.path.lexists(target):
        staging = tempfile.mkdtemp(prefix='.aresos-provisioning-', dir=paths.instances)
        try:
            os.makedirs(os.path.join(staging, 'minecraft'))
            for name, content in (('instance.cfg', instance_config(lock)),
                                  ('mmc-pack.json', json.dumps(component_pack(lock), indent=4) + '\n'),
                                  ('minecraft/options.txt', game_options()),
                                  ('.aresos-managed.json', json.dumps({'schema': 1, 'lock': lock['schema'],
                                                                       'minecraft': lock['minecraft']}) + '\n')):
                with open(os.path.join(staging, name), 'x', encoding='utf-8') as output:
                    output.write(content)
            for link, destination in expected_links(paths, lock).items():
                os.symlink(destination, os.path.join(staging, link))
            os.chmod(staging, 0o755)
            if os.path.lexists(target):
                raise FileExistsError(target)
            os.rename(staging, target)
            created.append(target)
        except FileExistsError:
            LOG.info('the desktop instance appeared while provisioning; leaving it as it is')
        finally:
            # Only a staging copy that was not renamed into place; rmtree removes its links, never their targets.
            if os.path.isdir(staging):
                shutil.rmtree(staging)
    if not os.path.lexists(paths.prism_config):
        try:
            with open(paths.prism_config, 'x', encoding='utf-8') as output:
                output.write(prism_settings(lock))
            created.append(paths.prism_config)
        except FileExistsError:
            pass
    return created


def parse_ini(text):
    """The [General] keys of a QSettings INI file (Prism's instance.cfg)."""
    values = {}
    section = None
    for line in text.splitlines():
        line = line.strip()
        if line.startswith('[') and line.endswith(']'):
            section = line[1:-1]
        elif '=' in line and section in (None, 'General'):
            key, value = line.split('=', 1)
            value = value.strip()
            if len(value) >= 2 and value[0] == value[-1] == '"':
                value = value[1:-1]
            values[key.strip()] = value
    return values


def check_instance(paths, lock):
    """Problems that make the existing instance differ from what this image pins. Never changes anything."""
    root = paths.instance(lock['instance'])
    if not os.path.isdir(root) or os.path.islink(root):
        return [f'{root} is not a folder']
    problems = []
    for link, destination in expected_links(paths, lock).items():
        path = os.path.join(root, link)
        if not os.path.islink(path):
            problems.append(f'{link} is not the AresOS link to {destination}')
        elif os.readlink(path) != destination:
            problems.append(f'{link} points to {os.readlink(path)}, not {destination}')
    try:
        with open(os.path.join(root, 'instance.cfg'), encoding='utf-8') as source:
            settings = parse_ini(source.read())
        expected = parse_ini(instance_config(lock))
        for key in MANAGED_SETTINGS:
            if settings.get(key) != expected[key]:
                problems.append(f'instance.cfg {key} is {settings.get(key)!r}, not {expected[key]!r}')
    except OSError as error:
        problems.append(f'instance.cfg: {error.strerror}')
    try:
        with open(os.path.join(root, 'mmc-pack.json'), encoding='utf-8') as source:
            pack = json.load(source)
        versions = {component.get('uid'): component.get('version') for component in pack.get('components', [])
                    if not component.get('disabled')}
        if versions.get('net.minecraft') != lock['minecraft']:
            problems.append(f'Minecraft is {versions.get("net.minecraft")}, this AresOS pins {lock["minecraft"]}')
        if versions.get(LOADER_UID) != lock['fabric_loader']['version']:
            problems.append(f'Fabric Loader is {versions.get(LOADER_UID)}, this AresOS pins '
                            f'{lock["fabric_loader"]["version"]}')
        extra = sorted(set(versions) - {'net.minecraft', LOADER_UID, 'org.lwjgl3'})
        if extra:
            problems.append('unexpected components: ' + ', '.join(extra))
    except (OSError, ValueError, AttributeError) as error:
        problems.append(f'mmc-pack.json: {error}')
    return problems


def readable_gzip(path):
    try:
        if not stat.S_ISREG(os.lstat(path).st_mode):
            return False
        with gzip.open(path, 'rb') as source:
            while source.read(1 << 20):
                pass
        return True
    except (OSError, EOFError, gzip.BadGzipFile):
        return False


def check_world(paths, lock):
    """('missing' | 'damaged' | 'ok', detail). Only reads; a damaged world is reported, never repaired."""
    world = os.path.join(paths.worlds, lock['world'])
    if not os.path.lexists(world):
        return 'missing', world
    if os.path.islink(world) or not os.path.isdir(world):
        return 'damaged', f'{world} is not a folder'
    if not (readable_gzip(os.path.join(world, 'level.dat')) or readable_gzip(os.path.join(world, 'level.dat_old'))):
        return 'damaged', 'level.dat cannot be read'
    marker = os.path.join(world, 'data/aresos/desktop.dat')
    if not readable_gzip(marker):
        return 'damaged', 'the AresOS desktop marker (data/aresos/desktop.dat) is missing or unreadable'
    provisioned = os.path.join(world, 'aresos-home.provisioned')
    if os.path.exists(provisioned):
        with open(provisioned, encoding='utf-8', errors='replace') as source:
            if source.read() != 'complete\n':
                return 'damaged', 'the hub was not finished when it was created (aresos-home.provisioned)'
    return 'ok', world


# ---------------------------------------------------------------- launch command and environment


def nvidia_present(root='/'):
    """The NVIDIA kernel driver lists at least one GPU."""
    try:
        return bool(os.listdir(os.path.join(root, 'proc/driver/nvidia/gpus')))
    except OSError:
        return False


def prism_command(lock, launch_id, world=None):
    """Prism in its own user scope (B5: the game in its own group with a soft memory target)."""
    command = [SYSTEMD_RUN, '--user', '--scope', '--quiet', '--collect', '--slice=aresos.slice',
               f'--unit=aresos-desktop-{launch_id}.scope', f'--property=MemoryHigh={MEMORY_HIGH}', '--',
               PRISM, '--launch', lock['instance']]
    if world:
        command += ['--world', world]
    return command


def session_environment(environ):
    """What Prism and the views inherit: the session's environment without launch secrets, with the system PATH."""
    env = {key: value for key, value in environ.items() if key not in PRIVATE_ENVIRONMENT}
    env['PATH'] = SYSTEM_PATH
    return env


def game_environment(instance, nonce, nvidia):
    """What the wrapper adds to the game's environment (B1's launch identity, the GPU choice)."""
    env = {'ARESOS_DESKTOP_INSTANCE': instance, 'ARESOS_LAUNCH_NONCE': nonce, 'PATH': SYSTEM_PATH}
    if nvidia:
        env.update(NVIDIA_OFFLOAD)
    return env


def new_token():
    return secrets.token_urlsafe(24)


# ---------------------------------------------------------------- persistent state and policy


@dataclasses.dataclass
class Persisted:
    latched: bool = False
    reason: str = None
    detail: str = ''
    consecutive: int = 0
    failures: list = dataclasses.field(default_factory=list)
    hub_seen: bool = False

    @classmethod
    def load(cls, path):
        try:
            with open(path, encoding='utf-8') as source:
                data = json.load(source)
        except FileNotFoundError:
            return cls()
        except (OSError, ValueError) as error:
            # A lost latch could let a crash loop resume; an unreadable file stops into recovery instead.
            return cls(latched=True, reason='state', detail=f'{path}: {error}')
        if not isinstance(data, dict) or data.get('schema') != 1:
            return cls(latched=True, reason='state', detail=f'{path}: unknown format')
        failures = [float(t) for t in data.get('failures', []) if isinstance(t, (int, float))]
        return cls(latched=bool(data.get('latched')), reason=data.get('reason'), detail=str(data.get('detail', '')),
                   consecutive=int(data.get('consecutive', 0)), failures=failures,
                   hub_seen=bool(data.get('hub_seen')))

    def save(self, path):
        data = dict(schema=1, latched=self.latched, reason=self.reason, detail=self.detail,
                    consecutive=self.consecutive, failures=self.failures, hub_seen=self.hub_seen)
        write_atomic(path, json.dumps(data, indent=2) + '\n', 0o600)

    def record_failure(self, now):
        """B2: count one unexpected failure; returns (latch, backoff seconds)."""
        # Wall-clock times survive a reboot; a time in the future (clock moved back) still counts as recent.
        self.failures = [t for t in self.failures if now - t < FAILURE_WINDOW] + [now]
        self.consecutive += 1
        latch = len(self.failures) >= MAX_FAILURES or self.consecutive >= MAX_FAILURES
        return latch, BACKOFF * 2 ** (self.consecutive - 1)

    def reset(self):
        self.latched, self.reason, self.detail = False, None, ''
        self.consecutive, self.failures = 0, []


@dataclasses.dataclass
class Launch:
    id: str
    nonce: str
    mode: str  # 'setup' (title screen, the owner creates AresHub) or 'hub' (--world AresHub)
    started: float = 0.0
    prism: object = None
    prism_exit: int = None
    prism_ended: float = None
    output: bytes = b''
    accepted: bool = False
    jvm_pid: int = None
    jvm_ticks: int = None
    jvm_started: float = None
    jvm_status: int = None
    jvm_ended: float = None
    ready: bool = False
    ever_ready: bool = False
    timed_out: bool = False
    adopted: bool = False


def process_ticks(pid, proc='/proc'):
    """A process's start time in clock ticks, which with the PID names it uniquely."""
    with open(f'{proc}/{pid}/stat', 'rb') as source:
        data = source.read()
    return int(data[data.rindex(b')') + 2:].split()[19])


def parent_pid(pid, proc='/proc'):
    with open(f'{proc}/{pid}/stat', 'rb') as source:
        data = source.read()
    return int(data[data.rindex(b')') + 2:].split()[1])


# ---------------------------------------------------------------- messages


def instance_logs(lock):
    base = f'~/.local/share/PrismLauncher/instances/{lock["instance"]}/minecraft'
    return f'  {base}/logs/latest.log\n  {base}/crash-reports/\n  ~/.local/state/aresos/desktop.log'


RETRY = 'Type  retry  and press Enter to try again.'


def message(state, reason, detail, lock, persisted):
    world = f'~/.local/share/aresos/worlds/{lock["world"]}'
    if state == SETUP:
        steps = ('1. Prism Launcher opens. Sign in there with your own Microsoft account.\n'
                 '2. Minecraft is downloaded (a few minutes the first time) and starts.\n'
                 '3. On the title screen click AresOS, keep or change the seed, and click Create.\n'
                 f'   Your hub is built and saved in {world}.\n')
        lead = {
            'setup': 'AresOS: first start\n\n',
            'setup_cancelled': 'AresOS: Prism closed before Minecraft started.\n\n',
            'setup_closed': 'AresOS: Minecraft closed before your hub was created.\n\n',
            'setup_crashed': f'AresOS: Minecraft stopped unexpectedly during setup ({detail}).\n\n',
        }.get(reason, 'AresOS: first start\n\n')
        tail = '\nThis window closes by itself when you are in your hub.\n'
        if reason != 'setup':
            tail = f'\n{RETRY}\n'
        return lead + steps + tail
    if state == AUTH_REQUIRED:
        return ('AresOS: Minecraft did not start.\n\n'
                'Prism Launcher ended before the game started. Usually it needs you to sign in again\n'
                '(Prism shows its own sign-in), or the network is not connected yet.\n\n'
                f'{RETRY} Prism opens again and the hub follows.\n')
    texts = {
        'quit': 'Minecraft was closed. Nothing is wrong.\n\n' + RETRY.replace('try again', 'open the hub again'),
        'slow_start': (f'The hub did not open within {int(START_TIMEOUT)} seconds. Minecraft is still running and\n'
                       'may still get there; this window closes by itself if it does.\n\nLogs:\n'
                       + instance_logs(lock)),
        'prism_failed': f'Prism Launcher could not start the desktop ({detail}).\n\nLogs:\n' + instance_logs(lock)
                        + f'\n\n{RETRY}',
        'crashes': (f'Minecraft stopped unexpectedly {persisted.consecutive} times in a row or 3 times within 5 '
                    f'minutes\n(last: {detail}), so AresOS stopped restarting it.\n\nLogs:\n' + instance_logs(lock)
                    + f'\n\n{RETRY}'),
        'killed': ('Minecraft was stopped by the system, most likely to free memory.\n'
                   'Close apps you do not need, wait a minute, then start it again.\n\n' + RETRY),
        'inputs': ('This AresOS image\'s Minecraft files do not match their pins, so the desktop is not\n'
                   f'started:\n{detail}\n\nThe next AresOS update or a rollback (at previous) brings them back.'),
        'instance': ('The desktop instance does not match this AresOS version:\n'
                     f'{detail}\n\nAresOS never changes an existing instance. To get a fresh one (your world is\n'
                     'kept, nothing is deleted):\n  aresos-desktop reset-instance\nthen  retry'),
        'world_missing': (f'Your hub world is missing: {world}\n'
                          'AresOS opened it before and never creates a replacement by itself.\n\n'
                          f'Put the folder back (from a backup), then {RETRY.lower()}\n'
                          'To start a new hub instead:  aresos-desktop forget-hub  then  retry'),
        'world_damaged': (f'Your hub world looks damaged: {detail}\n'
                          f'AresOS leaves {world} exactly as it is.\n\n'
                          f'Restore it from a backup, then {RETRY.lower()}'),
        'state': f'The desktop\'s own state file could not be read ({detail}).\n\n{RETRY}',
        'locked': (f'Minecraft for the desktop is still running from before ({detail}).\n'
                   'Close it, then ' + RETRY.lower()),
    }
    return 'AresOS: recovery\n\n' + texts.get(reason, f'{reason}: {detail}\n\n{RETRY}') + '\n'


# ---------------------------------------------------------------- the supervisor


class Supervisor:
    """The state machine. Processes, sockets and the clock come in through `runner`, so tests drive it directly."""

    def __init__(self, paths, lock, runner, clock=time.monotonic, wall=time.time, nvidia=None, environ=None):
        self.paths = paths
        self.lock = lock
        self.runner = runner
        self.clock = clock
        self.wall = wall
        self.nvidia = nvidia_present() if nvidia is None else nvidia
        self.environ = os.environ if environ is None else environ
        self.persisted = Persisted.load(paths.state_file)
        self.state = None
        self.reason = None
        self.detail = ''
        self.instance = None
        self.launch = None
        self.retry_at = None
        self.healthy_since = None
        self.last_heartbeat = None
        self.helper_nonce = None
        self.helper_starts = []
        self.helper_restart_at = None
        self.view = None

    # -- persistence

    def save(self):
        self.persisted.save(self.paths.state_file)

    def save_runtime(self):
        launch = self.launch
        data = dict(instance=self.instance, nonce=launch.nonce if launch else None,
                    launch=launch.id if launch else None, mode=launch.mode if launch else None,
                    jvm_pid=launch.jvm_pid if launch else None, jvm_ticks=launch.jvm_ticks if launch else None)
        write_atomic(self.paths.runtime_file, json.dumps(data) + '\n', 0o600)

    # -- state and views

    def enter(self, state, reason=None, detail=''):
        if (state, reason, detail) != (self.state, self.reason, self.detail):
            LOG.info('state %s%s%s', state, f' ({reason})' if reason else '', f': {detail}' if detail else '')
        self.state, self.reason, self.detail = state, reason, detail
        if state in (SETUP, AUTH_REQUIRED, RECOVERY):
            text = self.message()
            if self.view != text:
                self.runner.show_view(text)
                self.view = text
        elif self.view is not None:
            self.runner.close_view()
            self.view = None

    def message(self):
        return message(self.state, self.reason, self.detail, self.lock, self.persisted)

    def latch(self, reason, detail=''):
        self.persisted.latched, self.persisted.reason, self.persisted.detail = True, reason, detail
        self.save()
        self.retry_at = None
        self.enter(RECOVERY, reason, detail)

    # -- start-up

    def start(self):
        runtime = self.read_runtime()
        self.instance = runtime.get('instance') or 'aresdesktop-' + secrets.token_hex(6)
        if self.adopt(runtime):
            return
        if self.persisted.latched:
            self.enter(RECOVERY, self.persisted.reason, self.persisted.detail)
            return
        self.begin()

    def read_runtime(self):
        try:
            with open(self.paths.runtime_file, encoding='utf-8') as source:
                data = json.load(source)
            return data if isinstance(data, dict) else {}
        except (OSError, ValueError):
            return {}

    def adopt(self, runtime):
        """A supervisor restart finds the game of the previous one still running: watch it, never start another."""
        pid, ticks, nonce = runtime.get('jvm_pid'), runtime.get('jvm_ticks'), runtime.get('nonce')
        if not (isinstance(pid, int) and isinstance(ticks, int) and isinstance(nonce, str)):
            return False
        if not self.runner.alive(pid, ticks):
            return False
        launch = Launch(id=runtime.get('launch') or secrets.token_hex(6), nonce=nonce,
                        mode=runtime.get('mode') or 'hub', started=self.clock(), accepted=True, jvm_pid=pid,
                        jvm_ticks=ticks, jvm_started=self.clock(), adopted=True)
        self.launch = launch
        if not self.runner.watch_jvm(pid, ticks):
            self.launch = None
            return False
        LOG.info('adopted the running game (pid %d) from the previous supervisor', pid)
        self.ensure_helper()
        self.save_runtime()
        if self.persisted.latched:
            self.enter(RECOVERY, self.persisted.reason, self.persisted.detail)
        else:
            self.enter(SETUP if launch.mode == 'setup' else STARTING, 'setup' if launch.mode == 'setup' else None)
        return True

    def preflight(self):
        """(problem reason, detail) or (None, mode)."""
        problems = verify_inputs(self.lock, self.paths.share, java_check=self.runner.real)
        if problems:
            return 'inputs', '\n'.join('- ' + p for p in problems)
        try:
            provision(self.paths, self.lock)
        except OSError as error:
            return 'instance', f'- could not create the instance: {error}'
        problems = check_instance(self.paths, self.lock)
        if problems:
            return 'instance', '\n'.join('- ' + p for p in problems)
        world, detail = check_world(self.paths, self.lock)
        if world == 'damaged':
            return 'world_damaged', detail
        if world == 'missing':
            return ('world_missing', detail) if self.persisted.hub_seen else (None, 'setup')
        return None, 'hub'

    def begin(self):
        """Check, provision and launch, or latch recovery with the reason."""
        self.retry_at = None
        if self.runner.jvm_lock_held():
            # Something still holds the desktop's lock (a game this supervisor cannot see): never start a second.
            self.enter(RECOVERY, 'locked', 'the desktop lock is held')
            return
        problem, detail = self.preflight()
        if problem:
            self.latch(problem, detail)
            return
        self.start_launch(detail)

    def start_launch(self, mode):
        self.launch = Launch(id=secrets.token_hex(6), nonce=new_token(), mode=mode, started=self.clock())
        self.save_runtime()
        self.ensure_helper(restart=True)
        world = self.lock['world'] if mode == 'hub' else None
        self.enter(SETUP if mode == 'setup' else STARTING, 'setup' if mode == 'setup' else None)
        try:
            self.launch.prism = self.runner.start_prism(prism_command(self.lock, self.launch.id, world),
                                                        session_environment(self.environ))
        except OSError as error:
            self.launch.prism_exit = -1
            self.enter(RECOVERY, 'prism_failed', str(error))
            return
        LOG.info('launch %s: Prism started (%s)', self.launch.id, 'title screen for setup' if world is None
                 else f'--world {world}')

    # -- the helper

    def ensure_helper(self, restart=False):
        nonce = self.launch.nonce if self.launch else None
        if nonce is None:
            return
        if self.runner.helper_running() and self.helper_nonce == nonce and not restart:
            return
        if self.runner.helper_running():
            if self.helper_nonce == nonce:
                return
            self.runner.stop_helper()
        self.helper_nonce = nonce
        self.helper_restart_at = None
        self.helper_starts = [t for t in self.helper_starts if self.clock() - t < HELPER_BUDGET[1]] + [self.clock()]
        try:
            self.runner.start_helper(self.instance, nonce, session_environment(self.environ))
        except OSError as error:
            LOG.error('could not start the app helper: %s', error)

    def on_helper_exit(self, code):
        LOG.warning('the app helper exited (%s)', code)
        recent = [t for t in self.helper_starts if self.clock() - t < HELPER_BUDGET[1]]
        if len(recent) >= HELPER_BUDGET[0]:
            LOG.error('the app helper failed %d times within %d s; not restarting it until the next launch',
                      len(recent), HELPER_BUDGET[1])
            self.helper_restart_at = None
            return
        self.helper_restart_at = self.clock() + HELPER_RESTART

    def on_helper_status(self, status):
        launch = self.launch
        if launch is None or launch.jvm_pid is None or not isinstance(status, dict):
            return
        event = status.get('event')
        now = self.clock()
        if event == 'world_ready' and isinstance(status.get('world'), str):
            self.ready(status['world'], now)
        elif event == 'heartbeat' and isinstance(status.get('ready'), bool):
            if status['ready'] and isinstance(status.get('world'), str):
                self.ready(status['world'], now)
            elif not status['ready']:
                self.last_heartbeat = now
                if launch.ready:
                    LOG.info('the desktop left its world')
                launch.ready = False
                self.healthy_since = None
                if self.state == IN_WORLD:
                    self.enter(STARTING)

    def ready(self, world, now):
        launch = self.launch
        self.last_heartbeat = now
        if self.healthy_since is None:
            self.healthy_since = now
        launch.ready = launch.ever_ready = True
        if world == self.lock['world'] and not self.persisted.hub_seen:
            self.persisted.hub_seen = True
            self.save()
        if launch.mode == 'setup' and world == self.lock['world']:
            launch.mode = 'hub'
            self.save_runtime()
        if self.state != IN_WORLD and not self.persisted.latched:
            LOG.info('in the world %s', world)
            self.enter(IN_WORLD)

    # -- Prism

    def on_prism_output(self, data):
        if self.launch is not None:
            self.launch.output = (self.launch.output + data)[-8192:]

    def on_prism_exit(self, code):
        launch = self.launch
        if launch is None:
            return
        launch.prism_exit, launch.prism_ended = code, self.clock()
        LOG.info('Prism exited (%s)', code)
        if launch.accepted:
            return
        if code not in (0, 1) or (code != 0 and launch.prism_ended - launch.started < EARLY_PRISM_FAILURE):
            tail = launch.output.decode('utf-8', 'replace').strip().splitlines()[-3:]
            self.enter(RECOVERY, 'prism_failed', f'exit {code}' + (': ' + ' / '.join(tail) if tail else ''))

    # -- the wrapper (the real JVM)

    def on_jvm_start(self, request):
        """The wrapper asks for its launch: (ok, reply fields)."""
        if self.persisted.latched:
            return False, {'message': 'The AresOS desktop is in recovery. Type retry in its window first.'}
        if request.get('instance') != self.lock['instance']:
            return False, {'message': f'Only the {self.lock["instance"]} instance runs through this wrapper.'}
        java = request.get('java')
        if not isinstance(java, str) or os.path.realpath(java) != os.path.realpath(self.lock['java']['path']):
            return False, {'message': f'The desktop runs only on the pinned Java ({self.lock["java"]["path"]}).'}
        launch = self.launch
        if launch is not None and launch.jvm_pid is not None and self.runner.alive(launch.jvm_pid, launch.jvm_ticks):
            return False, {'message': 'The AresOS desktop is already running.'}
        if launch is None or launch.accepted:
            # Started from Prism by hand (not by this supervisor): a launch of its own, with a fresh nonce.
            world, _ = check_world(self.paths, self.lock)
            self.launch = launch = Launch(id=secrets.token_hex(6), nonce=new_token(),
                                          mode='hub' if world == 'ok' else 'setup', started=self.clock())
            self.ensure_helper(restart=True)
        launch.accepted = True
        launch.jvm_started = self.clock()
        self.retry_at = None
        self.save_runtime()
        if launch.mode == 'setup':
            if self.state != SETUP or self.reason != 'setup':
                self.enter(SETUP, 'setup')
        else:
            self.enter(STARTING)
        LOG.info('launch %s: the game is starting%s', launch.id, ' on NVIDIA' if self.nvidia else
                 ' on the default GPU (no NVIDIA driver found)')
        return True, {'launch': launch.id, 'env': game_environment(self.instance, launch.nonce, self.nvidia)}

    def on_jvm_started(self, wrapper_pid, pid):
        launch = self.launch
        if launch is None or not launch.accepted or launch.jvm_pid is not None:
            return False
        identity = self.runner.identify(pid)
        if identity is None or identity[0] != wrapper_pid:
            return False
        ticks = identity[1]
        if not self.runner.watch_jvm(pid, ticks):
            return False
        launch.jvm_pid, launch.jvm_ticks = pid, ticks
        self.save_runtime()
        LOG.info('launch %s: the game runs as pid %d', launch.id, pid)
        return True

    def on_jvm_report(self, pid, status):
        launch = self.launch
        if launch is not None and launch.jvm_pid == pid and isinstance(status, int):
            launch.jvm_status = status

    def on_jvm_gone(self):
        """The JVM's pidfd fired. Give the wrapper a moment to report how it ended."""
        if self.launch is not None and self.launch.jvm_ended is None:
            self.launch.jvm_ended = self.clock()

    def exit_status(self):
        launch = self.launch
        if launch.jvm_status is not None:
            return launch.jvm_status
        try:
            with open(self.paths.exit_file, encoding='utf-8') as source:
                data = json.load(source)
            if data.get('pid') == launch.jvm_pid and isinstance(data.get('status'), int):
                return data['status']
        except (OSError, ValueError, AttributeError):
            pass
        return None

    def finish_jvm(self):
        launch = self.launch
        status = self.exit_status()
        launch.jvm_pid = launch.jvm_ticks = launch.jvm_ended = None
        launch.ready = False
        self.healthy_since = None
        self.save_runtime()
        described = 'unknown exit' if status is None else (
            f'signal {-status}' if status < 0 else f'exit code {status}')
        LOG.info('launch %s: the game ended (%s)', launch.id, described)
        if status == 0:
            if launch.mode == 'setup' and not self.persisted.hub_seen:
                self.enter(SETUP, 'setup_closed')
            else:
                self.enter(RECOVERY, 'quit')
            return
        if status in SIGKILL_STATUSES:
            # B5: killed for memory or by force; never restarted by itself.
            self.latch('killed', described)
            return
        latch, delay = self.persisted.record_failure(self.wall())
        self.save()
        if latch:
            self.latch('crashes', described)
        elif launch.mode == 'setup':
            self.enter(SETUP, 'setup_crashed', described)
        else:
            LOG.info('restarting in %d s (%d of %d)', delay, self.persisted.consecutive, MAX_FAILURES)
            self.retry_at = self.clock() + delay
            self.enter(STARTING, 'restarting', described)

    # -- time

    def pending(self):
        """(due time, action) for everything timed; each action ends its own condition, so nothing fires twice."""
        launch = self.launch
        items = []
        if self.helper_restart_at is not None:
            items.append((self.helper_restart_at, self.restart_helper))
        if launch is not None and launch.jvm_ended is not None and launch.jvm_pid is not None:
            # Due at once when the wrapper has reported the exit status, otherwise after a short wait for it.
            items.append((launch.jvm_ended + (0 if launch.jvm_status is not None else EXIT_REPORT_WAIT),
                          self.finish_jvm))
        if self.retry_at is not None:
            items.append((self.retry_at, self.restart_launch))
        if (launch is not None and not launch.accepted and launch.prism_ended is not None
                and self.state in (SETUP, STARTING) and self.reason in (None, 'setup')):
            items.append((launch.prism_ended + PRISM_GRACE, self.prism_gave_up))
        if (launch is not None and launch.mode == 'hub' and launch.jvm_pid is not None and not launch.ever_ready
                and not launch.adopted and not launch.timed_out and launch.jvm_started is not None):
            items.append((launch.jvm_started + START_TIMEOUT, self.start_timed_out))
        if self.healthy_since is not None:
            items.append(((self.last_heartbeat or self.healthy_since) + HEARTBEAT_GAP, self.heartbeats_stopped))
            if self.persisted.consecutive or self.persisted.failures:
                items.append((self.healthy_since + HEALTHY_RESET, self.healthy_reset))
        return items

    def tick(self):
        for _ in range(16):
            now = self.clock()
            due = [item for item in self.pending() if item[0] <= now]
            if not due:
                return
            min(due, key=lambda item: item[0])[1]()

    def deadline(self):
        """Seconds until tick() has something to do, for the event loop's timeout."""
        items = self.pending()
        if not items:
            return 30.0
        return max(0.0, min(at for at, _ in items) - self.clock())

    def restart_helper(self):
        self.helper_restart_at = None
        if self.launch is not None and not self.runner.helper_running():
            self.helper_nonce = None
            self.ensure_helper()

    def restart_launch(self):
        self.retry_at = None
        self.begin()

    def prism_gave_up(self):
        if self.launch.mode == 'setup':
            self.enter(SETUP, 'setup_cancelled')
        else:
            self.enter(AUTH_REQUIRED, 'auth')

    def start_timed_out(self):
        self.launch.timed_out = True
        LOG.warning('launch %s: no ready world after %d s; the game keeps running', self.launch.id, START_TIMEOUT)
        self.enter(RECOVERY, 'slow_start')

    def heartbeats_stopped(self):
        LOG.info('heartbeats stopped; the healthy period starts again with the next one')
        self.healthy_since = None

    def healthy_reset(self):
        LOG.info('%d healthy minutes: failure counts reset', HEALTHY_RESET // 60)
        self.persisted.consecutive, self.persisted.failures = 0, []
        self.save()

    # -- the owner

    def retry(self):
        self.persisted.reset()
        self.save()
        self.retry_at = None
        launch = self.launch
        if launch is not None and launch.jvm_pid is not None and self.runner.alive(launch.jvm_pid, launch.jvm_ticks):
            self.enter(IN_WORLD if launch.ready else (SETUP if launch.mode == 'setup' else STARTING),
                       'setup' if launch.mode == 'setup' else None)
            return 'Minecraft is still running; the recovery state is cleared.'
        LOG.info('retry requested by the owner')
        self.begin()
        return f'State: {self.state}'

    def forget_hub(self):
        world, _ = check_world(self.paths, self.lock)
        if world != 'missing':
            return False, f'{self.lock["world"]} still exists; move it away first if you want a new hub.'
        self.persisted.hub_seen = False
        if self.persisted.reason == 'world_missing':
            self.persisted.reset()
        self.save()
        return True, 'The next start makes a new hub (title screen, AresOS button). Type retry.'

    def status(self):
        launch = self.launch
        return dict(state=self.state, reason=self.reason, latched=self.persisted.latched,
                    consecutive=self.persisted.consecutive, failures=len(self.persisted.failures),
                    hub_seen=self.persisted.hub_seen, instance=self.instance,
                    launch=launch.id if launch else None, jvm_pid=launch.jvm_pid if launch else None,
                    ready=bool(launch and launch.ready), nvidia=self.nvidia,
                    helper=self.runner.helper_running(), message=self.message() if self.state else '')


# ---------------------------------------------------------------- processes and the event loop


def set_parent_death_signal(signum):
    """Ask the kernel to send `signum` to this (child) process when its parent dies."""
    import ctypes
    libc = ctypes.CDLL(None, use_errno=True)
    if libc.prctl(1, signum, 0, 0, 0) != 0:  # PR_SET_PDEATHSIG
        raise OSError(ctypes.get_errno(), 'prctl(PR_SET_PDEATHSIG) failed')


class Runner:
    """Real processes. Each child gets a pidfd in the loop's selector; the helper's status pipe too."""
    real = True

    def __init__(self, paths, loop):
        self.paths = paths
        self.loop = loop
        self.helper = None
        self.helper_pipe = None
        self.view_process = None
        self.jvm_fd = None

    # helper
    def helper_running(self):
        return self.helper is not None and self.helper.poll() is None

    def start_helper(self, instance, nonce, env):
        read, write = os.pipe()
        env = dict(env, ARESOS_DESKTOP_INSTANCE=instance, ARESOS_LAUNCH_NONCE=nonce,
                   ARESOS_SHELL_STATUS_FD=str(write))
        try:
            self.helper = subprocess.Popen([HELPER], env=env, pass_fds=(write,), stdin=subprocess.DEVNULL,
                                           preexec_fn=lambda: set_parent_death_signal(signal.SIGTERM))
        finally:
            os.close(write)
        self.helper_pipe = read
        self.loop.watch_helper(self.helper, read)

    def stop_helper(self):
        helper, self.helper = self.helper, None
        if helper is None:
            return
        self.loop.forget(helper)
        if self.helper_pipe is not None:
            self.loop.forget_fd(self.helper_pipe)
            self.helper_pipe = None
        if helper.poll() is None:
            helper.terminate()
            try:
                helper.wait(5)
            except subprocess.TimeoutExpired:
                helper.kill()
                helper.wait()

    # Prism
    def start_prism(self, command, env):
        os.makedirs(self.paths.state_dir, exist_ok=True)
        process = subprocess.Popen(command, env=env, cwd=self.paths.home, stdin=subprocess.DEVNULL,
                                   stdout=subprocess.PIPE, stderr=subprocess.STDOUT, start_new_session=True)
        self.loop.watch_prism(process)
        return process

    # the JVM: not our child, so only a pidfd
    def identify(self, pid):
        """(parent PID, start ticks) of a process, or None."""
        try:
            return parent_pid(pid), process_ticks(pid)
        except (OSError, ValueError, IndexError):
            return None

    def alive(self, pid, ticks):
        try:
            return process_ticks(pid) == ticks
        except (OSError, ValueError, IndexError):
            return False

    def watch_jvm(self, pid, ticks):
        try:
            fd = os.pidfd_open(pid)
        except OSError:
            return False
        if not self.alive(pid, ticks):
            os.close(fd)
            return False
        if self.jvm_fd is not None:
            self.loop.forget_fd(self.jvm_fd)
        self.jvm_fd = fd
        self.loop.watch_jvm(fd)
        return True

    def jvm_lock_held(self):
        import fcntl
        try:
            fd = os.open(self.paths.jvm_lock, os.O_RDWR | os.O_CREAT | os.O_CLOEXEC, 0o600)
        except OSError:
            return False
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return False
        except BlockingIOError:
            return True
        finally:
            os.close(fd)

    # views
    def show_view(self, text):
        self.close_view()
        env = session_environment(self.loop.environ)
        env['ARESOS_TERMINAL'] = 'recovery'
        env['ARESOS_DESKTOP_VIEW'] = self.paths.view_text
        try:
            write_atomic(self.paths.view_text, text, 0o600)
            self.view_process = subprocess.Popen(
                VIEW_COMMAND, env=env, cwd=self.paths.home, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL, preexec_fn=lambda: set_parent_death_signal(signal.SIGTERM))
            self.loop.watch_view(self.view_process)
        except OSError as error:
            LOG.error('could not open the message window: %s', error)

    def close_view(self):
        view, self.view_process = self.view_process, None
        if view is not None and view.poll() is None:
            view.terminate()


class Peer:
    def __init__(self, sock, pid, uid):
        self.sock = sock
        self.pid = pid
        self.uid = uid
        self.buffer = b''
        self.wrapper = False


class Loop:
    """selectors-based event loop around one Supervisor."""

    def __init__(self, paths, lock, environ=None, nvidia=None):
        self.paths = paths
        self.environ = os.environ if environ is None else environ
        self.selector = selectors.DefaultSelector()
        self.children = {}
        self.stopping = False
        self.runner = Runner(paths, self)
        self.supervisor = Supervisor(paths, lock, self.runner, environ=self.environ, nvidia=nvidia)
        os.makedirs(paths.run_dir, mode=0o700, exist_ok=True)
        os.chmod(paths.run_dir, 0o700)
        self.listener = self.listen()

    def listen(self):
        path = self.paths.socket
        if os.path.lexists(path):
            probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            try:
                probe.connect(path)
                raise SystemExit('another aresos-desktop supervisor is already running')
            except (ConnectionRefusedError, FileNotFoundError):
                os.unlink(path)
            finally:
                probe.close()
        listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM | socket.SOCK_CLOEXEC)
        old = os.umask(0o177)
        try:
            listener.bind(path)
        finally:
            os.umask(old)
        listener.listen(8)
        listener.setblocking(False)
        self.selector.register(listener, selectors.EVENT_READ, ('listener', None))
        return listener

    # registrations
    def watch_child(self, kind, process):
        fd = os.pidfd_open(process.pid)
        self.children[fd] = process
        self.selector.register(fd, selectors.EVENT_READ, (kind, process))

    def watch_helper(self, process, pipe):
        os.set_blocking(pipe, False)
        self.watch_child('helper', process)
        self.selector.register(pipe, selectors.EVENT_READ, ('helper-status', [b'']))

    def watch_prism(self, process):
        os.set_blocking(process.stdout.fileno(), False)
        self.watch_child('prism', process)
        self.selector.register(process.stdout, selectors.EVENT_READ, ('prism-output', process))

    def watch_view(self, process):
        self.watch_child('view', process)

    def watch_jvm(self, fd):
        self.selector.register(fd, selectors.EVENT_READ, ('jvm', None))

    def forget(self, process):
        for fd, known in list(self.children.items()):
            if known is process:
                self.forget_fd(fd)

    def forget_fd(self, fd):
        try:
            self.selector.unregister(fd)
        except (KeyError, ValueError):
            pass
        self.children.pop(fd, None)
        if isinstance(fd, int):
            os.close(fd)

    # events
    def run(self):
        self.supervisor.start()
        while not self.stopping:
            for key, _ in self.selector.select(self.supervisor.deadline()):
                kind, data = key.data
                getattr(self, 'on_' + kind.replace('-', '_'))(key, data)
            self.supervisor.tick()
        self.close()

    def on_listener(self, key, data):
        try:
            sock, _ = self.listener.accept()
        except BlockingIOError:
            return
        pid, uid, _ = struct.unpack('3i', sock.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED,
                                                          struct.calcsize('3i')))
        if uid != os.getuid():
            sock.close()
            return
        sock.setblocking(False)
        self.selector.register(sock, selectors.EVENT_READ, ('peer', Peer(sock, pid, uid)))

    def on_peer(self, key, peer):
        try:
            data = peer.sock.recv(65536)
        except BlockingIOError:
            return
        except OSError:
            data = b''
        if not data:
            self.drop(peer)
            return
        peer.buffer += data
        while b'\n' in peer.buffer:
            line, peer.buffer = peer.buffer.split(b'\n', 1)
            try:
                answer = self.handle(peer, line)
            except Exception:  # one bad request must never take the desktop's supervision down
                LOG.exception('a request failed')
                answer = {'ok': False, 'error': 'internal', 'message': 'the request failed; see desktop.log'}
            self.reply(peer, answer)
        if len(peer.buffer) > MAX_LINE:
            self.drop(peer)

    def drop(self, peer):
        try:
            self.selector.unregister(peer.sock)
        except (KeyError, ValueError):
            pass
        peer.sock.close()

    def reply(self, peer, message):
        try:
            peer.sock.setblocking(True)
            peer.sock.settimeout(2)
            peer.sock.sendall((json.dumps(message) + '\n').encode('utf-8'))
            peer.sock.setblocking(False)
        except OSError:
            self.drop(peer)

    def handle(self, peer, line):
        try:
            request = json.loads(line.decode('utf-8'))
            if not isinstance(request, dict) or not isinstance(request.get('op'), str):
                raise ValueError('a request is a JSON object with an op')
        except (ValueError, UnicodeError) as error:
            return {'ok': False, 'error': 'malformed', 'message': str(error)}
        supervisor = self.supervisor
        op = request['op']
        if op == 'jvm_start':
            if request.get('pid') != peer.pid:
                return {'ok': False, 'error': 'not_authorized', 'message': 'pid does not match the connection'}
            ok, fields = supervisor.on_jvm_start(request)
            peer.wrapper = ok
            return dict(ok=ok, **fields)
        if op == 'jvm_started' and peer.wrapper and isinstance(request.get('pid'), int):
            return {'ok': supervisor.on_jvm_started(peer.pid, request['pid'])}
        if op == 'jvm_exited' and isinstance(request.get('pid'), int):
            # Only the game this supervisor watches can be reported, so any same-user peer may report it.
            supervisor.on_jvm_report(request['pid'], request.get('status'))
            return {'ok': True}
        if op == 'status':
            return dict(ok=True, **supervisor.status())
        if op == 'retry':
            return {'ok': True, 'message': supervisor.retry()}
        if op == 'forget_hub':
            ok, text = supervisor.forget_hub()
            return {'ok': ok, 'message': text}
        return {'ok': False, 'error': 'unknown_operation', 'message': f'unknown op {op!r}'}

    def reap(self, key, process):
        self.forget_fd(key.fd)
        return process.wait()

    def on_helper(self, key, process):
        code = self.reap(key, process)
        if process is self.runner.helper:
            self.runner.helper = None
            self.supervisor.on_helper_exit(code)

    def on_helper_status(self, key, buffer):
        try:
            data = os.read(key.fd, 65536)
        except BlockingIOError:
            return
        if not data:
            self.forget_fd(key.fd)
            if self.runner.helper_pipe == key.fd:
                self.runner.helper_pipe = None
            return
        buffer[0] += data
        while b'\n' in buffer[0]:
            line, buffer[0] = buffer[0].split(b'\n', 1)
            try:
                self.supervisor.on_helper_status(json.loads(line.decode('utf-8')))
            except (ValueError, UnicodeError):
                LOG.warning('ignored a malformed status line from the app helper')
        buffer[0] = buffer[0][-MAX_LINE:]

    def on_prism(self, key, process):
        code = self.reap(key, process)
        # Read what is already there, for an early failure's message. The pipe itself stays open until its last
        # writer is gone: a process Prism started may still hold it, and must never get a broken pipe.
        while not process.stdout.closed and self.read_prism(process):
            pass
        if self.supervisor.launch is not None and self.supervisor.launch.prism is process:
            self.supervisor.on_prism_exit(code)

    def read_prism(self, process):
        try:
            data = os.read(process.stdout.fileno(), 65536)
        except BlockingIOError:
            return False
        except (OSError, ValueError):
            data = b''
        if not data:
            try:
                self.selector.unregister(process.stdout)
            except (KeyError, ValueError):
                pass
            process.stdout.close()
            return False
        if self.supervisor.launch is not None and self.supervisor.launch.prism is process:
            self.supervisor.on_prism_output(data)
        return True

    def on_prism_output(self, key, process):
        self.read_prism(process)

    def on_view(self, key, process):
        self.reap(key, process)

    def on_jvm(self, key, data):
        self.forget_fd(key.fd)
        if self.runner.jvm_fd == key.fd:
            self.runner.jvm_fd = None
        self.supervisor.on_jvm_gone()

    def close(self):
        self.runner.stop_helper()
        self.runner.close_view()
        self.listener.close()
        try:
            os.unlink(self.paths.socket)
        except FileNotFoundError:
            pass


# ---------------------------------------------------------------- command line


def request(paths, message, timeout=10):
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.settimeout(timeout)
    try:
        sock.connect(paths.socket)
        sock.sendall((json.dumps(message) + '\n').encode('utf-8'))
        data = b''
        while not data.endswith(b'\n'):
            chunk = sock.recv(65536)
            if not chunk:
                break
            data += chunk
        return json.loads(data.decode('utf-8'))
    finally:
        sock.close()


def setup_logging(paths, foreground):
    os.makedirs(paths.state_dir, exist_ok=True)
    handlers = [logging.handlers.RotatingFileHandler(paths.log_file, maxBytes=512 * 1024, backupCount=1)]
    if foreground:
        handlers.append(logging.StreamHandler())
    logging.basicConfig(level=logging.INFO, handlers=handlers,
                        format='%(asctime)s aresos-desktop: %(levelname)s %(message)s')


def supervise(paths):
    setup_logging(paths, foreground=True)
    try:
        lock = load_lock(paths.share)
    except (OSError, ValueError) as error:
        LOG.error('cannot read the pinned inputs: %s', error)
        lock = None
    if lock is None:
        show_failure(paths, 'This AresOS image has no readable Minecraft pins '
                            f'({os.path.join(paths.share, LOCK_NAME)}), so the desktop cannot start.')
        return 1
    loop = Loop(paths, lock)

    def stop(signum, frame):
        loop.stopping = True

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGHUP, stop)
    signal.signal(signal.SIGINT, stop)
    loop.run()
    return 0


def show_failure(paths, text):
    """The keeper's last resort: a terminal with the reason, outside any supervisor."""
    write_atomic(paths.view_text, 'AresOS: recovery\n\n' + text + '\n\nLogs: ~/.local/state/aresos/desktop.log\n',
                 0o600)
    env = session_environment(os.environ)
    env['ARESOS_TERMINAL'] = 'recovery'
    env['ARESOS_DESKTOP_VIEW'] = paths.view_text
    subprocess.Popen(VIEW_COMMAND, env=env, cwd=paths.home, stdin=subprocess.DEVNULL, start_new_session=True)


def session(paths):
    """Keep the supervisor running for the session; give up into a terminal if it keeps failing."""
    setup_logging(paths, foreground=False)
    starts = []
    child = None
    stopping = False

    def stop(signum, frame):
        nonlocal stopping
        stopping = True
        if child is not None and child.poll() is None:
            child.terminate()

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGHUP, stop)
    signal.signal(signal.SIGINT, stop)
    while not stopping:
        now = time.monotonic()
        starts = [t for t in starts if now - t < KEEPER_BUDGET[1]] + [now]
        child = subprocess.Popen([SELF, 'supervise'], env=session_environment(os.environ))
        code = child.wait()
        if stopping or code == 0:
            return 0
        LOG.error('the supervisor exited with %s', code)
        if len(starts) >= KEEPER_BUDGET[0]:
            show_failure(paths, f'The desktop supervisor failed {len(starts)} times within '
                                f'{int(KEEPER_BUDGET[1] // 60)} minutes, so it was not started again.\n'
                                'Log out and in again (or restart) to try once more.')
            return 1
        time.sleep(2)
    return 0


def reset_instance(paths):
    lock = load_lock(paths.share)
    runner = Runner(paths, None)
    if runner.jvm_lock_held():
        print('The desktop is running. Close Minecraft first.', file=sys.stderr)
        return 1
    root = paths.instance(lock['instance'])
    if not os.path.lexists(root):
        print('There is no desktop instance; the next start creates one.')
        return 0
    aside = root + '.aside-' + time.strftime('%Y-%m-%d_%H-%M-%S')
    os.rename(root, aside)
    # The old copy must not keep opening the same worlds: drop only its link to them (the link, not a world).
    saves = os.path.join(aside, 'minecraft/saves')
    if os.path.islink(saves):
        os.unlink(saves)
    print(f'Moved the old instance to {aside} (nothing deleted). Type retry to start with a new one.')
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(prog='aresos-desktop', description='AresOS desktop supervisor (package 23)')
    parser.add_argument('command', choices=['session', 'supervise', 'status', 'retry', 'forget-hub',
                                            'reset-instance', 'explain'])
    args = parser.parse_args(argv)
    paths = Paths.from_environ()
    if args.command == 'session':
        return session(paths)
    if args.command == 'supervise':
        return supervise(paths)
    if args.command == 'reset-instance':
        return reset_instance(paths)
    op = {'status': 'status', 'explain': 'status', 'retry': 'retry', 'forget-hub': 'forget_hub'}[args.command]
    try:
        reply = request(paths, {'op': op})
    except (OSError, ValueError) as error:
        if args.command == 'explain' and os.path.exists(paths.view_text):
            with open(paths.view_text, encoding='utf-8') as source:
                print(source.read(), end='')
            return 0
        print(f'The AresOS desktop supervisor is not running ({error}).', file=sys.stderr)
        return 1
    if args.command == 'status':
        print(json.dumps({k: v for k, v in reply.items() if k != 'message'}, indent=2))
        return 0
    if args.command == 'explain':
        print(reply.get('message', ''), end='')
        return 0
    print(reply.get('message', ''))
    return 0 if reply.get('ok') else 1


if __name__ == '__main__':
    sys.exit(main())
