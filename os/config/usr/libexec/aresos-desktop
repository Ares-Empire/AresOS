# ---------------------------------------------------------------- paths


@dataclasses.dataclass(frozen=True)
class Paths:
    """Every file the supervisor touches, from HOME and XDG_RUNTIME_DIR, so tests use temporary folders."""
    home: str
    runtime: str
    share: str = SHARE

    @classmethod
    def from_environ(cls, environ=None, share=SHARE):
        environ = os.environ if environ is None else environ
        home, runtime = environ.get('HOME', ''), environ.get('XDG_RUNTIME_DIR', '')
        if not os.path.isabs(home) or not os.path.isabs(runtime):
            raise SystemExit('aresos-desktop needs an absolute HOME and XDG_RUNTIME_DIR')
        return cls(home, runtime, share)

    @property
    def prism_data(self):
        return os.path.join(self.home, '.local/share/PrismLauncher')

    @property
    def prism_config(self):
        return os.path.join(self.prism_data, 'prismlauncher.cfg')

    @property
    def instances(self):
        return os.path.join(self.prism_data, 'instances')

    def instance(self, name):
        return os.path.join(self.instances, name)

    @property
    def worlds(self):
        return os.path.join(self.home, '.local/share/aresos/worlds')

    @property
    def state_dir(self):
        return os.path.join(self.home, '.local/state/aresos')

    @property
    def state_file(self):
        return os.path.join(self.state_dir, 'desktop.json')

    @property
    def log_file(self):
        return os.path.join(self.state_dir, 'desktop.log')

    @property
    def run_dir(self):
        return os.path.join(self.runtime, 'aresos')

    @property
    def socket(self):
        return os.path.join(self.run_dir, 'desktop.sock')

    @property
    def runtime_file(self):
        return os.path.join(self.run_dir, 'desktop-runtime.json')

    @property
    def exit_file(self):
        # In the state folder, not the runtime folder: how a launch ended must survive a reboot until the
        # reconciliation that uses it is saved (review 5, finding 3).
        return os.path.join(self.state_dir, 'desktop-exit.json')

    @property
    def jvm_lock(self):
        return os.path.join(self.run_dir, 'desktop.lock')

    @property
    def stop_block(self):
        # While it names this session, no launch is admitted (package 25, the lead's fix 2). It ends with the folder.
        return os.path.join(self.run_dir, 'desktop-stopping.json')

    @property
    def view_text(self):
        return os.path.join(self.run_dir, 'desktop-view.txt')


def write_atomic(path, data, mode=0o644):
    """Write a whole file or nothing: a crash leaves the old file or the new one."""
    folder = os.path.dirname(path)
    os.makedirs(folder, exist_ok=True)
    handle, temporary = tempfile.mkstemp(prefix='.' + os.path.basename(path) + '.', dir=folder)
    try:
        with os.fdopen(handle, 'wb') as output:
            output.write(data.encode('utf-8') if isinstance(data, str) else data)
            output.flush()
            os.fsync(output.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    except BaseException:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
        raise


def write_durable(path, data, mode=0o644):
    """write_atomic, and the folder's entry on the disk too, as the wrapper writes its exit record (package 25,
    2.3): what a stop recorded must still be there after the power went off."""
    write_atomic(path, data, mode)
    folder = os.open(os.path.dirname(path), os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(folder)
    finally:
        os.close(folder)


# ---------------------------------------------------------------- pinned inputs


def load_lock(share=SHARE):
    with open(os.path.join(share, LOCK_NAME), encoding='utf-8') as source:
        lock = json.load(source)
    if lock.get('schema') != 1:
        raise ValueError(f'unknown desktop lock schema: {lock.get("schema")!r}')
    return lock


def library_file(library):
    """Prism looks up a local ("MMC-hint": "local") library as instance/libraries/<artifact>-<version>.jar."""
    _, artifact, version = library['name'].split(':')
    name = f'{artifact}-{version}.jar'
    if os.path.basename(library['url']).replace('%2B', '+') != name:
        raise ValueError(f'library URL does not end in {name}: {library["url"]}')
    return name


def loader_patch(lock):
    """The Fabric Loader component as a Prism patch whose libraries come only from the image."""
    loader = lock['fabric_loader']
    return {
        'formatVersion': 1,
        'name': 'Fabric Loader',
        'uid': LOADER_UID,
        'version': loader['version'],
        'order': 10,
        'type': 'release',
        'mainClass': loader['main_class'],
        'requires': [{'uid': 'net.minecraft', 'equals': lock['minecraft']}],
        'libraries': [{'name': library['name'], 'MMC-hint': 'local'} for library in loader['libraries']],
    }


def sha256_file(path):
    digest = hashlib.sha256()
    with open(path, 'rb') as source:
        for block in iter(lambda: source.read(1 << 20), b''):
            digest.update(block)
    return digest.hexdigest()


def pinned_files(lock, share):
    """(path in the image, pinned sha256) for every file the instance uses: jars and Prism's component metadata."""
    files = [(os.path.join(share, 'libraries', library_file(library)), library['sha256'])
             for library in lock['fabric_loader']['libraries']]
    files += [(os.path.join(share, 'mods', mod['file']), mod['sha256']) for mod in lock['mods']]
    # Minecraft and LWJGL as Prism components (their libraries, natives and main jar are listed there with hashes
    # that Prism checks on download). Being local patches, Prism never resolves other versions for them.
    files += [(os.path.join(share, 'patches', component['file']), component['sha256'])
              for component in lock['components']]
    return files


def pinned_components(lock):
    """uid → version of every component the desktop instance may contain."""
    versions = {component['uid']: component['version'] for component in lock['components']}
    versions[LOADER_UID] = lock['fabric_loader']['version']
    return versions


def verify_inputs(lock, share, java_check=True):
    """Problems with the image's own inputs: a pin mismatch, a missing file, a changed patch, no Java or Prism."""
    problems = []
    for path, expected in pinned_files(lock, share):
        try:
            info = os.lstat(path)
            if not stat.S_ISREG(info.st_mode):
                problems.append(f'{path} is not a regular file')
            elif sha256_file(path) != expected:
                problems.append(f'{path} does not match its pinned SHA-256')
        except OSError as error:
            problems.append(f'{path}: {error.strerror}')
    folders = {'libraries': {library_file(library) for library in lock['fabric_loader']['libraries']},
               'mods': {mod['file'] for mod in lock['mods']},
               'patches': {component['file'] for component in lock['components']} | {LOADER_UID + '.json'}}
    for folder, expected in folders.items():
        try:
            extra = sorted(set(os.listdir(os.path.join(share, folder))) - expected)
        except OSError:
            extra = []
        if extra:
            problems.append(f'{os.path.join(share, folder)} holds unpinned files: {", ".join(extra)}')
    patch = os.path.join(share, 'patches', LOADER_UID + '.json')
    try:
        with open(patch, encoding='utf-8') as source:
            if json.load(source) != loader_patch(lock):
                problems.append(f'{patch} differs from the pinned Fabric Loader')
    except (OSError, ValueError) as error:
        problems.append(f'{patch}: {error}')
    if java_check:
        for path, what in ((lock['java']['path'], 'Java 25'), (PRISM, 'Prism Launcher')):
            if not os.access(path, os.X_OK):
                problems.append(f'{what} is missing: {path}')
    return problems


# ---------------------------------------------------------------- the managed instance


def instance_config(lock):
    # Prism reads this with QSettings; values are plain on purpose (no commas, quotes or semicolons). An '=' or a
    # space inside a value is fine: a line splits at its first '=', and Prism splits JvmArgs at spaces. The keys are
    # Prism 11.1.1's (MinecraftInstance::loadSpecificSettings): JvmArgs counts only with OverrideJavaArgs=true, and
    # it must never hold -Xms, -Xmx or the other heap options, or Prism refuses the launch with a dialog
    # (JavaCommon::checkJVMArgs); the heap is MinMemAlloc and MaxMemAlloc.
    settings = [
        ('ConfigVersion', '1.3'), ('InstanceType', 'OneSix'), ('name', lock['instance']), ('iconKey', 'default'),
        ('OverrideCommands', 'true'), ('PreLaunchCommand', ''), ('WrapperCommand', WRAPPER),
        ('PostExitCommand', ''),
        ('OverrideJavaLocation', 'true'), ('JavaPath', lock['java']['path']), ('AutomaticJava', 'false'),
        ('IgnoreJavaCompatibility', 'false'),
        ('OverrideMemory', 'true'), ('MinMemAlloc', str(MIN_HEAP_MB)), ('MaxMemAlloc', str(HEAP_MB)),
        ('OverrideJavaArgs', 'true'), ('JvmArgs', JVM_ARGS),
        ('OverrideConsole', 'true'), ('ShowConsole', 'false'), ('AutoCloseConsole', 'true'),
        ('ShowConsoleOnError', 'false'),
        ('OverrideWindow', 'true'), ('LaunchMaximized', 'true'),
        ('OverridePerformance', 'true'), ('UseDiscreteGpu', 'false'), ('UseZink', 'false'),
        ('EnableFeralGamemode', 'false'), ('EnableMangoHud', 'false'),
        ('OverrideMiscellaneous', 'true'), ('CloseAfterLaunch', 'false'), ('QuitAfterGameStop', 'false'),
    ]
    return '[General]\n' + ''.join(f'{key}={value}\n' for key, value in settings)


# Keys the supervision depends on: without the wrapper it cannot see the game, and Java 25 is pinned.
MANAGED_SETTINGS = ('InstanceType', 'OverrideCommands', 'WrapperCommand', 'OverrideJavaLocation', 'JavaPath')


def component_pack(lock):
    versions = pinned_components(lock)
    return {'components': [
        {'cachedName': 'Minecraft', 'cachedVersion': versions['net.minecraft'], 'important': True,
         'uid': 'net.minecraft', 'version': versions['net.minecraft']},
        {'cachedName': 'LWJGL 3', 'cachedVersion': versions['org.lwjgl3'], 'dependencyOnly': True,
         'uid': 'org.lwjgl3', 'version': versions['org.lwjgl3']},
        {'cachedName': 'Fabric Loader', 'cachedVersion': versions[LOADER_UID], 'uid': LOADER_UID,
         'version': versions[LOADER_UID]}], 'formatVersion': 1}


def game_options():
    # B5: 8-chunk render and 5-chunk simulation distance; a borderless window, never exclusive fullscreen.
    return (f'renderDistance:{RENDER_DISTANCE}\nsimulationDistance:{SIMULATION_DISTANCE}\n'
            'fullscreen:false\nonboardAccessibility:false\n')


def prism_settings(lock):
    # Only what keeps Prism's first-start wizard to its sign-in page and stops it fetching a Java of its own.
    settings = [('ConfigVersion', '1.3'), ('Language', 'en_US'), ('ApplicationTheme', 'system'),
                ('IconTheme', 'pe_colored'), ('JavaPath', lock['java']['path']), ('IgnoreJavaWizard', 'true'),
                ('AutomaticJavaSwitch', 'false'), ('AutomaticJavaDownload', 'false'),
                ('UserAskedAboutAutomaticJavaDownload', 'true')]
    return '[General]\n' + ''.join(f'{key}={value}\n' for key, value in settings)


def expected_links(paths, lock):
    """Instance-relative symlinks and where they must point."""
    return {
        'patches': os.path.join(paths.share, 'patches'),
        'libraries': os.path.join(paths.share, 'libraries'),
        'minecraft/mods': os.path.join(paths.share, 'mods'),
        'minecraft/saves': paths.worlds,
    }


def provision(paths, lock):
    """Create the managed instance from the image's inputs when it does not exist yet.

    Idempotent: an existing instance (complete or not) and an existing Prism configuration are never touched. The
    instance is assembled in a hidden folder and renamed into place, so it appears whole or not at all. Returns the
    list of things it created.
    """
    created = []
    if not os.path.isdir(paths.worlds):
        os.makedirs(paths.worlds, mode=0o755, exist_ok=True)
        created.append(paths.worlds)
    os.makedirs(paths.instances, exist_ok=True)
    target = paths.instance(lock['instance'])
    if not os.path.lexists(target):
        staging = tempfile.mkdtemp(prefix='.aresos-provisioning-', dir=paths.instances)
        try:
            os.makedirs(os.path.join(staging, 'minecraft'))
            for name, content in (('instance.cfg', instance_config(lock)),
                                  ('mmc-pack.json', json.dumps(component_pack(lock), indent=4) + '\n'),
                                  ('minecraft/options.txt', game_options()),
                                  ('.aresos-managed.json', json.dumps({'schema': 1, 'lock': lock['schema'],
                                                                       'minecraft': lock['minecraft']}) + '\n')):
                with open(os.path.join(staging, name), 'x', encoding='utf-8') as output:
                    output.write(content)
            for link, destination in expected_links(paths, lock).items():
                os.symlink(destination, os.path.join(staging, link))
            os.chmod(staging, 0o755)
            if os.path.lexists(target):
                raise FileExistsError(target)
            os.rename(staging, target)
            created.append(target)
        except FileExistsError:
            LOG.info('the desktop instance appeared while provisioning; leaving it as it is')
        finally:
            # Only a staging copy that was not renamed into place; rmtree removes its links, never their targets.
            if os.path.isdir(staging):
                shutil.rmtree(staging)
    if not os.path.lexists(paths.prism_config):
        try:
            with open(paths.prism_config, 'x', encoding='utf-8') as output:
                output.write(prism_settings(lock))
            created.append(paths.prism_config)
        except FileExistsError:
            pass
    return created


def parse_ini(text):
    """The [General] keys of a QSettings INI file (Prism's instance.cfg)."""
    values = {}
    section = None
    for line in text.splitlines():
        line = line.strip()
        if line.startswith('[') and line.endswith(']'):
            section = line[1:-1]
        elif '=' in line and section in (None, 'General'):
            key, value = line.split('=', 1)
            value = value.strip()
            if len(value) >= 2 and value[0] == value[-1] == '"':
                value = value[1:-1]
            values[key.strip()] = value
    return values


def check_instance(paths, lock):
    """Problems that make the existing instance differ from what this image pins. Never changes anything."""
    root = paths.instance(lock['instance'])
    if not os.path.isdir(root) or os.path.islink(root):
        return [f'{root} is not a folder']
    problems = []
    for link, destination in expected_links(paths, lock).items():
        path = os.path.join(root, link)
        if not os.path.islink(path):
            problems.append(f'{link} is not the AresOS link to {destination}')
        elif os.readlink(path) != destination:
            problems.append(f'{link} points to {os.readlink(path)}, not {destination}')
    try:
        with open(os.path.join(root, 'instance.cfg'), encoding='utf-8') as source:
            settings = parse_ini(source.read())
        expected = parse_ini(instance_config(lock))
        for key in MANAGED_SETTINGS:
            if settings.get(key) != expected[key]:
                problems.append(f'instance.cfg {key} is {settings.get(key)!r}, not {expected[key]!r}')
    except OSError as error:
        problems.append(f'instance.cfg: {error.strerror}')
    try:
        with open(os.path.join(root, 'mmc-pack.json'), encoding='utf-8') as source:
            pack = json.load(source)
        components = [component for component in pack.get('components', []) if not component.get('disabled')]
        versions = {component.get('uid'): component.get('version') for component in components}
        pinned = pinned_components(lock)
        names = {'net.minecraft': 'Minecraft', 'org.lwjgl3': 'LWJGL', LOADER_UID: 'Fabric Loader'}
        for uid, version in pinned.items():
            if versions.get(uid) != version:
                problems.append(f'{names.get(uid, uid)} is {versions.get(uid)}, this AresOS pins {version}')
        extra = sorted(set(versions) - set(pinned))
        if extra or len(components) != len(versions):
            problems.append('unexpected components: ' + (', '.join(extra) or 'a component listed twice'))
    except (OSError, ValueError, AttributeError) as error:
        problems.append(f'mmc-pack.json: {error}')
    return problems


# ---------------------------------------------------------------- the world's saved data


class NbtError(ValueError):
    pass


def java_utf(raw):
    """An NBT string: Java's modified UTF-8 (DataOutput.writeUTF), not UTF-8.

    NUL is C0 80 and a character outside the BMP is its two UTF-16 surrogates, three bytes each. Decoded as
    DataInput.readUTF does: the 1-, 2- and 3-byte forms, anything else (4-byte UTF-8 included) is malformed.
    """
    if max(raw, default=0) < 0x80:
        return raw.decode('ascii')
    units = []
    index, size = 0, len(raw)
    while index < size:
        first = raw[index]
        if first < 0x80:
            units.append(first)
            index += 1
        elif first >> 5 == 0b110 and index + 1 < size and raw[index + 1] >> 6 == 0b10:
            units.append((first & 0x1f) << 6 | raw[index + 1] & 0x3f)
            index += 2
        elif (first >> 4 == 0b1110 and index + 2 < size and raw[index + 1] >> 6 == 0b10
              and raw[index + 2] >> 6 == 0b10):
            units.append((first & 0x0f) << 12 | (raw[index + 1] & 0x3f) << 6 | raw[index + 2] & 0x3f)
            index += 3
        else:
            raise NbtError(f'malformed string at byte {index}')
    # Surrogate pairs become one character; a lone surrogate stays as Java keeps it.
    return struct.pack(f'<{len(units)}H', *units).decode('utf-16-le', 'surrogatepass')


def read_nbt(data, limit=1 << 20):
    """Minecraft's named binary tag format: (root name, compound as {name: (tag type, value)}).

    Bounded and strict, for reading small saved-data files: any truncation, unknown tag, trailing byte or excess
    nesting is an error, never a guess.
    """
    position = 0

    def take(count):
        nonlocal position
        if count < 0 or position + count > len(data):
            raise NbtError('truncated')
        chunk = data[position:position + count]
        position += count
        return chunk

    def number(fmt):
        size = struct.calcsize(fmt)
        return struct.unpack(fmt, take(size))[0]

    def string():
        return java_utf(take(number('>H')))

    def payload(tag, depth):
        if depth > 64:
            raise NbtError('nested too deeply')
        simple = {1: '>b', 2: '>h', 3: '>i', 4: '>q', 5: '>f', 6: '>d'}
        if tag in simple:
            return number(simple[tag])
        if tag in (7, 11, 12):
            count = number('>i')
            width = {7: 1, 11: 4, 12: 8}[tag]
            if count < 0 or count * width > limit:
                raise NbtError('array too large')
            raw = take(count * width)
            return raw if tag == 7 else list(struct.unpack(f'>{count}{"i" if tag == 11 else "q"}', raw))
        if tag == 8:
            return string()
        if tag == 9:
            element, count = number('>b'), number('>i')
            if count < 0 or count > limit or (count and element == 0):
                raise NbtError('bad list')
            return [payload(element, depth + 1) for _ in range(count)]
        if tag == 10:
            compound = {}
            while True:
                child = number('>b')
                if child == 0:
                    return compound
                name = string()
                compound[name] = (child, payload(child, depth + 1))
        raise NbtError(f'unknown tag {tag}')

    try:
        if number('>b') != 10:
            raise NbtError('the root is not a compound')
        name = string()
        root = payload(10, 0)
    except (struct.error, UnicodeDecodeError) as error:
        raise NbtError(str(error)) from None
    if position != len(data):
        raise NbtError('trailing bytes')
    return name, root


def read_saved(path):
    """A gzip-compressed NBT file's root compound."""
    if not stat.S_ISREG(os.lstat(path).st_mode):
        raise NbtError('not a regular file')
    try:
        with gzip.open(path, 'rb') as source:
            data = source.read((1 << 24) + 1)
    except (OSError, EOFError, zlib.error) as error:
        # A bad header, corrupt DEFLATE data, a wrong checksum or a cut-off file: damage, never a crash.
        raise NbtError(f'not readable gzip data ({error})') from None
    if len(data) > 1 << 24:
        raise NbtError('too large')
    return read_nbt(data)[1]


def field(compound, name, *tags):
    entry = compound.get(name)
    if entry is None or entry[0] not in tags:
        raise NbtError(f'{name} is missing or has the wrong type')
    return entry[1]


# Minecraft 26.2's Identifier.parse (Level.RESOURCE_KEY_CODEC): [namespace:]path, the namespace of [a-z0-9_.-] and
# not '..', the path of [a-z0-9_./-]; no namespace means minecraft.
IDENTIFIER_NAMESPACE = re.compile(r'[a-z0-9_.-]*')
IDENTIFIER_PATH = re.compile(r'[a-z0-9_./-]*')


def valid_identifier(text):
    namespace, colon, path = text.partition(':')
    if not colon:
        namespace, path = 'minecraft', text
    elif not namespace:
        namespace = 'minecraft'
    return (namespace != '..' and IDENTIFIER_NAMESPACE.fullmatch(namespace) is not None
            and IDENTIFIER_PATH.fullmatch(path) is not None)


def check_marker(path):
    # DesktopWorld (mod): {data: {enabled: 1b}}. A disabled marker is not a desktop.
    if field(field(read_saved(path), 'data', 10), 'enabled', 1) != 1:
        raise NbtError('the desktop marker is switched off')


def check_home(path):
    # NetherHome (mod): {data: {seed: long, x, y, z: int, yaw: float, home?: {dimension, position, yaw, pitch}}}.
    data = field(read_saved(path), 'data', 10)
    field(data, 'seed', 4)
    for name in ('x', 'y', 'z'):
        field(data, name, 3)
    if not math.isfinite(field(data, 'yaw', 5)):
        raise NbtError('yaw is not a number')
    if 'home' in data:
        home = field(data, 'home', 10)
        if not valid_identifier(field(home, 'dimension', 8)):
            raise NbtError('home dimension is not a valid identifier')
        position = field(home, 'position', 9)
        if len(position) != 3 or not all(isinstance(value, float) and math.isfinite(value) for value in position):
            raise NbtError('home position is not three numbers')
        for name in ('yaw', 'pitch'):
            if not math.isfinite(field(home, name, 5)):
                raise NbtError(f'home {name} is not a number')


def check_world(paths, lock, name=None):
    """('missing' | 'damaged' | 'ok', detail). Only reads; a damaged world is reported, never repaired.

    'ok' means exactly what the mod needs for the hub: a readable level, the desktop marker switched on, the saved
    Nether home and a finished hub build. Without the home data the mod opens the world but disables home arrival,
    so that is damage too. `name` is another folder in the worlds folder (a dated home), checked the same way.
    """
    world = os.path.join(paths.worlds, lock['world'] if name is None else name)
    if not os.path.lexists(world):
        return 'missing', world
    if os.path.islink(world) or not os.path.isdir(world):
        return 'damaged', f'{world} is not a folder'
    # Minecraft falls back to level.dat_old when level.dat is damaged, so either one readable is enough.
    problems = []
    for name in ('level.dat', 'level.dat_old'):
        try:
            field(read_saved(os.path.join(world, name)), 'Data', 10)
            break
        except (OSError, EOFError, NbtError) as error:
            problems.append(f'{name}: {error}')
    else:
        return 'damaged', f'the level cannot be read ({"; ".join(problems)})'
    for relative, check, what in (('data/aresos/desktop.dat', check_marker, 'the AresOS desktop marker'),
                                  ('data/aresos/nether_home.dat', check_home, 'the saved Nether home')):
        try:
            check(os.path.join(world, relative))
        except FileNotFoundError:
            return 'damaged', f'{what} ({relative}) is missing'
        except (OSError, EOFError, NbtError) as error:
            return 'damaged', f'{what} ({relative}) is unreadable: {error}'
    for name, expected, what in (('aresos-home.provisioned', 'complete\n', 'the hub build'),):
        try:
            with open(os.path.join(world, name), encoding='utf-8', errors='replace') as source:
                if source.read(64) != expected:
                    return 'damaged', f'{what} was not finished ({name})'
        except OSError:
            return 'damaged', f'{what} has no completion record ({name})'
    if not os.path.isfile(os.path.join(world, 'aresos-home.properties')):
        return 'damaged', 'the hub manifest (aresos-home.properties) is missing'
    return 'ok', world


# ---------------------------------------------------------------- launch command and environment


def nvidia_present(root='/'):
    """The NVIDIA kernel driver lists at least one GPU."""
    try:
        return bool(os.listdir(os.path.join(root, 'proc/driver/nvidia/gpus')))
    except OSError:
        return False


def prism_command(lock, launch_id, world=None):
    """Prism in its own user scope, apart from the apps' (B5). The game itself gets game_scope()."""
    command = [SYSTEMD_RUN, '--user', '--scope', '--quiet', '--collect', '--slice=aresos.slice',
               f'--unit=aresos-desktop-{launch_id}.scope', '--',
               PRISM, '--launch', lock['instance']]
    if world:
        command += ['--world', world]
    return command


def game_unit(launch_id):
    return f'aresos-game-{launch_id}.scope'


def game_scope(launch_id):
    """The command the wrapper puts before Java (B5): the JVM in its own scope with the soft memory target.

    It is applied where the JVM starts, so the limit holds however Prism was started: by this supervisor, by a
    Prism that was already running (Prism hands `--launch` to it), or from Prism's own window. No `--collect`: a
    scope killed for memory stays listed as failed until the supervisor has read why (scope_result).
    """
    return [SYSTEMD_RUN, '--user', '--scope', '--quiet', '--slice=aresos.slice', f'--unit={game_unit(launch_id)}',
            f'--property=MemoryHigh={MEMORY_HIGH}', '--']


def game_cgroup_matches(cgroup, launch_id):
    """/proc/<pid>/cgroup (v2) puts the process in this launch's game scope."""
    lines = [line for line in cgroup.splitlines() if line.startswith('0::')]
    return len(lines) == 1 and lines[0].endswith(f'/aresos.slice/{game_unit(launch_id)}')


def memory_pressure(path=PRESSURE_FILE):
    """The last ten seconds' share of time with tasks stalled on memory (PSI 'some avg10'), or None if unknown."""
    try:
        with open(path, encoding='ascii') as source:
            for line in source:
                if line.startswith('some '):
                    return float(dict(part.split('=', 1) for part in line.split()[1:])['avg10'])
    except (OSError, ValueError, KeyError):
        pass
    return None


def session_environment(environ):
    """What Prism and the views inherit: the session's environment without launch secrets, with the system PATH."""
    env = {key: value for key, value in environ.items() if key not in PRIVATE_ENVIRONMENT}
    env['PATH'] = SYSTEM_PATH
    return env


def game_environment(instance, nonce, nvidia):
    """What the wrapper adds to the game's environment (B1's launch identity, the GPU choice)."""
    env = {'ARESOS_DESKTOP_INSTANCE': instance, 'ARESOS_LAUNCH_NONCE': nonce, LIFECYCLE_GATE: '1',
           'PATH': SYSTEM_PATH}
    if nvidia:
        env.update(NVIDIA_OFFLOAD)
    return env


def new_token():
    return secrets.token_urlsafe(24)


# ---------------------------------------------------------------- persistent state and policy


@dataclasses.dataclass
class Persisted:
    latched: bool = False
    reason: str = None
    detail: str = ''
    consecutive: int = 0
    failures: list = dataclasses.field(default_factory=list)
    hub_seen: bool = False
    # The last launch whose end has been accounted for, so a supervisor restart never counts an end twice.
    accounted: str = None
    # What the session decided when that launch ended (review 2, finding 4), saved in the same write as `accounted`:
    # {instance, launch, state, reason, detail, retry_after}. Bound to the session's instance, so a new session (a
    # reboot) starts the hub as usual; only the latch outlives the session.
    disposition: dict = None
    # A launch whose end was latched as unexplained (no report, no record), saved with the accounting: a restarted
    # supervisor restores it and still applies a matching late report or exit record, exactly once (review 4,
    # finding 2), also after a reboot (review 5, finding 3). {launch, pid, ticks, accepted, mode, nonce}
    unresolved: dict = None
    # The stop record (package 25, 2.3), an optional key: written before a stop asks for its save and kept true at
    # each phase. {open, launch, instance, kind, started, phase, save, why, sigterm, close, status, ended}. While
    # `open` it names a launch that a stop is ending: that launch's end is `stopped`, whatever its status. Closed,
    # it stays as the last stop's outcome until the next stop.
    stop: dict = None

    @classmethod
    def load(cls, path):
        try:
            with open(path, encoding='utf-8') as source:
                data = json.load(source)
        except FileNotFoundError:
            return cls()
        except (OSError, ValueError) as error:
            # A lost latch could let a crash loop resume; an unreadable file stops into recovery instead.
            return cls(latched=True, reason='state', detail=f'{path}: {error}')
        if not isinstance(data, dict) or data.get('schema') != 1:
            return cls(latched=True, reason='state', detail=f'{path}: unknown format')
        failures = [float(t) for t in data.get('failures', []) if isinstance(t, (int, float))]
        return cls(latched=bool(data.get('latched')), reason=data.get('reason'), detail=str(data.get('detail', '')),
                   consecutive=int(data.get('consecutive', 0)), failures=failures,
                   hub_seen=bool(data.get('hub_seen')),
                   accounted=data.get('accounted') if isinstance(data.get('accounted'), str) else None,
                   disposition=data.get('disposition') if isinstance(data.get('disposition'), dict) else None,
                   unresolved=data.get('unresolved') if isinstance(data.get('unresolved'), dict) else None,
                   stop=data.get('stop') if isinstance(data.get('stop'), dict) else None)

    def save(self, path, durable=False):
        data = dict(schema=1, latched=self.latched, reason=self.reason, detail=self.detail,
                    consecutive=self.consecutive, failures=self.failures, hub_seen=self.hub_seen,
                    accounted=self.accounted, disposition=self.disposition, unresolved=self.unresolved)
        if self.stop is not None:
            data['stop'] = self.stop  # schema 1 with an optional key: an older supervisor never reads it
        (write_durable if durable else write_atomic)(path, json.dumps(data, indent=2) + '\n', 0o600)

    def record_failure(self, now):
        """B2: count one unexpected failure; returns (latch, backoff seconds)."""
        # Wall-clock times survive a reboot; a time in the future (clock moved back) still counts as recent.
        self.failures = [t for t in self.failures if now - t < FAILURE_WINDOW] + [now]
        self.consecutive += 1
        latch = len(self.failures) >= MAX_FAILURES or self.consecutive >= MAX_FAILURES
        return latch, BACKOFF * 2 ** (self.consecutive - 1)

    def reset(self):
        self.latched, self.reason, self.detail = False, None, ''
        self.consecutive, self.failures = 0, []
        self.disposition = self.unresolved = None


@dataclasses.dataclass
class Launch:
    id: str
    nonce: str
    mode: str  # 'setup' (no --world: the mod makes AresHub, the title screen only if that fails) or 'hub' (--world AresHub)
    started: float = 0.0
    prism: object = None
    prism_exit: int = None
    prism_ended: float = None
    output: bytes = b''
    accepted: bool = False
    jvm_pid: int = None
    jvm_ticks: int = None
    jvm_started: float = None
    jvm_status: int = None
    jvm_ended: float = None
    ready: bool = False
    ever_ready: bool = False
    timed_out: bool = False
    adopted: bool = False
    # An automatic restart after a crash: the new hub window must not take focus from an app in front (B2).
    automatic: bool = False
    authorized: float = None
    reported: bool = False  # the wrapper reported this launch's JVM (it may have ended since)
    failed: bool = False
    wrapper_gone: float = None  # the wrapper's connection closed before its JVM was reported
    # The wrapper's jvm_failed report (an End) after this supervisor accepted the JVM.
    end_facts: object = None
    # The folder the helper last reported ready and the home checks passed (package 25, 1.3); None: none yet.
    active_world: str = None


@dataclasses.dataclass(frozen=True)
class End:
    """How a launch's Java ended, as its wrapper saw it. Facts only: what they mean is decided in one place
    (Supervisor.conclude), and nothing is decided from who sent which signal."""
    status: int = None  # Java's exit status as its wrapper waited for it (negative: the signal); None: Java never ran
    reason: str = None  # why the start did not become a game; None for a game that ran and ended
    sent: tuple = ()    # the signals the wrapper itself delivered to Java (in messages and the log only)
    session: str = None  # the desktop session (instance ID) the launch belonged to; None: this one


def failed_start(request):
    """The End in a jvm_failed report: a failed start always has a reason, the wrapper's or this one."""
    reason = request.get('reason')
    return end_facts(dict(request, reason=reason if isinstance(reason, str) and reason
                          else 'the launcher wrapper reported a failed start'))


def end_facts(data):
    """The End in a wrapper's report or exit record (one format for both), or None when it explains nothing."""
    status = data.get('status')
    if not isinstance(status, int) or isinstance(status, bool):
        status = None
    reason = data.get('reason')
    reason = reason[:500] if isinstance(reason, str) and reason else None
    if status is None and reason is None:
        return None
    sent = data.get('sent')
    sent = tuple(s for s in sent if isinstance(s, int) and not isinstance(s, bool)) if isinstance(sent, list) else ()
    session = data.get('session')
    return End(status, reason, sent, session if isinstance(session, str) else None)


def describe_status(status):
    if status is None:
        return 'no exit report'
    return f'signal {-status}' if status < 0 else f'exit code {status}'


def process_ticks(pid, proc='/proc'):
    """A process's start time in clock ticks, which with the PID names it uniquely."""
    with open(f'{proc}/{pid}/stat', 'rb') as source:
        data = source.read()
    return int(data[data.rindex(b')') + 2:].split()[19])


def parent_pid(pid, proc='/proc'):
    with open(f'{proc}/{pid}/stat', 'rb') as source:
        data = source.read()
    return int(data[data.rindex(b')') + 2:].split()[1])


# ---------------------------------------------------------------- saves (package 25, brief section 1)


@dataclasses.dataclass(frozen=True)
class SaveResult:
    """What one save request came to (1.3). Only `saved` is a save; everything else is not."""
    result: str         # saved, wrong_world, refused, timeout, lost, no_channel or invalid
    world: str          # the active world the request was about
    reason: str = None  # the game's own reason when it refused (SAVE_REFUSALS)
    ms: int = None      # the save's own time in the game
    detail: str = ''

    @property
    def saved(self):
        return self.result == 'saved'


@dataclasses.dataclass
class SaveCaller:
    deadline: float  # the caller's own, on the supervisor's clock
    done: object     # called once with the SaveResult


@dataclasses.dataclass
class SaveRequest:
    """One save_world request and every caller that waits for its answer."""
    reason: str
    callers: list
    id: int = None       # set when it is sent
    world: str = None    # the active world when it was sent
    peer: object = None  # the connection it went out on


def tell_caller(caller, result):
    try:
        caller.done(result)
    except Exception:  # one caller's failure must never take the supervision or another caller's answer down
        LOG.exception('a save\'s caller failed')


def clip(text, limit=48):
    """A peer's text for a log line or a message: printable ASCII, and short."""
    clean = ''.join(char if ' ' <= char <= '~' else '?' for char in str(text))
    return clean if len(clean) <= limit else clean[:limit]


def plain_world_name(name):
    """A world's folder name as the mod reports it: one path component, never a way out of the worlds folder."""
    return (isinstance(name, str) and 0 < len(name) <= 255 and name not in ('.', '..') and '/' not in name
            and '\0' not in name)


def save_text(result):
    """One line for whoever asked for the save."""
    if result.saved:
        return f'Saved: {result.world} is on the disk.'
    if result.result == 'refused':
        why = {'no_world': 'no home is open in Minecraft right now (it is loading, switching homes or closing)',
               'not_desktop_world': 'the world open in Minecraft is not an AresOS home',
               'server_stopping': 'Minecraft is closing the world right now',
               'error': f'Minecraft could not write {result.world} to the disk; its log says why'}[result.reason]
    else:
        why = {'wrong_world': result.detail,
               'timeout': 'Minecraft did not answer in time',
               'lost': 'the connection to Minecraft closed before it answered',
               'no_channel': 'Minecraft is not running, or has not connected to AresOS yet',
               'invalid': f'Minecraft\'s answer could not be used ({result.detail})'}[result.result]
    return f'Not saved: {why}.'


def save_reply(result):
    """The reply to the socket op `save`: `ok` only for a save, and always the world it was about."""
    return dict(ok=result.saved, result=result.result, world=result.world, reason=result.reason, ms=result.ms,
                message=save_text(result))


# ---------------------------------------------------------------- stops (package 25, brief section 2)


@dataclasses.dataclass
class Stop:
    """One stop while it runs. What must outlive this supervisor is the stop record in desktop.json."""
    kind: str             # stop, restart, logout (can be called off) or shutdown (cannot)
    started: float        # on the supervisor's clock
    deadline: float       # absolute: nothing that joins the stop extends it
    save_deadline: float
    launch: str = None
    callers: list = dataclasses.field(default_factory=list)       # each hears the stop's reply once, at its end
    save_callers: list = dataclasses.field(default_factory=list)  # `save` ops that joined: the stop's save result
    phase: str = 'save'   # save, then close
    save: str = None      # saved, nothing (to save), or why it is not confirmed
    why: str = ''
    result: object = None  # the last SaveResult
    answer: object = None  # a SaveResult the save's callback noted; step_stop reads it
    asking: bool = False
    ask_at: float = None
    sigterm: bool = False
    ended: bool = False   # the launch's end is accounted for
    close: str = None     # exited, failed, overrun, called_off, or none (nothing was running)
    lock_at: float = None
    recorded: bool = True
    exiting: bool = False  # the supervisor exits when this stop ends: its deadline leaves STOP_EXIT_RESERVE
    restart: str = None   # a restart after its stop: started, starting (one was on its way) or failed
    logout: str = None    # a logout after its stop: asked, exited, ending, or why not (stayed, apps_open, …)
    note: str = ''        # one more sentence for the reply (why there was no logout)


def open_apps(names, when='still open'):
    """`an app is still open (Mail)` or `2 apps are still open (Mail, Files)`, for a logout's reply."""
    shown = ', '.join(names[:6]) + (', …' if len(names) > 6 else '')
    return f'an app is {when} ({shown})' if len(names) == 1 else f'{len(names)} apps are {when} ({shown})'


def call_back(done, value):
    try:
        done(value)
    except Exception:  # one caller's failure must never take the supervision or another caller's answer down
        LOG.exception('a caller\'s answer failed')


def stop_text(stop, confirmed):
    """One line for whoever asked for the stop, the restart or the logout."""
    logged_out = stop.logout in ('exited', 'ending')
    if stop.close == 'none':
        text = 'Logged out: Minecraft was not running.' if logged_out else 'Nothing to stop: Minecraft is not running.'
    elif stop.close == 'called_off':
        lead = {'restart': 'Not restarted', 'logout': 'Not logged out'}.get(stop.kind, 'Not stopped')
        text = f'{lead}: Minecraft keeps running. {stop.why}'
    else:
        saved = {'saved': 'the home was saved first', 'nothing': 'there was nothing to save'}.get(
            stop.save, 'the home could not be confirmed as saved first')
        closed = {'exited': 'Minecraft closed',
                  'failed': 'Minecraft ended, but not by closing in its own orderly way',
                  'overrun': f'Minecraft did not close within {int(STOP_BUDGET)} seconds, so AresOS stopped waiting '
                             '(it never ends Minecraft by force)'}[stop.close]
        lead = 'Not a confirmed stop' if not (confirmed and stop.close == 'exited') else (
            'Logged out' if logged_out else 'Stopped')
        text = f'{lead}: {saved}; {closed}.' + ('' if confirmed or not stop.why else ' ' + stop.why)
    if not stop.recorded and stop.close != 'called_off':  # a stop called off for that reason has said so
        text += ' The stop could not be recorded on the disk.'
    if stop.kind == 'restart' and stop.close != 'called_off':
        text += {'started': ' Minecraft is starting again.', 'starting': ' Minecraft is already starting.',
                 'failed': ' Minecraft was not started again; the AresOS window says why.'}.get(
                     stop.restart, ' Minecraft is not started again.')
    if stop.kind == 'logout' and stop.close != 'called_off':
        text += ' Not logged out' + (f': {stop.note}.' if stop.note else '.')
    return text


# ---------------------------------------------------------------- messages


def instance_logs(lock):
    base = f'~/.local/share/PrismLauncher/instances/{lock["instance"]}/minecraft'
    return f'  {base}/logs/latest.log\n  {base}/crash-reports/\n  ~/.local/state/aresos/desktop.log'


RETRY = 'Type  retry  and press Enter to try again.'


def message(state, reason, detail, lock, persisted):
    world = f'~/.local/share/aresos/worlds/{lock["world"]}'
    if state == STOPPING:
        return 'AresOS is stopping Minecraft.\n'  # no window shows it; `status` and `explain` do
    if state == SETUP:
        steps = ('1. Prism Launcher opens. Sign in there with your own Microsoft account.\n'
                 '2. Minecraft is downloaded (a few minutes the first time) and starts.\n'
                 '3. Making your home… (the first start takes a moment)\n'
                 '   If that fails and the title screen shows, click AresOS: click Create if it is\n'
                 '   offered, otherwise follow the message it shows.\n'
                 f'   Your hub is built and saved in {world}.\n')
        lead = {
            'setup': 'AresOS: first start\n\n',
            'setup_cancelled': 'AresOS: Prism closed before Minecraft started.\n\n',
            'setup_closed': 'AresOS: Minecraft closed before your hub was created.\n\n',
            'setup_crashed': f'AresOS: Minecraft stopped unexpectedly during setup ({detail}).\n\n',
        }.get(reason, 'AresOS: first start\n\n')
        tail = '\nThis window closes by itself when you are in your hub.\n'
        if reason != 'setup':
            tail = f'\n{RETRY}\n'
        return lead + steps + tail
    if state == AUTH_REQUIRED:
        return ('AresOS: Minecraft did not start.\n\n'
                'Prism Launcher ended before the game started. Usually it needs you to sign in again\n'
                '(Prism shows its own sign-in), or the network is not connected yet.\n\n'
                f'{RETRY} Prism opens again and the hub follows.\n')
    def not_saved(what):
        return (f'{what}, because your home could not be confirmed as saved first.\n'
                f'{detail}\n\nMinecraft keeps running and nothing is lost.\n'
                'Type  retry  and press Enter to close this window.')

    texts = {
        'quit': 'Minecraft was closed. Nothing is wrong.\n\n' + RETRY.replace('try again', 'open the hub again'),
        'slow_start': (f'The hub did not open within {int(START_TIMEOUT)} seconds. Minecraft is still running and\n'
                       'may still get there; this window closes by itself if it does.\n\nLogs:\n'
                       + instance_logs(lock)),
        'prism_failed': f'Prism Launcher could not start the desktop ({detail}).\n\nLogs:\n' + instance_logs(lock)
                        + f'\n\n{RETRY}',
        'crashes': (f'Minecraft stopped unexpectedly {persisted.consecutive} times in a row or 3 times within 5 '
                    f'minutes\n(last: {detail}), so AresOS stopped restarting it.\n\nLogs:\n' + instance_logs(lock)
                    + f'\n\n{RETRY}'),
        'killed': (f'Minecraft was stopped from outside ({detail}),\n'
                   'most likely by the system to free memory. AresOS does not restart it by itself.\n'
                   'Close apps you do not need, wait a minute, then start it again.\n\n' + RETRY),
        'failed_start': (f'Minecraft did not start ({detail}).\n\nLogs:\n' + instance_logs(lock) + f'\n\n{RETRY}'),
        'unready': ('The hub stopped reporting that it is ready (no heartbeat from the AresOS mod).\n'
                    'Minecraft keeps running and nothing is changed; apps may not open from the hub.\n'
                    'This window closes by itself when the hub reports again.\n\nLogs:\n' + instance_logs(lock)),
        'helper': ('The AresOS app helper keeps failing, so apps cannot open from the hub and AresOS cannot\n'
                   'see whether the hub is ready. Minecraft keeps running.\n\n'
                   'Type  restart  and press Enter to save your home and start both again.'),
        'inputs': ('This AresOS image\'s Minecraft files do not match their pins, so the desktop is not\n'
                   f'started:\n{detail}\n\nThe next AresOS update or a rollback (at previous) brings them back.'),
        'instance': ('The desktop instance does not match this AresOS version:\n'
                     f'{detail}\n\nAresOS never changes an existing instance. To get a fresh one (your world is\n'
                     'kept, nothing is deleted):\n  aresos-desktop reset-instance\nthen  retry'),
        'world_missing': (f'Your hub world is missing: {world}\n'
                          'AresOS opened it before and never creates a replacement by itself.\n\n'
                          f'Put the folder back (from a backup), then {RETRY.lower()}\n'
                          'To start a new hub instead:  aresos-desktop forget-hub  then  retry'),
        'world_damaged': (f'Your hub world looks damaged: {detail}\n'
                          f'AresOS leaves {world} exactly as it is.\n\n'
                          f'Restore it from a backup, then {RETRY.lower()}'),
        'state': f'The desktop\'s own state file could not be read ({detail}).\n\n{RETRY}',
        'locked': (f'Minecraft for the desktop is still running from before ({detail}).\n'
                   'Close it, then ' + RETRY.lower()),
        'save_failed': not_saved('Minecraft was not stopped'),
        'save_failed_restart': not_saved('Minecraft was not restarted'),
        'save_failed_logout': not_saved('AresOS did not log out'),
        'stuck': (f'Minecraft was asked to close, but it is still running after {int(STOP_BUDGET)} seconds.\n'
                  'AresOS stopped waiting. It never ends Minecraft by force and starts no second one meanwhile.\n\n'
                  'Once Minecraft has closed, ' + RETRY.lower()),
        'unsaved': ('The last time Minecraft was stopped, AresOS could not confirm that your home was saved first.\n'
                    f'{detail}\n\nWhat you built in the last minutes before that stop may be missing.\n'
                    'Your home opens as it is on the disk.\n\n' + RETRY.replace('try again', 'open it')),
    }
    return 'AresOS: recovery\n\n' + texts.get(reason, f'{reason}: {detail}\n\n{RETRY}') + '\n'


# ---------------------------------------------------------------- the supervisor


class Supervisor:
    """The state machine. Processes, sockets and the clock come in through `runner`, so tests drive it directly."""

    def __init__(self, paths, lock, runner, clock=time.monotonic, wall=time.time, nvidia=None, environ=None):
        self.paths = paths
        self.lock = lock
        self.runner = runner
        self.clock = clock
        self.wall = wall
        self.nvidia = nvidia_present() if nvidia is None else nvidia
        self.environ = os.environ if environ is None else environ
        self.persisted = Persisted.load(paths.state_file)
        self.state = None
        self.reason = None
        self.detail = ''
        self.instance = None
        self.launch = None
        self.retry_at = None
        self.healthy_since = None
        self.last_heartbeat = None
        self.helper_nonce = None
        self.helper_starts = []
        self.helper_restart_at = None
        self.view = None
        # The startup cover (package 23b): whether one is up, and when stopped covers get SIGKILL.
        self.cover = False
        self.cover_kill_at = None
        # The black screen (package 25, 3.4): whether it is up, and when it ends once a restart's startup cover has
        # taken over. And whether a stop's lid block is held.
        self.black = False
        self.black_end_at = None
        self.lid_held = False
        # After a memory kill: since when every pressure sample was clear (review 2, finding 2). Never persisted, so a
        # supervisor restart starts the minute again instead of skipping it.
        self.pressure_clear_since = None
        self.pressure_checked = None
        self.unresolved_checked = None
        # The lifecycle channel (package 25): the accepted connection and the launch it was accepted for, the
        # save request in flight and the one that waits behind it.
        self.lifecycle = None
        self.lifecycle_launch = None
        self.save_ids = 0
        self.save_flight = None
        self.save_waiting = None
        # The stop that runs (package 25, section 2), and whether this supervisor wrote or found the admission block.
        self.stop = None
        self.admission_blocked = False
        self.block_kind = None  # the block's kind: a logout's is lifted when the logout does not go on
        # The app windows the helper last reported (3.4's `windows` event): a list of names, or None while it is
        # not known (no report from the helper that runs now). Unknown counts as open (the lead's fix 4).
        self.windows = None
        # The session (3.2): whether its labwc is watched, whether it has ended, why the session is ending under
        # this supervisor, and by when the supervisor's own exit must be done.
        self.labwc_watched = False
        self.labwc_gone = False
        self.session_over = None
        self.exit_by = None

    # -- persistence

    def save(self):
        self.persisted.save(self.paths.state_file)

    def save_runtime(self):
        launch = self.launch
        data = dict(instance=self.instance, nonce=launch.nonce if launch else None,
                    launch=launch.id if launch else None, mode=launch.mode if launch else None,
                    accepted=bool(launch and launch.accepted), reported=bool(launch and launch.reported),
                    failed=bool(launch and launch.failed),
                    jvm_pid=launch.jvm_pid if launch else None, jvm_ticks=launch.jvm_ticks if launch else None)
        write_atomic(self.paths.runtime_file, json.dumps(data) + '\n', 0o600)

    # -- state and views

    def enter(self, state, reason=None, detail=''):
        if (state, reason, detail) != (self.state, self.reason, self.detail):
            LOG.info('state %s%s%s', state, f' ({reason})' if reason else '', f': {detail}' if detail else '')
        self.state, self.reason, self.detail = state, reason, detail
        if state != STARTING:
            # The cover only hides a start: the hub (IN_WORLD) and every message window (SETUP, AUTH_REQUIRED,
            # RECOVERY, the slow-start view among them) must be seen, so it ends before a view opens (package 23b).
            self.hide_cover()
        if state not in (STOPPING, STARTING):
            # A message window and the home must be seen, never the black screen over them (package 25, 3.4).
            self.hide_black('something must be seen')
        if state in (SETUP, AUTH_REQUIRED, RECOVERY):
            text = self.message()
            if self.view != text:
                self.runner.show_view(text)
                self.view = text
        elif self.view is not None:
            self.runner.close_view()
            self.view = None

    def message(self):
        return message(self.state, self.reason, self.detail, self.lock, self.persisted)

    def show_cover(self, again):
        """The startup cover over this start (package 23b). Best effort: if it does not start, the start goes on
        exactly as without it."""
        self.hide_cover()
        try:
            self.runner.start_cover(again)
        except (OSError, subprocess.SubprocessError) as error:
            LOG.warning('the startup cover did not start (%s); the start goes on without it', error)
            return
        self.cover = True

    def hide_cover(self):
        """SIGTERM to the cover now, SIGKILL after COVER_STOP_WAIT if it is still there (tick): never waits."""
        if not self.cover:
            return
        self.cover = False
        kill_at = self.clock() + COVER_STOP_WAIT
        if self.runner.stop_cover(kill_at) and self.cover_kill_at is None:
            self.cover_kill_at = kill_at

    def kill_covers(self):
        self.cover_kill_at = self.runner.kill_covers(self.clock())

    def uncover_prism(self):
        """Prism has not handed the game over COVER_PRISM_WAIT after its start: it may be waiting for him, so the
        cover ends and its window shows. The launch itself goes on unchanged."""
        LOG.info('Prism has not started the game %d s after its start; the startup cover ends so that its window '
                 'can be seen', COVER_PRISM_WAIT)
        self.hide_cover()

    def owner_hides_cover(self):
        """Super+Ctrl+Escape (`aresos-desktop hide-cover`): the recovery terminal it opens must be seen (OS-BASE
        section 6), so the cover ends. Nothing else changes (package 23b, PLAN-GAP 2)."""
        if self.black:
            # The black screen too (package 25): the terminal counts as an app window anyway, once the helper says.
            self.hide_black('hide-cover (Super+Ctrl+Escape): the recovery terminal must be seen')
            if not self.cover:
                return 'The black screen is gone.'
        if not self.cover:
            LOG.info('hide-cover (Super+Ctrl+Escape): no startup cover is up')
            return 'No startup cover is up.'
        LOG.info('hide-cover (Super+Ctrl+Escape): the startup cover ends so that the recovery terminal can be seen')
        self.hide_cover()
        return 'The startup cover is gone.'

    def on_cover_exit(self, code):
        """The cover ended without being stopped (its own limit, a crash): one log line, nothing else changes."""
        if self.cover:
            self.cover = False
            LOG.warning('the startup cover ended by itself (%s); the start goes on', describe_status(code))

    # The black screen and the lid block (package 25, 3.4).

    def go_black(self, stop):
        """A shutdown, logout or restart goes black at its start, if the helper's last report says that no app
        window is open. With an app window open, or no report, the screens stay as they are: he sees his apps,
        never black. Best effort, as the startup cover: a black screen that does not start changes nothing else."""
        if self.black or stop.kind not in BLACK_KINDS or self.labwc_gone:
            return
        names = self.app_windows()
        if names != []:
            self.log_phase(stop, 'the screens stay as they are: ' + (
                'the app helper has not said whether an app is open' if names is None else open_apps(names, 'open')))
            return
        try:
            self.runner.start_black(STOP_BUDGET + BLACK_EXTRA)
        except (OSError, subprocess.SubprocessError) as error:
            LOG.warning('the black screen did not start (%s); the stop goes on without it', error)
            return
        self.black, self.black_end_at = True, None
        self.log_phase(stop, 'the screens go black')

    def hide_black(self, why=''):
        """SIGTERM to the black screen now, SIGKILL after COVER_STOP_WAIT if it is still there (tick): never
        waits."""
        self.black_end_at = None
        if not self.black:
            return
        self.black = False
        LOG.info('the black screen ends%s', f': {why}' if why else '')
        kill_at = self.clock() + COVER_STOP_WAIT
        if self.runner.stop_black(kill_at) and self.cover_kill_at is None:
            self.cover_kill_at = kill_at

    def on_black_exit(self, code):
        """The black screen ended without being stopped (its own limit, a crash, its display gone)."""
        if self.black:
            self.black, self.black_end_at = False, None
            LOG.warning('the black screen ended by itself (%s)', describe_status(code))

    def black_after_stop(self):
        """A stop ended and the session goes on: the black screen ends, so that what shows next is seen. Only a
        `restart` whose startup cover has just been started keeps it BLACK_HANDOVER longer, below that cover."""
        if not self.black:
            return
        if self.state == STARTING and self.cover:
            self.black_end_at = self.clock() + BLACK_HANDOVER
        else:
            self.hide_black('the stop has ended')

    def hold_lid(self):
        """For the length of every stop: a logind block on the lid switch and on sleep, held by a child that dies
        with the supervisor. It is started and never waited for, so it cannot delay the stop; a failure is one log
        line. A block left from an earlier stop counts its limit from that stop's start, so this stop gets its own."""
        self.release_lid()
        try:
            self.runner.start_lid_block(STOP_BUDGET + BLACK_EXTRA)
        except (OSError, subprocess.SubprocessError) as error:
            LOG.warning('the lid block did not start (%s): a lid closed during this stop is handled as logind is '
                        'set up', error)
            return
        self.lid_held = True

    def release_lid(self):
        if not self.lid_held:
            return
        self.lid_held = False
        kill_at = self.clock() + COVER_STOP_WAIT
        if self.runner.stop_lid_block(kill_at) and self.cover_kill_at is None:
            self.cover_kill_at = kill_at

    def on_lid_block_exit(self, code):
        """The lid block ended without being released: its own limit (0), or logind refused it."""
        if self.lid_held:
            self.lid_held = False
            if code == 0:
                LOG.info('the lid block ended at its own limit')
            else:
                LOG.warning('the lid block ended by itself (%s): a lid closed now is handled as logind is set up',
                            describe_status(code))

    def latch(self, reason, detail=''):
        self.persisted.latched, self.persisted.reason, self.persisted.detail = True, reason, detail
        self.persisted.disposition = None
        self.save()
        self.retry_at = None
        if reason == 'killed':
            # The minute of clear memory pressure starts after the kill.
            self.pressure_clear_since = self.pressure_checked = None
        self.enter(RECOVERY, reason, detail)

    def settle(self, state, reason=None, detail=''):
        """A launch ended and the session waits for the owner's retry: kept across supervisor restarts (finding 4)."""
        self.persisted.disposition = dict(instance=self.instance, launch=self.launch.id if self.launch else None,
                                          state=state, reason=reason, detail=detail, retry_after=None)
        self.save()
        self.enter(state, reason, detail)

    def schedule_restart(self, delay, detail):
        """B2's automatic restart after a crash, with its deadline kept across supervisor restarts (finding 4)."""
        self.persisted.disposition = dict(instance=self.instance, launch=self.launch.id if self.launch else None,
                                          state=STARTING, reason='restarting', detail=detail,
                                          retry_after=self.wall() + delay)
        self.save()
        LOG.info('restarting in %d s (%d of %d)', delay, self.persisted.consecutive, MAX_FAILURES)
        self.retry_at = self.clock() + delay
        self.enter(STARTING, 'restarting', detail)

    def restore(self):
        """This session's decision after its last launch ended, from before a supervisor restart."""
        kept = self.persisted.disposition
        if not isinstance(kept, dict) or kept.get('instance') != self.instance:
            return False
        detail = str(kept.get('detail') or '')
        if isinstance(kept.get('retry_after'), (int, float)) and not isinstance(kept.get('retry_after'), bool):
            delay = min(max(kept['retry_after'] - self.wall(), 0.0), MAX_BACKOFF)
            LOG.info('the restart after the last crash is still due in %d s', delay)
            self.retry_at = self.clock() + delay
            self.enter(STARTING, 'restarting', detail)
            return True
        if kept.get('state') in (SETUP, AUTH_REQUIRED, RECOVERY) and isinstance(kept.get('reason'), str):
            LOG.info('the session still waits for the owner (%s)', kept['reason'])
            self.enter(kept['state'], kept['reason'], detail)
            return True
        return False

    # -- start-up

    def start(self):
        runtime = self.read_runtime()
        # The session's first supervisor: its runtime file (in XDG_RUNTIME_DIR) does not exist yet. Only its first
        # hub launch gets the cover; a supervisor restarted in the middle of a session never covers his screen.
        first = not runtime.get('instance')
        self.instance = runtime.get('instance') or 'aresdesktop-' + secrets.token_hex(6)
        self.watch_session()
        if self.adopt(runtime):
            self.resume_stop()  # a stop the previous supervisor began on this game is called off or goes on (2.8)
            return
        # A game that ended while no supervisor ran is accounted for exactly once before anything starts again.
        self.account_for(runtime)
        self.close_stale_stop()  # a stop record still open whose launch is gone (2.9)
        self.restore_unresolved()
        if self.labwc_gone or self.blocked():
            # The session is ending (a shutdown or logout began in it, or its labwc is gone): nothing starts and no
            # window opens. A latch
            # stays persisted for the next session.
            self.enter(STOPPING, 'session')
            return
        if self.persisted.latched:
            self.enter(RECOVERY, self.persisted.reason, self.persisted.detail)
            return
        if self.retry_at is not None or self.state is not None:
            return  # a crash restarts after its backoff; a quit or setup end waits for the owner
        if self.restore():
            return
        self.begin(cover=COVER_FIRST if first else None)

    def read_runtime(self):
        try:
            with open(self.paths.runtime_file, encoding='utf-8') as source:
                data = json.load(source)
            return data if isinstance(data, dict) else {}
        except (OSError, ValueError):
            return {}

    def adopt(self, runtime):
        """A supervisor restart finds the game of the previous one still running: watch it, never start another."""
        pid, ticks, nonce = runtime.get('jvm_pid'), runtime.get('jvm_ticks'), runtime.get('nonce')
        if not (isinstance(pid, int) and isinstance(ticks, int) and isinstance(nonce, str)):
            return False
        if not self.runner.alive(pid, ticks):
            return False
        launch = Launch(id=runtime.get('launch') or secrets.token_hex(6), nonce=nonce,
                        mode=runtime.get('mode') or 'hub', started=self.clock(), accepted=True, jvm_pid=pid,
                        jvm_ticks=ticks, jvm_started=self.clock(), adopted=True, reported=True)
        self.launch = launch
        if not self.runner.watch_jvm(pid, ticks):
            self.launch = None
            return False
        LOG.info('adopted the running game (pid %d) from the previous supervisor', pid)
        self.ensure_helper()
        self.save_runtime()
        if self.persisted.latched:
            self.enter(RECOVERY, self.persisted.reason, self.persisted.detail)
        else:
            # Readiness is checked again within START_TIMEOUT (the mod reconnects to the new helper).
            self.enter(SETUP if launch.mode == 'setup' else STARTING, 'setup' if launch.mode == 'setup' else None)
        return True

    def account_for(self, runtime):
        launch_id, pid = runtime.get('launch'), runtime.get('jvm_pid')
        if not isinstance(launch_id, str) or self.persisted.accounted == launch_id:
            return
        if not isinstance(pid, int):
            if runtime.get('accepted') is True and not runtime.get('reported') and not runtime.get('failed'):
                self.account_for_start(runtime)
            return
        ticks = runtime.get('jvm_ticks') if isinstance(runtime.get('jvm_ticks'), int) else None
        now = self.clock()
        self.launch = Launch(id=launch_id, nonce=runtime.get('nonce') or new_token(),
                             mode=runtime.get('mode') or 'hub', started=now, accepted=True, jvm_pid=pid,
                             jvm_ticks=ticks, jvm_started=now, jvm_ended=now, reported=True)
        LOG.info('launch %s ended while no supervisor was running; accounting for it', launch_id)
        self.finish_jvm()

    def account_for_start(self, runtime):
        """A start the previous supervisor authorized but never got a JVM for (review 2, findings 1 and 3)."""
        now = self.clock()
        mode = runtime.get('mode') if runtime.get('mode') in ('setup', 'hub') else 'hub'
        self.launch = Launch(id=runtime['launch'], nonce=runtime.get('nonce') or new_token(), mode=mode,
                             started=now, accepted=True, authorized=now)
        if self.record_facts(self.launch.id) is None and self.runner.jvm_lock_held():
            # Its wrapper still runs. Its connection died with the previous supervisor, so the hand-off is lost as of
            # now: it gets the whole stop-and-report window (one deadline rule) to say how the start ended.
            self.launch.wrapper_gone = now
            LOG.info('launch %s: waiting for the start the previous supervisor authorized', self.launch.id)
            self.enter(SETUP if mode == 'setup' else STARTING, 'setup' if mode == 'setup' else None)
            return
        LOG.info('launch %s: its start ended while no supervisor was running; accounting for it', self.launch.id)
        self.unreported_start('the start of Minecraft ended while no supervisor was running')

    def restore_unresolved(self):
        """A launch latched as unexplained before this supervisor started: restored so that a matching late report
        or exit record still settles it, exactly once (review 4, finding 2). The record is durable, so this also
        holds after a reboot (review 5, finding 3)."""
        unresolved = self.persisted.unresolved
        if not isinstance(unresolved, dict) or not isinstance(unresolved.get('launch'), str):
            return
        if self.launch is not None and self.launch.id == unresolved['launch']:
            return
        mode = unresolved.get('mode') if unresolved.get('mode') in ('setup', 'hub') else 'hub'
        self.launch = Launch(id=unresolved['launch'], nonce=unresolved.get('nonce') or new_token(), mode=mode,
                             started=self.clock(), accepted=True, reported=unresolved.get('accepted') is True,
                             failed=True)
        self.reconcile(self.record_facts(self.launch.id, unresolved.get('pid'), unresolved.get('ticks')))

    def validate(self, inputs=True):
        """The one gate before any game starts: (problem reason, detail) or (None, mode). Changes nothing."""
        if inputs:
            problems = verify_inputs(self.lock, self.paths.share, java_check=self.runner.real)
            if problems:
                return 'inputs', '\n'.join('- ' + p for p in problems)
        problems = check_instance(self.paths, self.lock)
        if problems:
            return 'instance', '\n'.join('- ' + p for p in problems)
        world, detail = check_world(self.paths, self.lock)
        if world == 'damaged':
            return 'world_damaged', detail
        if world == 'missing':
            return ('world_missing', detail) if self.persisted.hub_seen else (None, 'setup')
        return None, 'hub'

    def preflight(self):
        """Check the image's inputs, provision what is missing, then the common gate."""
        problems = verify_inputs(self.lock, self.paths.share, java_check=self.runner.real)
        if problems:
            return 'inputs', '\n'.join('- ' + p for p in problems)
        try:
            provision(self.paths, self.lock)
        except OSError as error:
            return 'instance', f'- could not create the instance: {error}'
        return self.validate(inputs=False)

    def begin(self, automatic=False, cover=None):
        """Check, provision and launch, or latch recovery with the reason. `cover` (COVER_FIRST or COVER_AGAIN) puts
        the startup cover over a hub launch; never over setup or an automatic restart (B2: a cover on top would hide
        the app in front)."""
        self.retry_at = None
        if self.stop is not None or self.blocked():
            LOG.info('nothing is started: AresOS is stopping')  # 2.8, and the lead's fix 2
            if self.stop is None:
                self.enter(STOPPING, 'session')
            return
        if self.persisted.disposition is not None:
            self.persisted.disposition = None
            self.save()
        if self.runner.jvm_lock_held():
            # Something still holds the desktop's lock (a game this supervisor cannot see): never start a second.
            self.enter(RECOVERY, 'locked', 'the desktop lock is held')
            return
        problem, detail = self.preflight()
        if problem:
            self.latch(problem, detail)
            return
        self.start_launch(detail, automatic, cover)

    def start_launch(self, mode, automatic=False, cover=None):
        self.launch = Launch(id=secrets.token_hex(6), nonce=new_token(), mode=mode, started=self.clock(),
                             automatic=automatic)
        self.save_runtime()
        self.ensure_helper(restart=True)
        world = self.lock['world'] if mode == 'hub' else None
        self.enter(SETUP if mode == 'setup' else STARTING, 'setup' if mode == 'setup' else None)
        if cover in (COVER_FIRST, COVER_AGAIN) and mode == 'hub' and not automatic:
            self.show_cover(again=cover == COVER_AGAIN)  # before Prism, so its first window is already covered
        try:
            self.launch.prism = self.runner.start_prism(prism_command(self.lock, self.launch.id, world),
                                                        session_environment(self.environ))
        except OSError as error:
            self.launch.prism_exit = -1
            self.settle(RECOVERY, 'prism_failed', str(error))
            return
        LOG.info('launch %s: Prism started (%s)%s', self.launch.id, 'setup, no --world' if world is None
                 else f'--world {world}', ', automatic restart' if automatic else '')

    # -- the helper

    def ensure_helper(self, restart=False):
        launch = self.launch
        nonce = launch.nonce if launch else None
        if nonce is None:
            return
        if self.runner.helper_running() and self.helper_nonce == nonce and not restart:
            return
        if self.runner.helper_running():
            if self.helper_nonce == nonce:
                return
            self.runner.stop_helper()
        self.helper_nonce = nonce
        self.helper_restart_at = None
        self.helper_starts = [t for t in self.helper_starts if self.clock() - t < HELPER_BUDGET[1]] + [self.clock()]
        env = session_environment(self.environ)
        if launch.automatic and not self.cover:
            # B2: after a crash the restored hub waits below the app in front (the helper keeps it in front). Under
            # the startup cover (a crash before the hub was ready) nothing of his is in front, only the cover:
            # keeping the focus there would leave the restarted game without it, and Minecraft pauses itself. So
            # the hub takes the focus as at a covered start (package 23b, review 1, finding 3).
            env['ARESOS_SHELL_KEEP_FOREGROUND'] = '1'
        self.windows = None  # a new helper has not said yet
        try:
            self.runner.start_helper(self.instance, nonce, env)
        except OSError as error:
            LOG.error('could not start the app helper: %s', error)

    def on_helper_exit(self, code):
        LOG.warning('the app helper exited (%s)', code)
        self.windows = None  # nobody tracks the app windows now: unknown counts as open
        self.hide_black('the app helper ended, so nobody can tell whether an app is open')
        recent = [t for t in self.helper_starts if self.clock() - t < HELPER_BUDGET[1]]
        if len(recent) >= HELPER_BUDGET[0]:
            LOG.error('the app helper failed %d times within %d s; not restarting it until the next launch',
                      len(recent), HELPER_BUDGET[1])
            self.helper_restart_at = None
            launch = self.launch
            if launch is not None and launch.jvm_pid is not None:
                # Readiness can no longer be known: say so, without touching the game.
                launch.ready = False
                self.healthy_since = None
                if not self.persisted.latched and not self.held():
                    self.enter(RECOVERY, 'helper')
            return
        self.helper_restart_at = self.clock() + HELPER_RESTART

    def on_helper_status(self, status):
        if not isinstance(status, dict):
            return
        event = status.get('event')
        if event == 'windows':
            self.on_windows(status)  # read whether or not a game runs: a logout with none needs it too
            return
        launch = self.launch
        if launch is None or launch.jvm_pid is None:
            return
        now = self.clock()
        if event == 'world_ready' and isinstance(status.get('world'), str):
            self.ready(status['world'], now)
        elif event == 'heartbeat' and isinstance(status.get('ready'), bool):
            if status['ready'] and isinstance(status.get('world'), str):
                self.ready(status['world'], now)
            elif not status['ready']:
                self.last_heartbeat = now
                if launch.ready:
                    LOG.info('the desktop left its world')
                launch.ready = False
                self.healthy_since = None
                if self.state == IN_WORLD:
                    self.enter(STARTING)

    def on_windows(self, status):
        """The helper's `windows` event (3.4): {"event": "windows", "count": n, "names": [...]}, every app window
        but the desktop's, the covers' and the message window, minimized ones included. A count that is no number
        (the helper lost track) makes it unknown again."""
        count, names = status.get('count'), status.get('names')
        if type(count) is not int or count < 0:
            new = None
        else:
            count = min(count, MAX_WINDOWS)
            named = [clip(name) for name in names if isinstance(name, str) and name] if isinstance(names, list) else []
            new = named[:count] + ['an app without a name'] * (count - len(named[:count]))
        if new != self.windows:
            LOG.info('app windows open: %s', 'not known' if new is None else len(new))
            self.windows = new
        if new != []:
            # An app window that appears while the screens are black takes the black away at once (the lead's
            # fix 4); a count that is no longer known counts as open.
            self.hide_black('an app window is open now' if new else 'the app helper lost track of the app windows')

    def app_windows(self):
        """The app windows open right now, by name (empty: none), or None when that is not known: no report from
        the helper that runs now. A count is only as fresh as its helper, so it ends with it."""
        if self.windows is None or not self.runner.helper_running():
            return None
        return list(self.windows)

    def ready(self, world, now):
        launch = self.launch
        self.last_heartbeat = now
        checked = False
        if world == self.lock['world'] and not launch.ready:
            # A damaged hub is never declared ready, however the mod sees it (the game is left alone).
            state, detail = check_world(self.paths, self.lock)
            checked = state == 'ok'
            if state != 'ok':
                launch.ready = False
                if not (self.persisted.latched and self.persisted.reason == 'world_damaged'):
                    LOG.error('the hub reported ready, but its saved data is not: %s', detail)
                    self.latch('world_damaged', detail)
                return
        if self.healthy_since is None:
            self.healthy_since = now
        launch.ready = launch.ever_ready = True
        self.note_ready_world(world, checked)
        if world == self.lock['world'] and not self.persisted.hub_seen:
            self.persisted.hub_seen = True
            self.save()
        if launch.mode == 'setup' and world == self.lock['world']:
            launch.mode = 'hub'
            self.save_runtime()
        if self.state != IN_WORLD and not self.persisted.latched and not self.held():
            LOG.info('in the world %s', world)
            self.enter(IN_WORLD)

    # -- Prism

    def on_prism_output(self, data):
        if self.launch is not None:
            self.launch.output = (self.launch.output + data)[-8192:]

    def on_prism_exit(self, code):
        launch = self.launch
        if launch is None:
            return
        launch.prism_exit, launch.prism_ended = code, self.clock()
        LOG.info('Prism exited (%s)', code)
        if launch.accepted:
            return
        if code in SIGKILL_STATUSES:
            # Killed from outside (B5: memory) before the game started: never started again by itself.
            self.latch('killed', 'Prism Launcher was killed before Minecraft started')
            return
        if code not in (0, 1) or (code != 0 and launch.prism_ended - launch.started < EARLY_PRISM_FAILURE):
            tail = launch.output.decode('utf-8', 'replace').strip().splitlines()[-3:]
            self.settle(RECOVERY, 'prism_failed', f'exit {code}' + (': ' + ' / '.join(tail) if tail else ''))

    # -- the wrapper (the real JVM)

    def on_jvm_start(self, request):
        """The wrapper asks for its launch: (ok, reply fields). Every JVM passes the same gate."""
        if self.stop is not None or self.blocked():
            return False, {'message': 'AresOS is stopping, so Minecraft is not started now.'}
        if self.persisted.latched:
            return False, {'message': 'The AresOS desktop is in recovery. Type retry in its window first.'}
        if request.get('instance') != self.lock['instance']:
            return False, {'message': f'Only the {self.lock["instance"]} instance runs through this wrapper.'}
        java = request.get('java')
        if not isinstance(java, str) or os.path.realpath(java) != os.path.realpath(self.lock['java']['path']):
            return False, {'message': f'The desktop runs only on the pinned Java ({self.lock["java"]["path"]}).'}
        root = os.path.realpath(self.paths.instance(self.lock['instance']))
        directory, cwd = request.get('instance_dir'), request.get('cwd')
        if (not isinstance(directory, str) or not isinstance(cwd, str) or os.path.realpath(directory) != root
                or os.path.realpath(cwd) != os.path.join(root, 'minecraft')):
            return False, {'message': f'Only the managed instance in {root} runs through this wrapper.'}
        launch = self.launch
        if launch is not None and launch.jvm_pid is not None and self.runner.alive(launch.jvm_pid, launch.jvm_ticks):
            return False, {'message': 'The AresOS desktop is already running.'}
        problem, mode = self.validate()
        if problem:
            self.latch(problem, mode)
            return False, {'message': f'The AresOS desktop is in recovery ({problem}); see its window.'}
        if launch is None or launch.accepted:
            # Started from Prism by hand (not by this supervisor): a launch of its own, with a fresh nonce.
            self.launch = launch = Launch(id=secrets.token_hex(6), nonce=new_token(), mode=mode, started=self.clock())
            self.ensure_helper(restart=True)
        else:
            launch.mode = mode
        now = self.clock()
        launch.accepted, launch.authorized, launch.jvm_started = True, now, now
        self.retry_at = None
        if self.persisted.disposition is not None:
            self.persisted.disposition = None
            self.save()
        self.save_runtime()
        if launch.mode == 'setup':
            if self.state != SETUP or self.reason != 'setup':
                self.enter(SETUP, 'setup')
        else:
            self.enter(STARTING)
        LOG.info('launch %s: the game is starting%s', launch.id, ' on NVIDIA' if self.nvidia else
                 ' on the default GPU (no NVIDIA driver found)')
        scope = game_scope(launch.id)
        return True, {'launch': launch.id, 'env': game_environment(self.instance, launch.nonce, self.nvidia),
                      'scope': scope, 'unit': game_unit(launch.id) if scope else None,
                      # Where the wrapper writes how Java ended, and the session that end belongs to.
                      'session': self.instance, 'record': self.paths.exit_file}

    def on_jvm_started(self, wrapper_pid, pid, launch_id=None):
        """The wrapper reports the JVM's PID: (ok, message)."""
        launch = self.launch
        if (launch is None or not launch.accepted or launch.reported or launch.failed
                or (launch_id is not None and launch_id != launch.id)):
            return False, 'no launch is waiting for a JVM'
        identity = self.runner.identify(pid)
        if identity is None or identity[0] != wrapper_pid:
            return False, 'the JVM is not the wrapper\'s child'
        if self.runner.real and not game_cgroup_matches(identity[2], launch.id):
            return False, f'the JVM is not in its memory scope {game_unit(launch.id)}'
        if not self.runner.watch_jvm(pid, identity[1]):
            return False, 'the JVM cannot be watched'
        launch.jvm_pid, launch.jvm_ticks, launch.reported = pid, identity[1], True
        self.save_runtime()
        LOG.info('launch %s: the game runs as pid %d', launch.id, pid)
        return True, ''

    def on_jvm_failed(self, launch_id, end):
        """The wrapper's report of a start that did not become a game (Java could not start, was refused, the
        hand-off broke, or Java ended first), with the facts of how it ended (an End)."""
        launch = self.launch
        if launch is None or launch.id != launch_id or not launch.accepted or end is None:
            return
        if launch.failed:
            self.reconcile(end)
            return
        if launch.reported:
            # This supervisor accepted the JVM, but the wrapper never got the answer: these are the facts of its end,
            # decided once the JVM is gone (finish_jvm).
            launch.end_facts = end
            if end.status is not None and launch.jvm_status is None:
                launch.jvm_status = end.status
            return
        self.conclude(end)

    def on_wrapper_gone(self, launch_id):
        """The wrapper's connection closed before a JVM was reported. It still reports how the start ended (on a new
        connection, and in its exit record) once it has stopped Java: wrapper_ended waits for that."""
        launch = self.launch
        if (launch is not None and launch.id == launch_id and launch.accepted and not launch.reported
                and not launch.failed and launch.wrapper_gone is None):
            launch.wrapper_gone = self.clock()

    def wrapper_ended(self):
        self.unreported_start('Minecraft and its launcher wrapper ended before the game was handed to AresOS')

    def handoff_lost(self):
        self.unreported_start(f'no JVM and no failure were reported within {int(HANDOFF_TIMEOUT)} s of starting it')

    def unreported_start(self, why):
        """An authorized start ended without a report over the connection: its exit record decides, else unexplained."""
        self.conclude(self.record_facts(self.launch.id), unexplained=why)

    def record_facts(self, launch_id, pid=None, ticks=None):
        """The End in the wrapper's exit record of this launch, or None. Bound to the launch, and to the JVM's PID
        and start time when they are known."""
        try:
            with open(self.paths.exit_file, encoding='utf-8') as source:
                data = json.load(source)
        except (OSError, ValueError):
            return None
        if not isinstance(data, dict) or data.get('launch') != launch_id:
            return None
        if pid is not None and data.get('pid') != pid:
            return None
        if pid is not None and ticks is not None and data.get('ticks') not in (None, ticks):
            return None
        return end_facts(data)

    def reconcile(self, end):
        """A report or record for a launch whose end was latched as unexplained: applied exactly once (review 3
        finding 2, review 4 finding 2). A kill confirms the latch; any other explained end replaces it."""
        launch = self.launch
        unresolved = self.persisted.unresolved
        if not (isinstance(unresolved, dict) and unresolved.get('launch') == launch.id) or end is None:
            return
        self.persisted.unresolved = None
        if end.status in SIGKILL_STATUSES or not (self.persisted.latched and self.persisted.reason == 'killed'):
            self.save()  # a kill, as latched; or the owner has decided since (retry)
            return
        LOG.info('launch %s: the wrapper explained its end after all', launch.id)
        self.persisted.latched, self.persisted.reason, self.persisted.detail = False, None, ''
        launch.failed = False
        self.conclude(end)

    def on_jvm_report(self, pid, status, launch_id=None):
        launch = self.launch
        if (launch is None or not isinstance(status, int) or isinstance(status, bool)
                or launch_id not in (None, launch.id)):
            return
        if launch.jvm_pid == pid:
            launch.jvm_status = status
            return
        unresolved = self.persisted.unresolved
        if (launch.failed and isinstance(unresolved, dict) and unresolved.get('launch') == launch.id
                and unresolved.get('pid') == pid):
            self.reconcile(End(status))  # the game's own exit status, after its end was latched as unknown

    def check_unresolved(self):
        """Look at the wrapper's exit record for an unresolved end (it may be written after any report could still
        reach this supervisor)."""
        self.unresolved_checked = self.clock()
        unresolved = self.persisted.unresolved
        if not isinstance(unresolved, dict):
            return
        if self.launch is None or self.launch.id != unresolved.get('launch'):
            self.restore_unresolved()
            return
        self.reconcile(self.record_facts(unresolved['launch'], unresolved.get('pid'), unresolved.get('ticks')))

    def on_jvm_gone(self):
        """The JVM's pidfd fired. Give the wrapper a moment to report how it ended."""
        if self.launch is not None and self.launch.jvm_ended is None:
            self.launch.jvm_ended = self.clock()

    def finish_jvm(self):
        """The accepted JVM is gone: its end's facts are the wrapper's report, or its exit record."""
        launch = self.launch
        if launch.end_facts is not None:
            end = launch.end_facts
        elif launch.jvm_status is not None:
            end = End(launch.jvm_status)
        else:
            end = self.record_facts(launch.id, launch.jvm_pid, launch.jvm_ticks)
        self.conclude(end, unexplained='Minecraft and its launcher ended together')

    def conclude(self, end, unexplained=None):
        """The one place a launch's end is decided, before or after the hand-off alike, from its wrapper's facts
        (an End, or None when there are none). Only an end that is certain to be an ordinary one restarts by itself
        (JUDGMENT-CALL 10, review 5):
          - Java never ran (a stated reason, no status): a failed start, counted once;
          - exit 0: his quit, whenever it came (review 5, finding 2); never counted, never restarted;
          - SIGKILL: `killed`, latched, never counted or restarted, whoever sent it. The status cannot tell the
            system's kill from the wrapper's own SIGKILL of a Java that ignored SIGTERM (one can land a moment
            before the other), so no restart is ever decided from who sent a signal (review 5, finding 1);
          - no facts at all: `killed` too, and saved as unresolved until a late report or the record explains it;
          - any other status: a crash (or a failed start), counted once."""
        self.close_lifecycle('the game ended')
        launch = self.launch
        accepted = launch.reported
        pid, ticks = launch.jvm_pid, launch.jvm_ticks
        launch.failed = True
        launch.jvm_pid = launch.jvm_ticks = launch.jvm_ended = None
        launch.ready = False
        self.healthy_since = None
        self.persisted.accounted = launch.id
        self.persisted.unresolved = None
        status, reason = (end.status, end.reason) if end is not None else (None, None)
        record = self.open_stop()
        if record is not None and record.get('launch') == launch.id:
            # 2.7: decided from the supervisor's own record, never from the status or from who sent a signal.
            return self.conclude_stopped(end)
        if end is None:
            kind = 'unexplained'
        elif status is None:
            kind = 'failed'
        elif status in SIGKILL_STATUSES:
            kind = 'killed'
        elif status == 0:
            kind = 'quit'
        else:
            kind = 'crash'
        # The facts of a launch of an earlier session (from its exit record, after a reboot): the launch is accounted
        # for, but what that session would have done next, a quit that waits for him or a restart, is not this
        # session's (review 5, finding 3). Only a latch outlives a session (JUDGMENT-CALL 12).
        earlier = end is not None and end.session is not None and end.session != self.instance
        LOG.info('launch %s%s ended: %s (%s%s)', launch.id, ' of an earlier session' if earlier else '', kind,
                 describe_status(status), f'; {reason}' if reason else '')
        if kind in ('killed', 'unexplained'):
            scope = self.runner.scope_result(game_unit(launch.id))
            if kind == 'unexplained':
                why = unexplained or 'Minecraft ended without any report'
                self.persisted.unresolved = dict(launch=launch.id, pid=pid, ticks=ticks, accepted=accepted,
                                                 mode=launch.mode, nonce=launch.nonce)
            else:
                why = 'killed by SIGKILL' if accepted else 'Minecraft was killed by SIGKILL while it started'
                if SIGKILL in end.sent:
                    why += '; its launcher wrapper sent a SIGKILL too, so the cause is not certain'
            self.latch('killed', why + (f'; its scope ended with {scope}' if scope else ''))
            self.save_runtime()
            return kind
        if kind == 'quit':
            # The decision is saved with the accounting (one write), so a supervisor restart keeps it.
            if earlier:
                self.new_session()
            elif launch.mode == 'setup' and not self.persisted.hub_seen:
                self.settle(SETUP, 'setup_closed')
            else:
                self.settle(RECOVERY, 'quit')
            self.save_runtime()
            return kind
        if reason:
            detail = f'the launcher wrapper reported: {reason}'
            if status is not None:
                detail += f'; Java ended with {describe_status(status)}'
        else:
            detail = describe_status(status)
        latch, delay = self.persisted.record_failure(self.wall())
        if latch:
            self.latch('crashes', detail)
        elif earlier:
            self.new_session()
        elif launch.mode == 'setup':
            self.settle(SETUP, 'setup_crashed', detail)
        else:
            self.schedule_restart(delay, detail)
        self.save_runtime()
        return kind

    def new_session(self):
        """The launch just accounted for ended in an earlier session and left no latch: this session goes on as a
        new one does. start() begins by itself; later (a record found after start-up) the hub is started here."""
        self.persisted.disposition = None
        self.save()
        if self.state is not None:
            self.begin()

    # -- time

    def pending(self):
        """(due time, action) for everything timed; each action ends its own condition, so nothing fires twice."""
        launch = self.launch
        items = []
        if self.helper_restart_at is not None:
            items.append((self.helper_restart_at, self.restart_helper))
        if self.cover_kill_at is not None:
            items.append((self.cover_kill_at, self.kill_covers))
        if self.black_end_at is not None:
            items.append((self.black_end_at, self.hide_black))
        if self.cover and launch is not None and not launch.accepted:
            # The covered launch started Prism a moment after `started` (start_launch); jvm_start ends this wait.
            items.append((launch.started + COVER_PRISM_WAIT, self.uncover_prism))
        if launch is not None and launch.jvm_ended is not None and launch.jvm_pid is not None:
            # Due at once when the wrapper has reported the exit status, otherwise after a short wait for it.
            items.append((launch.jvm_ended + (0 if launch.jvm_status is not None else EXIT_REPORT_WAIT),
                          self.finish_jvm))
        if self.retry_at is not None:
            items.append((self.retry_at, self.restart_launch))
        if (launch is not None and not launch.accepted and launch.prism_ended is not None
                and self.state in (SETUP, STARTING) and self.reason in (None, 'setup')):
            items.append((launch.prism_ended + PRISM_GRACE, self.prism_gave_up))
        if (launch is not None and launch.accepted and not launch.reported and not launch.failed
                and launch.authorized is not None):
            # One deadline rule (review 4, finding 3): once the hand-off is seen lost, the wrapper gets its whole
            # stop-and-report window from that moment, past the authorization limit if need be; until then the
            # authorization limit stands.
            if launch.wrapper_gone is not None:
                items.append((launch.wrapper_gone + LOST_HANDOFF_WAIT, self.wrapper_ended))
            else:
                items.append((launch.authorized + HANDOFF_TIMEOUT, self.handoff_lost))
        if self.persisted.latched and self.persisted.reason == 'killed':
            items.append(((self.pressure_checked if self.pressure_checked is not None else float('-inf'))
                          + PRESSURE_SAMPLE, self.sample_pressure))
        if isinstance(self.persisted.unresolved, dict):
            items.append(((self.unresolved_checked if self.unresolved_checked is not None else float('-inf'))
                          + UNRESOLVED_CHECK, self.check_unresolved))
        if (launch is not None and launch.mode == 'hub' and launch.jvm_pid is not None and not launch.ever_ready
                and not launch.timed_out and launch.jvm_started is not None):
            items.append((launch.jvm_started + START_TIMEOUT, self.start_timed_out))
        if launch is not None and launch.ready and launch.jvm_pid is not None:
            items.append(((self.last_heartbeat or self.clock()) + HEARTBEAT_GAP, self.heartbeats_stopped))
        if self.healthy_since is not None and (self.persisted.consecutive or self.persisted.failures):
            items.append((self.healthy_since + HEALTHY_RESET, self.healthy_reset))
        if self.stop is not None:
            items.append((self.stop_due(), self.step_stop))
        for request in (self.save_flight, self.save_waiting):
            if request is not None:
                items += [(caller.deadline, self.save_timed_out) for caller in request.callers]
        return items

    def tick(self):
        for _ in range(16):
            now = self.clock()
            due = [item for item in self.pending() if item[0] <= now]
            if not due:
                return
            min(due, key=lambda item: item[0])[1]()

    def deadline(self):
        """Seconds until tick() has something to do, for the event loop's timeout."""
        items = self.pending()
        if not items:
            return 30.0
        return max(0.0, min(at for at, _ in items) - self.clock())

    def restart_helper(self):
        self.helper_restart_at = None
        if self.launch is not None and not self.runner.helper_running():
            self.helper_nonce = None
            self.ensure_helper()

    def restart_launch(self):
        self.retry_at = None
        self.begin(automatic=True)

    def prism_gave_up(self):
        if self.launch.mode == 'setup':
            self.settle(SETUP, 'setup_cancelled')
        else:
            self.settle(AUTH_REQUIRED, 'auth')

    def sample_pressure(self):
        """One memory-pressure sample after a kill; any pressure or unreadable value starts the clear minute again."""
        now = self.clock()
        if self.pressure_checked is not None and now - self.pressure_checked > PRESSURE_GAP:
            self.pressure_clear_since = None  # nobody looked in between: unknown, not clear
        self.pressure_checked = now
        value = self.runner.memory_pressure()
        if value is None or value > PRESSURE_CLEAR:
            self.pressure_clear_since = None
        elif self.pressure_clear_since is None:
            self.pressure_clear_since = now
        return value

    def start_timed_out(self):
        self.launch.timed_out = True
        LOG.warning('launch %s: no ready world after %d s; the game keeps running', self.launch.id, START_TIMEOUT)
        if not self.held():
            self.enter(RECOVERY, 'slow_start')

    def heartbeats_stopped(self):
        """Lost readiness shows; the game is left alone and the view closes when heartbeats return."""
        LOG.warning('no heartbeat for %d s: the hub is not reported ready any more', HEARTBEAT_GAP)
        self.launch.ready = False
        self.healthy_since = None
        if self.state == IN_WORLD and not self.persisted.latched:
            self.enter(RECOVERY, 'unready')

    def healthy_reset(self):
        LOG.info('%d healthy minutes: failure counts reset', HEALTHY_RESET // 60)
        self.persisted.consecutive, self.persisted.failures = 0, []
        self.save()

    # -- the owner

    def retry(self):
        """The owner's Retry: (ok, message). After a memory kill it waits for cleared pressure (B5)."""
        if self.stop is not None:
            return False, 'AresOS is stopping Minecraft right now. Type retry again when that is done.'
        if self.blocked():
            return False, 'AresOS is shutting down or logging out, so nothing is started any more.'
        if self.persisted.latched and self.persisted.reason == 'killed':
            value = self.sample_pressure()
            clear = 0.0 if self.pressure_clear_since is None else self.clock() - self.pressure_clear_since
            if clear < PRESSURE_CLEAR_FOR:
                if value is None:
                    why = (f'AresOS cannot read the memory pressure ({PRESSURE_FILE}), so it cannot tell '
                           'that memory is free.')
                elif value > PRESSURE_CLEAR:
                    why = f'Memory is still under pressure ({value:.0f}% of the last 10 seconds).'
                else:
                    why = (f'Memory has been free for {clear:.0f} of the {PRESSURE_CLEAR_FOR:.0f} seconds AresOS waits '
                           'for after a memory kill.')
                return False, why + ' Close apps you do not need, then type retry again in a minute.'
        self.persisted.reset()
        self.save()
        self.retry_at = None
        launch = self.launch
        if launch is not None and launch.jvm_pid is not None and self.runner.alive(launch.jvm_pid, launch.jvm_ticks):
            self.enter(IN_WORLD if launch.ready else (SETUP if launch.mode == 'setup' else STARTING),
                       'setup' if launch.mode == 'setup' else None)
            return True, 'Minecraft is still running; the recovery state is cleared.'
        LOG.info('retry requested by the owner')
        # AUTH_REQUIRED's retry is the moment Prism shows its sign-in ("Prism opens again"): it must be seen, so
        # that start is never covered (package 23b, review 1, finding 2). Every other retry says "Starting again…".
        self.begin(cover=None if self.state == AUTH_REQUIRED else COVER_AGAIN)
        return True, f'State: {self.state}'

    def forget_hub(self):
        world, _ = check_world(self.paths, self.lock)
        if world != 'missing':
            return False, f'{self.lock["world"]} still exists; move it away first if you want a new hub.'
        self.persisted.hub_seen = False
        if self.persisted.reason == 'world_missing':
            self.persisted.reset()
        self.save()
        return True, 'The next start makes a fresh flat home by itself. Type retry.'

    def status(self):
        launch = self.launch
        return dict(state=self.state, reason=self.reason, latched=self.persisted.latched,
                    consecutive=self.persisted.consecutive, failures=len(self.persisted.failures),
                    hub_seen=self.persisted.hub_seen, instance=self.instance,
                    launch=launch.id if launch else None, jvm_pid=launch.jvm_pid if launch else None,
                    ready=bool(launch and launch.ready), nvidia=self.nvidia,
                    helper=self.runner.helper_running(), cover=self.cover,
                    # The black screen and the lid block of a stop (package 25, 3.4).
                    black=self.black, lid_block=self.lid_held,
                    # Whether the game's lifecycle hello is accepted (package 25, 1.2): saves can be asked for.
                    lifecycle=self.lifecycle_peer() is not None,
                    # Whether a stop runs, and the stop record: the open one, or the last stop's outcome (2.3).
                    stopping=self.stop is not None, stop=self.persisted.stop,
                    # The open app windows by name (None: not known), whether this session's labwc is watched,
                    # and why the session is ending under this supervisor (3.2, 3.3).
                    windows=self.app_windows(), labwc=self.labwc_watched, session_over=self.session_over,
                    message=self.message() if self.state else '')

    # -- the lifecycle channel (package 25, brief section 1)

    def active_world(self):
        """The folder a save is about (1.3): the one the helper last reported ready and the home checks passed, or
        the locked world while none was reported, so a dead helper never stops saving."""
        launch = self.launch
        return (launch.active_world if launch is not None else None) or self.lock['world']

    def note_ready_world(self, world, checked=False):
        """ready(): the helper reported `world` ready. It becomes the active world only as a plain folder inside the
        worlds folder that passes the home checks (`checked`: ready() has just checked it)."""
        launch = self.launch
        if world == launch.active_world:
            return
        if not checked and (not plain_world_name(world) or check_world(self.paths, self.lock, world)[0] != 'ok'):
            return
        LOG.info('launch %s: the active world is %s', launch.id, world)
        launch.active_world = world

    def lifecycle_peer(self):
        """The accepted lifecycle connection of the running launch's game, or None."""
        launch = self.launch
        if (self.lifecycle is None or launch is None or launch.id != self.lifecycle_launch
                or launch.jvm_pid is None):
            return None
        return self.lifecycle

    def lifecycle_refusal(self, peer, request):
        """Why a lifecycle_hello is not accepted (1.2), or None. The text goes to the log: never the nonce."""
        launch = self.launch
        if peer.uid != os.getuid():
            return 'the peer is another user'
        if launch is None or launch.jvm_pid is None or launch.jvm_ended is not None:
            return 'no game is running that its launcher wrapper reported'
        if peer.pid != launch.jvm_pid:
            return f'the peer is not the game (pid {launch.jvm_pid})'
        if not self.runner.alive(launch.jvm_pid, launch.jvm_ticks):
            return 'the game is no longer running'
        if request.get('instance') != self.instance:
            return 'the hello names another desktop session'
        nonce = request.get('nonce')
        if not isinstance(nonce, str) or not hmac.compare_digest(nonce.encode('utf-8', 'backslashreplace'),
                                                                 launch.nonce.encode('utf-8', 'backslashreplace')):
            return 'the hello does not carry this launch\'s nonce'
        major = request.get('major')
        if type(major) is not int or major != LIFECYCLE_MAJOR:
            return f'the hello speaks another protocol version (major {clip(repr(major))})'
        capabilities = request.get('capabilities')
        if not isinstance(capabilities, list) or 'save_world' not in capabilities:
            return 'the hello does not offer save_world'
        return None

    def on_lifecycle_hello(self, peer, request):
        """The mod's first line on a new connection. True: accepted, with no reply (the mod expects none). False:
        the caller closes the connection; the mod tries again, which also covers a hello before jvm_started."""
        refusal = self.lifecycle_refusal(peer, request)
        if refusal is not None:
            LOG.warning('refused a lifecycle hello from pid %s: %s', peer.pid, refusal)
            return False
        old, self.lifecycle, self.lifecycle_launch = self.lifecycle, peer, self.launch.id
        LOG.info('launch %s: the game opened the lifecycle channel', self.launch.id)
        if old is not None and old is not peer:
            # One peer per launch: the newer hello replaces the older. What went out on the older connection can no
            # longer be answered (the mod drops the answer for a connection that ended); what waited goes out on
            # the new one.
            self.lifecycle_lost(old, 'a newer hello replaced its connection')
            old.close()
        return True

    def on_lifecycle_gone(self, peer):
        """A lifecycle peer's connection closed, or a line could not be sent to it."""
        if peer is self.lifecycle:
            self.lifecycle = None
            LOG.info('the game\'s lifecycle channel closed')
        self.lifecycle_lost(peer, 'the connection closed before the answer')

    def lifecycle_lost(self, peer, why):
        request = self.save_flight
        if request is not None and request.peer is peer:
            self.conclude_save(self.save_result('lost', request, detail=why))

    def close_lifecycle(self, why):
        """The launch ended: its channel ends with it, and nothing asked on it is a save."""
        peer, self.lifecycle = self.lifecycle, None
        if peer is not None:
            self.lifecycle_lost(peer, why)
            peer.close()

    def on_lifecycle_message(self, peer, message):
        """A line from an accepted lifecycle peer. Only world_saved is read (1.2); anything else is dropped."""
        if not isinstance(message, dict) or message.get('op') != 'world_saved':
            return
        request = self.save_flight
        ident = message.get('id')
        if (peer is not self.lifecycle or request is None or request.peer is not peer
                or type(ident) is not int or ident != request.id):
            # A late answer (every caller's deadline has passed), one on an older connection, or an id never asked.
            LOG.warning('dropped a world_saved answer that belongs to no request in flight (id %s)',
                        clip(repr(ident)))
            return
        self.conclude_save(self.judge_save(request, message))

    def judge_save(self, request, message):
        """What the answer to the request in flight means (1.3). `saved` only if the game says ok for the world that
        was active when the request went out and still is."""
        ok = message.get('ok')
        if ok is True:
            answered = message.get('world')
            if not isinstance(answered, dict) or not isinstance(answered.get('id'), str):
                return self.save_result('invalid', request, detail='the answer names no world')
            if self.active_world() != request.world:
                return self.save_result('wrong_world', request, detail=(
                    f'the home changed from {request.world} to {self.active_world()} while it was saved'))
            if answered['id'] != request.world or answered.get('desktop') is not True:
                return self.save_result('wrong_world', request, detail=(
                    f'Minecraft saved {clip(answered["id"])}, which is not the home {request.world}'))
            ms = message.get('ms')
            return self.save_result('saved', request, ms=ms if type(ms) is int and ms >= 0 else None)
        if ok is False and message.get('reason') in SAVE_REFUSALS:
            return self.save_result('refused', request, reason=message['reason'])
        return self.save_result('invalid', request, detail='the answer is neither a save nor a known refusal')

    def save_result(self, result, request=None, **fields):
        world = request.world if request is not None and request.world else self.active_world()
        return SaveResult(result, world, **fields)

    def request_save(self, reason, done, wait=None):
        """Ask the game to flush-save the active world for one caller (1.3 to 1.5). `done(SaveResult)` is called
        exactly once: when the answer is in or at the caller's own deadline (`wait` seconds on the supervisor's
        clock, SAVE_WAIT by default), whichever comes first. With no accepted hello it is called before this
        returns (`no_channel`).

        `done` may run from inside conclude() (a launch's end closes the channel first) or from tick(): it must
        only note the result, never start or end a launch itself.

        One request is in flight and at most one waits (1.4). A caller that arrives while a request is in flight
        does not join it, because that save may have begun before the caller asked: it gets one follow-up request,
        sent when the first is answered, and later callers join that one."""
        caller = SaveCaller(self.clock() + (SAVE_WAIT if wait is None else wait), done)
        if self.save_flight is None:
            self.send_save(SaveRequest(reason, [caller]))
            return
        if self.save_waiting is None:
            self.save_waiting = SaveRequest(reason, [])
        self.save_waiting.callers.append(caller)

    def send_save(self, request):
        peer = self.lifecycle_peer()
        if peer is None:
            self.answer_callers(request, self.save_result('no_channel'))
            return
        self.save_ids += 1
        request.id, request.world, request.peer = self.save_ids, self.active_world(), peer
        self.save_flight = request
        LOG.info('save_world %d (%s): asked the game to save %s', request.id, request.reason, request.world)
        if not peer.send({'op': 'save_world', 'id': request.id, 'reason': request.reason}):
            self.on_lifecycle_gone(peer)  # changes nothing when the loop has said so already

    def conclude_save(self, result):
        """The request in flight is over (answered, lost or given up): the waiting one goes out, then its callers
        hear the result."""
        request, self.save_flight = self.save_flight, None
        LOG.info('save_world %d: %s%s', request.id, result.result,
                 f' ({result.reason or result.detail})' if result.reason or result.detail else '')
        self.send_waiting()
        self.answer_callers(request, result)

    def send_waiting(self):
        waiting, self.save_waiting = self.save_waiting, None
        if waiting is not None and waiting.callers:
            self.send_save(waiting)

    @staticmethod
    def answer_callers(request, result):
        callers, request.callers = request.callers, []
        for caller in callers:
            tell_caller(caller, result)

    def save_timed_out(self):
        """Callers whose own deadline has passed hear `timeout`. A request nobody waits for any more is given up:
        a late answer to it is logged and dropped, and the waiting request goes out."""
        now = self.clock()
        late = []
        for request in (self.save_flight, self.save_waiting):
            if request is not None:
                due = [caller for caller in request.callers if caller.deadline <= now]
                request.callers = [caller for caller in request.callers if caller.deadline > now]
                late += [(caller, self.save_result('timeout', request)) for caller in due]
        if self.save_waiting is not None and not self.save_waiting.callers:
            self.save_waiting = None
        flight = self.save_flight
        if flight is not None and not flight.callers:
            LOG.warning('save_world %d was not answered in time; a late answer is dropped', flight.id)
            self.save_flight = None
            self.send_waiting()
        for caller, result in late:
            tell_caller(caller, result)


    # -- one stop routine (package 25, brief section 2)

    def held(self):
        """Whether what shows must stay as it is: a stop runs or the session is ending (no window, and nothing is
        declared running), or a window shows that stays until `retry` (2.9: a heartbeat must not close it)."""
        return (self.stop is not None or self.state == STOPPING
                or (self.state == RECOVERY and self.reason in STICKY))

    def in_handoff(self):
        launch = self.launch
        return launch is not None and launch.accepted and not launch.reported and not launch.failed

    def open_stop(self):
        """The stop record while it is open (it names a launch that a stop is ending), or None."""
        record = self.persisted.stop
        return record if isinstance(record, dict) and record.get('open') is True else None

    def record_stop(self, **changes):
        """Keep the stop record true (2.3): in desktop.json, file and folder fsynced, before the stop goes on.
        False: it could not be written."""
        self.persisted.stop = dict(self.persisted.stop or {}, **changes)
        try:
            self.persisted.save(self.paths.state_file, durable=True)
        except OSError as error:
            LOG.error('the stop record could not be written: %s', error)
            return False
        return True

    def log_phase(self, stop, text):
        """Every stop logs its phases with their times (2.1): desktop.log, and the journal through stderr."""
        LOG.info('stop (%s) +%.2f s: %s', stop.kind, self.clock() - stop.started, text)

    # The admission block (the lead's fix 2).

    def session_key(self):
        """What binds the admission block to this session: its instance, and the session's labwc (PID and start
        ticks) when LABWC_PID names a live process. The runtime folder can outlive a session (another login of the
        same user keeps it), and the instance with it; a new session has another labwc, so an old block never holds
        there. The PID is only looked at, never signalled."""
        labwc = None
        try:
            pid = int(self.environ.get('LABWC_PID', ''))
            identity = self.runner.identify(pid)
            labwc = [pid, identity[1]] if identity is not None else None
        except ValueError:
            pass
        return dict(instance=self.instance, labwc=labwc)

    def blocked(self):
        """Whether a shutdown or logout began in this session: then no launch, retry or hand-off is admitted until
        the session ends, by this supervisor or by one that replaces it."""
        if self.admission_blocked:
            return True
        try:
            with open(self.paths.stop_block, encoding='utf-8') as source:
                data = json.load(source)
        except (OSError, ValueError):
            return False
        key = self.session_key()
        self.admission_blocked = (isinstance(data, dict) and data.get('instance') == key['instance']
                                  and data.get('labwc') == key['labwc'])
        if self.admission_blocked:
            self.block_kind = data.get('kind')
        return self.admission_blocked

    def block_admission(self, kind):
        """Written when a stop that ends the session begins, before its launch's record can close. A logout's
        block that a shutdown joins becomes a shutdown's, which nothing lifts."""
        if self.blocked() and (kind != 'shutdown' or self.block_kind == 'shutdown'):
            return
        self.admission_blocked = True  # this supervisor holds it even if the file cannot be written
        self.block_kind = kind
        try:
            write_atomic(self.paths.stop_block,
                         json.dumps(dict(self.session_key(), kind=kind, since=self.wall())) + '\n', 0o600)
        except OSError as error:
            LOG.error('the admission block could not be written (%s); it holds for this supervisor only', error)
        LOG.info('the session is ending (%s): nothing is started any more', kind)

    def unblock_admission(self):
        """A logout was called off or did not end the session: launches are admitted again. A shutdown's block
        stays, also when a logout was tried after it."""
        if not self.blocked() or self.block_kind != 'logout':
            return
        self.admission_blocked = False
        self.block_kind = None
        try:
            os.unlink(self.paths.stop_block)
        except FileNotFoundError:
            pass
        except OSError as error:
            LOG.error('the admission block could not be removed: %s', error)

    # Requests.

    def ask_save(self, reason, done):
        """The socket op `save`. While a stop runs it joins the stop (2.8): nothing starts a second save, and the
        caller hears the stop's save result when the stop ends."""
        if self.stop is not None:
            self.stop.save_callers.append(done)
        else:
            self.request_save(reason, done)

    def request_stop(self, kind, done):
        """End the game on purpose (section 2): the record, the save and its answer, SIGTERM to Java, its real exit
        and the desktop lock, all inside one deadline. `done(reply)` is called once, when the stop has ended.

        `kind` is `stop`, `restart` or `logout` (called off when the save is not confirmed: the game keeps running)
        or `shutdown` (it closes anyway, recorded as unsaved). A request that arrives while a stop runs joins it:
        no second stop, no second save, the deadline stays, and a `shutdown` makes it one that cannot be called
        off."""
        if kind == 'shutdown' and self.session_over is None and self.runner.system_stopping() is False:
            # A session that ends under the supervisor (3.2) is never asked about: it cannot be called off.
            LOG.info('a shutdown stop was asked for, but systemd says the system is not stopping: a plain stop')
            kind = 'stop'
        stop = self.stop
        if stop is not None:
            stop.callers.append(done)
            if kind == 'shutdown' and stop.kind != 'shutdown':
                self.make_final(stop)
            return
        if kind == 'logout':
            refusal = self.logout_refusal()
            if refusal is not None:
                LOG.info('logout refused, nothing is stopped: %s', refusal['message'])
                call_back(done, refusal)
                return
        now = self.clock()
        stop = self.stop = Stop(kind, now, now + STOP_BUDGET, now + STOP_SAVE_WAIT, callers=[done])
        # First what he would notice (3.4): a lid closed right now must not suspend, and the screens go black.
        self.hold_lid()
        self.go_black(stop)
        if kind in SESSION_ENDING_KINDS:
            self.block_admission(kind)
        self.retry_at = None  # no backoff restart fires (2.8); a stop that is called off has a game that runs
        launch = self.launch
        running = (launch is not None and not launch.failed
                   and (launch.jvm_pid is not None or (launch.accepted and not launch.reported)))
        unseen = not running and self.runner.jvm_lock_held()
        if not running and not unseen:
            # Positive evidence that nothing is running: no Java, none in hand-off, and the desktop lock is free.
            # Such a stop writes no record (2.9).
            stop.save, stop.close = 'nothing', 'none'
            self.log_phase(stop, 'nothing is running')
            self.after_close()
            return
        stop.launch = launch.id if running else None
        self.log_phase(stop, f'begins for launch {stop.launch}')
        previous = self.persisted.stop
        self.persisted.stop = None
        if not self.record_stop(open=True, launch=stop.launch, instance=self.instance, kind=kind,
                                started=self.wall(), phase='save', save=None, why='', sigterm=False, close=None):
            stop.recorded = False
            if kind in CALLED_OFF_KINDS:
                self.persisted.stop = previous
                self.call_off('The stop could not be recorded on the disk.')
                return
        self.enter(STOPPING, kind)
        if unseen:
            # A game this supervisor cannot see holds the desktop lock: it can be neither asked nor closed.
            self.stop_unconfirmed('unseen', 'Not saved: a Minecraft that AresOS cannot see holds the desktop lock.')
            if self.stop is stop:
                stop.close = 'failed'
                if not self.record_stop(save=stop.save, why=stop.why, close='failed'):
                    stop.recorded = False
                self.finish_stop()
            return
        self.step_stop()

    def make_final(self, stop):
        """A `stop --reason shutdown` (or, from step 3, the session's signal) joined a stop that could be called
        off: it no longer can."""
        self.log_phase(stop, 'a shutdown joined: the stop can no longer be called off')
        stop.kind = 'shutdown'
        self.go_black(stop)  # the shutdown begins here for him (3.4)
        self.block_admission('shutdown')
        if self.open_stop() is not None and not self.record_stop(kind='shutdown'):
            stop.recorded = False
        self.enter(STOPPING, 'shutdown')
        if stop.phase == 'logout':
            # A logout that waits for labwc: the session is ending, which is what it asked for.
            stop.logout = 'exited' if self.labwc_gone else 'ending'
            self.finish_stop()

    # The phases. step_stop() goes on as far as it can without waiting; stop_due() says when it can go on again.

    def stop_due(self):
        stop, launch = self.stop, self.launch
        # "At once" is a time that has passed on every later reading of the clock: tick() compares it with its own
        # reading, taken before this one.
        now = stop.started
        gone = launch is not None and launch.jvm_ended is not None  # the pidfd fired; conclude() comes in a moment
        if stop.phase == 'save':
            if self.in_handoff() or gone:
                due = stop.deadline
            elif stop.answer is not None:
                due = now
            elif stop.asking:
                due = stop.save_deadline
            else:
                due = now if stop.ask_at is None else stop.ask_at
        elif stop.phase == 'logout':
            due = stop.deadline  # labwc's end is an event (the loop's pidfd); only the deadline is timed
        elif stop.ended:
            due = now if stop.lock_at is None else stop.lock_at
        else:
            due = stop.deadline if stop.sigterm or gone else now
        return min(due, stop.deadline)

    def step_stop(self):
        stop, now = self.stop, self.clock()
        if now >= stop.deadline:
            if stop.phase == 'logout':
                self.no_logout('stayed', f'the session did not end within the stop\'s {int(STOP_BUDGET)} seconds')
            else:
                self.stop_overrun()
            return
        if stop.phase == 'save':
            self.step_save(stop, now)
        if self.stop is stop and stop.phase == 'close':
            self.step_close(stop, now)

    def step_save(self, stop, now):
        """2.4, in its order: nothing to save (only on positive evidence), saved, what passes by itself (asked
        again each second until the save deadline), and anything else: not confirmed."""
        if self.in_handoff() or self.launch.jvm_ended is not None:
            return  # a launch in hand-off is waited for and then closed (2.8); a Java that is gone is concluded
        answer, stop.answer = stop.answer, None
        if answer is None and stop.asking:
            if now < stop.save_deadline:
                return
            answer = self.save_result('timeout')  # save_timed_out() says the same at this moment
        stop.asking = False
        if answer is None:
            if stop.ask_at is not None and now < stop.ask_at:
                return
            if self.no_world_folder():
                self.stop_saved(stop, 'nothing', 'The worlds folder holds no folder at all.')
            elif now >= stop.save_deadline:
                self.stop_unconfirmed('timeout', 'Not saved: Minecraft could not be asked in time.')
            else:
                stop.asking = True
                # The callback only notes the answer (it can run inside conclude() or before this returns).
                self.request_save('shutdown', lambda result: setattr(stop, 'answer', result),
                                  wait=stop.save_deadline - now)
            return
        stop.result = answer
        if answer.saved:
            self.stop_saved(stop, 'saved', save_text(answer))
            return
        passing = answer.result == 'no_channel' or (answer.result == 'refused' and answer.reason in SAVE_PASSING)
        if passing and now + STOP_ASK_AGAIN < stop.save_deadline:
            stop.ask_at = now + STOP_ASK_AGAIN
            return
        self.stop_unconfirmed(answer.reason or answer.result, save_text(answer))

    def no_world_folder(self):
        """Positive evidence that there is nothing to save: the worlds folder was listed and holds no folder (nor a
        link that could be one). A folder that cannot be listed is unknown, never empty."""
        try:
            with os.scandir(self.paths.worlds) as entries:
                return not any(entry.is_symlink() or entry.is_dir(follow_symlinks=False) for entry in entries)
        except OSError:
            return False

    def stop_saved(self, stop, save, why):
        stop.save, stop.why, stop.phase = save, why, 'close'
        self.log_phase(stop, f'the save is confirmed ({save}): {why}')

    def stop_unconfirmed(self, save, why):
        """The save is not confirmed (2.4): a stop that can be called off is; one that cannot closes anyway."""
        stop = self.stop
        stop.save, stop.why = save, why
        self.log_phase(stop, f'the save is not confirmed ({save}): {why}')
        if stop.kind in CALLED_OFF_KINDS:
            self.call_off(why)
        else:
            stop.phase = 'close'

    def step_close(self, stop, now):
        """2.5: SIGTERM to Java through its pidfd, then its real exit, then the desktop lock."""
        if not stop.ended:
            if stop.sigterm or self.launch.jvm_ended is not None:
                return  # waiting for the exit, or for a Java that went by itself to be concluded
            # The record says SIGTERM before it is sent: from here the stop can no longer be called off (2.3).
            if not self.record_stop(phase='close', save=stop.save, why=stop.why, sigterm=True):
                stop.recorded = False
                if stop.kind in CALLED_OFF_KINDS:
                    self.persisted.stop['sigterm'] = False
                    self.call_off('The stop could not be recorded on the disk.')
                    return
            stop.sigterm = True
            sent = self.runner.signal_jvm()
            self.log_phase(stop, 'SIGTERM sent to Java' if sent else 'SIGTERM could not be sent to Java (no pidfd)')
            return
        if self.runner.jvm_lock_held():
            stop.lock_at = now + STOP_LOCK_CHECK  # the wrapper has not let go of the desktop lock yet
            return
        self.after_close()

    # What follows the close: a logout ends the session, a restart starts the game again (3.3).

    def logout_refusal(self):
        """3.3: `logout` is refused, and stops nothing, while an app window is open or the helper has not said, and
        when this supervisor watches no labwc it could end. None: it may begin."""
        names = self.app_windows()
        if names is None:
            error, why = 'apps_unknown', ('AresOS cannot tell whether an app is still open (its app helper has not '
                                          'reported). Nothing was stopped.')
        elif names:
            error, why = 'apps_open', (f'{open_apps(names)}. Close {"it" if len(names) == 1 else "them"} first; '
                                       'nothing was stopped.')
        elif not self.labwc_watched:
            error, why = 'no_session', ('this AresOS desktop watches no session of its own that it could end. '
                                        'Nothing was stopped.')
        else:
            return None
        return dict(ok=False, result='refused', kind='logout', error=error, windows=names,
                    message='Not logged out: ' + why)

    def after_close(self):
        """The game is closed, or none ran. A confirmed `logout` goes on to end the session, also with no game
        running (the lead's fix 3); every other stop has ended."""
        stop = self.stop
        if not (stop.kind == 'logout' and stop.save in ('saved', 'nothing') and stop.close in ('exited', 'none')):
            self.finish_stop()
            return
        # The app check is fresh at the moment it matters (the lead's fix 4): right before labwc is signalled.
        names = self.app_windows()
        if names is None:
            self.no_logout('apps_unknown', 'AresOS can no longer tell whether an app is open')
        elif names:
            self.no_logout('apps_open', open_apps(names, 'open now'))
        elif not self.labwc_watched or not self.runner.signal_labwc():
            self.no_logout('no_session', 'the session could not be asked to end')
        else:
            # SIGTERM through the pidfd the loop watches, never `labwc --exit` (which signals whatever LABWC_PID
            # says). Its exit is waited for inside the stop's one deadline.
            stop.phase, stop.logout = 'logout', 'asked'
            if not stop.exiting:
                # labwc's end is the supervisor's exit too: the stop's last seconds are left for it, as in
                # end_session().
                stop.exiting, self.exit_by = True, stop.deadline
                stop.deadline -= STOP_EXIT_RESERVE
            self.log_phase(stop, 'SIGTERM sent to labwc; waiting for the session to end')

    def no_logout(self, outcome, note):
        """The logout does not go on, or labwc stayed: the reply says so and the session stays (the `quit` window)."""
        stop = self.stop
        stop.logout, stop.note = outcome, note
        self.log_phase(stop, f'no logout ({outcome}): {note}')
        self.finish_stop()

    def start_again(self, stop):
        """`restart`, after its stop (3.3): with no app window open as `retry` does (the startup cover), otherwise
        as an automatic restart does (the hub waits below the app in front; unknown counts as open). The session's
        instance stays. Returns `started`, `starting` (a start was already on its way: no second one) or `failed`
        (a window says why)."""
        launch = self.launch
        if stop.close == 'none' and launch is not None and not launch.failed and self.state in (SETUP, STARTING):
            return 'starting'
        if self.app_windows() == []:
            # As retry() does: AUTH_REQUIRED's start shows Prism's sign-in, so it is never covered.
            self.begin(cover=None if self.state == AUTH_REQUIRED else COVER_AGAIN)
        else:
            self.begin(automatic=True)
        return 'started' if self.launch is not launch and self.state in (SETUP, STARTING) else 'failed'

    # The session ends under the supervisor (3.2).

    def watch_session(self):
        """Watch this session's labwc. LABWC_PID is taken only from the supervisor's own environment, and the
        runner uses it only for a process named labwc, with our uid and this supervisor's XDG_RUNTIME_DIR in its
        environment: a supervisor on a private runtime folder can then never touch the session's labwc. Otherwise
        nothing is watched (one log line) and nothing is ever signalled."""
        try:
            pid = int(self.environ.get('LABWC_PID', ''))
        except ValueError:
            LOG.info('no LABWC_PID in the environment: no labwc is watched, and `logout` is refused')
            return
        found = self.runner.watch_labwc(pid, self.paths.runtime)
        if found == 'watched':
            self.labwc_watched = True
            LOG.info('watching the session\'s labwc (PID %d)', pid)
        elif found == 'gone':
            self.labwc_gone = True
            LOG.info('the session\'s labwc (PID %d) has ended: the session is over', pid)
        else:
            LOG.warning('LABWC_PID %d is not watched (%s): `logout` is refused', pid, found)

    def on_labwc_gone(self):
        """The watched labwc ended: the session is over. The loop ends the session next (end_session)."""
        self.labwc_watched, self.labwc_gone = False, True
        LOG.info('labwc ended: the session is over')
        self.hide_black('labwc ended')

    def overran(self):
        """Whether a stop already sent SIGTERM to the launch that is still there and ran out of its deadline."""
        record, launch = self.open_stop(), self.launch
        return (record is not None and launch is not None and record.get('launch') == launch.id
                and record.get('sigterm') is True and record.get('close') == 'overrun')

    def end_session(self, why, done):
        """The session ends under the supervisor: SIGTERM, SIGHUP or SIGINT, or labwc's end. The stop routine runs
        as one that cannot be called off (2.2; systemd is not asked), and `done(reply)` is called once the
        supervisor may exit. A stop that runs is joined and made final: its deadline is never extended, and its
        last STOP_EXIT_RESERVE seconds are left for the supervisor's own exit."""
        if self.session_over is None:
            self.session_over = why
            LOG.info('the session is ending (%s)', why)
        now = self.clock()
        if self.stop is None and self.overran():
            # 2.7: Java had its SIGTERM and a whole deadline. The supervisor exits; the system's teardown ends it.
            LOG.info('a stop already ran out of its deadline on this Minecraft: nothing more is waited for')
            self.block_admission('shutdown')
            self.enter(STOPPING, 'overrun')
            self.exit_by = self.exit_by or now + STOP_EXIT_RESERVE
            call_back(done, None)
            return
        self.request_stop('shutdown', done)
        stop = self.stop
        if stop is not None and not stop.exiting:
            stop.exiting = True
            stop.deadline -= STOP_EXIT_RESERVE
        self.exit_by = self.exit_by or (now if stop is None else stop.deadline) + STOP_EXIT_RESERVE

    def call_off(self, why):
        """Before SIGTERM only: the game keeps running as an ordinary launch, and a window says why (2.4)."""
        stop = self.stop
        stop.why, stop.close = why, 'called_off'
        self.log_phase(stop, 'called off; Minecraft keeps running')
        if self.open_stop() is not None:
            self.record_stop(open=False, phase='called_off', save=stop.save, why=why, close='called_off',
                             ended=self.wall())
        self.finish_stop()

    def stop_overrun(self):
        """The deadline (2.7): the supervisor stops waiting and never kills. Java, or the lock, is still there."""
        stop = self.stop
        if not stop.sigterm and not stop.ended and stop.kind in CALLED_OFF_KINDS:
            self.call_off(f'The stop ran out of its {int(STOP_BUDGET)} seconds before Minecraft was asked to close.')
            return
        if stop.save is None:
            stop.save, stop.why = 'timeout', 'Not saved: the stop ran out of time before the home was saved.'
        stop.close = 'overrun'
        self.log_phase(stop, 'the deadline: no longer waiting; nothing is killed')
        if isinstance(self.persisted.stop, dict) and self.persisted.stop.get('launch') == stop.launch:
            self.record_stop(phase='overrun', save=stop.save, why=stop.why, close='overrun')
        self.finish_stop()

    def finish_stop(self):
        """The stop has ended: what shows next is decided here, never while it ran, and every caller hears it."""
        stop, self.stop = self.stop, None
        confirmed = stop.save in ('saved', 'nothing')
        took = self.clock() - stop.started
        result = 'called_off' if stop.close == 'called_off' else 'confirmed' if confirmed else 'unsaved'
        logged_out = stop.logout in ('exited', 'ending')
        LOG.info('stop (%s) ended after %.2f s: %s, close %s%s%s', stop.kind, took, result, stop.close,
                 '' if stop.recorded else '; it could not be recorded',
                 f'; logout {stop.logout}' if stop.logout else '')
        try:
            if stop.kind == 'logout':
                # Still a logout at its end (a session that really ends made it final): the session stays.
                self.unblock_admission()
                self.exit_by = None
            if stop.kind == 'shutdown' or self.blocked():
                # The session is ending: no window. The supervisor exits when the session's signal comes; if Java
                # is still there, the system's teardown ends it (2.7).
                self.enter(STOPPING, 'overrun' if stop.close == 'overrun' else 'session')
            elif stop.close == 'called_off':
                self.enter(RECOVERY, SAVE_FAILED[stop.kind], stop.why)
            elif stop.close == 'overrun':
                self.enter(RECOVERY, 'stuck')
            elif self.persisted.latched:
                self.enter(RECOVERY, self.persisted.reason, self.persisted.detail)
            elif stop.kind == 'restart':
                try:
                    stop.restart = self.start_again(stop)
                except Exception:  # the callers still hear how the stop ended
                    LOG.exception('the restart\'s new start failed')
                    stop.restart = 'failed'
            elif stop.close != 'none' or self.state not in (SETUP, AUTH_REQUIRED, RECOVERY):
                self.settle(RECOVERY, 'quit')
        except OSError as error:
            LOG.error('after the stop: %s', error)
        if not (stop.kind == 'shutdown' or self.blocked()):
            # The session goes on: what the stop held ends with it (3.4). While the session is ending, the black
            # screen and the lid block stay until it is torn down: they end with this supervisor, or by their
            # own limit.
            self.release_lid()
            self.black_after_stop()
        ok = confirmed and stop.close in ('exited', 'none') and stop.recorded
        if stop.kind == 'restart':
            ok = ok and stop.restart in ('started', 'starting')
        if stop.kind == 'logout' or stop.logout is not None:
            ok = ok and logged_out
        reply = dict(ok=ok, result=result, kind=stop.kind, save=stop.save, close=stop.close,
                     recorded=stop.recorded, seconds=round(took, 2), message=stop_text(stop, confirmed))
        if stop.restart is not None:
            reply['restart'] = stop.restart
        if stop.logout is not None:
            reply['logout'] = stop.logout
        for done in stop.callers:
            call_back(done, reply)
        for done in stop.save_callers:
            call_back(done, stop.result if stop.result is not None else self.save_result('no_channel'))

    # The launch's end, and the record across supervisors.

    def close_record(self, end, save, why, never_ran=False):
        """The launch the open stop record names is gone: the record closes with what the stop came to, in the
        same write as the accounting. Returns (save, close, why). `never_ran`: no JVM of this launch was ever
        reported to this supervisor."""
        status = end.status if end is not None else None
        if save not in ('saved', 'nothing') and never_ran and end is not None and status is None:
            # Positive evidence (2.4): the wrapper's own word for a start that did not become a game, and no JVM
            # was ever handed over.
            save, why = 'nothing', 'Java never ran.'
        overran = self.persisted.stop.get('close') == 'overrun'
        close = 'overrun' if overran else 'exited' if status == JAVA_SIGTERM_EXIT else 'failed'
        if save not in ('saved', 'nothing'):
            why = why or 'Minecraft ended before your home was confirmed as saved.'
            # The latch `unsaved` (2.9), persisted here; whether a window shows it is the caller's.
            self.persisted.latched, self.persisted.reason, self.persisted.detail = True, 'unsaved', why
            self.persisted.disposition = None
        self.record_stop(open=False, phase='ended', save=save, why=why, close=close, status=status,
                         ended=self.wall())
        return save, close, why

    def conclude_stopped(self, end):
        """conclude() for a launch that an open stop record names (2.7): `stopped`. Never counted, never restarted
        by backoff, never latched `killed`, whatever its status, also for a supervisor that adopted the game."""
        launch, stop = self.launch, self.stop
        record = self.persisted.stop
        mine = stop is not None and stop.launch == launch.id
        save, why = record.get('save'), record.get('why')
        if mine:
            if stop.phase == 'save' and stop.answer is not None and stop.answer.saved:
                # Answered before Java ended, read only now.
                stop.save, stop.why, stop.result = 'saved', save_text(stop.answer), stop.answer
            save, why = stop.save, stop.why
        save, close, why = self.close_record(end, save, why, never_ran=not launch.reported)
        LOG.info('launch %s ended: stopped (%s%s); save %s, close %s', launch.id,
                 describe_status(end.status if end is not None else None),
                 f'; {end.reason}' if end is not None and end.reason else '', save, close)
        self.save_runtime()
        if mine:
            stop.ended, stop.phase, stop.save, stop.why, stop.close = True, 'close', save, why or '', close
        else:
            self.settle_stopped(record)
        return 'stopped'

    def close_stale_stop(self, settle=True):
        """2.9, at a start: a record still open whose launch is gone is closed. The launch is `stopped`, and
        `unsaved` is latched if its save was not confirmed."""
        record = self.open_stop()
        if record is None:
            return
        launch_id = record.get('launch')
        if self.launch is not None and self.launch.id == launch_id and not self.launch.failed:
            return  # its start is still waited for (account_for_start); conclude() closes the record
        LOG.info('a stop (%s) of launch %s was still open; its launch is gone', record.get('kind'), launch_id)
        if isinstance(launch_id, str):
            self.persisted.accounted = launch_id
        self.close_record(self.record_facts(launch_id) if isinstance(launch_id, str) else None,
                          record.get('save'), record.get('why'))
        if settle:
            self.settle_stopped(record)

    def settle_stopped(self, record):
        """A stopped launch ended and no stop runs here any more (it overran, or another supervisor began it)."""
        mine = record.get('instance') == self.instance and record.get('kind') != 'shutdown'
        if self.state is None:
            # start() goes on: it shows a latch, restores this session's decision, or begins as a new session does.
            if mine and not self.persisted.latched:
                self.persisted.disposition = dict(instance=self.instance, launch=record.get('launch'),
                                                  state=RECOVERY, reason='quit', detail='', retry_after=None)
                self.save()
        elif self.blocked():
            self.enter(STOPPING, 'session')
        elif self.persisted.latched:
            self.enter(RECOVERY, self.persisted.reason, self.persisted.detail)
        elif mine:
            self.settle(RECOVERY, 'quit')

    def resume_stop(self):
        """2.8: this supervisor replaced one in the middle of a stop and adopted its game. A stop that can be
        called off and had not sent SIGTERM is called off; any other goes on inside what is left of its deadline
        (by the record's start), and a `restart` or `logout` cut this way ends as a plain stop does."""
        record = self.open_stop()
        if record is None:
            return
        if record.get('launch') != self.launch.id:
            self.close_stale_stop(settle=False)
            return
        kind = record.get('kind')
        if kind == 'logout':
            self.unblock_admission()  # cut this way it ends as a plain stop does: the session stays
        if kind in CALLED_OFF_KINDS and record.get('sigterm') is not True:
            LOG.info('the stop (%s) the previous supervisor began is called off; Minecraft keeps running', kind)
            self.record_stop(open=False, phase='called_off', close='called_off', ended=self.wall())
            return
        started = record.get('started')
        gone = self.wall() - started if type(started) in (int, float) else STOP_BUDGET
        begun = self.clock() - min(max(gone, 0.0), STOP_BUDGET)
        stop = Stop('shutdown' if kind == 'shutdown' else 'stop', begun, begun + STOP_BUDGET,
                    begun + STOP_SAVE_WAIT, launch=self.launch.id)
        if record.get('sigterm') is True:
            stop.phase, stop.sigterm = 'close', True
            stop.save, stop.why = record.get('save'), str(record.get('why') or '')
        self.stop = stop
        self.hold_lid()  # the black screen went with the previous supervisor, and no helper has reported yet
        self.log_phase(stop, f'goes on after a supervisor restart ({kind}, phase {stop.phase})')
        self.enter(STOPPING, stop.kind)


# ---------------------------------------------------------------- processes and the event loop


def set_parent_death_signal(signum):
    """Ask the kernel to send `signum` to this (child) process when its parent dies."""
    import ctypes
    libc = ctypes.CDLL(None, use_errno=True)
    if libc.prctl(1, signum, 0, 0, 0) != 0:  # PR_SET_PDEATHSIG
        raise OSError(ctypes.get_errno(), 'prctl(PR_SET_PDEATHSIG) failed')


def labwc_problem(pid, runtime, proc='/proc'):
    """Why the process LABWC_PID names is not this session's labwc, or None when it is (3.2): it is named labwc, it
    has our uid, and its environment has this supervisor's XDG_RUNTIME_DIR. ProcessLookupError: no such process."""
    base = f'{proc}/{pid}'
    try:
        with open(f'{base}/comm', encoding='utf-8', errors='replace') as source:
            name = source.read().strip()
        owner = os.stat(base).st_uid
    except FileNotFoundError:
        raise ProcessLookupError(pid) from None
    except OSError as error:
        return f'it cannot be looked at: {error.strerror}'
    if name != 'labwc':
        return f'that process is named {clip(name)}'
    if owner != os.getuid():
        return 'that process belongs to another user'
    try:
        with open(f'{base}/environ', 'rb') as source:
            environ = source.read().split(b'\0')
    except FileNotFoundError:
        raise ProcessLookupError(pid) from None
    except OSError as error:
        return f'its environment cannot be read: {error.strerror}'
    if b'XDG_RUNTIME_DIR=' + os.fsencode(runtime) not in environ:
        return 'that labwc runs on another runtime folder, so it is another session\'s'
    return None


def kill_and_leave(process, what):
    """SIGKILL, then at most CLEANUP_KILL_WAIT for it to be gone: cleanup never waits without a limit (package 25,
    2.1). What is still there after that is left to the system."""
    process.kill()
    try:
        process.wait(CLEANUP_KILL_WAIT)
    except subprocess.TimeoutExpired:
        LOG.warning('%s is still there %d s after SIGKILL; it is left to the system', what, CLEANUP_KILL_WAIT)


class Runner:
    """Real processes. Each child gets a pidfd in the loop's selector; the helper's status pipe too."""
    real = True

    def __init__(self, paths, loop):
        self.paths = paths
        self.loop = loop
        self.helper = None
        self.helper_pipe = None
        self.view_process = None
        self.jvm_fd = None
        self.cover = None
        # (process, when it gets SIGKILL): covers, black screens and lid blocks sent SIGTERM that have not ended yet
        self.covers_ending = []
        self.black = None
        self.lid_block = None
        self.labwc_fd = None

    # helper
    def helper_running(self):
        return self.helper is not None and self.helper.poll() is None

    def start_helper(self, instance, nonce, env):
        read, write = os.pipe()
        env = dict(env, ARESOS_DESKTOP_INSTANCE=instance, ARESOS_LAUNCH_NONCE=nonce,
                   ARESOS_SHELL_STATUS_FD=str(write))
        try:
            self.helper = subprocess.Popen([HELPER], env=env, pass_fds=(write,), stdin=subprocess.DEVNULL,
                                           preexec_fn=lambda: set_parent_death_signal(signal.SIGTERM))
        finally:
            os.close(write)
        self.helper_pipe = read
        self.loop.watch_helper(self.helper, read)

    def stop_helper(self):
        helper, self.helper = self.helper, None
        if helper is None:
            return
        self.loop.forget(helper)
        if self.helper_pipe is not None:
            self.loop.forget_fd(self.helper_pipe)
            self.helper_pipe = None
        if helper.poll() is None:
            helper.terminate()
            try:
                helper.wait(5)
            except subprocess.TimeoutExpired:
                kill_and_leave(helper, 'the app helper')

    # Prism
    def start_prism(self, command, env):
        os.makedirs(self.paths.state_dir, exist_ok=True)
        process = subprocess.Popen(command, env=env, cwd=self.paths.home, stdin=subprocess.DEVNULL,
                                   stdout=subprocess.PIPE, stderr=subprocess.STDOUT, start_new_session=True)
        self.loop.watch_prism(process)
        return process

    # the JVM: not our child, so only a pidfd
    def identify(self, pid):
        """(parent PID, start ticks, /proc/<pid>/cgroup) of a process, or None."""
        try:
            with open(f'/proc/{pid}/cgroup', encoding='utf-8') as source:
                cgroup = source.read()
            return parent_pid(pid), process_ticks(pid), cgroup
        except (OSError, ValueError, IndexError):
            return None

    def scope_result(self, unit):
        """How systemd says the game's scope ended (for example 'oom-kill'), or None. Clears a failed scope."""
        try:
            shown = subprocess.run([SYSTEMCTL, '--user', 'show', unit, '--property=Result', '--property=LoadState'],
                                   capture_output=True, text=True, timeout=5)
            values = dict(line.split('=', 1) for line in shown.stdout.splitlines() if '=' in line)
            if values.get('LoadState') != 'loaded':
                return None
            subprocess.run([SYSTEMCTL, '--user', 'reset-failed', unit], capture_output=True, timeout=5)
            return values.get('Result') or None
        except (OSError, subprocess.SubprocessError, ValueError):
            return None

    def memory_pressure(self):
        return memory_pressure()

    def alive(self, pid, ticks):
        try:
            return process_ticks(pid) == ticks
        except (OSError, ValueError, IndexError):
            return False

    def watch_jvm(self, pid, ticks):
        try:
            fd = os.pidfd_open(pid)
        except OSError:
            return False
        if not self.alive(pid, ticks):
            os.close(fd)
            return False
        if self.jvm_fd is not None:
            self.loop.forget_fd(self.jvm_fd)
        self.jvm_fd = fd
        self.loop.watch_jvm(fd)
        return True

    def jvm_lock_held(self):
        import fcntl
        try:
            fd = os.open(self.paths.jvm_lock, os.O_RDWR | os.O_CREAT | os.O_CLOEXEC, 0o600)
        except OSError:
            return False
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return False
        except BlockingIOError:
            return True
        finally:
            os.close(fd)

    def signal_jvm(self):
        """SIGTERM to Java through the pidfd the loop watches (package 25, 2.5): never a PID from a file, never
        through the wrapper, never SIGKILL. False: there is no such pidfd, or the process is gone."""
        if self.jvm_fd is None:
            return False
        try:
            signal.pidfd_send_signal(self.jvm_fd, signal.SIGTERM)
        except OSError:
            return False
        return True

    # the session's labwc: not our child either, so only a pidfd (package 25, 3.2)
    def watch_labwc(self, pid, runtime):
        """Watch the session's labwc by pidfd. `watched`; `gone` (there is no such process: this session's labwc has
        ended); or why it is not watched. The pidfd is opened first and is still alive after the checks, so what
        /proc said is about the process the pidfd names."""
        import select
        try:
            fd = os.pidfd_open(pid)
        except ProcessLookupError:
            return 'gone'
        except OSError as error:
            return f'it cannot be watched: {error.strerror}'
        try:
            problem = labwc_problem(pid, runtime)
            gone = bool(select.select([fd], [], [], 0)[0])
        except ProcessLookupError:
            gone = True
        if gone or problem is not None:
            os.close(fd)
            return 'gone' if gone else problem
        self.labwc_fd = fd
        self.loop.watch_labwc(fd)
        return 'watched'

    def signal_labwc(self):
        """SIGTERM to labwc through the pidfd the loop watches (3.3): never a PID, never `labwc --exit`. False:
        nothing is watched, or it is gone."""
        if self.labwc_fd is None:
            return False
        try:
            signal.pidfd_send_signal(self.labwc_fd, signal.SIGTERM)
        except OSError:
            return False
        return True

    def system_stopping(self):
        """Whether the system is shutting down, on systemd's clear word only (2.2): True, False, or None for no
        clear answer within SYSTEM_STATE_WAIT."""
        try:
            done = subprocess.run([SYSTEMCTL, 'is-system-running'], capture_output=True, text=True,
                                  stdin=subprocess.DEVNULL, timeout=SYSTEM_STATE_WAIT)
        except (OSError, subprocess.SubprocessError):
            return None
        state = done.stdout.strip()
        if state == 'stopping':
            return True
        return False if state in SYSTEM_NOT_STOPPING else None

    # the startup cover (package 23b)
    def start_cover(self, again):
        """The cover, a child of the supervisor (its scope, never the game's), with the views' cleaned environment.
        Started and never waited for: the loop reaps it."""
        self.cover = self.spawn_cover([COVER, '--again'] if again else [COVER])

    def spawn_cover(self, command):
        process = subprocess.Popen(command, env=session_environment(self.loop.environ), cwd=self.paths.home,
                                   stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                   preexec_fn=lambda: set_parent_death_signal(signal.SIGTERM))
        try:
            self.loop.watch_cover(process)
        except OSError:
            process.kill()
            process.wait()
            raise
        return process

    def stop_cover(self, kill_at):
        """SIGTERM to the cover; kill_covers() sends SIGKILL at kill_at if it is still there. False: none ran."""
        cover, self.cover = self.cover, None
        return self.end_later(cover, kill_at)

    def end_later(self, process, kill_at):
        if process is None or process.poll() is not None:
            return False
        process.terminate()
        self.covers_ending.append((process, kill_at))
        return True

    # the black screen and the lid block (package 25, 3.4)
    def start_black(self, limit):
        """The cover's black face on every output, a child like the startup cover: it dies with the supervisor,
        and by itself after `limit` seconds. Started and never waited for."""
        self.black = self.spawn_cover([COVER, '--black', '--limit', f'{limit:g}'])

    def stop_black(self, kill_at):
        black, self.black = self.black, None
        return self.end_later(black, kill_at)

    def start_lid_block(self, limit):
        """A logind block on the lid switch and on sleep, held by `systemd-inhibit` for as long as its command
        runs: `limit` seconds at most. Die-with-parent, so the block never outlives the supervisor; started and
        never waited for. Its own words about a refusal go to the supervisor's stderr (the journal)."""
        command = [SYSTEMD_INHIBIT, f'--what={LID_BLOCK}', '--who=AresOS', '--mode=block',
                   '--why=AresOS is saving your home before Minecraft stops', SLEEP, f'{limit:g}']
        process = subprocess.Popen(command, env=session_environment(self.loop.environ), cwd='/',
                                   stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                   preexec_fn=lambda: set_parent_death_signal(signal.SIGTERM))
        try:
            self.loop.watch_child('lid', process)
        except OSError:
            process.kill()
            process.wait()
            raise
        self.lid_block = process

    def stop_lid_block(self, kill_at):
        block, self.lid_block = self.lid_block, None
        return self.end_later(block, kill_at)

    def lid_block_ended(self, process):
        """The loop reaped a lid block: True when it was the one held (it ended by itself)."""
        self.covers_ending = [(other, at) for other, at in self.covers_ending if other is not process]
        if process is self.lid_block:
            self.lid_block = None
            return True
        return False

    def kill_covers(self, now):
        """SIGKILL to each stopped cover still there at its time; returns the next such time, or None."""
        waiting = []
        for cover, kill_at in self.covers_ending:
            if cover.poll() is not None:
                continue
            if kill_at <= now:
                cover.kill()
            else:
                waiting.append((cover, kill_at))
        self.covers_ending = waiting
        return min((kill_at for _, kill_at in waiting), default=None)

    def cover_ended(self, process):
        """The loop reaped a cover: `cover` or `black` when it was the one up (it ended by itself, not by
        stop_cover or stop_black), else None."""
        self.covers_ending = [(cover, at) for cover, at in self.covers_ending if cover is not process]
        if process is self.cover:
            self.cover = None
            return 'cover'
        if process is self.black:
            self.black = None
            return 'black'
        return None

    def end_children(self, by=None):
        """The supervisor's exit: the helper, the message window, every cover, the black screen and the lid block
        get SIGTERM at once and share one wait (CLOSE_WAIT, or what `by` leaves of the session-ending stop's
        deadline); what is still there then gets SIGKILL and CLEANUP_KILL_WAIT, and is left to the system after
        that (2.1)."""
        children = []
        helper, self.helper = self.helper, None
        if helper is not None:
            self.loop.forget(helper)
            if self.helper_pipe is not None:
                self.loop.forget_fd(self.helper_pipe)
                self.helper_pipe = None
            children.append((helper, 'the app helper'))
        view, self.view_process = self.view_process, None
        if view is not None:
            children.append((view, 'the message window'))
        children += [(process, 'a cover or lid block that was ending') for process, _ in self.covers_ending]
        children += [(process, what) for process, what in ((self.cover, 'a startup cover'),
                                                           (self.black, 'the black screen'),
                                                           (self.lid_block, 'the lid block')) if process is not None]
        self.cover, self.black, self.lid_block, self.covers_ending = None, None, None, []
        children = [(process, what) for process, what in children if process.poll() is None]
        for process, _ in children:
            process.terminate()
        wait = CLOSE_WAIT if by is None else min(CLOSE_WAIT, max(0.0, by - time.monotonic() - CLEANUP_KILL_WAIT))
        for limit, last in ((wait, False), (CLEANUP_KILL_WAIT, True)):
            end = time.monotonic() + limit
            for process, what in children:
                try:
                    process.wait(max(0.0, end - time.monotonic()))
                except subprocess.TimeoutExpired:
                    if last:
                        LOG.warning('%s is still there %d s after SIGKILL; it is left to the system', what,
                                    CLEANUP_KILL_WAIT)
            children = [(process, what) for process, what in children if process.poll() is None]
            if not last:
                for process, _ in children:
                    process.kill()

    # views
    def show_view(self, text):
        self.close_view()
        env = session_environment(self.loop.environ)
        env['ARESOS_TERMINAL'] = 'recovery'
        env['ARESOS_DESKTOP_VIEW'] = self.paths.view_text
        try:
            write_atomic(self.paths.view_text, text, 0o600)
            self.view_process = subprocess.Popen(
                VIEW_COMMAND, env=env, cwd=self.paths.home, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL, preexec_fn=lambda: set_parent_death_signal(signal.SIGTERM))
            self.loop.watch_view(self.view_process)
        except OSError as error:
            LOG.error('could not open the message window: %s', error)

    def close_view(self, wait=False):
        """Close the message window. The loop reaps it; on shutdown (wait) this waits for it itself."""
        view, self.view_process = self.view_process, None
        if view is not None and view.poll() is None:
            view.terminate()
            if wait:
                try:
                    view.wait(5)
                except subprocess.TimeoutExpired:
                    kill_and_leave(view, 'the message window')


class Peer:
    def __init__(self, sock, pid, uid, loop=None):
        self.loop = loop
        self.sock = sock
        self.pid = pid
        self.uid = uid
        self.buffer = b''
        self.wrapper = False
        self.launch = None
        self.lifecycle = False  # the game's accepted lifecycle connection (package 25)
        self.closed = False

    def send(self, message):
        """One line to this peer, never waited for. False: it did not take the line and is dropped."""
        return self.loop.reply(self, message)

    def close(self):
        self.loop.drop(self)


class Loop:
    """selectors-based event loop around one Supervisor."""

    def __init__(self, paths, lock, environ=None, nvidia=None):
        self.paths = paths
        self.environ = os.environ if environ is None else environ
        self.selector = selectors.DefaultSelector()
        self.children = {}
        self.stopping = False
        self.signal_pipe = None
        self.runner = Runner(paths, self)
        self.supervisor = Supervisor(paths, lock, self.runner, environ=self.environ, nvidia=nvidia)
        os.makedirs(paths.run_dir, mode=0o700, exist_ok=True)
        os.chmod(paths.run_dir, 0o700)
        self.listener = self.listen()

    def listen(self):
        path = self.paths.socket
        if os.path.lexists(path):
            probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            try:
                probe.connect(path)
                raise SystemExit('another aresos-desktop supervisor is already running')
            except (ConnectionRefusedError, FileNotFoundError):
                os.unlink(path)
            finally:
                probe.close()
        listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM | socket.SOCK_CLOEXEC)
        old = os.umask(0o177)
        try:
            listener.bind(path)
        finally:
            os.umask(old)
        listener.listen(8)
        listener.setblocking(False)
        self.selector.register(listener, selectors.EVENT_READ, ('listener', None))
        return listener

    # registrations
    def watch_child(self, kind, process):
        fd = os.pidfd_open(process.pid)
        self.children[fd] = process
        self.selector.register(fd, selectors.EVENT_READ, (kind, process))

    def watch_helper(self, process, pipe):
        os.set_blocking(pipe, False)
        self.watch_child('helper', process)
        self.selector.register(pipe, selectors.EVENT_READ, ('helper-status', [b'']))

    def watch_prism(self, process):
        os.set_blocking(process.stdout.fileno(), False)
        self.watch_child('prism', process)
        self.selector.register(process.stdout, selectors.EVENT_READ, ('prism-output', process))

    def watch_view(self, process):
        self.watch_child('view', process)

    def watch_cover(self, process):
        self.watch_child('cover', process)

    def watch_jvm(self, fd):
        self.selector.register(fd, selectors.EVENT_READ, ('jvm', None))

    def watch_labwc(self, fd):
        self.selector.register(fd, selectors.EVENT_READ, ('labwc', None))

    def watch_signals(self, signals):
        """3.2: a signal is noticed at once, not at the loop's next timeout. Python writes each one's number into
        this pipe, which the selector watches; the handler itself has nothing to do. Main thread only."""
        read, write = os.pipe2(os.O_NONBLOCK | os.O_CLOEXEC)
        self.signal_pipe = (read, write)
        self.selector.register(read, selectors.EVENT_READ, ('signal', frozenset(signals)))
        signal.set_wakeup_fd(write, warn_on_full_buffer=False)
        for signum in signals:
            signal.signal(signum, lambda signum, frame: None)

    def forget(self, process):
        for fd, known in list(self.children.items()):
            if known is process:
                self.forget_fd(fd)

    def forget_fd(self, fd):
        try:
            self.selector.unregister(fd)
        except (KeyError, ValueError):
            pass
        self.children.pop(fd, None)
        if isinstance(fd, int):
            os.close(fd)

    # events
    def run(self):
        self.supervisor.start()
        if self.supervisor.labwc_gone:
            # Started after its labwc ended (3.2): it stops what it adopted and exits.
            self.end_session('its labwc had ended before this supervisor started')
        while not self.stopping:
            for key, _ in self.selector.select(self.supervisor.deadline()):
                kind, data = key.data
                getattr(self, 'on_' + kind.replace('-', '_'))(key, data)
            self.supervisor.tick()
        self.close(self.supervisor.exit_by)

    def end_session(self, why):
        """The session ends under the supervisor (3.2): the stop routine runs first, and the loop ends when it has."""
        self.supervisor.end_session(why, self.session_ended)

    def session_ended(self, reply):
        self.stopping = True

    def on_signal(self, key, signals):
        try:
            received = os.read(key.fd, 64)
        except BlockingIOError:
            return
        for number in sorted(set(received) & signals):
            self.end_session(signal.Signals(number).name)

    def on_labwc(self, key, data):
        self.forget_fd(key.fd)
        if self.runner.labwc_fd == key.fd:
            self.runner.labwc_fd = None
        self.supervisor.on_labwc_gone()
        self.end_session('labwc ended')

    def on_listener(self, key, data):
        try:
            sock, _ = self.listener.accept()
        except BlockingIOError:
            return
        pid, uid, _ = struct.unpack('3i', sock.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED,
                                                          struct.calcsize('3i')))
        if uid != os.getuid():
            sock.close()
            return
        sock.setblocking(False)
        self.selector.register(sock, selectors.EVENT_READ, ('peer', Peer(sock, pid, uid, self)))

    def on_peer(self, key, peer):
        try:
            data = peer.sock.recv(65536)
        except BlockingIOError:
            return
        except OSError:
            data = b''
        if not data:
            self.drop(peer)
            return
        peer.buffer += data
        while b'\n' in peer.buffer and not peer.closed:
            line, peer.buffer = peer.buffer.split(b'\n', 1)
            lifecycle = peer.lifecycle
            try:
                answer = self.on_lifecycle_line(peer, line) if lifecycle else self.handle(peer, line)
            except Exception:  # one bad request must never take the desktop's supervision down
                LOG.exception('a request failed')
                answer = None if lifecycle else {'ok': False, 'error': 'internal',
                                                 'message': 'the request failed; see desktop.log'}
            # No answer: a lifecycle line (the mod expects none), or a reply that comes later (`save`).
            if answer is not None:
                self.reply(peer, answer)
        if len(peer.buffer) > MAX_LINE:
            self.drop(peer)

    def drop(self, peer):
        try:
            self.selector.unregister(peer.sock)
        except (KeyError, ValueError):
            return
        peer.sock.close()
        peer.closed = True
        if peer.wrapper:
            self.supervisor.on_wrapper_gone(peer.launch)
        if peer.lifecycle:
            self.supervisor.on_lifecycle_gone(peer)

    def reply(self, peer, message):
        """One line to a peer. It never blocks the loop (package 25, 1.5): a peer that does not take its whole
        line at once is dropped. True: the line was taken."""
        data = (json.dumps(message) + '\n').encode('utf-8')
        try:
            taken = peer.sock.send(data)  # the socket is non-blocking
        except OSError:  # a full buffer (BlockingIOError), a closed peer
            taken = -1
        if taken != len(data):
            self.drop(peer)
            return False
        return True

    def handle(self, peer, line):
        try:
            request = json.loads(line.decode('utf-8'))
            if not isinstance(request, dict) or not isinstance(request.get('op'), str):
                raise ValueError('a request is a JSON object with an op')
        except (ValueError, UnicodeError) as error:
            return {'ok': False, 'error': 'malformed', 'message': str(error)}
        supervisor = self.supervisor
        op = request['op']
        if op == 'jvm_start':
            if request.get('pid') != peer.pid:
                return {'ok': False, 'error': 'not_authorized', 'message': 'pid does not match the connection'}
            ok, fields = supervisor.on_jvm_start(request)
            peer.wrapper = ok
            peer.launch = fields.get('launch') if ok else None
            return dict(ok=ok, **fields)
        if op == 'jvm_started' and peer.wrapper and isinstance(request.get('pid'), int):
            ok, text = supervisor.on_jvm_started(peer.pid, request['pid'], peer.launch)
            return {'ok': ok, 'message': text}
        if op == 'jvm_failed' and (peer.wrapper or isinstance(request.get('launch'), str)):
            # The wrapper reports on its own connection, or on a new one after the first broke (it names the
            # launch). Like jvm_exited, it can only describe the launch this supervisor is waiting for.
            supervisor.on_jvm_failed(peer.launch if peer.wrapper else request['launch'], failed_start(request))
            return {'ok': True}
        if op == 'jvm_exited' and isinstance(request.get('pid'), int):
            # Only the game this supervisor watches can be reported, so any same-user peer may report it.
            supervisor.on_jvm_report(request['pid'], request.get('status'), request.get('launch'))
            return {'ok': True}
        if op == 'lifecycle_hello':
            return self.lifecycle_hello(peer, request)
        if op == 'save':
            return self.save_op(peer, request)
        if op in ('stop', 'restart', 'logout'):
            return self.stop_op(peer, request)
        if op == 'status':
            return dict(ok=True, **supervisor.status())
        if op == 'retry':
            ok, text = supervisor.retry()
            return {'ok': ok, 'message': text}
        if op == 'forget_hub':
            ok, text = supervisor.forget_hub()
            return {'ok': ok, 'message': text}
        if op == 'hide_cover':
            return {'ok': True, 'message': supervisor.owner_hides_cover()}
        return {'ok': False, 'error': 'unknown_operation', 'message': f'unknown op {op!r}'}

    # the lifecycle channel and saves (package 25, brief section 1)
    def lifecycle_hello(self, peer, request):
        """Accepted: no reply, and from now on only world_saved is read on this connection. Refused: it closes."""
        if self.supervisor.on_lifecycle_hello(peer, request):
            peer.lifecycle = True
        else:
            self.drop(peer)
        return None

    def on_lifecycle_line(self, peer, line):
        try:
            message = json.loads(line.decode('utf-8'))
        except (ValueError, UnicodeError):
            return None  # dropped, like every line that is no world_saved
        self.supervisor.on_lifecycle_message(peer, message)
        return None

    def save_op(self, peer, request):
        """Socket op `save` (1.5): the reply comes when the result is in, so nothing waits here."""
        reason = request.get('reason', 'manual')
        if reason not in SAVE_REASONS:
            return {'ok': False, 'error': 'bad_reason',
                    'message': 'a save\'s reason is one of: ' + ', '.join(SAVE_REASONS)}
        self.supervisor.ask_save(reason, lambda result: self.reply(peer, save_reply(result)))
        return None

    def stop_op(self, peer, request):
        """Socket ops `stop` (`reason: shutdown` for one that cannot be called off), `restart` and `logout` (3.3).
        The reply comes when the stop has ended, so nothing waits here."""
        op, reason = request['op'], request.get('reason')
        if reason not in (None, 'manual', 'shutdown') or (reason == 'shutdown' and op != 'stop'):
            return {'ok': False, 'error': 'bad_reason', 'message': 'only a stop has a reason: shutdown, or none'}
        self.supervisor.request_stop('shutdown' if reason == 'shutdown' else op,
                                     lambda reply: self.reply(peer, reply))
        return None

    def reap(self, key, process):
        self.forget_fd(key.fd)
        return process.wait()

    def on_helper(self, key, process):
        code = self.reap(key, process)
        if process is self.runner.helper:
            self.runner.helper = None
            self.supervisor.on_helper_exit(code)

    def on_helper_status(self, key, buffer):
        try:
            data = os.read(key.fd, 65536)
        except BlockingIOError:
            return
        if not data:
            self.forget_fd(key.fd)
            if self.runner.helper_pipe == key.fd:
                self.runner.helper_pipe = None
            return
        buffer[0] += data
        while b'\n' in buffer[0]:
            line, buffer[0] = buffer[0].split(b'\n', 1)
            try:
                self.supervisor.on_helper_status(json.loads(line.decode('utf-8')))
            except (ValueError, UnicodeError):
                LOG.warning('ignored a malformed status line from the app helper')
        buffer[0] = buffer[0][-MAX_LINE:]

    def on_prism(self, key, process):
        code = self.reap(key, process)
        # Read what is already there, for an early failure's message. The pipe itself stays open until its last
        # writer is gone: a process Prism started may still hold it, and must never get a broken pipe.
        while not process.stdout.closed and self.read_prism(process):
            pass
        if self.supervisor.launch is not None and self.supervisor.launch.prism is process:
            self.supervisor.on_prism_exit(code)

    def read_prism(self, process):
        try:
            data = os.read(process.stdout.fileno(), 65536)
        except BlockingIOError:
            return False
        except (OSError, ValueError):
            data = b''
        if not data:
            try:
                self.selector.unregister(process.stdout)
            except (KeyError, ValueError):
                pass
            process.stdout.close()
            return False
        if self.supervisor.launch is not None and self.supervisor.launch.prism is process:
            self.supervisor.on_prism_output(data)
        return True

    def on_prism_output(self, key, process):
        self.read_prism(process)

    def on_view(self, key, process):
        self.reap(key, process)

    def on_cover(self, key, process):
        code = self.reap(key, process)
        which = self.runner.cover_ended(process)
        if which == 'black':
            self.supervisor.on_black_exit(code)
        elif which:
            self.supervisor.on_cover_exit(code)

    def on_lid(self, key, process):
        code = self.reap(key, process)
        if self.runner.lid_block_ended(process):
            self.supervisor.on_lid_block_exit(code)

    def on_jvm(self, key, data):
        self.forget_fd(key.fd)
        if self.runner.jvm_fd == key.fd:
            self.runner.jvm_fd = None
        self.supervisor.on_jvm_gone()

    def close(self, by=None):
        """The supervisor's exit. `by`: when it must be done (the session-ending stop's one deadline)."""
        self.runner.end_children(by)
        if self.signal_pipe is not None:
            signal.set_wakeup_fd(-1)
            for fd in self.signal_pipe:
                self.forget_fd(fd)
            self.signal_pipe = None
        # A game that still runs keeps running (the next supervisor adopts it, or the system's teardown ends it);
        # only this process's ends of its pipes close.
        for key in list(self.selector.get_map().values()):
            kind, data = key.data
            if kind == 'peer':
                data.sock.close()
            elif kind == 'prism-output':
                data.stdout.close()
        self.listener.close()
        try:
            os.unlink(self.paths.socket)
        except FileNotFoundError:
            pass


# ---------------------------------------------------------------- command line


def request(paths, message, timeout=REQUEST_WAIT):
    """One request and its reply, inside one deadline for all of it: connecting, sending and waiting (package 25,
    1.5). Past it: TimeoutError (an OSError)."""
    deadline = time.monotonic() + timeout

    def left():
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise TimeoutError(f'no reply within {timeout:.0f} s')
        return remaining

    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        sock.settimeout(left())
        sock.connect(paths.socket)
        sock.settimeout(left())
        sock.sendall((json.dumps(message) + '\n').encode('utf-8'))
        data = b''
        while not data.endswith(b'\n'):
            sock.settimeout(left())
            chunk = sock.recv(65536)
            if not chunk:
                break
            data += chunk
        return json.loads(data.decode('utf-8'))
    finally:
        sock.close()


def setup_logging(paths, foreground):
    os.makedirs(paths.state_dir, exist_ok=True)
    handlers = [logging.handlers.RotatingFileHandler(paths.log_file, maxBytes=512 * 1024, backupCount=1)]
    if foreground:
        handlers.append(logging.StreamHandler())
    logging.basicConfig(level=logging.INFO, handlers=handlers,
                        format='%(asctime)s aresos-desktop: %(levelname)s %(message)s')


def supervise(paths):
    setup_logging(paths, foreground=True)
    try:
        lock = load_lock(paths.share)
    except (OSError, ValueError) as error:
        LOG.error('cannot read the pinned inputs: %s', error)
        lock = None
    if lock is None:
        show_failure(paths, 'This AresOS image has no readable Minecraft pins '
                            f'({os.path.join(paths.share, LOCK_NAME)}), so the desktop cannot start.')
        return 1
    loop = Loop(paths, lock)
    # 3.2: each of these ends the session under the supervisor. The stop routine runs before it exits.
    loop.watch_signals((signal.SIGTERM, signal.SIGHUP, signal.SIGINT))
    loop.run()
    return 0


def show_failure(paths, text):
    """The keeper's last resort: a terminal with the reason, outside any supervisor."""
    write_atomic(paths.view_text, 'AresOS: recovery\n\n' + text + '\n\nLogs: ~/.local/state/aresos/desktop.log\n',
                 0o600)
    env = session_environment(os.environ)
    env['ARESOS_TERMINAL'] = 'recovery'
    env['ARESOS_DESKTOP_VIEW'] = paths.view_text
    subprocess.Popen(VIEW_COMMAND, env=env, cwd=paths.home, stdin=subprocess.DEVNULL, start_new_session=True)


def session(paths):
    """Keep the supervisor running for the session; give up into a terminal if it keeps failing."""
    setup_logging(paths, foreground=False)
    starts = []
    child = None
    stopping = False

    def stop(signum, frame):
        nonlocal stopping
        stopping = True
        if child is not None and child.poll() is None:
            child.terminate()

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGHUP, stop)
    signal.signal(signal.SIGINT, stop)
    while not stopping:
        now = time.monotonic()
        starts = [t for t in starts if now - t < KEEPER_BUDGET[1]] + [now]
        child = subprocess.Popen([SELF, 'supervise'], env=session_environment(os.environ))
        if stopping and child.poll() is None:
            child.terminate()  # the signal came before `child` named this supervisor
        # The keeper waits for the supervisor, which runs its stop routine before it exits (package 25, 3.2).
        code = child.wait()
        if stopping or code == 0:
            return 0
        LOG.error('the supervisor exited with %s', code)
        if len(starts) >= KEEPER_BUDGET[0]:
            show_failure(paths, f'The desktop supervisor failed {len(starts)} times within '
                                f'{int(KEEPER_BUDGET[1] // 60)} minutes, so it was not started again.\n'
                                'Log out and in again (or restart) to try once more.')
            return 1
        time.sleep(2)
    return 0


def save_command(paths, reason):
    """`aresos-desktop save` (package 25, 1.5): exit 0 only when the game answered that the active world is saved."""
    try:
        reply = request(paths, {'op': 'save', 'reason': reason}, timeout=COMMAND_WAIT)
    except (OSError, ValueError) as error:
        print(f'Not saved: the AresOS desktop supervisor did not answer ({error}).', file=sys.stderr)
        return 1
    saved = reply.get('ok') is True and reply.get('result') == 'saved'
    print(reply.get('message', ''), file=sys.stdout if saved else sys.stderr)
    return 0 if saved else 1


def stop_command(paths, word, reason=None):
    """`aresos-desktop stop [--reason shutdown]`, `restart` and `logout` (package 25, 3.3): exit 0 only for a
    confirmed stop whose close exited (and, for the other two, the new start or the session's end), or when
    nothing is running."""
    message = {'op': word}
    if word == 'stop' and reason == 'shutdown':
        message['reason'] = 'shutdown'
    try:
        reply = request(paths, message, timeout=COMMAND_WAIT)
    except (OSError, ValueError) as error:
        lead = {'restart': 'Not restarted', 'logout': 'Not logged out'}.get(word, 'Not stopped')
        print(f'{lead}: the AresOS desktop supervisor did not answer ({error}).', file=sys.stderr)
        return 1
    done = reply.get('ok') is True
    print(reply.get('message', ''), file=sys.stdout if done else sys.stderr)
    return 0 if done else 1


def reset_instance(paths):
    lock = load_lock(paths.share)
    runner = Runner(paths, None)
    if runner.jvm_lock_held():
        print('The desktop is running. Close Minecraft first.', file=sys.stderr)
        return 1
    root = paths.instance(lock['instance'])
    if not os.path.lexists(root):
        print('There is no desktop instance; the next start creates one.')
        return 0
    aside = root + '.aside-' + time.strftime('%Y-%m-%d_%H-%M-%S')
    os.rename(root, aside)
    # The old copy must not keep opening the same worlds: drop only its link to them (the link, not a world).
    saves = os.path.join(aside, 'minecraft/saves')
    if os.path.islink(saves):
        os.unlink(saves)
    print(f'Moved the old instance to {aside} (nothing deleted). Type retry to start with a new one.')
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(prog='aresos-desktop', description='AresOS desktop supervisor (package 23)')
    parser.add_argument('command', choices=['session', 'supervise', 'status', 'retry', 'forget-hub',
                                            'reset-instance', 'explain', 'hide-cover', 'save', 'stop',
                                            'restart', 'logout'])
    parser.add_argument('--reason', choices=SAVE_REASONS, default='manual',
                        help='save: why the world is saved (it is only logged). stop: `shutdown` for a stop that '
                             'cannot be called off; anything else is a plain stop')
    args = parser.parse_args(argv)
    paths = Paths.from_environ()
    if args.command == 'session':
        return session(paths)
    if args.command == 'supervise':
        return supervise(paths)
    if args.command == 'reset-instance':
        return reset_instance(paths)
    if args.command == 'save':
        return save_command(paths, args.reason)
    if args.command in ('stop', 'restart', 'logout'):
        return stop_command(paths, args.command, args.reason)
    op = {'status': 'status', 'explain': 'status', 'retry': 'retry', 'forget-hub': 'forget_hub',
          'hide-cover': 'hide_cover'}[args.command]
    try:
        reply = request(paths, {'op': op})
    except (OSError, ValueError) as error:
        if args.command == 'explain' and os.path.exists(paths.view_text):
            with open(paths.view_text, encoding='utf-8') as source:
                print(source.read(), end='')
            return 0
        print(f'The AresOS desktop supervisor is not running ({error}).', file=sys.stderr)
        return 1
    if args.command == 'status':
        print(json.dumps({k: v for k, v in reply.items() if k != 'message'}, indent=2))
        return 0
    if args.command == 'explain':
        print(reply.get('message', ''), end='')
        return 0
    print(reply.get('message', ''))
    return 0 if reply.get('ok') else 1


if __name__ == '__main__':
    sys.exit(main())
