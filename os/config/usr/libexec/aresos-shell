#!/usr/bin/python3
"""AresOS app helper: the OS side of the aresos-shell/1.1 interface.

Design: docs/design/OS-BASE.md Appendix B1 (mod and OS interface v1) and B2
(supervision and focus). The desktop mod connects over a private Unix socket
and never sends a command. It names an app ID; this helper starts a reviewed
definition or a discovered desktop entry in its own systemd user scope,
watches the app's windows and tells the mod when focus moves.

Wire format: one UTF-8 JSON object per line, at most 64 KiB per line.
  request  {"protocol": "aresos-shell/1.1", "id": <request id>, "op": <operation>, ...}
  reply    {"protocol": ..., "id": <request id>, "ok": true, ...}
           {"protocol": ..., "id": <request id or null>, "ok": false, "error": <code>, "message": <text>}
  event    {"protocol": ..., "id": <event id>, "event": "app_state" | "shell_focus" | "apps_changed", ...}

Minor 1 adds app_details, list_paging and apps_changed. list_apps returns an
ID-ordered page with revision and optional next; cursor requests the next page.
Only icon paths and bounded descriptive metadata leave the helper, never launch
commands or environment. Discovery scans run on their own thread within hard
bounds, at most every three seconds, and the last good catalogue answers
meanwhile; icons arrive asynchronously. Minor 0 keeps the original starter-only list,
revision and launch access. Examples: mod/src/test/resources/shell-1.1/.

Operations (B1): hello, list_apps, open_app, world_ready, heartbeat. Everything
else, including the guardian's request_power, prepare_stop and save_complete
(package 25), is rejected as unknown_operation.

Registry: one reviewed, image-shipped file per app in /usr/share/aresos/apps:
  {"schema": 1, "id": "notepad", "name": "Notepad",
   "argv": ["/usr/bin/kwrite"]   (or "desktop_entry": "org.kde.kwrite.desktop"),
   "working_directory": "~",
   "window": {"app_ids": ["org.kde.kwrite"], "instance": "multi"}}
window.app_ids are the Wayland app_ids (under XWayland, the WM_CLASS class) of
the app's windows. window.instance is "multi" when every launch is its own
process, and "single" when a launch hands over to an already running instance
and exits (Chrome), so an early clean exit is not a failure.

The supervisor that starts the desktop (package 23) gives this helper and the
game the same ARESOS_DESKTOP_INSTANCE and ARESOS_LAUNCH_NONCE. The mod must
present both in hello, world_ready and heartbeat. This binds a connection to
the supervised desktop; it is a local session protocol, not a security
boundary against other programs of the same user.

Readiness for the supervisor: when ARESOS_SHELL_STATUS_FD names a pipe the
supervisor passed in, the helper writes one JSON object per line to it for
every authenticated desktop event, and never reads from it:
  {"event": "desktop_connected"}
  {"event": "world_ready", "world": <save folder name>}
  {"event": "heartbeat", "ready": <bool>, "world": <save folder name or null>}

After the supervisor restarts a crashed desktop it sets
ARESOS_SHELL_KEEP_FOREGROUND=1: when the new desktop window takes focus while
another window was in front, the helper gives that window its focus back once,
so the restored hub waits below the app the owner is using (B2).
"""
import argparse
import dataclasses
import glob
import hashlib
import hmac
import json
import logging
import os
import posixpath
import re
import secrets
import selectors
import shutil
import signal
import socket
import stat
import struct
import subprocess
import sys
import tempfile
import threading
import time
import queue
from xml.parsers import expat

LOG = logging.getLogger('aresos-shell')

NAME = 'aresos-shell'
MAJOR = 1
MINOR = 1
MAX_MESSAGE = 64 * 1024
MAX_OUTGOING = 1024 * 1024
MAX_CONNECTIONS = 8
MAX_APPS = 256
MAX_LIST = 32
HELLO_TIMEOUT = 10.0
WINDOW_TIMEOUT = 30.0
# A close this soon after its window lost focus is the compositor handing focus on, not the owner switching.
HANDOFF = 0.5
# A restored desktop window that takes focus this soon after appearing gives it back (keep_foreground).
KEEP_WINDOW = 3.0
# Pause between the end of one scope check and the start of the next (one batched systemctl call each).
SCOPE_CHECK = 5.0
SCOPE_TIMEOUT = 5.0
JOURNAL_LIMIT = 256
# Well beyond the mod's 45-second open timeout, the only window in which it resends a request ID.
REPLAY_HORIZON = 600.0
REGISTRY = '/usr/share/aresos/apps'
DESKTOP_ENTRY_DIRS = ('/usr/share/applications', '/usr/local/share/applications')
EXEC_PATH = '/usr/local/bin:/usr/bin'
MAX_DESKTOP_ENTRY = 1024 * 1024
# Arguments used for Terminal=true entries; changing the everyday terminal stays in one place.
TERMINAL_COMMAND = ('/usr/bin/foot', '--app-id={app_id}')
NVIDIA_OFFLOAD = {'__NV_PRIME_RENDER_OFFLOAD': '1', '__GLX_VENDOR_LIBRARY_NAME': 'nvidia',
                  '__VK_LAYER_NV_optimus': 'NVIDIA_only'}
GPU_KEYS = ('__NV_PRIME_RENDER_OFFLOAD', '__NV_PRIME_RENDER_OFFLOAD_PROVIDER', '__GLX_VENDOR_LIBRARY_NAME',
            '__VK_LAYER_NV_optimus', '__EGL_VENDOR_LIBRARY_FILENAMES', 'DRI_PRIME')
SYSTEMD_RUN = '/usr/bin/systemd-run'
SYSTEMCTL = '/usr/bin/systemctl'
# The desktop mod sets this Wayland app_id (and X11 class) on its own window.
DESKTOP_APP_IDS = frozenset({'aresos-desktop'})
BASE_CAPABILITIES = frozenset({'list_apps', 'open_app', 'app_state', 'world_ready', 'heartbeat'})
DETAIL_CAPABILITIES = frozenset({'app_details', 'apps_changed', 'list_paging'})
CATALOGUE_CHECK = 3.0
# One discovery scan's bounds (security review 1, FIX 1). The laptop's five folders hold about 250 entries and
# 1.6 MB, read in well under a second; a scan over any bound changes nothing and is logged once.
SCAN_ENTRIES = 4096
SCAN_FOLDERS = 256
SCAN_DEPTH = 8
SCAN_BYTES = 32 * 1024 * 1024
SCAN_SECONDS = 2.0
# Opening an app checks its program off the serving loop (review 2, FIX 1). The loop waits CHECK_WAIT for the
# check (a local file answers in microseconds), then answers when it does, or fails the launch as unavailable once
# CHECK_SECONDS have passed. A check stuck in a dead mount keeps its thread, so at most MAX_CHECKS are outstanding.
CHECK_WAIT = 0.2
CHECK_SECONDS = 3.0
MAX_CHECKS = 4
WINDOW_CAPABILITIES = frozenset({'shell_focus', 'windows'})
# The launch secrets stay with the desktop; launched apps never inherit them,
# nor the helper's own service plumbing.
PRIVATE_ENVIRONMENT = ('ARESOS_LAUNCH_NONCE', 'ARESOS_DESKTOP_INSTANCE', 'ARESOS_SHELL_STATUS_FD',
                       'ARESOS_SHELL_KEEP_FOREGROUND', 'NOTIFY_SOCKET', 'LISTEN_FDS', 'LISTEN_PID', 'LISTEN_FDNAMES',
                       'WATCHDOG_PID', 'WATCHDOG_USEC')

ENVELOPE = re.compile(r'aresos-shell/(\d{1,3})\.(\d{1,3})\Z')
REQUEST_ID = re.compile(r'[A-Za-z0-9._:-]{1,128}\Z')
APP_ID = re.compile(r'[a-z0-9_-]{1,64}\Z')
WINDOW_ID = re.compile(r'[A-Za-z0-9._-]{1,128}\Z')
DESKTOP_FILE = re.compile(r'[A-Za-z0-9._-]{1,128}\.desktop\Z')
INSTANCE = re.compile(r'[A-Za-z0-9._-]{1,64}\Z')
NONCE = re.compile(r'[A-Za-z0-9_-]{16,128}\Z')
CAPABILITY = re.compile(r'[a-z_]{1,32}\Z')
WORLD_ID = re.compile(r'[^\x00-\x1f]{1,128}\Z')

FINAL = frozenset({'failed', 'closed'})


def protocol(minor=MINOR):
    return f'{NAME}/{MAJOR}.{minor}'


# This file, run again as the SVG pre-check's own process (review 2, FIX 2). Taken from the code itself: a module
# that a test loads has no __file__.
HELPER_FILE = os.path.abspath(protocol.__code__.co_filename)


class StatusPipe:
    """One-way readiness lines to the desktop supervisor (package 23).

    Each line is far below PIPE_BUF, so it arrives whole. A full pipe drops the line (the next heartbeat repeats
    the state); a closed pipe switches reporting off. Neither may ever stop the helper.
    """

    def __init__(self, fd):
        self.fd = fd
        os.set_blocking(fd, False)

    def __call__(self, **fields):
        if self.fd is None:
            return
        try:
            os.write(self.fd, (json.dumps(fields, sort_keys=True) + '\n').encode('utf-8'))
        except BlockingIOError:
            pass
        except OSError:
            self.fd = None


def no_status(**fields):
    pass


class Failure(Exception):
    """A request the helper refuses with a stable error code."""

    def __init__(self, code, message, close=False, **fields):
        super().__init__(message)
        self.code = code
        self.message = message
        self.close = close
        self.fields = fields


# ---------------------------------------------------------------- registry

@dataclasses.dataclass(frozen=True)
class App:
    """A reviewed or discovered launch definition, kept entirely inside the helper."""
    id: str
    name: str
    argv: tuple = ()
    desktop_entry: str = None
    working_directory: str = '~'
    app_ids: frozenset | tuple = frozenset()
    instance: str | None = 'multi'
    invalid: str = None
    replaces: tuple = ()
    gpu: str = None
    discovered: bool = False
    terminal: bool = False
    icon_name: str = ''
    icon: str = None
    source: str = None
    categories: tuple = ()
    generic_name: str = None
    keywords: tuple = ()
    desktop_id: str = None
    exec_name: str = None
    app_id_prefixes: tuple = ()
    # Why it cannot start now (None: it can), worked out when its catalogue was built (review 2, FIX 1).
    unavailable: str = None
    # The exact window identities a reviewed hint gave it: they rank above discovered candidates (review 2, finding 3).
    hint_ids: tuple = ()
    # (name, value) pairs a reviewed hint adds to its start (30b); never sent on the socket.
    environment: tuple = ()


ENTRY_KEYS = {'schema', 'id', 'name', 'argv', 'desktop_entry', 'working_directory', 'window', 'replaces', 'gpu'}
WINDOW_KEYS = {'app_ids', 'instance'}


def parse_entry(data):
    """Validate one registry file strictly: entries are reviewed, so typos must not pass."""
    if not isinstance(data, dict):
        raise ValueError('entry is not an object')
    unknown = set(data) - ENTRY_KEYS
    if unknown:
        raise ValueError('unknown keys: ' + ', '.join(sorted(unknown)))
    if data.get('schema') != 1:
        raise ValueError('schema must be 1')
    app_id, name = data.get('id'), data.get('name')
    if not isinstance(app_id, str) or not APP_ID.match(app_id):
        raise ValueError('id must match [a-z0-9_-]{1,64}')
    if not isinstance(name, str) or not name.strip() or len(name) > 64 or any(ord(c) < 32 for c in name):
        raise ValueError('name must be 1-64 printable characters')
    argv, entry = data.get('argv'), data.get('desktop_entry')
    if (argv is None) == (entry is None):
        raise ValueError('exactly one of argv or desktop_entry is required')
    if argv is not None:
        if (not isinstance(argv, list) or not argv or len(argv) > 64
                or not all(isinstance(part, str) and part and '\0' not in part for part in argv)):
            raise ValueError('argv must be a non-empty list of strings')
        if not posixpath.isabs(argv[0]):
            raise ValueError('argv[0] must be an absolute path')
    if entry is not None and (not isinstance(entry, str) or not DESKTOP_FILE.match(entry)):
        raise ValueError('desktop_entry must be a desktop file ID')
    directory = data.get('working_directory', '~')
    if not isinstance(directory, str) or not (directory == '~' or os.path.isabs(directory)) or '\0' in directory:
        raise ValueError('working_directory must be ~ or an absolute path')
    window = data.get('window')
    if not isinstance(window, dict) or set(window) - WINDOW_KEYS:
        raise ValueError('window must be an object with app_ids and instance')
    app_ids, instance = window.get('app_ids'), window.get('instance')
    if (not isinstance(app_ids, list) or not app_ids or len(app_ids) > 8
            or not all(isinstance(value, str) and WINDOW_ID.match(value) for value in app_ids)):
        raise ValueError('window.app_ids must list 1-8 Wayland app IDs')
    if DESKTOP_APP_IDS & set(app_ids):
        raise ValueError('window.app_ids must not claim the desktop window')
    if instance not in ('single', 'multi'):
        raise ValueError('window.instance must be single or multi')
    replaces = data.get('replaces', [])
    if (not isinstance(replaces, list) or len(replaces) > MAX_LIST
            or not all(isinstance(value, str) and DESKTOP_FILE.match(value) for value in replaces)):
        raise ValueError('replaces must list desktop file IDs')
    gpu = data.get('gpu')
    if 'gpu' in data and gpu != 'discrete':
        raise ValueError('gpu must be discrete')
    return App(app_id, name, tuple(argv or ()), entry, directory, frozenset(app_ids), instance,
               replaces=tuple(replaces), gpu=gpu)


def load_registry(directory):
    """Return (apps by ID, revision). Broken entries stay visible as unavailable."""
    apps, owners = {}, {}
    digest = hashlib.sha256()
    paths = sorted(glob.glob(os.path.join(glob.escape(directory), '*.json')))
    if len(paths) > MAX_APPS:
        LOG.warning('registry cut at MAX_APPS=%d', MAX_APPS)
    for path in paths[:MAX_APPS]:
        digest.update(os.path.basename(path).encode() + b'\0')
        try:
            with open(path, 'rb') as handle:
                raw = handle.read(MAX_MESSAGE + 1)
            digest.update(raw + b'\0')
            if len(raw) > MAX_MESSAGE:
                raise ValueError('entry is too large')
            data = json.loads(raw.decode('utf-8'), parse_constant=_reject_constant)
        except (OSError, ValueError, RecursionError) as error:
            LOG.error('registry entry %s is unreadable: %s', path, error)
            continue
        try:
            app = parse_entry(data)
        except ValueError as error:
            LOG.error('registry entry %s is invalid: %s', path, error)
            app_id, name = (data.get('id'), data.get('name')) if isinstance(data, dict) else (None, None)
            if isinstance(app_id, str) and APP_ID.match(app_id):
                app = App(app_id, name if isinstance(name, str) and name.strip() and len(name) <= 64 else app_id,
                          invalid='invalid_entry')
            else:
                continue
        if app.id in apps:
            LOG.error('registry ID %s is defined twice; both copies are unavailable', app.id)
            app = dataclasses.replace(apps[app.id], invalid='duplicate_entry')
        apps[app.id] = app
        for window_id in app.app_ids:
            owners.setdefault(window_id, set()).add(app.id)
    # One window identity must lead to exactly one app, or focus return would guess.
    for window_id, ids in owners.items():
        if len(ids) > 1:
            LOG.error('window app_id %s is claimed by %s; those entries are unavailable', window_id, sorted(ids))
            for app_id in ids:
                apps[app_id] = dataclasses.replace(apps[app_id], invalid='duplicate_window_identity')
    return apps, digest.hexdigest()[:16]


def _reject_constant(value):
    raise ValueError('invalid JSON constant ' + value)


# ---------------------------------------------------------------- window hints

@dataclasses.dataclass(frozen=True)
class Hint:
    """Reviewed facts about one discovered program: extra window identities (review 1, finding 1) and how it must be
    started (30b): the NVIDIA card, and environment values as (name, value) pairs."""
    desktop_id: str
    app_ids: tuple = ()
    app_id_prefixes: tuple = ()
    gpu: str = None
    environment: tuple = ()


HINTS = 'hints'
HINT_KEYS = {'schema', 'desktop_id', 'app_ids', 'app_id_prefixes', 'gpu', 'environment'}
# A prefix is deliberate: 4 to 64 characters that end at a separator, so `steam_app_` but never `s` or `steam`.
HINT_PREFIX = re.compile(r'[A-Za-z0-9._-]{3,63}[._-]\Z')
# The only names a hint may set at a program's start (30b): exact names, because a namespace is not narrow. Among
# the SDL_ names are ones that load a library or write a file (SDL_OPENGL_LIBRARY, SDL_AUDIO_DISK_OUTPUT_FILE). A new
# name is a reviewed change to this line: what the variable makes a program do, and every file a value could name.
HINT_ENVIRONMENT_NAMES = frozenset({'SDL_VIDEO_DRIVER'})
# 1 to 128 printable ASCII characters, passed as they are (never expanded).
HINT_ENVIRONMENT_VALUE = re.compile(r'[ -~]{1,128}\Z')


def parse_hint(data):
    """Validate one hint file as strictly as a registry entry: it decides which program a window belongs to and
    how that program starts."""
    if not isinstance(data, dict):
        raise ValueError('hint is not an object')
    unknown = set(data) - HINT_KEYS
    if unknown:
        raise ValueError('unknown keys: ' + ', '.join(sorted(unknown)))
    if data.get('schema') != 1:
        raise ValueError('schema must be 1')
    desktop_id = data.get('desktop_id')
    if not isinstance(desktop_id, str) or not DESKTOP_FILE.match(desktop_id):
        raise ValueError('desktop_id must be a desktop file ID')
    app_ids, prefixes = data.get('app_ids', []), data.get('app_id_prefixes', [])
    if (not isinstance(app_ids, list) or len(app_ids) > 8 or len(set(map(str, app_ids))) != len(app_ids)
            or not all(isinstance(value, str) and WINDOW_ID.match(value) for value in app_ids)):
        raise ValueError('app_ids must list at most 8 different Wayland app IDs')
    if (not isinstance(prefixes, list) or len(prefixes) > 8 or len(set(map(str, prefixes))) != len(prefixes)
            or not all(isinstance(value, str) and HINT_PREFIX.match(value) for value in prefixes)):
        raise ValueError('app_id_prefixes must list at most 8 different prefixes of 4-64 characters ending in . _ or -')
    # The same meaning as a registry entry's gpu: ask for the NVIDIA card where there is one.
    gpu = data.get('gpu')
    if 'gpu' in data and gpu != 'discrete':
        raise ValueError('gpu must be discrete')
    environment = data.get('environment', {})
    if not isinstance(environment, dict):
        raise ValueError('environment must be an object')
    for name, value in environment.items():
        if name not in HINT_ENVIRONMENT_NAMES:
            raise ValueError(f'environment name {name!r} is not allowed')
        if not isinstance(value, str) or not HINT_ENVIRONMENT_VALUE.match(value):
            raise ValueError(f'environment value of {name} must be 1-128 printable ASCII characters')
    if not app_ids and not prefixes and gpu is None and not environment:
        raise ValueError('a hint must name at least one window identity, gpu or environment')
    if DESKTOP_APP_IDS & set(app_ids) or any(desktop.startswith(prefix) for desktop in DESKTOP_APP_IDS
                                             for prefix in prefixes):
        raise ValueError('a hint must not claim the desktop window')
    return Hint(desktop_id, tuple(app_ids), tuple(prefixes), gpu, tuple(environment.items()))


def _unique_keys(pairs):
    """A key given twice would let a reviewer read one value while the helper used the other (30b)."""
    data = dict(pairs)
    if len(data) != len(pairs):
        raise ValueError('a key is given twice')
    return data


def _hints_clash(one, two):
    prefixes = [(a, b) for a in one.app_id_prefixes for b in two.app_id_prefixes]
    return bool(set(one.app_ids) & set(two.app_ids)
                or any(a.startswith(b) or b.startswith(a) for a, b in prefixes)
                or any(value.startswith(prefix) for value in one.app_ids for prefix in two.app_id_prefixes)
                or any(value.startswith(prefix) for value in two.app_ids for prefix in one.app_id_prefixes))


def load_hints(folder):
    """Hints by desktop file ID. A broken hint is skipped; hints that name the same program or could claim the same
    window are all refused, since one window identity must lead to exactly one program."""
    found = {}
    for path in sorted(glob.glob(os.path.join(glob.escape(folder), '*.json')))[:MAX_APPS]:
        try:
            with open(path, 'rb') as handle:
                raw = handle.read(MAX_MESSAGE + 1)
            if len(raw) > MAX_MESSAGE:
                raise ValueError('hint is too large')
            hint = parse_hint(json.loads(raw.decode('utf-8'), parse_constant=_reject_constant,
                                         object_pairs_hook=_unique_keys))
        except (OSError, ValueError, RecursionError) as error:
            LOG.error('window hint %s is invalid: %s', path, error)
            continue
        found.setdefault(hint.desktop_id, []).append(hint)
    hints = {}
    for desktop_id, candidates in found.items():
        if len(candidates) > 1:
            LOG.error('window hints for %s are defined twice; both are refused', desktop_id)
        else:
            hints[desktop_id] = candidates[0]
    clashing = {hint.desktop_id for hint in hints.values() for other in hints.values()
                if other is not hint and _hints_clash(hint, other)}
    for desktop_id in sorted(clashing):
        LOG.error('window hints for %s could claim another hinted program\'s windows; refused', desktop_id)
        del hints[desktop_id]
    return hints


def resolve(app, executable=None, entry_dirs=DESKTOP_ENTRY_DIRS):
    """Return (argv, working directory, None) or (None, None, reason). Checked at each use."""
    executable = executable or (lambda path: os.path.isfile(path) and os.access(path, os.X_OK))
    if app.invalid:
        return None, None, app.invalid
    if app.discovered:
        # Discovery resolved the first word once. Never search PATH again at launch time.
        if not app.argv or not executable(app.argv[0]):
            return None, None, 'not_installed'
        argv = list(app.argv)
        if app.terminal:
            terminal = [part.format(app_id=terminal_app_id(app)) for part in TERMINAL_COMMAND]
            if not executable(terminal[0]):
                return None, None, 'not_installed'
            argv = terminal + argv
        return argv, app.working_directory, None
    if app.desktop_entry:
        path = next((os.path.join(folder, app.desktop_entry) for folder in entry_dirs
                     if os.path.isfile(os.path.join(folder, app.desktop_entry))), None)
        if path is None:
            return None, None, 'not_installed'
        try:
            argv, directory = desktop_exec(path)
        except (OSError, ValueError) as error:
            LOG.error('desktop entry %s cannot be used: %s', path, error)
            return None, None, 'invalid_entry'
        if not posixpath.isabs(argv[0]):
            found = shutil.which(argv[0], path=EXEC_PATH)
            if found is None:
                return None, None, 'not_installed'
            argv[0] = found
        return argv, directory or app.working_directory, None if executable(argv[0]) else 'not_installed'
    return list(app.argv), app.working_directory, None if executable(app.argv[0]) else 'not_installed'


def with_availability(apps, executable=None, budget=None):
    """Each program with whether it can start, worked out where the catalogue is built: on the discovery worker,
    never on the serving loop. list_apps serves these values and touches no file (review 2, FIX 1)."""
    result = {}
    for key, app in apps.items():
        if budget is not None:
            budget.time()
        result[key] = dataclasses.replace(app, unavailable=resolve(app, executable)[2])
    return result


def launch_check(app, executable, working_directory):
    """What opening an app needs from the filesystem. Runs on a LaunchChecks thread (review 2, FIX 1)."""
    argv, directory, reason = resolve(app, executable)
    if reason is None:
        # Popen's child changes into this folder while the helper waits for it to start systemd-run, so a folder on
        # a dead mount must stall this thread first, not the serving loop.
        try:
            os.stat(working_directory(directory))
        except OSError:
            pass  # a missing folder still fails the start itself, as before
    return argv, directory, reason


EXEC_RESERVED = set('\t\n\'><~|&;$*?#()`\\')
STRING_ESCAPES = {'s': ' ', 'n': '\n', 't': '\t', 'r': '\r', '\\': '\\'}


def desktop_exec(path):
    """Split a desktop entry's Exec key per the Desktop Entry spec, without files or URLs."""
    group, values = None, {}
    with open(path, encoding='utf-8') as handle:
        for line in handle.read(MAX_MESSAGE).splitlines():
            line = line.strip()
            if not line or line.startswith('#'):
                continue
            if line.startswith('['):
                group = line
                continue
            if group == '[Desktop Entry]' and '=' in line:
                key, value = line.split('=', 1)
                values.setdefault(key.strip(), value.strip())
    if values.get('Type') != 'Application' or not values.get('Exec'):
        raise ValueError('not an application entry with Exec')
    argv = _desktop_argv(values, path)
    directory = values.get('Path') or None
    if directory is not None and not posixpath.isabs(directory):
        raise ValueError('Path must be absolute')
    return argv, directory


# flatpak run's options that take no value (flatpak 1.16, `flatpak run --help`). Any other option must carry its value
# after '=': a value in the next word would make the app ID a guess.
FLATPAK_FLAGS = frozenset({'-u', '--user', '--system', '-d', '--devel', '--log-session-bus', '--log-system-bus',
                           '--log-a11y-bus', '--no-a11y-bus', '--a11y-bus', '--no-session-bus', '--session-bus',
                           '--no-documents-portal', '--file-forwarding', '--sandbox', '-p', '--die-with-parent',
                           '--parent-expose-pids', '--parent-share-pids', '--clear-env', '-v', '--verbose',
                           '--ostree-verbose'})
# A Flatpak application ID: three or more dot-separated parts, none starting with a digit.
FLATPAK_APP = re.compile(r'(?=.{1,255}\Z)[A-Za-z_][A-Za-z0-9_-]*(?:\.[A-Za-z_][A-Za-z0-9_-]*){2,}\Z')


def flatpak_run(words):
    """For a `flatpak run [options] APP ...` command: (its app ID or None, whether it forwards files). Else None.

    The app ID is the first word after the options, and only when every option before it is understood; otherwise
    it is left unknown rather than invented (review 1, finding 7). File forwarding counts only before the app ID.
    """
    if len(words) < 2 or posixpath.basename(words[0]) != 'flatpak' or words[1] != 'run':
        return None
    forwarding = False
    for word in words[2:]:
        if not word.startswith('-'):
            return (word if FLATPAK_APP.match(word) else None), forwarding
        if word == '--file-forwarding':
            forwarding = True
        elif not (word.startswith('--') and '=' in word) and word not in FLATPAK_FLAGS:
            return None, False
    return None, False


def _desktop_argv(values, path, flatpak=False):
    """The existing Exec grammar, shared by reviewed and discovered entries.

    With flatpak (discovered entries), Flatpak's file-forwarding markers are removed, but only from a recognised
    `flatpak run ... --file-forwarding` command; anywhere else `@@` is an ordinary argument (review 1, finding 6).
    """
    exec_value = _unescape_string(values['Exec'])
    args, current, quoted, escaped, started = [], [], False, False, False
    for char in exec_value:
        if quoted:
            if escaped:
                if char not in '"`$\\':
                    raise ValueError('invalid escape in quoted Exec argument')
                current.append(char)
                escaped = False
            elif char == '\\':
                escaped = True
            elif char == '"':
                quoted = False
            else:
                current.append(char)
        elif char == '"':
            quoted = started = True
        elif char == ' ':
            if started:
                args.append(''.join(current))
                current, started = [], False
        elif char in EXEC_RESERVED:
            raise ValueError('unquoted reserved character in Exec')
        else:
            current.append(char)
            started = True
    if quoted:
        raise ValueError('unterminated quote in Exec')
    if started:
        args.append(''.join(current))
    if flatpak and (flatpak_run(args) or (None, False))[1]:
        clean, index = [], 0
        while index < len(args):
            arg = args[index]
            if arg in ('@@', '@@u'):
                codes = ('%u', '%U') if arg == '@@u' else ('%f', '%F')
                if index + 2 >= len(args) or args[index + 1] not in codes or args[index + 2] != '@@':
                    raise ValueError('invalid Flatpak forwarding markers')
                index += 3
            else:
                clean.append(arg)
                index += 1
        args = clean
    argv = []
    for arg in args:
        if arg in ('%f', '%F', '%u', '%U', '%d', '%D', '%n', '%N', '%v', '%m'):
            continue
        if arg == '%i':
            if values.get('Icon'):
                argv += ['--icon', values['Icon']]
            continue
        if arg == '%c':
            argv.append(values.get('Name', ''))
            continue
        if arg == '%k':
            argv.append(path)
            continue
        if re.search(r'%[^%]', arg.replace('%%', '')):
            raise ValueError('unsupported field code in Exec')
        argv.append(arg.replace('%%', '%'))
    if not argv:
        raise ValueError('empty Exec')
    return argv


def _unescape_string(value):
    result, index = [], 0
    while index < len(value):
        char = value[index]
        if char == '\\' and index + 1 < len(value) and value[index + 1] in STRING_ESCAPES:
            result.append(STRING_ESCAPES[value[index + 1]])
            index += 2
            continue
        result.append(char)
        index += 1
    return ''.join(result)


# ---------------------------------------------------------------- desktop discovery

def desktop_directories(environ=None):
    environ = os.environ if environ is None else environ
    home = environ.get('HOME') or os.path.expanduser('~')
    data_home = environ.get('XDG_DATA_HOME')
    if not data_home or not os.path.isabs(data_home):
        data_home = os.path.join(home, '.local/share')
    return (os.path.join(data_home, 'applications'),
            os.path.join(home, '.local/share/flatpak/exports/share/applications'),
            '/var/lib/flatpak/exports/share/applications',
            '/usr/local/share/applications', '/usr/share/applications')


def flatpak_deployments(environ=None):
    """Where Flatpak deploys apps. Its exported desktop files and icons are links into these folders."""
    environ = os.environ if environ is None else environ
    home = environ.get('HOME') or os.path.expanduser('~')
    return (os.path.join(home, '.local/share/flatpak/app'), '/var/lib/flatpak/app')


class ScanLimit(Exception):
    """A discovery scan looked at more than its budget allows; the last good catalogue stays in force."""


class ScanBudget:
    """One scan's bounds. Every folder entry looked at counts, accepted or not, and so does every byte read."""

    def __init__(self, clock=time.monotonic):
        self.clock = clock
        self.deadline = clock() + SCAN_SECONDS
        self.entries = self.folders = self.bytes = 0

    def entry(self):
        self.entries += 1
        if self.entries > SCAN_ENTRIES:
            raise ScanLimit(f'more than {SCAN_ENTRIES} folder entries')
        self.time()

    def time(self):
        if self.clock() > self.deadline:
            raise ScanLimit(f'longer than {SCAN_SECONDS:g} seconds')

    def folder(self, depth):
        self.folders += 1
        if self.folders > SCAN_FOLDERS or depth > SCAN_DEPTH:
            raise ScanLimit(f'more than {SCAN_FOLDERS} folders or nesting deeper than {SCAN_DEPTH}')

    def read(self, size):
        self.bytes += size
        if self.bytes > SCAN_BYTES:
            raise ScanLimit(f'more than {SCAN_BYTES} bytes of desktop entries')


def within(path, roots):
    return any(path == root or path.startswith(root.rstrip('/') + '/') for root in roots)


def open_confined(path, roots, directory=False):
    """A readable descriptor for path, opened only after what path resolves to was found inside roots.

    The O_PATH descriptor pins the resolved file without reading it (or opening a device or FIFO); the readable
    descriptor is reopened through that pin, so the file read is the file checked even if a link changes meanwhile.
    roots are real paths.
    """
    pinned = os.open(path, os.O_PATH | os.O_CLOEXEC | (os.O_DIRECTORY if directory else 0))
    try:
        if not within(os.readlink(f'/proc/self/fd/{pinned}'), roots):
            raise ValueError('resolves outside its folders')
        if not directory and not stat.S_ISREG(os.fstat(pinned).st_mode):
            raise ValueError('not a regular file')
        return os.open(f'/proc/self/fd/{pinned}', os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC
                       | (os.O_DIRECTORY if directory else 0))
    finally:
        os.close(pinned)


def confined_listing(path, roots, limit):
    """{name: is a real folder} for each entry of a folder whose real location was checked before listing.

    A folder of more than limit entries raises ScanLimit as soon as it shows one too many, so a huge folder is never
    held in memory.
    """
    descriptor = open_confined(path, roots, directory=True)
    try:
        listing = {}
        with os.scandir(descriptor) as entries:
            for entry in entries:
                if len(listing) >= limit:
                    raise ScanLimit(f'more than {limit} folder entries')
                listing[entry.name] = entry.is_dir(follow_symlinks=False)
        return listing
    finally:
        os.close(descriptor)


def walk_folder(folder, budget):
    """(relative path, is a folder) for everything under folder, in os.walk's sorted top-down order.

    A linked subfolder is never entered: each one is opened relative to its parent with O_NOFOLLOW. Every entry
    looked at counts against the scan budget before it is kept, so a huge folder cannot exhaust the helper.
    """
    try:
        descriptor = os.open(folder, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    except OSError:
        return
    yield from _walk(descriptor, '', 0, budget)


def _walk(descriptor, prefix, depth, budget):
    try:
        budget.folder(depth)
        names = []
        with os.scandir(descriptor) as entries:
            for entry in entries:
                budget.entry()
                try:
                    # Like os.walk, a link to a folder counts as a folder; O_NOFOLLOW below keeps it unentered.
                    names.append((entry.name, entry.is_dir()))
                except OSError:
                    continue
        names.sort()
        for name, folder in names:
            if not folder:
                yield prefix + name, False
        for name, folder in names:
            if not folder:
                continue
            yield prefix + name, True
            try:
                child = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=descriptor)
            except OSError:
                continue
            yield from _walk(child, prefix + name + '/', depth + 1, budget)
    finally:
        os.close(descriptor)


def desktop_files(directories, budget=None, visited=None):
    """Yield the first file for each desktop ID, including hidden or broken overrides.

    Nested paths form IDs by replacing / with -. Sort within each folder so sanitisation collisions are stable.
    Directory symlinks are not traversed; desktop-file links are checked when they are read. visited, if given,
    collects every folder and desktop file seen (the change signature).
    """
    budget = budget or ScanBudget()
    seen = set()
    for folder in directories:
        for relative, is_folder in walk_folder(folder, budget):
            if not is_folder and not relative.endswith('.desktop'):
                continue
            path = os.path.join(folder, relative)
            if visited is not None:
                visited.add(path)
            if is_folder:
                continue
            desktop_id = relative.replace('/', '-')
            if desktop_id not in seen:
                seen.add(desktop_id)
                yield desktop_id, path


def read_desktop_entry(path, budget=None, roots=None):
    """Bounded untrusted text, with no interpolation, includes or action-group parsing.

    With roots, the file must resolve inside them (a link out is refused before anything is read).
    """
    if roots is None:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)
    else:
        fd = open_confined(path, roots)
    with os.fdopen(fd, 'rb') as handle:
        info = os.fstat(handle.fileno())
        if not stat.S_ISREG(info.st_mode):
            raise ValueError('not a regular desktop file')
        if info.st_size > MAX_DESKTOP_ENTRY:
            raise ValueError('desktop file exceeds 1 MiB')
        if budget is not None:
            budget.read(info.st_size)
        raw = handle.read(MAX_DESKTOP_ENTRY)
        if budget is not None and len(raw) > info.st_size:
            budget.read(len(raw) - info.st_size)
        if os.fstat(handle.fileno()).st_size > MAX_DESKTOP_ENTRY:
            raise ValueError('desktop file exceeds 1 MiB')
    if b'\0' in raw:
        raise ValueError('NUL in desktop file')
    group, found, values = None, False, {}
    for line in raw.decode('utf-8', 'replace').splitlines():
        line = line.strip()
        if not line or line.startswith('#'):
            continue
        if line.startswith('['):
            if not line.endswith(']'):
                raise ValueError('invalid group header')
            group = line
            if group == '[Desktop Entry]':
                if found:
                    raise ValueError('duplicate Desktop Entry group')
                found = True
            continue
        if group != '[Desktop Entry]':
            continue
        if '=' not in line:
            raise ValueError('invalid Desktop Entry line')
        key, value = line.split('=', 1)
        key = key.strip()
        if not re.fullmatch(r'[A-Za-z0-9-]+(?:\[[^\[\]\x00-\x1f]+\])?', key) or key in values:
            raise ValueError('invalid or duplicate desktop key')
        values[key] = value.strip()
    if not found:
        raise ValueError('missing Desktop Entry group')
    return values


def desktop_bool(values, key):
    value = values.get(key, 'false')
    if value not in ('true', 'false'):
        raise ValueError('invalid boolean ' + key)
    return value == 'true'


def executable_file(path):
    return os.path.isfile(path) and os.access(path, os.X_OK)


def find_executable(word, executable):
    if not word or '\0' in word or '=' in word:
        return None
    if os.path.isabs(word):
        return word if executable(word) else None
    if '/' in word:
        return None
    return next((path for folder in EXEC_PATH.split(':')
                 if executable(path := os.path.join(folder, word))), None)


def terminal_app_id(app):
    return 'aresos.app.' + app.id


def detail_text(value, limit):
    return ''.join(c for c in _unescape_string(value).strip() if c.isprintable())[:limit]


def desktop_details(desktop_id, values):
    categories = tuple(dict.fromkeys(word for word in values.get('Categories', '').split(';')
                                     if re.fullmatch(r'[A-Za-z0-9-]{1,32}', word)))[:16]
    keywords = tuple(dict.fromkeys(word for value in re.split(r'(?<!\\);', values.get('Keywords', ''))
                                   if (word := detail_text(value.replace(r'\;', ';'), 32))))[:16]
    return dict(icon_name=_unescape_string(values.get('Icon', '')), categories=categories,
                generic_name=detail_text(values.get('GenericName', ''), 64) or None,
                keywords=keywords, desktop_id=desktop_id if len(desktop_id) <= 128 and desktop_id.isprintable() else None)


def discovered_app(desktop_id, path, values, executable):
    if (desktop_bool(values, 'Hidden') or desktop_bool(values, 'NoDisplay')
            or values.get('Type') != 'Application'):
        return None
    # This catalogue belongs to AresOS even when inspected from another desktop or a headless test.
    if ('OnlyShowIn' in values and 'AresOS' not in values['OnlyShowIn'].split(';')
            or 'AresOS' in values.get('NotShowIn', '').split(';')):
        return None
    if 'TryExec' in values and not find_executable(_unescape_string(values['TryExec']), executable):
        return None
    if not values.get('Exec'):
        return None
    argv = _desktop_argv(values, path, flatpak=True)
    program = find_executable(argv[0], executable)
    if program is None:
        return None
    argv[0] = program
    name = ''.join(c for c in _unescape_string(values.get('Name', '')).strip() if c.isprintable())[:64]
    if not name:
        raise ValueError('missing printable Name')
    app_id = re.sub('[^a-z0-9_-]', '-', desktop_id[:-len('.desktop')].lower())[:64]
    if not app_id:
        raise ValueError('empty app ID')
    directory = _unescape_string(values.get('Path', ''))
    if '\0' in directory:
        raise ValueError('NUL in Path')
    terminal = desktop_bool(values, 'Terminal')
    if terminal and not executable(TERMINAL_COMMAND[0]):
        return None
    discrete = (desktop_bool(values, 'PrefersNonDefaultGPU') or desktop_bool(values, 'X-KDE-RunOnDiscreteGpu')
                or 'Game' in values.get('Categories', '').split(';'))
    # A Flatpak's program is its app ID: from X-Flatpak, else from its own `flatpak run` command, else unknown. The
    # launcher's file name (flatpak) and the desktop file's name are never taken for it (review 1, finding 7).
    flatpak_id = _unescape_string(values.get('X-Flatpak', ''))
    run = flatpak_run(argv)
    if run is not None:
        flatpak_id = flatpak_id or run[0] or ''
    program_name = flatpak_id if run is not None else (flatpak_id or os.path.basename(program))
    identities = [_unescape_string(values.get('StartupWMClass', '')), desktop_id[:-len('.desktop')], flatpak_id,
                  *(() if run is not None else (os.path.basename(program),))]
    # The terminal wrapper supplies the identity, rather than the command running inside it.
    if terminal:
        identities = [terminal_app_id(App(app_id, name))]
    identities = tuple(dict.fromkeys(value for value in identities if WINDOW_ID.fullmatch(value)))
    exec_name = detail_text(program_name, 128)
    return App(app_id, name, tuple(argv), desktop_entry=desktop_id,
               working_directory=directory if os.path.isabs(directory) else '~',
               app_ids=identities, instance=None, discovered=True, terminal=terminal,
               gpu='discrete' if discrete else None,
               exec_name=exec_name if exec_name and '/' not in exec_name else None,
               **desktop_details(desktop_id, values))


def prefixed(identity, prefixes):
    """True when a reviewed prefix claims identity: it must be longer than the prefix (steam_app_ itself is no game)."""
    return any(identity.startswith(prefix) and len(identity) > len(prefix) for prefix in prefixes)


def apply_hints(apps, hints):
    """Reviewed hints give an installed discovered program more window identities (review 1, finding 1) and its start
    settings (30b).

    They beat discovered candidates, exact identities and prefixes alike (review 2, finding 3): another discovered
    program loses each identity a hint names or a hint's prefix covers. They never take a registry entry's identity
    (valid or not) or the desktop's. A hint's gpu adds to the entry's own wish and never takes it away; its
    environment goes to that program's start alone. A hint for a program that is not installed, or that a registry
    entry replaces, changes nothing.
    """
    apps = dict(apps)
    reviewed = {identity for app in apps.values() if not app.discovered for identity in app.app_ids} | DESKTOP_APP_IDS
    for key in sorted(apps):
        hint = hints.get(apps[key].desktop_entry) if apps[key].discovered else None
        if hint is None:
            continue
        extra = tuple(identity for identity in hint.app_ids if identity not in reviewed)

        def claimed(identity):
            return identity in extra or prefixed(identity, hint.app_id_prefixes)

        for other_key, other in list(apps.items()):
            if other.discovered and other_key != key and any(map(claimed, other.app_ids)):
                apps[other_key] = dataclasses.replace(
                    other, app_ids=tuple(identity for identity in other.app_ids if not claimed(identity)))
        apps[key] = dataclasses.replace(apps[key], app_ids=tuple(dict.fromkeys((*apps[key].app_ids, *extra))),
                                        app_id_prefixes=hint.app_id_prefixes, hint_ids=extra,
                                        gpu=hint.gpu or apps[key].gpu, environment=hint.environment)
    return apps


def load_catalogue(registry_dir, environ=None, entry_dirs=None, executable=None, dependencies=None,
                   entries=None, budget=None, deployments=None):
    """Keep reviewed launch policies; desktop replacements contribute presentation only.

    entries are (desktop ID, path) pairs a bounded walk already found; budget bounds the bytes read. A desktop file
    that is a link must resolve inside the application folders or a Flatpak deployment, or it is skipped.
    """
    budget = budget or ScanBudget()
    apps, revision = load_registry(registry_dir)
    apps = {key: dataclasses.replace(app, source='image') for key, app in apps.items()}
    owners = {identity for app in apps.values() for identity in app.app_ids} | DESKTOP_APP_IDS
    executable = executable or executable_file
    replaced = {desktop_id for app in apps.values() for desktop_id in app.replaces}
    replaced.update(app.desktop_entry for app in apps.values() if app.desktop_entry)
    directories = tuple(desktop_directories(environ) if entry_dirs is None else entry_dirs)
    deployments = tuple(flatpak_deployments(environ) if deployments is None else deployments)
    roots = tuple(os.path.realpath(folder) for folder in (*directories, *deployments))
    entries = dict(desktop_files(directories) if entries is None else entries)
    for key, app in list(apps.items()):
        for desktop_id in dict.fromkeys((*app.replaces, *((app.desktop_entry,) if app.desktop_entry else ()))):
            if desktop_id not in entries:
                continue
            budget.time()
            try:
                values = read_desktop_entry(entries[desktop_id], budget, roots)
                if desktop_bool(values, 'Hidden') or values.get('Type') != 'Application':
                    continue
                apps[key] = dataclasses.replace(app, **desktop_details(desktop_id, values))
                break
            except (OSError, ValueError) as error:
                LOG.warning('desktop entry %r skipped: %r', entries[desktop_id], error)
    for desktop_id, path in entries.items():
        if desktop_id in replaced:
            continue
        # The scan's deadline holds while entries are parsed too (review 2, FIX 1).
        budget.time()
        try:
            values = read_desktop_entry(path, budget, roots)
            if dependencies is not None:
                words = [_unescape_string(values.get('TryExec', ''))]
                if values.get('Exec'):
                    words.append(_desktop_argv(values, path, flatpak=True)[0])
                for word in words:
                    if os.path.isabs(word):
                        dependencies.add(word)
                    elif word and '/' not in word:
                        dependencies.update(os.path.join(folder, word) for folder in EXEC_PATH.split(':'))
            app = discovered_app(desktop_id, path, values, executable)
        except (OSError, ValueError) as error:
            LOG.warning('desktop entry %r skipped: %r', path, error)
            continue
        if app is None:
            continue
        if app.id in apps:
            LOG.warning('desktop entry %r loses app ID %s to an earlier or registry entry', path, app.id)
            continue
        if len(apps) >= MAX_APPS:
            LOG.warning('catalogue cut at MAX_APPS=%d', MAX_APPS)
            break
        # Even an unavailable reviewed entry reserves its identities; discovery never disables another app.
        source = next(('user', 'flatpak-user', 'flatpak-system', 'system', 'system')[min(i, 4)]
                      for i, folder in enumerate(directories) if os.path.commonpath((folder, path)) == str(folder))
        app = dataclasses.replace(app, source=source,
                                  app_ids=tuple(identity for identity in app.app_ids if identity not in owners))
        owners.update(app.app_ids)
        apps[app.id] = app
    apps = apply_hints(apps, load_hints(os.path.join(registry_dir, HINTS)))
    # Availability is part of each App, so it is part of the revision too.
    apps = with_availability(apps, executable, budget)
    digest = hashlib.sha256(revision.encode())
    for app in sorted(apps.values(), key=lambda app: app.id):
        digest.update(json.dumps(dataclasses.asdict(app), sort_keys=True,
                                 default=lambda value: sorted(value)).encode('utf-8'))
    return apps, digest.hexdigest()[:16]


def load_legacy(registry_dir, executable=None, budget=None):
    """A 1.0 client's list: the reviewed registry alone, with its own revision and published availability."""
    apps, revision = load_registry(registry_dir)
    return with_availability(apps, executable, budget), revision


class Catalogue:
    """Stat before parsing; even repeated list requests do at most one pass every three seconds.

    Each pass is bounded (ScanBudget). A pass that hits a bound changes nothing: the last good catalogue stays, and
    the bound is logged once until a pass completes again. Production runs passes on Discovery's thread; tests call
    refresh() directly.
    """

    def __init__(self, registry_dir, environ=None, entry_dirs=None, executable=None, deployments=None):
        self.registry_dir = registry_dir
        self.environ = environ
        self.directories = tuple(desktop_directories(environ) if entry_dirs is None else entry_dirs)
        self.deployments = tuple(flatpak_deployments(environ) if deployments is None else deployments)
        self.executable = executable
        self.signature = None
        self.apps = {}
        self.revision = None
        self.legacy = None
        self.checked = float('-inf')
        self.dependencies = set(EXEC_PATH.split(':')) | {TERMINAL_COMMAND[0]}
        self.limited = False

    def refresh(self, now):
        if now - self.checked < CATALOGUE_CHECK:
            return False
        self.checked = now
        return self.scan()

    def scan(self):
        """One bounded pass. True when it installed a changed catalogue."""
        budget = ScanBudget()
        try:
            changed = self._scan(budget)
        except ScanLimit as limit:
            if not self.limited:
                LOG.warning('discovery scan stopped after %s; the last good catalogue stays', limit)
            self.limited = True
            return False
        self.limited = False
        return changed

    def _scan(self, budget):
        paths = set(self.dependencies)
        paths.add(str(self.registry_dir))
        for relative, is_folder in walk_folder(self.registry_dir, budget):
            if is_folder or relative.endswith('.json'):
                paths.add(os.path.join(self.registry_dir, relative))
        paths.update(str(folder) for folder in self.directories)
        entries = list(desktop_files(self.directories, budget, visited=paths))
        # Executable changes can change visibility or availability without changing an entry.
        for app in self.apps.values():
            if app.argv:
                paths.add(app.argv[0])
            if app.terminal:
                paths.add(TERMINAL_COMMAND[0])
        signature, sizes = [], {}
        for path in sorted(paths):
            budget.time()
            try:
                info = os.stat(path)
                signature.append((path, info.st_ino, info.st_size, info.st_mtime_ns, info.st_ctime_ns))
                sizes[path] = info.st_size
            except OSError:
                signature.append((path, None))
        if signature == self.signature:
            return False
        # Refuse before reading when the entries alone are over the byte budget (hard links cost no disk space).
        # Files over 1 MiB are rejected unread, so they cost nothing here.
        planned = sum(size for _, path in entries if (size := sizes.get(path, 0)) <= MAX_DESKTOP_ENTRY)
        if planned > SCAN_BYTES:
            raise ScanLimit(f'more than {SCAN_BYTES} bytes of desktop entries')
        dependencies = set(EXEC_PATH.split(':')) | {TERMINAL_COMMAND[0]}
        apps, revision = load_catalogue(self.registry_dir, self.environ, self.directories, self.executable,
                                        dependencies=dependencies, entries=entries, budget=budget,
                                        deployments=self.deployments)
        legacy = load_legacy(self.registry_dir, self.executable, budget)
        # A pass that ran out of time publishes nothing, however far it got (review 2, FIX 1).
        budget.time()
        self.apps, self.revision, self.legacy = apps, revision, legacy
        self.dependencies = dependencies
        self.signature = signature
        return True

    def stop(self):
        pass


class Discovery:
    """Production discovery: every scan runs on its own thread, never on the serving loop (review 1, FIX 1).

    The loop only takes a finished catalogue and asks for the next scan once one is due. While a scan runs, fails or
    hits a bound, the last good catalogue stays in force, and the helper keeps answering. Before the first scan
    finishes, the last good catalogue is the reviewed registry alone.
    """

    def __init__(self, catalogue):
        self.catalogue = catalogue
        self.apps, self.revision = load_catalogue(catalogue.registry_dir, catalogue.environ, entry_dirs=(),
                                                  executable=catalogue.executable, deployments=())
        self.legacy = load_legacy(catalogue.registry_dir, catalogue.executable)
        self.lock = threading.Lock()
        self.wanted = threading.Event()
        self.scanned = threading.Event()
        self.stopping = threading.Event()
        self.finished = None
        self.started = None
        self.requested = float('-inf')
        self.blocked_logged = False
        self.thread = None

    def start(self, now, wait=SCAN_SECONDS + 1):
        """Start the worker with a first scan, and wait briefly so the first list normally has every program."""
        self.requested = now
        self.wanted.set()
        self.thread = threading.Thread(target=self.loop, name='aresos-discovery', daemon=True)
        self.thread.start()
        self.scanned.wait(wait)
        self.refresh(now)

    def refresh(self, now):
        """Never touches the folders: take a finished scan, and request the next one when it is due."""
        with self.lock:
            finished, self.finished = self.finished, None
            started = self.started
        if finished is not None:
            self.apps, self.revision, self.legacy = finished
        if started is None:
            self.blocked_logged = False
            if now - self.requested >= CATALOGUE_CHECK:
                self.requested = now
                self.wanted.set()
        elif time.monotonic() - started > 2 * SCAN_SECONDS and not self.blocked_logged:
            # A read can block (a stalled mount) where the budget cannot interrupt it; only discovery waits.
            self.blocked_logged = True
            LOG.warning('a discovery scan has been blocked for %.0f seconds; the last good catalogue stays',
                        time.monotonic() - started)
        return finished is not None

    def loop(self):
        while True:
            self.wanted.wait()
            if self.stopping.is_set():
                return
            with self.lock:
                self.wanted.clear()
                self.started = time.monotonic()
            try:
                changed = self.catalogue.scan()
            except Exception:
                LOG.exception('discovery scan failed; the last good catalogue stays')
                changed = False
            with self.lock:
                self.started = None
                if changed:
                    self.finished = (self.catalogue.apps, self.catalogue.revision, self.catalogue.legacy)
            self.scanned.set()

    def stop(self):
        self.stopping.set()
        self.wanted.set()
        if self.thread is not None:
            self.thread.join(SCAN_SECONDS + 1)


# ---------------------------------------------------------------- icons

MAX_ICON_BYTES = 8 * 1024 * 1024
MAX_ICON_OUTPUT = 1024 * 1024
ICON_TIMEOUT = 3.0
ICON_SIDE = 4096  # A hard 16-Mpixel ceiling; ImageMagick's area limit alone only spills to disk.
MAGICK = '/usr/bin/magick'
BWRAP = '/usr/bin/bwrap'
PRLIMIT = '/usr/bin/prlimit'
# The converter's address space (review 1, FIX 2). librsvg and its own picture decoders ignore ImageMagick's
# -limit memory; every icon that converts at all needs under 128 MiB here (measured with 1024-pixel SVG and PNG).
ICON_ADDRESS_SPACE = 256 * 1024 * 1024
# The icon cache's budget (review 1, FIX 3): two generations for every listed program fit; 128x128 pictures are
# at most about 66 KB each.
ICON_CACHE_FILES = 2 * MAX_APPS
ICON_CACHE_BYTES = 32 * 1024 * 1024
ICON_FILE = re.compile(r'[0-9a-f]{64}\.png\Z')
# A theme's index.theme (review fixes 3). The laptop's largest, hicolor's, has 55,507 bytes and 649 folders (337 at
# scale 1); Breeze's has 19,534 bytes and 47 folders.
ICON_INDEX_BYTES = 256 * 1024
ICON_INDEX_FOLDERS = 2048
# Sized folders up to 256 pixels are used first; larger ones, up to this, only when a theme has nothing else.
ICON_LARGEST = 1024
# Folder entries one picture pass may list in all: every icon folder on the laptop, all of them listed, has 20,277.
ICON_LOOKUP_ENTRIES = 131072
PNG_SIGNATURE = b'\x89PNG\r\n\x1a\n'
ICON_LIMITS = ('-limit', 'memory', '64MiB', '-limit', 'map', '0', '-limit', 'disk', '0',
               '-limit', 'time', '2', '-limit', 'thread', '1', '-limit', 'width', str(ICON_SIDE),
               '-limit', 'height', str(ICON_SIDE), '-limit', 'area', '16MP', '-limit', 'list-length', '2')
ICON_POLICY = '''<policymap>
  <policy domain="delegate" rights="none" pattern="*"/>
  <policy domain="filter" rights="none" pattern="*"/>
  <policy domain="coder" rights="none" pattern="*"/>
  <policy domain="coder" rights="read" pattern="SVG"/>
  <policy domain="coder" rights="read|write" pattern="{PNG,PNG32}"/>
  <policy domain="path" rights="none" pattern="@*"/>
</policymap>'''


def icon_directories(environ=None):
    environ = os.environ if environ is None else environ
    home = environ.get('HOME') or os.path.expanduser('~')
    return (os.path.join(home, '.local/share/icons'),
            os.path.join(home, '.local/share/flatpak/exports/share/icons'),
            '/var/lib/flatpak/exports/share/icons', '/usr/local/share/icons',
            '/usr/share/icons', '/usr/share/pixmaps')


def icon_cache_directory(environ=None):
    environ = os.environ if environ is None else environ
    cache = environ.get('XDG_CACHE_HOME', '')
    if not os.path.isabs(cache):
        cache = os.path.join(environ.get('HOME') or os.path.expanduser('~'), '.cache')
    return os.path.join(cache, 'aresos/icons')


def resolve_icon(name, directories, deployments=None):
    """One lookup on its own; a picture pass shares one IconLookup between all its programs."""
    return IconLookup(directories, deployments).resolve(name)


def icon_stat(path, is_folder=False, folder=None, roots=()):
    """What a picture pass's signature keeps of path. Like the catalogue's, it reads nothing.

    Without folder, path was the pass's to read or list: its stat through links, so a Flatpak update that switches its
    active link is seen. Of something refused for its kind (a FIFO, a device, a folder where a file belongs or the other
    way round) only its inode and kind, which change when it is replaced, not while it is used.

    With folder, path resolves outside roots, the real folders allowed to its icon root folder, and was refused
    (review 4, FIX 1): the lstat of each folder and link on the way from folder to the first step out of roots, and
    nothing behind it. Replacing the link is seen; a link onto something that keeps changing (a log, or the helper's
    own picture cache, which a pass changes) never asks for a pass.
    """
    if folder is None:
        try:
            info = os.stat(path)
        except OSError:
            return None
        if not (stat.S_ISDIR if is_folder else stat.S_ISREG)(info.st_mode):
            return info.st_ino, stat.S_IFMT(info.st_mode)
        return info.st_ino, info.st_size, info.st_mtime_ns, info.st_ctime_ns
    way, links = [], 0
    current, parts = os.path.realpath(folder), os.path.relpath(path, folder).split(os.sep)
    while parts:
        part = parts.pop(0)
        if part in ('', '.'):
            continue
        step = os.path.dirname(current) if part == '..' else os.path.join(current, part)
        if not within(step, roots):
            break
        try:
            info = os.lstat(step)
        except OSError:
            way.append(None)
            break
        way.append((info.st_ino, info.st_mode, info.st_size, info.st_mtime_ns, info.st_ctime_ns))
        if stat.S_ISLNK(info.st_mode) and links < 40:
            links += 1
            try:
                target = os.readlink(step)
            except OSError:
                break
            parts[:0] = target.split(os.sep)
            if os.path.isabs(target):
                current = os.sep
        elif stat.S_ISDIR(info.st_mode):
            current = step
        else:
            break
    return tuple(way)


def read_icon_index(path, roots):
    """(folder, size, scalable) for each folder an icon theme's index.theme lists, in its order (review fixes 3).

    Read like a desktop entry: through the checked, pinned descriptor, at most ICON_INDEX_BYTES and
    ICON_INDEX_FOLDERS folders. A folder at a Scale over 1, or without a Size from 1 to ICON_LARGEST, is left out; a
    folder name that is not a plain relative path refuses the whole index, and so does an index without an
    [Icon Theme] group whose Directories names a folder (review 4, SHOULD 4: an empty or garbage file is broken).
    """
    with os.fdopen(open_confined(path, roots), 'rb') as handle:
        if os.fstat(handle.fileno()).st_size > ICON_INDEX_BYTES:
            raise ValueError(f'index.theme exceeds {ICON_INDEX_BYTES} bytes')
        raw = handle.read(ICON_INDEX_BYTES + 1)
    if len(raw) > ICON_INDEX_BYTES:
        raise ValueError(f'index.theme exceeds {ICON_INDEX_BYTES} bytes')
    if b'\0' in raw:
        raise ValueError('NUL in index.theme')
    groups, group = {}, None
    for line in raw.decode('utf-8', 'replace').splitlines():
        line = line.strip()
        if not line or line.startswith('#'):
            continue
        if line.startswith('['):
            if not line.endswith(']'):
                raise ValueError('invalid group header in index.theme')
            group = groups.setdefault(line[1:-1], {})
        elif group is not None and '=' in line:
            key, _, value = line.partition('=')
            group.setdefault(key.strip(), value.strip())
    if 'Directories' not in groups.get('Icon Theme', {}):
        raise ValueError('index.theme has no [Icon Theme] group with Directories')
    names = [name.strip() for name in groups['Icon Theme']['Directories'].split(',')]
    names = list(dict.fromkeys(name for name in names if name))
    if not names:
        raise ValueError('index.theme lists no folders')
    if len(names) > ICON_INDEX_FOLDERS:
        raise ValueError(f'index.theme lists more than {ICON_INDEX_FOLDERS} folders')
    folders = []
    for name in names:
        if name.startswith('/') or len(name) > 255 or any(part in ('', '.', '..') for part in name.split('/')):
            raise ValueError(f'index.theme lists the folder {name[:40]!r}')
        values = groups.get(name, {})
        size, scale = values.get('Size', ''), values.get('Scale', '1')
        if (re.fullmatch(r'\d{1,4}', size, re.ASCII) and re.fullmatch(r'\d{1,4}', scale, re.ASCII)
                and int(scale) == 1 and 0 < int(size) <= ICON_LARGEST):
            folders.append((name, int(size), values.get('Type', 'Threshold') == 'Scalable'))
    return folders


class IconLookup:
    """One picture pass's view of the icon folders: each theme's layout is worked out, and each folder listed, at most
    once however many programs ask (review fixes 3).

    A root whose theme folder holds an index.theme uses the theme's index; the first root that has one speaks for all
    of them, as the icon theme specification says. A root without one (the home folder, Flatpak exports) keeps the
    fixed layout <N>x<N>/<context> and scalable/<context>. A broken or oversized index leaves the whole theme on the
    fixed layout. A folder is listed, and a file chosen, only where it really lies inside its own icon root or inside
    a Flatpak deployment: a Flatpak export's icons are links into its deployment (review 1, FIX 5). The pass lists at
    most ICON_LOOKUP_ENTRIES folder entries in all.

    seen holds every root, folder, index and picture the pass looked at, as {path: (how, icon_stat(path, *how))}, taken
    before it was read: the pass's signature. Anything that could change a lookup's answer changes one of them; what
    resolved outside its root is kept by the links that lead there, never by what they lead to (review 4, FIX 1).
    warned ({index path: its signature entry}) is the IconCache's, so each broken index is warned about once for each
    helper run while it stays as it is.
    """

    THEMES = ('hicolor', 'breeze')

    def __init__(self, directories, deployments=None, warned=None):
        self.directories = tuple(directories)
        deployments = tuple(os.path.realpath(path)
                            for path in (flatpak_deployments() if deployments is None else deployments))
        self.roots = {folder: (os.path.realpath(folder), *deployments) for folder in self.directories}
        self.seen = {}
        self.warned = {} if warned is None else warned
        self.listings = {}
        self.orders = {}
        self.entries = 0
        for folder in self.directories:
            self.note(folder, is_folder=True)

    def note(self, path, folder=None, is_folder=False):
        """path into the signature before it is read or listed; folder is its icon root when it may lead outside."""
        if path not in self.seen:
            how = (is_folder,)
            if folder is not None and not within(os.path.realpath(path), self.roots[folder]):
                how = (is_folder, folder, self.roots[folder])
            self.seen[path] = how, icon_stat(path, *how)

    def listing(self, folder, *parts):
        """{name: is a real folder} of a folder under the root folder."""
        path = os.path.join(folder, *parts)
        if path in self.listings:
            return self.listings[path]
        self.note(path, folder, is_folder=True)
        names = {}
        if self.entries < ICON_LOOKUP_ENTRIES:
            try:
                names = confined_listing(path, self.roots[folder], ICON_LOOKUP_ENTRIES - self.entries)
            except ScanLimit:
                LOG.warning('icon lookup stopped after %d folder entries; the programs left keep the fallback look',
                            ICON_LOOKUP_ENTRIES)
                self.entries = ICON_LOOKUP_ENTRIES
            except ValueError as error:
                LOG.debug('icon folder %s skipped: %s', path, error)
            except OSError:
                pass
        self.entries += len(names)
        self.listings[path] = names
        return names

    def layout(self, theme):
        """(root's position, root, folder under the theme, size, scalable) for each folder that may hold theme's
        pictures."""
        index = None
        for folder in self.directories:
            if 'index.theme' in self.listing(folder, theme):
                path = os.path.join(folder, theme, 'index.theme')
                self.note(path, folder)
                try:
                    index = read_icon_index(path, self.roots[folder])
                except (OSError, ValueError) as error:
                    # A pass that runs again for another reason does not repeat it (review 4, FIX 1).
                    if self.warned.get(path) != self.seen[path]:
                        self.warned[path] = self.seen[path]
                        LOG.warning('icon theme index %s not used, %s keeps the fixed layout: %s', path, theme, error)
                break
        folders = []
        for position, folder in enumerate(self.directories):
            names = self.listing(folder, theme)
            if index is not None and 'index.theme' in names:
                folders.extend((position, folder, name, size, scalable) for name, size, scalable in index)
                continue
            for size_name in sorted(name for name, is_folder in names.items() if is_folder):
                match = re.fullmatch(r'(\d{1,4})x\1', size_name)
                if size_name != 'scalable' and not (match and 0 < int(match[1]) <= ICON_LARGEST):
                    continue
                size = int(match[1]) if match else 0
                contexts = self.listing(folder, theme, size_name)
                folders.extend((position, folder, f'{size_name}/{context}', size, size_name == 'scalable')
                               for context in sorted(name for name, is_folder in contexts.items() if is_folder))
        return folders

    def order(self, theme):
        """theme's folders in lookup order, each with the kinds of file it may give.

        PNGs by size up to 256, largest first, as before, whatever the folder's Type (hicolor's index calls its
        256x256/apps Scalable); then SVGs, scalable folders first, then sized ones up to 256, largest first; then PNGs
        over 256, the smallest first. The fixed layout's scalable/ has no size: as before, it gives any kind of file
        among the scalable folders. Within a step roots break ties, then the folder's place in its index or layout.
        """
        if theme not in self.orders:
            ranked = []
            for position, folder, name, size, scalable in self.layout(theme):
                if 0 < size <= 256:
                    ranked.append(((0, -size, position), folder, name, ('png', 'bare')))
                elif size > 256:
                    ranked.append(((3, size, position), folder, name, ('png', 'bare')))
                if scalable:
                    ranked.append(((1, 0, position), folder, name, ('svg',) if size else ('png', 'svg', 'bare')))
                elif size <= 256:
                    ranked.append(((2, -size, position), folder, name, ('svg',)))
            ranked.sort(key=lambda item: item[0])
            self.orders[theme] = [item[1:] for item in ranked]
        return self.orders[theme]

    def candidate(self, folder, *parts):
        path = os.path.join(folder, *parts)
        real = os.path.realpath(path)
        if not within(real, self.roots[folder]):
            return None  # the folder that holds it is in the signature, so replacing it is seen
        if os.path.lexists(path):
            # Also a link whose file is not there yet: only it shows when that file appears (review 4, SHOULD 2).
            self.note(path)
        return real if os.path.isfile(real) else None

    def resolve(self, name):
        if not name or '\0' in name:
            return None
        if os.path.isabs(name):
            self.note(name)
            return name
        if '/' in name or '..' in name or len(name) > 255:
            return None
        if name.endswith(('.png', '.svg')):
            files = ((name, name[-3:]),)
        else:
            files = ((name + '.png', 'png'), (name + '.svg', 'svg'), (name, 'bare'))
        # Theme precedence applies across roots, then the order above. Only listed folders are looked into.
        for theme in self.THEMES:
            for folder, relative, kinds in self.order(theme):
                wanted = [filename for filename, kind in files if kind in kinds]
                if not wanted:
                    continue
                names = self.listing(folder, theme, relative)
                for filename in wanted:
                    if filename in names and (path := self.candidate(folder, theme, relative, filename)):
                        return path
        for folder in self.directories:
            for filename, _ in files:
                if path := self.candidate(folder, filename):
                    return path
        return None


def sniff_icon(raw):
    if raw.startswith(PNG_SIGNATURE):
        if len(raw) < 33 or raw[8:16] != b'\0\0\0\rIHDR':
            raise ValueError('invalid PNG header')
        width, height = struct.unpack('>II', raw[16:24])
        if not (0 < width <= ICON_SIDE and 0 < height <= ICON_SIDE):
            raise ValueError('icon exceeds pixel cap')
        return 'png'
    # SVG must announce its root in the first 4 KiB. Never admit DTDs/entities (including internal ones).
    head = raw[:4096].removeprefix(b'\xef\xbb\xbf').lstrip()
    if b'<!DOCTYPE' in raw.upper() or b'<!ENTITY' in raw.upper():
        raise ValueError('XML declarations are not supported')
    head = re.sub(rb'^(?:<\?xml[^?]*\?>\s*|<!--.*?-->\s*)+', b'', head, flags=re.DOTALL)
    if re.match(rb'<svg(?:\s|/?>)', head):
        return 'svg'
    raise ValueError('not a PNG or SVG')


def librsvg_coder(formats):
    return bool(re.search(rb'^\s*SVG\s+SVG\s+r[-w+]+\s+[^\n]*\bRSVG\b', formats, re.MULTILINE))


SVG_PICTURES = frozenset({'image', 'feImage', 'foreignObject'})
XINCLUDE = 'http://www.w3.org/2001/XInclude'
CSS_URL = re.compile(r'url\s*\(\s*[\'"]?\s*([^)\'"\s]*)', re.IGNORECASE)
# What the SVG pre-check looks at, at most (review 2, FIX 2). The 42,575 SVG icons installed on the laptop
# (2026-11-14) have at most 957 elements, 3,883 attributes, nesting 11, namespace addresses of 50 characters and
# names of 31. Expat expands every name with its namespace address, and Python keeps each distinct expanded name.
SVG_ELEMENTS = 8192
SVG_ATTRIBUTES = 32768
SVG_DEPTH = 64
SVG_NAMESPACE = 512
SVG_NAME = 128
SVG_DRAWN = b'drawn\n'


def drawn_svg(raw):
    """Refuse an SVG that refers to any picture or file, inside or outside itself (review 1, FIX 2).

    App icons are drawn shapes. librsvg decodes embedded and referenced pictures with decoders of its own, outside
    the converter's coder policy and pixel checks, so only references to the SVG's own elements (#id) pass: no
    image, feImage or foreignObject element, no XInclude, no href or url() to anything else (data: included), no
    CSS @import or CSS escapes, no processing instruction (xml-stylesheet), no DTD. Anything over the SVG_ bounds is
    refused too. The helper never runs this itself: IconCache.check_svg runs it in a process of its own.
    """
    parser = expat.ParserCreate(namespace_separator=' ')
    parser.SetParamEntityParsing(expat.XML_PARAM_ENTITY_PARSING_NEVER)
    style = [0]
    seen = dict(elements=0, attributes=0, depth=0)

    def refuse(what):
        raise ValueError('SVG ' + what)

    def namespace(prefix, address):
        # Called for each declaration before any name in it is expanded.
        if len(prefix or '') > SVG_NAME or len(address or '') > SVG_NAMESPACE:
            refuse(f'declares a namespace over {SVG_NAMESPACE} characters')

    def bounded(name, attributes):
        seen['elements'] += 1
        seen['attributes'] += len(attributes)
        seen['depth'] += 1
        if seen['elements'] > SVG_ELEMENTS or seen['attributes'] > SVG_ATTRIBUTES or seen['depth'] > SVG_DEPTH:
            refuse(f'has over {SVG_ELEMENTS} elements, {SVG_ATTRIBUTES} attributes or nesting {SVG_DEPTH}')
        for key in (name, *attributes):
            address, _, local = key.rpartition(' ')
            if len(local) > SVG_NAME or len(address) > SVG_NAMESPACE:
                refuse(f'has a name over {SVG_NAME} characters')

    def css(text, where):
        # librsvg reads attributes and <style> as CSS, where u\72l( is url(.
        if '\\' in text or '@import' in text.lower():
            refuse(f'{where} has a CSS escape or @import')
        for match in CSS_URL.finditer(text):
            if not match[1].startswith('#'):
                refuse(f'{where} refers to {match[1][:40]!r}')

    def start(name, attributes):
        bounded(name, attributes)
        namespace, _, local = name.rpartition(' ')
        if local in SVG_PICTURES or namespace == XINCLUDE:
            refuse(f'contains <{local}>')
        if local == 'style':
            style[0] += 1
        for key, value in attributes.items():
            attribute_namespace, _, attribute = key.rpartition(' ')
            if attribute == 'href':
                if not value.strip().startswith('#'):
                    refuse(f'refers to {value.strip()[:40]!r}')
            elif not attribute_namespace:
                css(value, attribute)

    def end(name):
        seen['depth'] -= 1
        if name.rpartition(' ')[2] == 'style':
            style[0] -= 1

    def data(text):
        if style[0]:
            css(text, '<style>')

    parser.StartNamespaceDeclHandler = namespace
    parser.StartElementHandler = start
    parser.EndElementHandler = end
    parser.CharacterDataHandler = data
    parser.ProcessingInstructionHandler = lambda target, data: refuse(f'has a <?{target}?> instruction')
    parser.StartDoctypeDeclHandler = lambda *args: refuse('has a DTD')
    parser.EntityDeclHandler = lambda *args: refuse('declares entities')
    try:
        parser.Parse(raw, True)
    except expat.ExpatError as error:
        raise ValueError(f'SVG is not well-formed XML: {error}') from None


def check_svg_file(path):
    """The SVG pre-check's own process (--check-svg FILE). It prints SVG_DRAWN or why the SVG is refused; a parse
    that tries to grow dies here, under the converter's address-space ceiling, never in the helper."""
    try:
        with open(path, 'rb') as handle:
            raw = handle.read(MAX_ICON_BYTES + 1)
        if len(raw) > MAX_ICON_BYTES:
            raise ValueError('SVG is too large')
        drawn_svg(raw)
    except (OSError, ValueError) as error:
        sys.stdout.buffer.write(f'refused: {error}'.encode('utf-8', 'replace')[:200] + b'\n')
    else:
        sys.stdout.buffer.write(SVG_DRAWN)
    sys.stdout.buffer.flush()
    return 0


def icons_revision(apps, base_revision):
    pictures = [(app.id, app.icon) for app in sorted(apps.values(), key=lambda app: app.id) if app.icon]
    if not pictures:
        return base_revision
    return hashlib.sha256(json.dumps([base_revision, pictures]).encode()).hexdigest()[:16]


class IconCache:
    """One background worker, one bounded converter at a time; requests and results never do file IO.

    The helper calls request() every CATALOGUE_CHECK seconds and take() on its normal tick. It lists the returned Apps
    and revision, and announces a changed revision only to 1.1 clients. No lookup/probe/conversion is on that path.
    The worker runs a picture pass for a request only when something changed since the last complete pass (step()).
    """

    def __init__(self, environ=None, directories=None, timeout=ICON_TIMEOUT, magick=MAGICK, bwrap=BWRAP,
                 prlimit=PRLIMIT):
        self.directory = icon_cache_directory(environ)
        self.directories = icon_directories(environ) if directories is None else tuple(directories)
        self.deployments = flatpak_deployments(environ)
        self.timeout, self.magick, self.bwrap, self.prlimit = timeout, magick, bwrap, prlimit
        # Each source's current picture, so a changed source's older generation is removed (review 1, FIX 3).
        self.generations = {}
        self.full_logged = False
        self.pending = queue.Queue(maxsize=1)
        self.results = queue.Queue(maxsize=MAX_APPS * 2)
        self.stopping = threading.Event()
        self.lock = threading.Lock()
        self.process = None
        self.thread = None
        self.svg_checked = False
        self.failed = set()
        # The newest request's revision: only a changed catalogue cuts a running pass short.
        self.latest = None
        # (revision, signature) of the last complete pass; None while a pass is due.
        self.finished = None
        # Broken theme indexes already warned about (IconLookup.warned).
        self.warned = {}
        # Whether the running pass had a picture refused for the cache's budget.
        self.crowded = False
        # Once at start rather than once per picture (review fixes 3): without these no picture can be made.
        missing = [path for path in (bwrap, magick, prlimit) if not os.access(path, os.X_OK)]
        if missing:
            LOG.warning('%s missing: programs show without pictures', ', '.join(missing))

    def request(self, apps, revision):
        if self.stopping.is_set():
            return
        if len(apps) > MAX_APPS:
            raise ValueError('too many apps')
        try:
            self.pending.get_nowait()
        except queue.Empty:
            pass
        self.latest = revision
        self.pending.put_nowait((dict(apps), revision))
        if self.thread is None:
            self.thread = threading.Thread(target=self.loop, name='aresos-icons', daemon=True)
            self.thread.start()

    def take(self, apps, base_revision):
        apps = dict(apps)
        while True:
            try:
                revision, app_id, name, path = self.results.get_nowait()
            except queue.Empty:
                return apps, icons_revision(apps, base_revision)
            app = apps.get(app_id)
            if revision == base_revision and app is not None and app.icon_name == name:
                apps[app_id] = dataclasses.replace(app, icon=path)

    def loop(self):
        while not self.stopping.is_set():
            try:
                apps, revision = self.pending.get(timeout=0.1)
            except queue.Empty:
                continue
            self.step(apps, revision)

    def step(self, apps, revision):
        """One request on the worker; True when it ran a picture pass.

        A pass looks up and converts every program's picture again (about 228 ms of processor time with 59 programs on
        the laptop), so it runs only when the catalogue's revision changed, when anything the last complete pass looked
        at changed (its signature: the icon roots, theme folders, indexes, the folders it listed, the pictures it
        chose and those it made), or when the last pass did not finish (review fixes 3). Checking it only stats.
        """
        if self.finished is not None and self.finished[0] == revision and all(
                icon_stat(path, *how) == info for path, (how, info) in self.finished[1].items()):
            return False
        self.finished = None
        self.crowded = False
        lookup = IconLookup(self.directories, self.deployments, self.warned)
        roots = tuple(os.path.realpath(folder) for folder in (*self.directories, *self.deployments))
        pictures, complete = set(), True
        for app in apps.values():
            if self.stopping.is_set() or self.latest != revision:
                complete = False
                break  # the latest rescan supersedes this pass
            path = None
            try:
                if source := lookup.resolve(app.icon_name):
                    # A named icon is read only from inside its folders; an absolute Icon path as written.
                    path = self.convert(source) if os.path.isabs(app.icon_name) else self.convert(source, roots)
            except (OSError, ValueError, subprocess.SubprocessError) as error:
                LOG.debug('icon for %s skipped: %s', app.id, error)
            if path:
                pictures.add(os.path.basename(path))
                # The made picture too: a cleared cache is made again, as the pass on every request used to.
                lookup.note(path)
            try:
                self.results.put_nowait((revision, app.id, app.icon_name, path))
            except queue.Full:
                complete = False
                break  # bounded even if the event loop stops taking answers
        if complete:
            freed = self.prune(pictures)
            # Pictures the full cache refused get one more pass once pruning made room (review 4, SHOULD 3). A cache
            # full of pictures still in use frees nothing, so it is not asked again.
            if not (self.crowded and freed):
                self.finished = (revision, lookup.seen)
        return True

    def prepare(self):
        # Never follow either private cache component to another location.
        base = os.path.dirname(os.path.dirname(self.directory))
        os.makedirs(base, mode=0o700, exist_ok=True)
        for path in (os.path.dirname(self.directory), self.directory):
            try:
                os.mkdir(path, 0o700)
            except FileExistsError:
                pass
            info = os.lstat(path)
            if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
                raise ValueError('unsafe icon cache directory')
            # Only when needed: every chmod changes the folder, and this runs for each picture, cached or not (review 4).
            if stat.S_IMODE(info.st_mode) != 0o700:
                os.chmod(path, 0o700, follow_symlinks=False)

    def command(self, work, *arguments, identify=False):
        # Mount runtime libraries, not /usr or the home tree. The only input image is a bounded snapshot.
        return [self.bwrap, '--unshare-all', '--die-with-parent', '--new-session', '--cap-drop', 'ALL',
                '--ro-bind', '/usr/lib64', '/usr/lib64', '--symlink', 'usr/lib64', '/lib64',
                '--ro-bind', self.magick, '/usr/bin/magick', '--dev', '/dev', '--dir', '/tmp',
                '--ro-bind', os.path.join(work, 'policy.xml'), '/etc/ImageMagick-7/policy.xml',
                '--ro-bind', os.path.join(work, 'input'), '/input/icon', '--chdir', '/', '--clearenv',
                '--setenv', 'HOME', '/nonexistent', '--setenv', 'PATH', '/usr/bin',
                '--setenv', 'MAGICK_CONFIGURE_PATH', '/etc/ImageMagick-7',
                '--setenv', 'MAGICK_THREAD_LIMIT', '1', '--setenv', 'OMP_NUM_THREADS', '1',
                '--', '/usr/bin/magick', *(['identify'] if identify else []), *ICON_LIMITS, *arguments]

    def run(self, command):
        # A missing sandbox stays an OSError, as when it was started directly, not a failed conversion.
        if not os.access(command[0], os.X_OK):
            raise FileNotFoundError(f'converter not found: {command[0]}')
        return self.limited(command)

    def check_svg(self, path):
        """drawn_svg in a short-lived process of its own, under the converter's address-space ceiling and timeout:
        whatever the parse costs is paid there, never in the helper (review 2, FIX 2)."""
        output = self.limited([sys.executable or '/usr/bin/python3', '-I', '-S', HELPER_FILE, '--check-svg', path],
                              label='SVG pre-check')
        if output != SVG_DRAWN:
            raise ValueError(output.decode('utf-8', 'replace').strip()[:200] or 'SVG pre-check gave no answer')

    def limited(self, command, label='icon converter'):
        """command's output, run under the address-space ceiling and the timeout; its whole process group ends after.

        prlimit sets the limit before the command starts; everything it starts inherits it.
        """
        command = [self.prlimit, f'--as={ICON_ADDRESS_SPACE}', '--', *command]
        with self.lock:
            if self.stopping.is_set():
                raise ValueError('icon worker stopped')
            proc = self.process = subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                                    stderr=subprocess.DEVNULL, start_new_session=True,
                                                    close_fds=True, env={'PATH': '/usr/bin', 'LC_ALL': 'C'})
        data = bytearray()
        deadline = time.monotonic() + self.timeout
        try:
            with selectors.DefaultSelector() as selector:
                selector.register(proc.stdout, selectors.EVENT_READ)
                while True:
                    remaining = deadline - time.monotonic()
                    if remaining <= 0 or self.stopping.is_set():
                        raise subprocess.TimeoutExpired(command, self.timeout)
                    if not selector.select(min(remaining, 0.1)):
                        continue
                    chunk = os.read(proc.stdout.fileno(), 65536)
                    if not chunk:
                        break
                    data.extend(chunk)
                    if len(data) > MAX_ICON_OUTPUT:
                        raise ValueError('converter output too large')
            if proc.wait(timeout=max(0.001, deadline - time.monotonic())):
                raise ValueError(f'{label} failed')
            return bytes(data)
        finally:
            # Kill the held process group even if a failed converter left a child holding stdout open.
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            proc.wait()
            proc.stdout.close()
            with self.lock:
                self.process = None

    def convert(self, source, roots=None):
        """The cached picture for source, or None when the cache budget is used up.

        With roots (real paths), source must still resolve inside them when it is opened (review 1, FIX 5).
        """
        if not os.path.isabs(source) or '\0' in source:
            raise ValueError('icon source must be an absolute path')
        descriptor = os.open(source, os.O_RDONLY | os.O_NONBLOCK) if roots is None else open_confined(source, roots)
        with os.fdopen(descriptor, 'rb') as handle:
            info = os.fstat(handle.fileno())
            if not stat.S_ISREG(info.st_mode) or not 0 < info.st_size <= MAX_ICON_BYTES:
                raise ValueError('icon is not a bounded regular file')
            key = hashlib.sha256(os.fsencode(source) + b'\0' + str(info.st_size).encode()
                                 + b'\0' + str(info.st_mtime_ns).encode()).hexdigest()
            if key in self.failed:
                return None
            raw = handle.read(MAX_ICON_BYTES + 1)
            after = os.fstat(handle.fileno())
            if len(raw) != info.st_size or (after.st_size, after.st_mtime_ns) != (info.st_size, info.st_mtime_ns):
                raise ValueError('icon changed while reading')
        coder = sniff_icon(raw)
        self.prepare()
        target = os.path.join(self.directory, key + '.png')
        try:
            with open(target, 'rb', opener=lambda p, f: os.open(p, f | os.O_NOFOLLOW | os.O_NONBLOCK)) as handle:
                cached = os.fstat(handle.fileno())
                if (stat.S_ISREG(cached.st_mode) and cached.st_uid == os.getuid()
                        and stat.S_IMODE(cached.st_mode) == 0o600 and cached.st_size <= MAX_ICON_OUTPUT
                        and self.normalized(handle.read(33))):
                    self.current(source, target)
                    return target
        except OSError:
            pass
        # The source changed: its older picture is stale whether or not the new one can be made.
        self.current(source, None)
        if not self.room(0):
            return None
        try:
            with tempfile.TemporaryDirectory(prefix='.convert-', dir=self.directory) as work:
                for name, content in (('input', raw), ('policy.xml', ICON_POLICY.encode())):
                    with open(os.path.join(work, name), 'xb') as handle:
                        handle.write(content)
                if coder == 'svg':
                    # Before any converter sees it (review 1, FIX 2), in a process of its own (review 2, FIX 2).
                    # A cached picture skips this: it was made only after its SVG passed.
                    self.check_svg(os.path.join(work, 'input'))
                if coder == 'svg' and not self.svg_checked:
                    if not librsvg_coder(self.run(self.command(work, '-list', 'format', identify=True))):
                        raise ValueError('SVG coder is not librsvg')
                    self.svg_checked = True
                output = self.run(self.command(work, '-background', 'none', f'{coder}:/input/icon',
                                                '-resize', '128x128', '-alpha', 'on', '-colorspace', 'sRGB',
                                                '-gravity', 'center', '-extent', '128x128', '-strip',
                                                '-depth', '8', 'PNG32:-'))
                if not self.normalized(output):
                    raise ValueError('converter did not produce a normalized PNG')
                if not self.room(len(output)):
                    return None
                descriptor, temporary = tempfile.mkstemp(prefix='.icon-', dir=self.directory)
                try:
                    with os.fdopen(descriptor, 'wb') as handle:
                        handle.write(output)
                        handle.flush()
                        os.fsync(handle.fileno())
                    os.replace(temporary, target)
                finally:
                    if os.path.exists(temporary):
                        os.unlink(temporary)
            self.current(source, target)
            return target
        except (OSError, ValueError, subprocess.SubprocessError):
            self.remember_failure(key)
            raise

    def remember_failure(self, key):
        if len(self.failed) >= MAX_APPS * 2:
            self.failed.clear()
        self.failed.add(key)

    def current(self, source, target):
        """Record target as source's picture; an older generation of the same source is removed."""
        old = self.generations.pop(source, None)
        if old is not None and old != target:
            try:
                os.unlink(old)
            except FileNotFoundError:
                pass
        if target is not None:
            if len(self.generations) >= ICON_CACHE_FILES:
                self.generations.clear()
            self.generations[source] = target

    def room(self, size):
        """Whether one more picture of size bytes fits the cache's budget; a full cache is logged once."""
        files = total = 0
        with os.scandir(self.directory) as entries:
            for entry in entries:
                # The running conversion's work folder is not a picture; prune removes stale ones.
                if entry.is_dir(follow_symlinks=False):
                    continue
                files += 1
                if files >= ICON_CACHE_FILES:
                    break
                try:
                    total += entry.stat(follow_symlinks=False).st_size
                except OSError:
                    pass
        if files < ICON_CACHE_FILES and total + size <= ICON_CACHE_BYTES:
            self.full_logged = False
            return True
        self.crowded = True
        if not self.full_logged:
            self.full_logged = True
            LOG.warning('icon cache budget (%d files, %d bytes) is used up; new pictures keep the fallback look',
                        ICON_CACHE_FILES, ICON_CACHE_BYTES)
        return False

    def prune(self, keep):
        """After a complete pass: remove pictures no listed program uses (removed programs, older generations,
        earlier runs) and leftovers of interrupted writes. Whether it removed a file, which room() counts."""
        try:
            with os.scandir(self.directory) as listing:
                entries = [(entry.name, entry.is_dir(follow_symlinks=False)) for entry in listing]
        except OSError:
            return False
        freed = False
        for name, is_folder in entries:
            path = os.path.join(self.directory, name)
            try:
                if is_folder and name.startswith('.convert-'):
                    shutil.rmtree(path)
                elif not is_folder and name not in keep and (ICON_FILE.match(name) or name.startswith('.icon-')):
                    os.unlink(path)
                    freed = True
            except OSError:
                pass
        self.generations = {source: target for source, target in self.generations.items()
                            if os.path.basename(target) in keep}
        return freed

    @staticmethod
    def normalized(raw):
        return (len(raw) >= 33 and raw[:16] == PNG_SIGNATURE + b'\0\0\0\rIHDR'
                and raw[16:29] == struct.pack('>IIBBBBB', 128, 128, 8, 6, 0, 0, 0))

    def stop(self):
        self.stopping.set()
        with self.lock:
            if self.process is not None:
                try:
                    os.killpg(self.process.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
        if self.thread is not None:
            self.thread.join(self.timeout + 1)


# ---------------------------------------------------------------- journal

class Journal:
    """Launch results by request ID, kept across helper restarts (B1).

    Lives in $XDG_RUNTIME_DIR, so it ends with the login session, like the desktop instance it belongs to.
    Replay protection is never dropped early: only a launch whose answer can no longer change, last changed at
    least REPLAY_HORIZON ago, may be forgotten (the mod resends a request ID only within its 45-second open
    timeout). Its answer is settled when it finished, or when it was handed over to a running app whose windows
    can't be watched; how long that app stays open does not hold the entry. A launch still in progress is never
    forgotten. With no room left, new launches are refused instead.
    """

    def __init__(self, path, instance, clock=time.monotonic):
        self.path = path
        self.instance = instance
        self.clock = clock
        self.entries = {}
        self.load()

    def load(self):
        try:
            with open(self.path, encoding='utf-8') as handle:
                data = json.load(handle)
        except FileNotFoundError:
            return
        except (OSError, ValueError, RecursionError) as error:
            LOG.error('launch journal unreadable, starting empty: %s', error)
            return
        if not isinstance(data, dict) or data.get('instance') != self.instance:
            LOG.info('launch journal belongs to another desktop instance; starting empty')
            return
        now = self.clock()
        launches = data.get('launches')
        for request_id, entry in (launches.items() if isinstance(launches, dict) else ()):
            if (isinstance(request_id, str) and REQUEST_ID.match(request_id) and isinstance(entry, dict)
                    and isinstance(entry.get('app_id'), str) and isinstance(entry.get('state'), str)):
                updated = entry.get('updated')
                # The monotonic clock is system-wide, so ages survive a helper restart; anything odd counts as new.
                if type(updated) not in (int, float) or not 0 <= updated <= now:
                    entry['updated'] = now
                self.entries[request_id] = entry

    def touch(self, entry):
        entry['updated'] = self.clock()

    def put(self, request_id, entry):
        self.touch(entry)
        self.entries[request_id] = entry

    def room(self):
        """True when a new request can be recorded, after forgetting what can no longer be replayed."""
        if len(self.entries) < JOURNAL_LIMIT:
            return True
        now = self.clock()
        expired = [key for key, entry in self.entries.items()
                   if (entry['state'] in FINAL or entry.get('settled'))
                   and now - entry.get('updated', now) >= REPLAY_HORIZON]
        for key in expired:
            del self.entries[key]
        return len(self.entries) < JOURNAL_LIMIT

    def save(self):
        data = json.dumps({'instance': self.instance, 'launches': self.entries}, separators=(',', ':'))
        temporary = f'{self.path}.{os.getpid()}.tmp'
        descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | getattr(os, "O_NOFOLLOW", 0), 0o600)
        try:
            with os.fdopen(descriptor, 'w', encoding='utf-8') as handle:
                handle.write(data)
                handle.flush()
                os.fsync(handle.fileno())
            os.replace(temporary, self.path)
        except BaseException:
            try:
                os.unlink(temporary)
            except OSError:
                pass
            raise


# ---------------------------------------------------------------- launching

def unit_escape(value):
    return value.replace('-', '\\x2d')


def nvidia_present(root='/'):
    """The NVIDIA kernel driver lists at least one GPU (same rule as aresos-desktop)."""
    try:
        return bool(os.listdir(os.path.join(root, 'proc/driver/nvidia/gpus')))
    except OSError:
        return False


class ScopeLauncher:
    """Start apps in their own user scope, outside the game's and the helper's cgroups."""

    def __init__(self, popen=subprocess.Popen, run=subprocess.run, environ=None, nvidia=None):
        self.popen = popen
        self.run = run
        self.environ = os.environ if environ is None else environ
        self.nvidia = nvidia or nvidia_present

    @staticmethod
    def unit(app, launch_id):
        # systemd's desktop naming: app-<launcher>-<application id>-<random>.scope
        return f'app-aresos-{unit_escape(app.id)}-{launch_id}.scope'

    def command(self, app, argv, launch_id):
        # systemd-run expands ${NAME} in the command by default; the parsed Exec words must arrive unchanged.
        return [SYSTEMD_RUN, '--user', '--scope', '--quiet', '--collect', '--slice=app.slice',
                f'--unit={self.unit(app, launch_id)}', f'--description=AresOS app: {app.name}',
                '--expand-environment=no', '--', *argv]

    def environment(self, app=None):
        env = {key: value for key, value in self.environ.items() if key not in PRIVATE_ENVIRONMENT and key not in GPU_KEYS}
        if app is not None:
            # A reviewed hint's values (30b): after the session's are filtered, before the NVIDIA values.
            env.update(app.environment)
        if app is not None and app.gpu == 'discrete' and self.nvidia():
            env.update(NVIDIA_OFFLOAD)
        return env

    def working_directory(self, directory):
        home = self.environ.get('HOME') or os.path.expanduser('~')
        return home if directory == '~' else directory

    def spawn(self, app, argv, directory, launch_id):
        # --scope execs the app in this child, so poll() reports the app's own exit.
        return self.popen(self.command(app, argv, launch_id), cwd=self.working_directory(directory),
                          env=self.environment(app), stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                          stderr=subprocess.DEVNULL, start_new_session=True, close_fds=True)


class LaunchCheck:
    def __init__(self):
        self.done = threading.Event()
        self.result = None


class LaunchChecks:
    """Launch checks on their own threads, never on the serving loop (review 2, FIX 1).

    A program on a mount that stopped answering blocks its check's thread, maybe for good. Repeated launches of the
    same program share its outstanding check, and at most MAX_CHECKS checks are outstanding at once: beyond that a
    launch fails as unavailable at once instead of starting yet another thread.
    """

    def __init__(self, limit=MAX_CHECKS):
        self.limit = limit
        self.lock = threading.Lock()
        self.running = {}

    def start(self, key, function, *arguments):
        """The outstanding check for key, or a new one; None when MAX_CHECKS are outstanding."""
        with self.lock:
            check = self.running.get(key)
            if check is not None:
                return check
            if len(self.running) >= self.limit:
                return None
            check = self.running[key] = LaunchCheck()
        try:
            threading.Thread(target=self.run, args=(key, check, function, arguments), name='aresos-launch-check',
                             daemon=True).start()
        except RuntimeError as error:
            LOG.error('could not start a launch check: %s', error)
            with self.lock:
                del self.running[key]
            return None
        return check

    def run(self, key, check, function, arguments):
        try:
            check.result = function(*arguments)
        except Exception:
            LOG.exception('a launch check failed')
            check.result = (None, None, 'invalid_entry')
        finally:
            with self.lock:
                if self.running.get(key) is check:
                    del self.running[key]
            check.done.set()



# ---------------------------------------------------------------- scope watching

ACTIVE, GONE, UNKNOWN = 'active', 'gone', 'unknown'
# systemd's ActiveState column. Only these two lists decide; any other value (maintenance, a future state, a typo)
# is UNKNOWN, so an odd line can never end a launch.
RUNNING_STATES = frozenset({'active', 'activating', 'deactivating', 'reloading', 'refreshing'})
ENDED_STATES = frozenset({'inactive', 'failed'})
LIST_SCOPES = [SYSTEMCTL, '--user', 'list-units', '--type=scope', '--all', '--no-legend', '--plain', '--no-pager']


def parse_scopes(text):
    """Unit name to ACTIVE state from `systemctl list-units --plain --no-legend`, or None if any line is odd."""
    states = {}
    for line in text.splitlines():
        fields = line.split()
        if not fields:
            continue
        if fields[0] in ('*', '●'):  # status bullets, should --plain ever keep them
            fields = fields[1:]
        if len(fields) < 4 or not fields[0].endswith('.scope'):
            return None
        unit, state = fields[0], fields[2]
        # A unit listed twice with different states says nothing certain.
        states[unit] = state if states.get(unit, state) == state else None
    return states


def classify(state):
    if state in RUNNING_STATES:
        return ACTIVE
    if state in ENDED_STATES:
        return GONE
    return UNKNOWN


def query_scopes(units, run=subprocess.run, timeout=SCOPE_TIMEOUT):
    """One batched call for all units: each is ACTIVE, GONE or UNKNOWN (the call failed or made no sense)."""
    try:
        done = run(LIST_SCOPES, capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL)
    except (OSError, ValueError, subprocess.SubprocessError):
        return {unit: UNKNOWN for unit in units}
    states = parse_scopes(done.stdout) if done.returncode == 0 and isinstance(done.stdout, str) else None
    if states is None:
        return {unit: UNKNOWN for unit in units}
    # A transient scope started with --collect disappears from a complete, valid list once it has ended.
    return {unit: classify(states[unit]) if unit in states else GONE for unit in units}


class ScopeWatcher:
    """Checks launch scopes on its own thread, never on the event loop.

    The event loop says which units to watch (`watch`); one thread runs one batched query per pass, waits
    SCOPE_CHECK after each pass ends, and posts the answers to a queue with a wake-up byte for the loop.
    """

    def __init__(self, run=subprocess.run, interval=SCOPE_CHECK, timeout=SCOPE_TIMEOUT):
        self.run = run
        self.interval = interval
        self.timeout = timeout
        self.lock = threading.Lock()
        self.units = frozenset()
        self.results = queue.SimpleQueue()
        self.stopping = threading.Event()
        self.thread = None
        self.reader, self.writer = socket.socketpair()
        self.reader.setblocking(False)
        self.writer.setblocking(False)

    def watch(self, units):
        with self.lock:
            self.units = frozenset(units)

    def start(self):
        self.thread = threading.Thread(target=self.loop, name='aresos-scope-watcher', daemon=True)
        self.thread.start()

    def loop(self):
        while not self.stopping.wait(self.interval):
            try:
                self.check()
            except Exception:
                LOG.exception('scope check failed; trying again next pass')

    def check(self):
        """One pass; tests call it directly instead of running the thread."""
        with self.lock:
            units = self.units
        if not units:
            return
        self.results.put(query_scopes(units, self.run, self.timeout))
        try:
            self.writer.send(b'w')
        except OSError:
            pass  # a full wake-up buffer already holds a wake-up

    def take(self):
        """All answers posted since the last call, oldest first."""
        try:
            while self.reader.recv(4096):
                pass
        except OSError:
            pass
        answers = []
        while True:
            try:
                answers.append(self.results.get_nowait())
            except queue.Empty:
                return answers

    def stop(self):
        self.stopping.set()
        if self.thread is not None:
            self.thread.join(self.timeout + 1)
        self.reader.close()
        self.writer.close()


# ---------------------------------------------------------------- windows

@dataclasses.dataclass
class Toplevel:
    handle: int
    seen: float
    app_id: str = ''
    parent: int = 0
    activated: bool = False
    ready: bool = False
    owner: str = None
    # The owner a dialog took from a discovered parent; it keeps it after the parent closes.
    launch_owner: str = None
    pending: dict = dataclasses.field(default_factory=dict)


class Windows:
    """Toplevels as the compositor reports them, with the open/close changes not yet taken.

    Each toplevel's title, app_id, parent and state apply together at its done event, as the protocol says, so a
    read that ends between them never shows a half-changed window.
    """
    SHELL = '\0desktop'

    def __init__(self, clock=time.monotonic):
        self.clock = clock
        self.toplevels = {}
        self.opened = []
        self.closed = []
        self.owners = {}
        self.prefixes = ()
        self.candidates = {}
        self.reserved_ids = set(DESKTOP_APP_IDS)

    def set_registry(self, apps):
        """The programs whose windows can be told apart: an exact identity or a reviewed hint's prefix, no guess.

        Ownership goes in this order (review 2, finding 3): the desktop's window and the registry's identities, then
        reviewed hints (exact, then prefix), then discovered programs' own candidates.
        """
        valid = [app for app in apps.values() if not app.invalid]
        reviewed = {identity for app in apps.values() if not app.discovered for identity in app.app_ids}
        self.reserved_ids = reviewed | {identity for app in valid for identity in app.hint_ids} | DESKTOP_APP_IDS
        self.owners = {window_id: app.id for app in valid if app.discovered for window_id in app.hint_ids}
        self.owners.update({window_id: app.id for app in valid if not app.discovered for window_id in app.app_ids})
        self.prefixes = tuple((prefix, app.id) for app in valid for prefix in app.app_id_prefixes)
        self.candidates = {window_id: app.id for app in valid if app.discovered for window_id in app.app_ids
                           if window_id not in self.reserved_ids}
        # A dialog's inherited owner goes with its program (e.g. a 1.0 desktop: discovered programs own nothing).
        valid = {app.id for app in apps.values() if not app.invalid}
        for toplevel in self.toplevels.values():
            if toplevel.launch_owner not in valid:
                toplevel.launch_owner = None
        # Windows listed before the registry was known get their owners now (twice, so dialogs follow parents).
        for _ in range(2):
            for toplevel in self.toplevels.values():
                if toplevel.ready:
                    self._settle(toplevel)

    def new(self, handle):
        self.toplevels[handle] = Toplevel(handle, self.clock())

    def app_id(self, handle, value):
        if handle in self.toplevels:
            self.toplevels[handle].pending['app_id'] = value or ''

    def parent(self, handle, parent):
        if handle in self.toplevels:
            self.toplevels[handle].pending['parent'] = parent

    def state(self, handle, activated):
        if handle in self.toplevels:
            self.toplevels[handle].pending['activated'] = activated

    def done(self, handle):
        toplevel = self.toplevels.get(handle)
        if toplevel is None:
            return
        previous_id = toplevel.app_id
        for key, value in toplevel.pending.items():
            setattr(toplevel, key, value)
        toplevel.pending.clear()
        if not toplevel.ready:
            toplevel.ready = True
            toplevel.owner = self._owner(toplevel, set())
            self.opened.append(toplevel)
        else:
            self._settle(toplevel)
            if toplevel.owner is None and toplevel.app_id != previous_id and toplevel not in self.opened:
                self.opened.append(toplevel)

    def _settle(self, toplevel):
        # Some apps set their app_id only after the window first appears; announce it again when it becomes theirs.
        owner = self._owner(toplevel, set())
        if owner != toplevel.owner:
            toplevel.owner = owner
            if toplevel not in self.opened:
                self.opened.append(toplevel)

    def gone(self, handle):
        toplevel = self.toplevels.pop(handle, None)
        if toplevel is not None and toplevel.ready:
            self.closed.append(toplevel)

    def _owner(self, toplevel, seen):
        if toplevel.app_id in DESKTOP_APP_IDS:
            return self.SHELL
        if toplevel.app_id in self.owners:
            return self.owners[toplevel.app_id]
        if toplevel.app_id in self.reserved_ids:
            # An unusable reviewed entry's identity: never a prefix's or a discovered program's.
            if toplevel.launch_owner is not None:
                return None
        else:
            # A reviewed hint's prefix (Steam's games, steam_app_<n>) beats a discovered program's own candidate.
            owner = next((app for prefix, app in self.prefixes if prefixed(toplevel.app_id, (prefix,))), None)
            if owner is not None:
                return owner
            if toplevel.app_id in self.candidates:
                return self.candidates[toplevel.app_id]
        # Dialogs belong to their parent's app, so closing one never looks like the app closing.
        parent = self.toplevels.get(toplevel.parent)
        if parent is not None and parent.handle not in seen:
            seen.add(toplevel.handle)
            return self._owner(parent, seen)
        return toplevel.launch_owner

    def take(self):
        opened, closed = self.opened, self.closed
        self.opened, self.closed = [], []
        return opened, closed

    def active(self):
        return next((t for t in self.toplevels.values() if t.ready and t.activated), None)

    def of(self, owner):
        return [t for t in self.toplevels.values() if t.ready and t.owner == owner]


class WaylandError(Exception):
    pass


class ForeignToplevels:
    """A minimal Wayland client for zwlr_foreign_toplevel_manager_v1, standard library only.

    labwc implements the wlr foreign-toplevel protocol; it reports every
    toplevel's app_id, parent and activated state, and lets us activate one.
    """
    MANAGER = 'zwlr_foreign_toplevel_manager_v1'
    STATE_ACTIVATED = 2

    def __init__(self, sock, windows):
        self.sock = sock
        self.windows = windows
        self.buffer = bytearray()
        self.next_id = 2
        self.kinds = {1: 'display'}
        self.globals = {}
        self.callbacks = set()
        self.manager = None
        self.seat = None
        self.registry = self._new('registry')
        self._send(1, 1, struct.pack('=I', self.registry))

    @classmethod
    def connect(cls, windows, environ=None, timeout=5.0):
        environ = os.environ if environ is None else environ
        display = environ.get('WAYLAND_DISPLAY')
        if not display:
            raise WaylandError('WAYLAND_DISPLAY is not set')
        path = display if posixpath.isabs(display) else posixpath.join(environ.get('XDG_RUNTIME_DIR', ''), display)
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(timeout)
        try:
            sock.connect(path)
            client = cls(sock, windows)
            client.roundtrip()
            if not client.bind():
                raise WaylandError('the compositor does not offer ' + cls.MANAGER)
            client.roundtrip()
        except BaseException:
            sock.close()
            raise
        sock.setblocking(False)
        return client

    def _new(self, kind):
        object_id = self.next_id
        self.next_id += 1
        self.kinds[object_id] = kind
        return object_id

    def _send(self, object_id, opcode, payload=b''):
        message = struct.pack('=II', object_id, ((8 + len(payload)) << 16) | opcode) + payload
        self.sock.sendall(message)

    @staticmethod
    def string(value):
        data = value.encode('utf-8') + b'\0'
        return struct.pack('=I', len(data)) + data + b'\0' * (-len(data) % 4)

    def bind(self):
        manager = next(((name, version) for name, (interface, version) in self.globals.items()
                        if interface == self.MANAGER), None)
        seat = next(((name, version) for name, (interface, version) in self.globals.items()
                     if interface == 'wl_seat'), None)
        if manager is None:
            return False
        self.manager = self._new('manager')
        self._send(self.registry, 0, struct.pack('=I', manager[0]) + self.string(self.MANAGER)
                   + struct.pack('=II', min(manager[1], 3), self.manager))
        if seat is not None:
            self.seat = self._new('seat')
            self._send(self.registry, 0, struct.pack('=I', seat[0]) + self.string('wl_seat')
                       + struct.pack('=II', 1, self.seat))
        return True

    def roundtrip(self):
        callback = self._new('callback')
        self.callbacks.add(callback)
        self._send(1, 0, struct.pack('=I', callback))
        while callback in self.callbacks:
            data = self.sock.recv(65536)
            if not data:
                raise WaylandError('the compositor closed the connection')
            self.feed(data)

    def activate(self, handle):
        if self.seat is None or self.kinds.get(handle) != 'toplevel':
            return False
        self._send(handle, 4, struct.pack('=I', self.seat))
        return True

    def readable(self):
        try:
            data = self.sock.recv(65536)
        except BlockingIOError:
            return
        if not data:
            raise WaylandError('the compositor closed the connection')
        self.feed(data)

    def feed(self, data):
        self.buffer += data
        while len(self.buffer) >= 8:
            object_id, word = struct.unpack_from('=II', self.buffer)
            size, opcode = word >> 16, word & 0xffff
            if size < 8 or size % 4:
                raise WaylandError('invalid message size from the compositor')
            if len(self.buffer) < size:
                return
            payload = bytes(self.buffer[8:size])
            del self.buffer[:size]
            self.dispatch(object_id, opcode, payload)

    @staticmethod
    def _string(payload, offset):
        (length,) = struct.unpack_from('=I', payload, offset)
        offset += 4
        if length == 0:
            return None, offset
        value = payload[offset:offset + length - 1].decode('utf-8', 'replace')
        return value, offset + length + (-length % 4)

    def dispatch(self, object_id, opcode, payload):
        kind = self.kinds.get(object_id)
        if kind == 'display':
            if opcode == 0:
                _, code = struct.unpack_from('=II', payload)
                message, _ = self._string(payload, 8)
                raise WaylandError(f'compositor error {code}: {message}')
        elif kind == 'registry':
            if opcode == 0:
                (name,) = struct.unpack_from('=I', payload)
                interface, offset = self._string(payload, 4)
                (version,) = struct.unpack_from('=I', payload, offset)
                self.globals[name] = (interface, version)
            elif opcode == 1:
                (name,) = struct.unpack_from('=I', payload)
                interface, _ = self.globals.pop(name, (None, 0))
                if interface == self.MANAGER and self.manager is not None:
                    raise WaylandError('the compositor removed ' + self.MANAGER)
        elif kind == 'callback':
            self.callbacks.discard(object_id)
            self.kinds.pop(object_id, None)
        elif kind == 'manager':
            if opcode == 0:
                (handle,) = struct.unpack_from('=I', payload)
                self.kinds[handle] = 'toplevel'
                self.windows.new(handle)
            elif opcode == 1:
                raise WaylandError(self.MANAGER + ' finished')
        elif kind == 'toplevel':
            if opcode == 1:
                value, _ = self._string(payload, 0)
                self.windows.app_id(object_id, value)
            elif opcode == 4:
                (length,) = struct.unpack_from('=I', payload)
                values = struct.unpack_from(f'={length // 4}I', payload, 4)
                self.windows.state(object_id, self.STATE_ACTIVATED in values)
            elif opcode == 5:
                self.windows.done(object_id)
            elif opcode == 6:
                self.windows.gone(object_id)
                self.kinds.pop(object_id, None)
                self._send(object_id, 7)
            elif opcode == 7:
                (parent,) = struct.unpack_from('=I', payload)
                self.windows.parent(object_id, parent)


# ---------------------------------------------------------------- protocol core

class Helper:
    """The protocol state machine. Sockets and the compositor stay outside it."""

    def __init__(self, registry_dir, instance, nonce, journal_path, launcher=None, windows=None,
                 activate=None, clock=time.monotonic, executable=None, window_timeout=WINDOW_TIMEOUT, registry=None,
                 watcher=None, status=no_status, keep_foreground=False, catalogue=None, icons=None):
        self.instance = instance
        self.status = status
        self.keep_foreground = keep_foreground
        self.desktop_appeared = None
        # The window that last lost focus to another one (not the desktop): where a restored desktop gives focus back.
        # Kept apart from active_handle, because a new window may be identified as the desktop only later (review 2,
        # finding 8).
        self.keep_target = None
        self.nonce = nonce
        self.apps, self.revision = registry or load_registry(registry_dir)
        if catalogue is None:
            # Without a discovery worker (tests, diagnostics) availability is worked out once, here at start-up.
            self.apps = with_availability(self.apps, executable)
        self.catalogue = catalogue
        self.icons = icons
        self.catalogue_apps = self.apps
        self.base_revision = self.revision
        self.legacy_apps, self.legacy_revision = (catalogue.legacy if catalogue is not None
                                                 else ({k: a for k, a in self.apps.items() if not a.discovered},
                                                       self.revision))
        self.icon_requested = float('-inf')
        self.cursor_key = secrets.token_bytes(32)
        self.launcher = launcher or ScopeLauncher()
        # Started by build(); tests drive its passes directly.
        self.watcher = watcher or ScopeWatcher(run=self.launcher.run)
        self.windows = windows
        self.activate_window = activate
        self.clock = clock
        self.executable = executable
        self.window_timeout = window_timeout
        self.capabilities = BASE_CAPABILITIES | DETAIL_CAPABILITIES | (
            WINDOW_CAPABILITIES if windows is not None else frozenset())
        self.journal = Journal(journal_path, instance, clock)
        # Which client's rules decide window ownership (review 1, finding 2): the last desktop's minor. Only a 1.1
        # client can start a discovered launch, so a journal that still holds one means the desktop spoke 1.1.
        self.window_minor = int(any(entry.get('discovered') and entry['state'] not in FINAL
                                    for entry in self.journal.entries.values()))
        self.windows_pending = False
        if windows is not None:
            windows.set_registry(self.window_apps())
        self.connections = []
        self.desktop = None
        self.events = 0
        self.checks = LaunchChecks()
        # Request ID -> a launch waiting for its check: the app, the check, its deadline and who to answer.
        self.checking = {}
        self.processes = {}
        self.deadlines = {}
        self.started = {}
        self.handles = {}
        # Discovered scopes can outlive their windows (Steam/Discord) and their launch replies.
        self.discovered_scopes = {}
        # Discovered program -> (deadline, return wanted, the compositor's pick after the close or None).
        self.discovered_closing = {}
        self.shell = 'foreground'
        self.foreground_app = None
        self.active_handle = None
        self.active_owner = None
        self.handoff = None
        self.returning_until = None
        self.adopting = set()
        self.world = None
        self.last_heartbeat = None
        self.reconcile()
        if windows is not None:
            # The compositor has listed its windows by now: tie restarted launches to them, then take stock.
            self.windows_changed()

    # -- restart reconciliation

    def reconcile(self):
        """Never relaunch after a restart: settle every launch the journal still calls open.

        One batched scope query (not one per launch) says which apps still run; an unknown answer decides nothing
        and leaves the launch to the scope watcher.
        """
        units = {entry['unit'] for entry in self.journal.entries.values() if entry.get('unit')
                 and ((entry['state'] not in FINAL and not entry.get('settled'))
                      or (self.is_discovered(entry) and entry['state'] != 'failed'))}
        states = query_scopes(units, self.watcher.run, self.watcher.timeout) if units else {}
        changed = False
        for request_id, entry in self.journal.entries.items():
            scope = states.get(entry.get('unit'), GONE)
            if self.is_discovered(entry) and scope != GONE:
                self.discovered_scopes[entry['unit']] = dict(app_id=entry['app_id'], state=scope,
                                                            started=entry.get('started', 0.0), request_id=request_id)
            if entry['state'] in FINAL:
                continue
            if scope == ACTIVE and entry.pop('uncertain', None):
                self.journal.touch(entry)
                changed = True
            if entry['state'] == 'launching':
                if scope == GONE:
                    entry.update(state='failed', error='launch_uncertain',
                                 message='the helper restarted while starting this app; it was not retried')
                else:
                    entry['state'] = 'starting'
                    if scope == UNKNOWN:
                        entry['uncertain'] = True  # if it turns out gone, it never surely started
                self.journal.touch(entry)
                changed = True
                if entry['state'] in FINAL:
                    continue
            if self.windows is not None:
                if entry['state'] == 'starting':
                    # Any matching window listed from now on may be its window, including ones open already.
                    self.started[request_id] = 0.0
                    self.deadlines[request_id] = self.clock() + self.window_timeout
                else:
                    self.adopting.add(request_id)
            elif scope == GONE and not entry.get('settled'):
                state, fields = self.end_of_scope(entry)
                if state == 'settled':
                    entry['settled'] = True
                elif state is not None:
                    entry['state'] = state
                    entry.update(fields)
                if state is not None:
                    self.journal.touch(entry)
                    changed = True
        if changed:
            self.journal.save()

    def adopt_windows(self):
        """After a restart, give launches that had windows the app's current windows, or close them."""
        for request_id, entry in self.journal.entries.items():
            if request_id not in self.adopting or entry['state'] in FINAL:
                continue
            windows = {toplevel.handle for toplevel in self.windows.of(entry['app_id'])}
            if windows:
                # Which of an app's windows came from which launch is lost with the old helper; share them.
                self.handles[request_id] = windows
            else:
                self.set_state(request_id, 'closed')
        self.adopting.clear()

    # -- connections

    def connected(self, conn):
        conn.authenticated = False
        conn.capabilities = frozenset()
        conn.minor = MINOR
        conn.opened = self.clock()
        conn.inbuf = bytearray()
        self.connections.append(conn)

    def disconnected(self, conn):
        if conn in self.connections:
            self.connections.remove(conn)
        if self.desktop is conn:
            self.desktop = None

    def receive(self, conn, data):
        conn.inbuf += data
        while True:
            end = conn.inbuf.find(b'\n')
            if end < 0:
                if len(conn.inbuf) > MAX_MESSAGE:
                    self.error(conn, None, Failure('message_too_large', f'messages are limited to {MAX_MESSAGE} bytes',
                                                   close=True))
                    conn.inbuf.clear()
                return
            line = bytes(conn.inbuf[:end])
            del conn.inbuf[:end + 1]
            if len(line) >= MAX_MESSAGE:
                self.error(conn, None, Failure('message_too_large', f'messages are limited to {MAX_MESSAGE} bytes',
                                               close=True))
                conn.inbuf.clear()
                return
            self.handle_line(conn, line)
            if getattr(conn, 'closing', False):
                return

    def handle_line(self, conn, line):
        try:
            message = json.loads(line.decode('utf-8'), parse_constant=_reject_constant)
            # JSON escapes can smuggle lone surrogates into any string; nothing below may ever meet one.
            json.dumps(message, ensure_ascii=False).encode('utf-8')
        except (UnicodeError, ValueError, RecursionError):
            self.error(conn, None, Failure('malformed', 'expected one JSON object of valid UTF-8 per line'))
            return
        if not isinstance(message, dict):
            self.error(conn, None, Failure('malformed', 'expected a JSON object'))
            return
        request_id = message.get('id')
        if not isinstance(request_id, str) or not REQUEST_ID.match(request_id):
            self.error(conn, None, Failure('malformed', 'id must match [A-Za-z0-9._:-]{1,128}'))
            return
        version = ENVELOPE.match(message.get('protocol')) if isinstance(message.get('protocol'), str) else None
        if version is None or int(version.group(1)) != MAJOR:
            self.error(conn, request_id, Failure('incompatible_version', f'this helper speaks {protocol()}',
                                                 close=not conn.authenticated))
            return
        operation = message.get('op')
        try:
            # Check the type before the lookup: a list or object is not even hashable.
            if not isinstance(operation, str):
                raise Failure('malformed', 'op must be a string')
            handler = {'hello': self.hello, 'list_apps': self.list_apps, 'open_app': self.open_app,
                       'world_ready': self.world_ready, 'heartbeat': self.heartbeat}.get(operation)
            if handler is None:
                raise Failure('unknown_operation', f'unknown operation {operation[:64]!r}')
            if not conn.authenticated and operation != 'hello':
                raise Failure('hello_required', 'send hello first')
            result = handler(conn, request_id, message)
        except Failure as failure:
            self.error(conn, request_id, failure)
            return
        # None: the answer comes later (a launch whose check is still running).
        if result is not None:
            self.reply(conn, request_id, result)

    def reply(self, conn, request_id, result):
        ok = result.pop('ok', True)
        self.send(conn, dict({'id': request_id, 'ok': ok}, **result))

    def send(self, conn, message):
        conn.send(dict({'protocol': protocol(conn.minor)}, **message))

    def error(self, conn, request_id, failure):
        self.send(conn, dict({'id': request_id, 'ok': False, 'error': failure.code, 'message': failure.message},
                             **failure.fields))
        if failure.close:
            conn.finish()

    def emit(self, event, **fields):
        conn = self.desktop
        if conn is None or event not in conn.capabilities or (event == 'apps_changed' and conn.minor < 1):
            return
        self.events += 1
        self.send(conn, dict({'id': f'e-{self.events}', 'event': event}, **fields))

    def authorized(self, message):
        instance, nonce = message.get('instance'), message.get('nonce')
        if not isinstance(instance, str) or not isinstance(nonce, str):
            return False
        try:
            return (hmac.compare_digest(instance.encode('utf-8'), self.instance.encode('utf-8'))
                    and hmac.compare_digest(nonce.encode('utf-8'), self.nonce.encode('utf-8')))
        except UnicodeError:
            return False

    # -- operations

    def hello(self, conn, request_id, message):
        if conn.authenticated:
            raise Failure('invalid_state', 'hello already completed')
        major, minor = message.get('major'), message.get('minor')
        if type(major) is not int or type(minor) is not int or minor < 0:
            raise Failure('malformed', 'major and minor must be integers', close=True)
        if major != MAJOR:
            raise Failure('incompatible_version', f'this helper speaks {protocol()}', close=True)
        capabilities = names(message.get('capabilities', []))
        required = names(message.get('requires', []))
        offered = self.capabilities if minor >= 1 else self.capabilities - DETAIL_CAPABILITIES
        missing = sorted(required - offered)
        if missing:
            raise Failure('incompatible_version', 'missing capabilities: ' + ', '.join(missing), close=True,
                          missing=missing)
        if not self.authorized(message):
            LOG.warning('refused a hello with the wrong desktop instance or launch nonce')
            raise Failure('not_authorized', 'desktop instance or launch nonce does not match', close=True)
        conn.authenticated = True
        conn.minor = min(minor, MINOR)
        if self.windows is not None and conn.minor != self.window_minor:
            # Applied at the next tick, after this reply: a 1.0 desktop sees the registry's windows alone.
            self.window_minor = conn.minor
            self.windows.set_registry(self.window_apps())
            self.windows_pending = True
            if conn.minor < 1:
                # A return a discovered program was still waiting for is not a 1.0 desktop's (review 2, finding 1).
                self.cancel_returns()
        conn.capabilities = capabilities
        previous, self.desktop = self.desktop, conn
        if previous is not None and previous is not conn:
            # The newest authenticated desktop wins, e.g. the mod reconnecting.
            previous.finish()
        LOG.info('desktop connected (minor %d)', conn.minor)
        self.status(event='desktop_connected')
        return {'major': MAJOR, 'minor': conn.minor, 'capabilities': sorted(offered)}

    def list_apps(self, conn, request_id, message):
        self.refresh_catalogue()
        if conn.minor == 0:
            return {'revision': self.legacy_revision,
                    'apps': [self.app_row(app) for app in sorted(self.legacy_apps.values(), key=lambda a: a.id)]}
        offset = 0
        if 'cursor' in message:
            cursor = message['cursor']
            if not isinstance(cursor, str) or not 0 < len(cursor) <= 64:
                raise Failure('malformed', 'cursor must be a helper-issued string of at most 64 characters')
            match = re.fullmatch(r'p([0-9]{1,3})-[0-9a-f]{24}', cursor)
            if match is None or not hmac.compare_digest(cursor, self.page_cursor(int(match[1]))):
                raise Failure('invalid_cursor', 'cursor was not issued by this helper; list again without it')
            offset = int(match[1])
        rows = [self.app_row(app, details=True)
                for app in sorted(self.catalogue_apps.values(), key=lambda a: a.id)]
        page = {'revision': self.revision, 'apps': []}
        for index in range(offset, len(rows)):
            trial = dict(revision=self.revision, apps=page['apps'] + [rows[index]])
            if index + 1 < len(rows):
                trial['next'] = self.page_cursor(index + 1)
            envelope = dict(protocol=protocol(conn.minor), id=request_id, ok=True, **trial)
            if len(json.dumps(envelope, separators=(',', ':'), ensure_ascii=False).encode('utf-8')) + 1 > MAX_MESSAGE:
                break
            page = trial
        return page

    def page_cursor(self, offset):
        tag = hmac.new(self.cursor_key, str(offset).encode(), 'sha256').hexdigest()[:24]
        return f'p{offset}-{tag}'

    def app_row(self, app, details=False):
        # The catalogue's published value: listing touches no file (review 2, FIX 1).
        row = dict(id=app.id, name=app.name, available=app.unavailable is None, reason=app.unavailable)
        if details:
            for key in ('source', 'icon', 'categories', 'generic_name', 'keywords', 'desktop_id', 'exec_name'):
                if value := getattr(app, key):
                    row[key] = list(value) if isinstance(value, tuple) else value
            if app.discovered:
                row['terminal'] = app.terminal
        return row

    def refresh_catalogue(self):
        now = self.clock()
        previous = self.revision
        if self.catalogue is not None and self.catalogue.refresh(now):
            self.base_revision = self.catalogue.revision
            self.legacy_apps, self.legacy_revision = self.catalogue.legacy
            self.catalogue_apps = {
                key: dataclasses.replace(app, icon=old.icon) if (old := self.catalogue_apps.get(key)) is not None
                and old.icon_name == app.icon_name else app for key, app in self.catalogue.apps.items()}
            # Uninstalling an entry must not erase an existing window's owner or its pending return.
            retained = {key: app for key, app in self.apps.items() if key not in self.catalogue_apps
                        and (any(entry['app_id'] == key and entry['state'] not in FINAL
                                 for entry in self.journal.entries.values())
                             or any(scope['app_id'] == key for scope in self.discovered_scopes.values())
                             or (self.windows is not None and self.windows.of(key)))}
            self.apps = dict(retained, **self.catalogue_apps)
            if self.windows is not None:
                self.windows.set_registry(self.window_apps())
                self.windows_changed()
            self.icon_requested = float('-inf')
        if self.icons is not None:
            if now - self.icon_requested >= CATALOGUE_CHECK:
                self.icons.request(self.catalogue_apps, self.base_revision)
                self.icon_requested = now
            self.catalogue_apps, self.revision = self.icons.take(self.catalogue_apps, self.base_revision)
            self.apps.update(self.catalogue_apps)
        else:
            self.revision = self.base_revision
        if self.revision != previous:
            self.emit('apps_changed', revision=self.revision)

    def open_app(self, conn, request_id, message):
        app_id = message.get('app_id')
        if not isinstance(app_id, str) or len(app_id) > 128:
            raise Failure('malformed', 'app_id must be a string')
        unknown = {'app_id': app_id, 'launch_id': None, 'state': 'failed',
                   'error': 'unknown_app', 'message': 'no reviewed launch definition'}
        waiting = self.checking.get(request_id)
        if waiting is not None:
            # Resent while its check runs: answered with the same launch once there is an answer, never a second one.
            if waiting['app'].id != app_id:
                raise Failure('request_id_reused', 'this request ID already opened another app')
            if conn.minor == 0 and waiting['app'].discovered:
                return self.launch_result(request_id, unknown)
            waiting['conns'].append(conn)
            return None
        entry = self.journal.entries.get(request_id)
        if entry is not None:
            if entry['app_id'] != app_id:
                raise Failure('request_id_reused', 'this request ID already opened another app')
            if conn.minor == 0 and entry.get('discovered'):
                # A 1.1 client's launch stays its own; a 1.0 client gets what it gets for any unknown ID.
                return self.launch_result(request_id, unknown)
            # A duplicate (e.g. resent after a reconnect) returns the same launch, never a second one.
            return self.launch_result(request_id, entry)
        if not self.journal.room():
            raise self.journal_full(request_id, app_id)
        # A 1.0 client knows only the reviewed registry: for it, a discovered ID is an unknown one, answered and
        # journaled exactly as before package 30 (review 1, finding 3).
        app = self.catalogue_apps.get(app_id) if conn.minor >= 1 or app_id in self.legacy_apps else None
        if app is None:
            return self.record(request_id, unknown)
        # Whether its program is still there is checked off the loop (review 2, FIX 1).
        check = self.checks.start(app, launch_check, app, self.executable, self.launcher.working_directory)
        if check is None:
            LOG.warning('%s not opened: %d launch checks are still waiting for an answer', app.id, MAX_CHECKS)
            return self.launch(request_id, app, None, None, 'checks_busy')
        if check.done.wait(CHECK_WAIT):
            return self.launch(request_id, app, *check.result)
        self.checking[request_id] = dict(app=app, check=check, deadline=self.clock() + CHECK_SECONDS, conns=[conn])
        return None

    @staticmethod
    def journal_full(request_id, app_id):
        # Forgetting a recent request ID could start an app twice; refusing a new one cannot.
        return Failure('journal_full', 'too many launches in the last few minutes; try again shortly',
                       request_id=request_id, app_id=app_id, state='failed')

    def checks_answered(self):
        """Go on with launches whose check has answered; fail those whose check is overdue as unavailable."""
        now = self.clock()
        for request_id, waiting in list(self.checking.items()):
            app, check = waiting['app'], waiting['check']
            if check.done.is_set():
                result = check.result
            elif now >= waiting['deadline']:
                LOG.warning('%s not opened: its program did not answer within %g seconds', app.id, CHECK_SECONDS)
                result = (None, None, 'not_responding')
            else:
                continue
            del self.checking[request_id]
            conns = [conn for conn in waiting['conns'] if conn in self.connections]
            try:
                if not self.journal.room():
                    raise self.journal_full(request_id, app.id)
                answer = self.launch(request_id, app, *result)
            except Failure as failure:
                for conn in conns:
                    self.error(conn, request_id, failure)
                continue
            for conn in conns:
                self.reply(conn, request_id, dict(answer))

    def launch(self, request_id, app, argv, directory, reason):
        """Start app once its check has answered, or record why it could not start."""
        app_id = app.id
        if reason is not None:
            return self.record(request_id, {'app_id': app_id, 'launch_id': None, 'state': 'failed',
                                            'error': 'unavailable', 'reason': reason, 'message': reason})
        launch_id = secrets.token_hex(8)
        unit = self.launcher.unit(app, launch_id)
        entry = {'app_id': app_id, 'launch_id': launch_id, 'state': 'launching', 'unit': unit}
        if app.discovered:
            entry['started'] = self.clock()
            entry['discovered'] = True
        self.journal.put(request_id, entry)
        # Recorded before starting: a crash in between is reconciled, not retried.
        self.journal.save()
        try:
            process = self.launcher.spawn(app, argv, directory, launch_id)
        except (OSError, ValueError, subprocess.SubprocessError) as error:
            LOG.error('could not start %s: %s', app.id, error)
            entry.update(state='failed', error='launch_failed', message='could not start the app')
            self.journal.touch(entry)
            self.journal.save()
            return self.launch_result(request_id, entry)
        LOG.info('started %s in %s', app.id, unit)
        entry['state'] = 'starting'
        self.journal.touch(entry)
        self.journal.save()
        self.processes[request_id] = process
        # A deliberate launch says where he wants to be: an earlier close's pending return is dropped (finding 4).
        self.cancel_returns()
        if app.discovered:
            self.discovered_scopes[unit] = dict(app_id=app_id, state=ACTIVE, started=entry['started'],
                                               request_id=request_id, process=process)
        if self.windows is not None:
            self.started[request_id] = self.clock()
            self.deadlines[request_id] = self.clock() + self.window_timeout
        return self.launch_result(request_id, entry)

    def record(self, request_id, entry):
        self.journal.put(request_id, entry)
        self.journal.save()
        return self.launch_result(request_id, entry)

    @staticmethod
    def launch_result(request_id, entry):
        state = 'starting' if entry['state'] == 'launching' else entry['state']
        result = {'ok': state != 'failed', 'request_id': request_id, 'launch_id': entry.get('launch_id'),
                  'app_id': entry['app_id'], 'state': state}
        if state == 'failed':
            result.update(error=entry.get('error', 'launch_failed'), message=entry.get('message', ''))
            if entry.get('reason'):
                result['reason'] = entry['reason']
        return result

    def world_ready(self, conn, request_id, message):
        if not self.authorized(message):
            raise Failure('not_authorized', 'desktop instance or launch nonce does not match', close=True)
        world = message.get('world')
        if (not isinstance(world, dict) or world.get('desktop') is not True
                or not isinstance(world.get('id'), str) or not WORLD_ID.match(world['id'])):
            raise Failure('malformed', 'world must name the marked desktop world')
        if self.world != world['id']:
            LOG.info('desktop world ready')
        self.world = world['id']
        self.last_heartbeat = self.clock()
        self.status(event='world_ready', world=self.world)
        return {}

    def heartbeat(self, conn, request_id, message):
        if not self.authorized(message):
            raise Failure('not_authorized', 'desktop instance or launch nonce does not match', close=True)
        ready = message.get('ready')
        if not isinstance(ready, bool):
            raise Failure('malformed', 'ready must be a boolean')
        if not ready and self.world is not None:
            LOG.info('desktop world no longer ready')
            self.world = None
        self.last_heartbeat = self.clock()
        self.status(event='heartbeat', ready=ready, world=self.world)
        return {}

    # -- launch lifecycle

    def is_discovered(self, entry):
        app = self.apps.get(entry['app_id'])
        return app is not None and app.discovered

    def set_state(self, request_id, state, **fields):
        entry = self.journal.entries.get(request_id)
        if entry is None or entry['state'] == state or entry['state'] in FINAL:
            return
        entry['state'] = state
        entry.update(fields)
        if state in ('focused', 'background'):
            entry.pop('uncertain', None)  # a window confirms the app started
        self.journal.touch(entry)
        self.journal.save()
        if state in FINAL or state in ('focused', 'background'):
            self.deadlines.pop(request_id, None)
        event = {'request_id': request_id, 'launch_id': entry.get('launch_id'), 'app_id': entry['app_id'],
                 'state': state}
        event.update(fields)
        self.emit('app_state', **event)

    def settle(self, request_id):
        """This request's answer can no longer change, though the app may still run: replay retention may end."""
        entry = self.journal.entries.get(request_id)
        if entry is None or entry.get('settled'):
            return
        entry['settled'] = True
        self.journal.touch(entry)
        self.journal.save()

    def confirmed(self, request_id):
        """Its app is seen running (scope or window): an interrupted start is no longer in doubt."""
        entry = self.journal.entries.get(request_id)
        if entry is not None and entry.pop('uncertain', None):
            self.journal.touch(entry)
            self.journal.save()

    def end_of_scope(self, entry):
        """What a launch becomes once its scope is gone and no process of ours can say how it ended."""
        app = self.apps.get(entry['app_id'])
        single = app is not None and (app.discovered or app.instance == 'single')
        if entry.get('uncertain'):
            return 'failed', {'error': 'launch_uncertain',
                              'message': 'the helper restarted while starting this app; it was not retried'}
        if self.windows is None:
            # A one-process app has closed; a handed-over app's answer can't change any more.
            return ('settled', {}) if single else ('closed', {})
        if entry['state'] == 'starting' and not single:
            return 'failed', {'error': 'launch_failed', 'message': 'exited before showing a window'}
        # With window tracking, windows decide the rest (a handed-over launch waits for its window).
        return None, {}

    def watched_units(self):
        """Unit to request ID for launches whose scope still matters.

        Without window tracking that is every unresolved launch, focused and background included. With tracking,
        windows decide reviewed apps, except for a launch still starting that this helper did not start itself.
        Discovered scopes are also watched after their windows close: a live scope keeps a launch waiting for a
        resident instance's window.
        """
        units = {}
        for request_id, entry in self.journal.entries.items():
            if entry['state'] in FINAL or entry.get('settled') or not entry.get('unit'):
                continue
            if self.windows is None or (entry['state'] == 'starting' and request_id not in self.processes):
                units[entry['unit']] = request_id
        units.update({unit: scope['request_id'] for unit, scope in self.discovered_scopes.items()})
        return units

    def scopes_answered(self):
        """Apply the scope watcher's answers. Only GONE ends a launch; UNKNOWN keeps it and its watch."""
        watched = self.watched_units()
        for answers in self.watcher.take():
            for unit, state in answers.items():
                request_id = watched.get(unit)
                scope = self.discovered_scopes.get(unit)
                if scope is not None:
                    process = scope.get('process')
                    # A still-running systemd-run may not have registered its scope at the time of the query.
                    if state == GONE and (process is None or process.poll() is not None):
                        del self.discovered_scopes[unit]
                    elif state != GONE:
                        scope['state'] = state
                entry = self.journal.entries.get(request_id)
                if entry is None or entry.get('unit') != unit:
                    continue  # a retained scope can outlive its replay record, even if that ID is reused
                if state == ACTIVE and request_id is not None:
                    self.confirmed(request_id)
                # A launch result with its own process is ended by that process, never by the list.
                if state != GONE or request_id is None or request_id in self.processes:
                    continue
                if entry['state'] in FINAL or entry.get('settled'):
                    continue
                state_after, fields = self.end_of_scope(entry)
                if state_after == 'settled':
                    self.settle(request_id)
                elif state_after is not None:
                    self.set_state(request_id, state_after, **fields)
        self.watcher.watch(self.watched_units())

    def tick(self):
        self.refresh_catalogue()
        self.checks_answered()
        now = self.clock()
        for conn in list(self.connections):
            if not conn.authenticated and now - conn.opened > HELLO_TIMEOUT:
                conn.finish()
        for request_id, process in list(self.processes.items()):
            code = process.poll()
            if code is None:
                continue
            del self.processes[request_id]
            entry = self.journal.entries.get(request_id)
            if entry is None or entry['state'] != 'starting':
                continue
            app = self.apps.get(entry['app_id'])
            if self.windows is None:
                if code != 0:
                    self.set_state(request_id, 'failed', error='launch_failed', message=f'exited with status {code}')
                elif app is not None and (app.discovered or app.instance == 'single'):
                    # Handed over to the running instance, whose windows can't be watched here: answer settled.
                    self.settle(request_id)
                else:
                    self.set_state(request_id, 'closed')
            elif code != 0 or (app is not None and not app.discovered and app.instance == 'multi'):
                self.set_state(request_id, 'failed', error='launch_failed',
                               message=f'exited with status {code} before showing a window')
            # A single-instance app hands the launch to its running instance and exits 0.
        for request_id, deadline in list(self.deadlines.items()):
            if now >= deadline:
                del self.deadlines[request_id]
                entry = self.journal.entries.get(request_id)
                if entry is not None and entry['state'] == 'starting':
                    if self.is_discovered(entry):
                        # No instance contract: a clean early exit can hand over to a resident process. With
                        # a live/unknown scope keep waiting; once it is gone the usual bounded window wait ends.
                        if entry.get('unit') in self.discovered_scopes or request_id in self.processes:
                            self.deadlines[request_id] = now + self.window_timeout
                            continue
                    self.set_state(request_id, 'failed', error='no_window',
                                   message='no matching window appeared')
        self.scopes_answered()
        if self.windows is not None and (self.discovered_closing or self.windows_pending):
            self.windows_changed()

    def windows_changed(self):
        """Apply the compositor's changes so far.

        A socket read is not a compositor batch: the same close-and-refocus can arrive split across reads in any
        order. So the transition state lives on the helper (the last active window and a short hand-off record),
        and the outcome is the same however the bytes were split.
        """
        opened, closed = self.windows.take()
        self.windows_pending = False
        now = self.clock()
        if any(toplevel.owner == Windows.SHELL for toplevel in opened):
            self.desktop_appeared = now
        if (self.keep_foreground and self.desktop_appeared is not None
                and now - self.desktop_appeared > KEEP_WINDOW):
            self.keep_foreground = False
        # Foreign-toplevel has no PID or cgroup, so a window belongs to a program only by a reviewed identity (its
        # own, a registry entry's or a hint's), never by which programs happen to run (review 1, finding 1). A
        # window nobody owns is nobody's: it confirms no launch, keeps no program open and forces no return.
        # Dialogs follow their parent, and keep a discovered parent's owner after it closes.
        for toplevel in self.windows.toplevels.values():
            parent = self.windows.toplevels.get(toplevel.parent)
            if toplevel.ready and parent is not None and self.apps.get(parent.owner) is not None:
                if self.apps[parent.owner].discovered:
                    toplevel.owner = self.windows._owner(toplevel, set())
                    if toplevel.owner == parent.owner:
                        toplevel.launch_owner = parent.owner
        if self.adopting:
            self.adopt_windows()
        # Claims first, so a window that opened and closed between two reads still confirms its launch.
        for toplevel in opened:
            if toplevel.owner in (None, Windows.SHELL) or any(toplevel.handle in h for h in self.handles.values()):
                continue
            waiting = [request_id for request_id, entry in self.journal.entries.items()
                       if entry['state'] == 'starting' and entry['app_id'] == toplevel.owner
                       and self.started.get(request_id, float('inf')) <= toplevel.seen]
            if waiting:
                request_id = waiting[0]
                self.started.pop(request_id, None)
                self.handles.setdefault(request_id, set()).add(toplevel.handle)
        # Discovered apps have no per-launch window contract: all their windows, including a resident instance's
        # restored window and its children, decide whether they are gone. Reviewed launches keep their old rules.
        for request_id, entry in self.journal.entries.items():
            if not self.is_discovered(entry) or entry['state'] in FINAL or entry.get('settled'):
                continue
            relevant = {t.handle for t in self.windows.of(entry['app_id'])}
            if relevant:
                self.handles[request_id] = relevant
                self.started.pop(request_id, None)
                self.discovered_closing.pop(entry['app_id'], None)
            elif request_id in self.handles and not any(t.owner == entry['app_id'] for t in closed):
                # A late, explicit identity corrected an inferred owner. It no longer belongs to this launch.
                del self.handles[request_id]
                self.discovered_closing.setdefault(entry['app_id'], (now + HANDOFF, False, None))
        returned = False
        for toplevel in closed:
            app = toplevel.owner
            definition = self.apps.get(app)
            if definition is not None and definition.discovered:
                if not self.windows.of(app):
                    handed_off = (self.handoff is not None and self.handoff[0] == app
                                  and now - self.handoff[2] <= HANDOFF)
                    pending = self.discovered_closing.get(app)
                    # A window already active now is the compositor's pick (it may arrive before the close).
                    pick = self.windows.active()
                    self.discovered_closing[app] = (pending[0] if pending else now + HANDOFF,
                                                    bool(pending and pending[1]) or app == self.foreground_app
                                                    or handed_off,
                                                    pending[2] if pending else pick and pick.handle)
                    for request_id in list(self.handles):
                        if self.journal.entries[request_id]['app_id'] == app:
                            del self.handles[request_id]
                continue
            for request_id, handles in list(self.handles.items()):
                if toplevel.handle in handles:
                    handles.discard(toplevel.handle)
                    if not handles:
                        del self.handles[request_id]
                        self.set_state(request_id, 'closed')
            if returned or app in (None, Windows.SHELL) or self.windows.of(app):
                continue
            # The compositor may already have activated the next window when the close arrives.
            handed_off = (self.handoff is not None and self.handoff[1] == toplevel.handle
                          and now - self.handoff[2] <= HANDOFF)
            # For a 1.1 desktop the registry's apps leave a window nobody owns in front too (review 2, finding 4); a
            # 1.0 desktop keeps today's immediate return.
            if (app == self.foreground_app or handed_off) and not (self.window_minor >= 1 and self.unowned_windows()):
                returned = True
                self.return_to_desktop(app)
        active = self.windows.active()
        if active is not None and active.handle != self.active_handle and active.owner != Windows.SHELL:
            # The first window activated after a close is the compositor's own pick and keeps the return; a later
            # switch is his choice, and a return he no longer wants is dropped (review 1, finding 4). Taken into
            # account before an overdue return runs: the switch he just made wins (review 2, finding 2).
            for app, (deadline, should_return, pick) in list(self.discovered_closing.items()):
                if should_return:
                    self.discovered_closing[app] = (deadline, pick is None or pick == active.handle,
                                                    active.handle if pick is None else pick)
        # Closing a launcher and announcing its child are separate protocol messages, possibly separate reads.
        # Reuse the focus hand-off interval to bridge that gap, without waiting for tray-only processes to exit.
        for app, (deadline, should_return, _) in list(self.discovered_closing.items()):
            if self.windows.of(app):
                del self.discovered_closing[app]
                continue
            if now < deadline:
                continue
            del self.discovered_closing[app]
            for request_id, entry in self.journal.entries.items():
                if entry['app_id'] == app and entry['state'] not in FINAL:
                    self.set_state(request_id, 'closed')
            # A window nobody owns may be this program's own (an identity no hint knows yet): the hub is not
            # pulled in front of it, and comes back only when the compositor gives it the focus. Under 1.0 nothing a
            # discovered program does forces a return (review 2, finding 1).
            if (should_return and not returned and self.shell == 'background' and self.window_minor >= 1
                    and not self.unowned_windows()):
                returned = True
                self.return_to_desktop(app)
        for request_id, handles in self.handles.items():
            focused = active is not None and active.handle in handles
            self.set_state(request_id, 'focused' if focused else 'background')
        if active is None:
            return
        previous_handle, previous_owner = self.active_handle, self.active_owner
        self.active_handle, self.active_owner = active.handle, active.owner
        if (active.handle != previous_handle and previous_handle in self.windows.toplevels
                and self.windows.toplevels[previous_handle].owner != Windows.SHELL):
            self.keep_target = previous_handle
        if active.owner == Windows.SHELL and self.keep_foreground and self.desktop_appeared is not None:
            # The restored desktop window took focus on appearing; the window in front keeps it (once). The target
            # is the window that lost focus to it, also when the desktop window was identified only after it took
            # focus (then active_handle already names the desktop window itself).
            self.keep_foreground = False
            target = self.windows.toplevels.get(self.keep_target)
            if (target is not None and target.handle != active.handle and target.owner != Windows.SHELL
                    and self.activate_window is not None and self.activate_window(target.handle)):
                LOG.info('the restored desktop stays below the window in front')
                self.active_handle, self.active_owner = target.handle, target.owner
                return
        if active.owner == Windows.SHELL:
            # The compositor already returned us. A pending close must not later
            # steal focus from another app deliberately opened during its grace.
            self.cancel_returns()
            self.returning_until = None
            self.handoff = None
            self.foreground_app = None
            if self.shell == 'background':
                self.shell = 'foreground'
                self.emit('shell_focus', focus='foreground', reason='desktop_activated')
            return
        if returned or (self.returning_until is not None and now <= self.returning_until):
            # The compositor's own pick after the close; the desktop's activation is on its way.
            return
        self.returning_until = None
        if active.handle != previous_handle:
            self.handoff = ((previous_owner, previous_handle, now)
                            if previous_owner not in (None, Windows.SHELL) and previous_owner != active.owner else None)
        self.foreground_app = active.owner
        if self.shell == 'foreground':
            self.shell = 'background'
            fields = {'focus': 'background', 'reason': 'app_activated' if active.owner else 'other_window'}
            if active.owner:
                fields['app_id'] = active.owner
            self.emit('shell_focus', **fields)

    def cancel_returns(self):
        """Pending closes still end their launches, but none of them brings the hub back any more."""
        self.discovered_closing = {app: (deadline, False, pick)
                                   for app, (deadline, _, pick) in self.discovered_closing.items()}

    def window_apps(self):
        """The programs whose windows the helper tells apart. With a 1.0 desktop that is today's set, the reviewed
        registry alone: a discovered program's window is nobody's, so it never forces a return (review 1, finding 2).
        """
        if self.window_minor >= 1:
            return self.apps
        return {key: app for key, app in self.apps.items() if not app.discovered}

    def unowned_windows(self):
        return [toplevel for toplevel in self.windows.toplevels.values() if toplevel.ready and toplevel.owner is None]

    def return_to_desktop(self, app):
        """The foreground app's last relevant window closed: give the hub its focus back."""
        desktop = self.windows.of(Windows.SHELL)
        activated = bool(desktop) and self.activate_window is not None and bool(self.activate_window(desktop[-1].handle))
        self.foreground_app = None
        self.handoff = None
        self.shell = 'foreground'
        self.returning_until = self.clock() + HANDOFF if activated else None
        LOG.info('%s closed its last window; returning to the desktop', app)
        self.emit('shell_focus', focus='foreground', reason='app_closed', app_id=app, activated=activated)


def names(values):
    if not isinstance(values, list) or len(values) > MAX_LIST:
        raise Failure('malformed', 'capability lists must be arrays of names')
    result = set()
    for value in values:
        if not isinstance(value, str) or not CAPABILITY.match(value):
            raise Failure('malformed', 'capability names must match [a-z_]{1,32}')
        result.add(value)
    return frozenset(result)


# ---------------------------------------------------------------- server

class Peer:
    """One client connection with non-blocking buffers."""

    def __init__(self, sock, server):
        self.sock = sock
        self.server = server
        self.outbuf = bytearray()
        self.closing = False
        self.closed = False

    def send(self, message):
        if self.closed:
            return
        data = json.dumps(message, separators=(',', ':'), ensure_ascii=False).encode('utf-8') + b'\n'
        if len(data) > MAX_MESSAGE:
            LOG.error('dropped an oversized outgoing message')
            return
        if len(self.outbuf) + len(data) > MAX_OUTGOING:
            LOG.warning('client is not reading; disconnecting it')
            self.close()
            return
        self.outbuf += data
        self.flush()

    def flush(self):
        while self.outbuf and not self.closed:
            try:
                sent = self.sock.send(self.outbuf)
            except BlockingIOError:
                break
            except OSError:
                self.close()
                return
            del self.outbuf[:sent]
        if self.closed:
            return
        if self.closing and not self.outbuf:
            self.close()
        else:
            self.server.watch(self)

    def finish(self):
        self.closing = True
        self.flush()

    def close(self):
        if self.closed:
            return
        self.closed = True
        self.server.forget(self)
        self.sock.close()


def peer_uid(sock):
    pid, uid, gid = struct.unpack('3i', sock.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize('3i')))
    return uid


def prepare_socket(path, uid=None):
    """Create the private runtime folder and claim the socket path, refusing a live helper."""
    uid = os.getuid() if uid is None else uid
    folder = os.path.dirname(path)
    os.makedirs(folder, mode=0o700, exist_ok=True)
    info = os.lstat(folder)
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != uid:
        raise SystemExit(f'{folder} must be a directory owned by this user')
    if info.st_mode & 0o077:
        os.chmod(folder, 0o700)
    try:
        info = os.lstat(path)
    except FileNotFoundError:
        return
    if not stat.S_ISSOCK(info.st_mode):
        raise SystemExit(f'{path} exists and is not a socket')
    probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        probe.connect(path)
    except (ConnectionRefusedError, FileNotFoundError):
        os.unlink(path)
        return
    finally:
        probe.close()
    raise SystemExit('another aresos-shell is already serving ' + path)


class Server:
    def __init__(self, path, helper, wayland=None, uid=None):
        self.path = path
        self.helper = helper
        self.wayland = wayland
        self.uid = os.getuid() if uid is None else uid
        self.selector = selectors.DefaultSelector()
        self.peers = {}
        self.stopping = False
        prepare_socket(path, self.uid)
        self.listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        old = os.umask(0o177)
        try:
            self.listener.bind(path)
        finally:
            os.umask(old)
        os.chmod(path, 0o600)
        self.listener.listen(MAX_CONNECTIONS)
        self.listener.setblocking(False)
        self.selector.register(self.listener, selectors.EVENT_READ, 'listener')
        if wayland is not None:
            self.selector.register(wayland.sock, selectors.EVENT_READ, 'wayland')
        self.selector.register(helper.watcher.reader, selectors.EVENT_READ, 'scopes')

    def watch(self, peer):
        events = selectors.EVENT_READ | (selectors.EVENT_WRITE if peer.outbuf else 0)
        if peer.sock.fileno() >= 0 and peer.sock in self.peers:
            self.selector.modify(peer.sock, events, peer)

    def forget(self, peer):
        if self.peers.pop(peer.sock, None) is not None:
            self.selector.unregister(peer.sock)
        self.helper.disconnected(peer)

    def accept(self):
        try:
            sock, _ = self.listener.accept()
        except BlockingIOError:
            return
        try:
            uid = peer_uid(sock)
        except OSError:
            uid = None
        if uid != self.uid or len(self.peers) >= MAX_CONNECTIONS:
            LOG.warning('refused a connection (%s)', 'other user' if uid != self.uid else 'too many connections')
            sock.close()
            return
        sock.setblocking(False)
        peer = Peer(sock, self)
        self.peers[sock] = peer
        self.selector.register(sock, selectors.EVENT_READ, peer)
        self.helper.connected(peer)

    def step(self, timeout=0.5):
        for key, mask in self.selector.select(timeout):
            self.handle(key, mask)
        self.helper.tick()

    def handle(self, key, mask):
        """One selector event: a new client, compositor news, scope answers or client traffic."""
        if key.data == 'listener':
            self.accept()
            return
        if key.data == 'wayland':
            self.wayland.readable()
            self.helper.windows_changed()
            return
        if key.data == 'scopes':
            self.helper.scopes_answered()
            return
        peer = key.data
        if mask & selectors.EVENT_WRITE:
            peer.flush()
        if not mask & selectors.EVENT_READ or peer.closed:
            return
        try:
            data = peer.sock.recv(65536)
        except BlockingIOError:
            return
        except OSError:
            data = b''
        if not data:
            peer.close()
        elif not peer.closing:
            try:
                self.helper.receive(peer, data)
            except Exception:
                LOG.exception('unexpected error while handling a request; dropping that connection')
                peer.close()

    def run(self):
        while not self.stopping:
            self.step()
        self.close()

    def close(self):
        for peer in list(self.peers.values()):
            peer.close()
        self.selector.close()
        self.listener.close()
        self.helper.watcher.stop()
        if self.helper.catalogue is not None:
            self.helper.catalogue.stop()
        if self.helper.icons is not None:
            self.helper.icons.stop()
        try:
            os.unlink(self.path)
        except FileNotFoundError:
            pass


def build(registry_dir, instance, nonce, journal_path, environ=None, launcher=None, clock=time.monotonic,
          connect=None, status=no_status, keep_foreground=False):
    """Start-up in the order that matters: owners from the registry first, then the compositor's window list."""
    catalogue = Discovery(Catalogue(registry_dir, environ=environ))
    catalogue.start(clock())
    registry = catalogue.apps, catalogue.revision
    windows = Windows(clock=clock)
    windows.set_registry(registry[0])
    try:
        wayland = (connect or ForeignToplevels.connect)(windows, environ)
    except (OSError, WaylandError, struct.error) as error:
        LOG.warning('window tracking is off, apps report starting only: %s', error)
        wayland, windows = None, None
    helper = Helper(registry_dir, instance, nonce, journal_path, launcher=launcher, windows=windows,
                    activate=wayland.activate if wayland else None, clock=clock, registry=registry, status=status,
                    keep_foreground=keep_foreground, catalogue=catalogue, icons=IconCache(environ=environ))
    helper.watcher.watch(helper.watched_units())
    helper.watcher.start()
    return helper, wayland


def main(argv=None):
    parser = argparse.ArgumentParser(description='AresOS app helper (aresos-shell/1.1)')
    parser.add_argument('--registry', default=REGISTRY, help='folder of reviewed app entries')
    parser.add_argument('--socket', help='socket path (default $XDG_RUNTIME_DIR/aresos/shell.sock)')
    parser.add_argument('--list', action='store_true', help='print the reviewed registry with availability and exit')
    # Internal: the icon worker runs the SVG pre-check through this, in its own memory-limited process.
    parser.add_argument('--check-svg', metavar='FILE', help=argparse.SUPPRESS)
    args = parser.parse_args(argv)
    if args.check_svg is not None:
        return check_svg_file(args.check_svg)
    logging.basicConfig(level=logging.INFO, format='aresos-shell: %(levelname)s %(message)s')
    if args.list:
        apps, revision = load_registry(args.registry)
        rows = []
        for app in sorted(apps.values(), key=lambda app: app.id):
            _, _, reason = resolve(app)
            rows.append({'id': app.id, 'name': app.name, 'available': reason is None, 'reason': reason})
        print(json.dumps({'revision': revision, 'apps': rows}, indent=2))
        return 0
    runtime = os.environ.get('XDG_RUNTIME_DIR')
    instance, nonce = os.environ.get('ARESOS_DESKTOP_INSTANCE', ''), os.environ.get('ARESOS_LAUNCH_NONCE', '')
    if not runtime or not os.path.isabs(runtime):
        parser.error('XDG_RUNTIME_DIR must be set')
    if not INSTANCE.match(instance) or not NONCE.match(nonce):
        parser.error('ARESOS_DESKTOP_INSTANCE and ARESOS_LAUNCH_NONCE (16+ URL-safe characters) must be set '
                     'by the desktop supervisor')
    status = no_status
    status_fd = os.environ.get('ARESOS_SHELL_STATUS_FD', '')
    if status_fd:
        if not status_fd.isdigit():
            parser.error('ARESOS_SHELL_STATUS_FD must be a file descriptor number')
        status = StatusPipe(int(status_fd))
    path = args.socket or os.environ.get('ARESOS_SHELL_SOCKET') or os.path.join(runtime, 'aresos', 'shell.sock')
    prepare_socket(path)
    helper, wayland = build(args.registry, instance, nonce, os.path.join(os.path.dirname(path), 'shell-journal.json'),
                            status=status, keep_foreground=os.environ.get('ARESOS_SHELL_KEEP_FOREGROUND') == '1')
    server = Server(path, helper, wayland)

    def stop(signum, frame):
        server.stopping = True

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    LOG.info('serving %s on %s (%d apps)', protocol(), path, len(helper.apps))
    try:
        server.run()
    except WaylandError as error:
        # Window tracking is part of the negotiated contract; restart rather than silently lose it.
        LOG.error('lost the compositor: %s', error)
        server.close()
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
