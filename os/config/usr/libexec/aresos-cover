#!/usr/bin/python3
"""AresOS startup cover (package 23b): one quiet screen between login and the hub.

The desktop supervisor (/usr/libexec/aresos-desktop) starts this before Prism
for the session's first hub launch, and with --again on the owner's retry. It
covers what Minecraft shows while it starts (Prism's launch dialog, Mojang's
loading screen, "joining world"), which no mod can cover: the early loading
screen draws before mods run.

One borderless fullscreen window (app-id aresos.cover, title AresOS; labwc's
window rule makes it fullscreen and keeps it on top). It only draws: a dark
gradient, the word AresOS and one line under it. It takes no input and never
closes on a key or a click. It ends on SIGTERM (the supervisor stops it once
the hub is ready, or a message window has to be seen), or by itself after
LIMIT seconds, so a cover nobody stopped can never outlive its purpose.

A missing font never stops it: Pango falls back to the default sans.

--black (package 25, board #379) is the black screen while a shutdown, logout
or restart saves the home: plain black, no text and no pointer, one fullscreen
window on every output (app-id aresos.black). Each window asks for its own
output; labwc's rule for aresos.black only keeps it on top. It is a surface,
never outputs switched off: labwc, the game and the save run on behind it. It
ends as the cover does, on SIGTERM or by its limit (the supervisor gives it the
stop's deadline and half a minute).
"""
import argparse
import signal
import sys

APP_ID = 'aresos.cover'
BLACK_APP_ID = 'aresos.black'
TITLE = 'AresOS'
# The longest a cover stays up by itself (10 minutes).
LIMIT = 600.0
# linux-hub's look, from the Ares-Crown theme. The gradient is darker at the bottom: the lighter colour on top.
TOP = '#1a191e'
BOTTOM = '#0d0d10'
INK = '#f3f1ea'
MUTED = '#a6a39a'
# Package 31's font (/usr/share/fonts/aresos/SpaceGrotesk-Variable.ttf), found through fontconfig by its family.
# The generic family after it is Pango's fallback when that font is missing.
FAMILY = 'Space Grotesk,sans-serif'
FIRST = 'Starting your home screen…'
AGAIN = 'Starting again…'


def parse(argv=None):
    parser = argparse.ArgumentParser(prog='aresos-cover', description='AresOS startup cover (package 23b)')
    parser.add_argument('--again', action='store_true', help='say "Starting again…" (after the owner\'s retry)')
    parser.add_argument('--black', action='store_true',
                        help='plain black on every screen, no text (while a shutdown, logout or restart saves)')
    # Only for tests: a shorter limit. A limit outside (0, LIMIT] falls back to LIMIT.
    parser.add_argument('--limit', type=float, default=LIMIT, help=argparse.SUPPRESS)
    args = parser.parse_args(argv)
    if not (0 < args.limit <= LIMIT):
        args.limit = LIMIT
    return args


def line(again):
    return AGAIN if again else FIRST


def sizes(height):
    """Font sizes in pixels for a window this tall: the word about 1/12 of it, the line under it half that."""
    title = max(height / 12.0, 1.0)
    return title, title / 2.0


def rgb(colour):
    """'#rrggbb' as three floats from 0 to 1, as cairo takes them."""
    return tuple(int(colour[i:i + 2], 16) / 255.0 for i in (1, 3, 5))


def load_gtk():
    """GTK 4, Pango and cairo through gi; imported here so the rest of this file loads without them."""
    import gi
    gi.require_version('Gtk', '4.0')
    gi.require_version('Pango', '1.0')
    gi.require_version('PangoCairo', '1.0')
    from gi.repository import GLib, Gtk, Pango, PangoCairo
    import cairo
    return GLib, Gtk, Pango, PangoCairo, cairo


def draw(cr, width, height, text, Pango, PangoCairo, cairo):
    """The whole picture: gradient, the word, the line under it. Nothing else."""
    gradient = cairo.LinearGradient(0, 0, 0, height)
    gradient.add_color_stop_rgb(0, *rgb(TOP))
    gradient.add_color_stop_rgb(1, *rgb(BOTTOM))
    cr.set_source(gradient)
    cr.paint()
    title_size, line_size = sizes(height)

    def layout(words, size, weight):
        result = PangoCairo.create_layout(cr)
        font = Pango.FontDescription.from_string(FAMILY)
        font.set_weight(weight)
        font.set_absolute_size(size * Pango.SCALE)
        result.set_font_description(font)
        result.set_text(words, -1)
        return result

    title = layout(TITLE, title_size, Pango.Weight.BOLD)
    under = layout(text, line_size, Pango.Weight.NORMAL)
    title_width, title_height = title.get_pixel_size()
    under_width, _ = under.get_pixel_size()
    # The word sits in the middle of the window; the line follows it with a small gap.
    top = (height - title_height) / 2.0
    cr.set_source_rgb(*rgb(INK))
    cr.move_to((width - title_width) / 2.0, top)
    PangoCairo.show_layout(cr, title)
    cr.set_source_rgb(*rgb(MUTED))
    cr.move_to((width - under_width) / 2.0, top + title_height + line_size * 0.4)
    PangoCairo.show_layout(cr, under)


def quiet_window(Gtk, paint):
    """One borderless window that only draws: no input, and no key or click closes it."""
    window = Gtk.Window(title=TITLE, decorated=False)
    area = Gtk.DrawingArea(can_focus=False, focusable=False)
    area.set_draw_func(paint)
    window.set_child(area)
    # A key or click never closes it (Alt+F4 sends a close request): only SIGTERM or the limit end it.
    window.connect('close-request', lambda _window: True)
    return window


def paint_black(_area, cr, _width, _height):
    cr.set_source_rgb(0, 0, 0)
    cr.paint()


def black_out(Gtk, display):
    """--black: one plain black fullscreen window on every output, also on one plugged in while it is up. Each
    window asks for its own output itself: a rule's ToggleFullscreen would put them all on one. Returns the
    windows by monitor."""
    windows = {}
    monitors = display.get_monitors()

    def cover_outputs(*_):
        present = [monitors.get_item(index) for index in range(monitors.get_n_items())]
        for monitor in present:
            if monitor not in windows:
                window = windows[monitor] = quiet_window(Gtk, paint_black)
                window.set_cursor_from_name('none')  # no pointer on a black screen
                window.fullscreen_on_monitor(monitor)
                window.present()
        for monitor in [monitor for monitor in windows if monitor not in present]:
            windows.pop(monitor).destroy()

    monitors.connect('items-changed', cover_outputs)
    cover_outputs()
    return windows


def main(argv=None):
    args = parse(argv)
    try:
        GLib, Gtk, Pango, PangoCairo, cairo = load_gtk()
        import gi
    except (ImportError, ValueError) as error:
        print(f'aresos-cover: GTK 4 is not available ({error})', file=sys.stderr)
        return 1
    # Without a GApplication, GTK names the Wayland app-id after the program name.
    GLib.set_prgname(BLACK_APP_ID if args.black else APP_ID)
    GLib.set_application_name(TITLE)
    gi.require_version('Gdk', '4.0')
    from gi.repository import Gdk
    # PyGObject may have tried GTK's start already on import; either way there must be a display now.
    if not Gtk.init_check() or Gdk.Display.get_default() is None:
        print('aresos-cover: no display to draw on', file=sys.stderr)
        return 1
    loop = GLib.MainLoop()

    def stop(*_):
        loop.quit()
        return GLib.SOURCE_REMOVE

    try:  # GLib 2.80 moved the Unix signal source to GLibUnix
        gi.require_version('GLibUnix', '2.0')
        from gi.repository import GLibUnix
        GLibUnix.signal_add(GLib.PRIORITY_HIGH, signal.SIGTERM, stop)
    except (ImportError, ValueError, AttributeError):
        GLib.unix_signal_add(GLib.PRIORITY_HIGH, signal.SIGTERM, stop)
    GLib.timeout_add(int(args.limit * 1000), stop)
    if args.black:
        windows = black_out(Gtk, Gdk.Display.get_default())
    else:
        text = line(args.again)
        window = quiet_window(Gtk, lambda _area, cr, width, height: draw(cr, width, height, text, Pango, PangoCairo,
                                                                         cairo))
        # Fullscreen and always on top come from labwc's window rule for this app-id (rc.xml), one place for both:
        # a fullscreen request of its own would be toggled off again by the rule's ToggleFullscreen on the first
        # map.
        window.present()
        windows = {None: window}
    loop.run()
    for window in windows.values():
        window.destroy()
    return 0


if __name__ == '__main__':
    sys.exit(main())
