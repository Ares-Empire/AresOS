From b7820667a24787fdf88a79a006f716d78d7f4ccc Mon Sep 17 00:00:00 2001
From: elviosak <33790211+elviosak@users.noreply.github.com>
Date: Fri, 9 Oct 2026 05:31:28 -0300
Subject: [PATCH] allow constraints for wlr_layer_surface_v1

AresOS: upstream labwc commit b7820667a24787fdf88a79a006f716d78d7f4ccc
(released in labwc 0.20.3, upstream issue #3745), adapted to labwc 0.9.6.

The logic is upstream's, line for line. Adapted, because 0.9.6 has no global
`server`:
- `server.active_view` is `seat->server->active_view`, or
  `server->active_view` in create_constraint();
- `server.seat.focused_layer` is `seat->focused_layer`, or
  `server->seat.focused_layer` in create_constraint();
- constrain_cursor() takes `server` as its first argument;
- the context line for wlr_seat_pointer_warp() uses `seat->seat`.
---
diff --git a/src/input/cursor.c b/src/input/cursor.c
--- a/src/input/cursor.c
+++ b/src/input/cursor.c
@@ -735,7 +735,10 @@ static void
 warp_cursor_to_constraint_hint(struct seat *seat,
 		struct wlr_pointer_constraint_v1 *constraint)
 {
-	if (!seat->server->active_view) {
+	struct view *view = seat->server->active_view;
+	struct wlr_layer_surface_v1 *layer = seat->focused_layer;
+	struct wlr_surface *surface = constraint ? constraint->surface : NULL;
+	if (!surface || (!view && !layer)) {
 		return;
 	}
 
@@ -743,9 +746,19 @@ warp_cursor_to_constraint_hint(struct seat *seat,
 			& WLR_POINTER_CONSTRAINT_V1_STATE_CURSOR_HINT) {
 		double sx = constraint->current.cursor_hint.x;
 		double sy = constraint->current.cursor_hint.y;
-		wlr_cursor_warp(seat->cursor, NULL,
-			seat->server->active_view->current.x + sx,
-			seat->server->active_view->current.y + sy);
+		int x = 0;
+		int y = 0;
+		if (view && view->surface == surface) {
+			x = view->current.x;
+			y = view->current.y;
+		} else if (layer && layer->surface == surface) {
+			struct wlr_scene_tree *scene_tree = surface->data;
+			x = scene_tree->node.x;
+			y = scene_tree->node.y;
+		} else {
+			return;
+		}
+		wlr_cursor_warp(seat->cursor, NULL, x + sx, y + sy);
 
 		/* Make sure we are not sending unnecessary surface movements */
 		wlr_seat_pointer_warp(seat->seat, sx, sy);
@@ -798,7 +811,9 @@ create_constraint(struct wl_listener *listener, void *data)
 	wl_signal_add(&wlr_constraint->events.destroy, &constraint->destroy);
 
 	struct view *view = server->active_view;
-	if (view && view->surface == wlr_constraint->surface) {
+	struct wlr_layer_surface_v1 *layer = server->seat.focused_layer;
+	if ((view && view->surface == wlr_constraint->surface)
+			|| (layer && layer->surface == wlr_constraint->surface)) {
 		constrain_cursor(server, wlr_constraint);
 	}
 }
@@ -837,7 +852,13 @@ constrain_cursor(struct server *server, struct wlr_pointer_constraint_v1
 static void
 apply_constraint(struct seat *seat, struct wlr_pointer *pointer, double *x, double *y)
 {
-	if (!seat->server->active_view) {
+	struct view *view = seat->server->active_view;
+	struct wlr_layer_surface_v1 *layer = seat->focused_layer;
+	struct wlr_surface *surface = seat->current_constraint
+		? seat->current_constraint->surface
+		: NULL;
+
+	if (!surface || (!view && !layer)) {
 		return;
 	}
 	if (!seat->current_constraint
@@ -850,8 +871,16 @@ apply_constraint(struct seat *seat, struct wlr_pointer *pointer, double *x, doub
 	double sx = seat->cursor->x;
 	double sy = seat->cursor->y;
 
-	sx -= seat->server->active_view->current.x;
-	sy -= seat->server->active_view->current.y;
+	if (view && view->surface == surface) {
+		sx -= view->current.x;
+		sy -= view->current.y;
+	} else if (layer && layer->surface == surface) {
+		struct wlr_scene_tree *scene_tree = surface->data;
+		sx -= scene_tree->node.x;
+		sy -= scene_tree->node.y;
+	} else {
+		return;
+	}
 
 	double sx_confined, sy_confined;
 	if (!wlr_region_confine(&seat->current_constraint->region, sx, sy,
