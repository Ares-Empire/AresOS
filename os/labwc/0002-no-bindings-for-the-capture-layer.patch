 		return false;
 	}
+	if (seat_bindings_inhibited(&server->seat)) {
+		return false;
+	}
 
 	struct mousebind *mousebind;
 	bool double_click = is_double_click(rc.doubleclick_time, button, ctx);
@@ -1426,7 +1436,8 @@ process_cursor_axis(struct server *server, enum wl_pointer_axis orientation,
 	}
 
 	bool consumed = false;
-	if (direction != LAB_DIRECTION_INVALID) {
+	if (direction != LAB_DIRECTION_INVALID
+			&& !seat_bindings_inhibited(&server->seat)) {
 		struct mousebind *mousebind;
 		wl_list_for_each(mousebind, &rc.mousebinds, link) {
 			if (ctx.type == LAB_NODE_CLIENT
diff --git a/src/input/keyboard.c b/src/input/keyboard.c
--- a/src/input/keyboard.c
+++ b/src/input/keyboard.c
@@ -192,10 +192,14 @@ match_keybinding_for_sym(struct server *server, uint32_t modifiers,
 		xkb_keysym_t sym, xkb_keycode_t xkb_keycode)
 {
 	struct keybind *keybind;
+	bool inhibited = seat_bindings_inhibited(&server->seat);
 	wl_list_for_each(keybind, &rc.keybinds, link) {
 		if (modifiers ^ keybind->modifiers) {
 			continue;
 		}
+		if (inhibited && !keybind->allow_when_inhibited) {
+			continue;
+		}
 		if (view_inhibits_actions(server->active_view, &keybind->actions)) {
 			continue;
 		}
@@ -488,11 +492,20 @@ handle_compositor_keybindings(struct keyboard *keyboard,
 	struct wlr_keyboard *wlr_keyboard = keyboard->wlr_keyboard;
 	struct keyinfo keyinfo = get_keyinfo(wlr_keyboard, event->keycode);
 	bool locked = seat->server->session_lock_manager->locked;
+	bool inhibited = seat_bindings_inhibited(seat);
 
 	key_state_set_pressed(event->keycode,
 		event->state == WL_KEYBOARD_KEY_STATE_PRESSED);
 
 	if (event->state == WL_KEYBOARD_KEY_STATE_RELEASED) {
+		if (inhibited && cur_keybind && !cur_keybind->allow_when_inhibited) {
+			/*
+			 * Pressed before the inhibiting layer took the keyboard:
+			 * drop the pending on-release action. The release is
+			 * still kept from clients below, as the press was.
+			 */
+			cur_keybind = NULL;
+		}
 		if (cur_keybind && cur_keybind->on_release) {
 			key_state_bound_key_remove(event->keycode);
 			if (locked && !cur_keybind->allow_when_locked) {
@@ -513,11 +526,12 @@ handle_compositor_keybindings(struct keyboard *keyboard,
 	}
 
 	/*
-	 * Ignore labwc keybindings if the session is locked.
+	 * Ignore labwc keybindings if the session is locked, and menu and
+	 * window-switcher keys also while bindings are inhibited.
 	 * It's important to do this after key_state_set_pressed() to ensure
 	 * _all_ key press/releases are registered
 	 */
-	if (!locked) {
+	if (!locked && !inhibited) {
 		if (server->input_mode == LAB_INPUT_STATE_MENU) {
 			key_state_store_pressed_key_as_bound(event->keycode);
 			handle_menu_keys(server, &keyinfo.translated);
diff --git a/src/seat.c b/src/seat.c
--- a/src/seat.c
+++ b/src/seat.c
@@ -1,6 +1,7 @@
 // SPDX-License-Identifier: GPL-2.0-only
 #include <assert.h>
 #include <stdbool.h>
+#include <string.h>
 #include <strings.h>
 #include <wlr/backend/libinput.h>
 #include <wlr/types/wlr_cursor.h>
@@ -862,6 +863,25 @@ seat_set_focus_layer(struct seat *seat, struct wlr_layer_surface_v1 *layer)
 	seat->focused_layer = layer;
 }
 
+/* The namespace of the capture surface of aresos-input-portal */
+#define LAB_INHIBITING_LAYER_NAMESPACE "aresos-input-barrier"
+
+bool
+seat_bindings_inhibited(struct seat *seat)
+{
+	struct wlr_layer_surface_v1 *layer = seat->focused_layer;
+	/*
+	 * seat->focused_layer is also set when the session lock kept the
+	 * keyboard, so ask the seat who really has it.
+	 */
+	return layer && layer->surface
+		&& layer->surface == seat->seat->keyboard_state.focused_surface
+		&& layer->current.keyboard_interactive
+			== ZWLR_LAYER_SURFACE_V1_KEYBOARD_INTERACTIVITY_EXCLUSIVE
+		&& layer->namespace
+		&& !strcmp(layer->namespace, LAB_INHIBITING_LAYER_NAMESPACE);
+}
+
 void
 seat_output_layout_changed(struct seat *seat)
 {
