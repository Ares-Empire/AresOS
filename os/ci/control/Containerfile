# Package 18c, B2: the Control test layer. Only the check_build=control disk
# uses it; the release and the CI layer's own pass stay without it.
# Built by os/ci/control/runner.sh (podman build --no-hosts) from the checkout.
FROM localhost/aresos:vm
COPY os/ci/control/actions.py /usr/libexec/aresos-ci/actions.d/control.py
COPY os/ci/control/release_checks.py os/ci/control/own-mcp.py /usr/libexec/aresos-ci/control/
# Per run: the pinned Claude Code (checked by runner.sh), the fixture CA
# certificate (never its key) and the fixture servers' names at 10.0.2.2.
COPY vm-work/control-layer/claude vm-work/control-layer/fixture-ca.crt vm-work/control-layer/hosts /tmp/aresos-ci-control/
RUN install -Dm0755 /tmp/aresos-ci-control/claude /usr/libexec/aresos-ci/control/claude-2.1.319 && \
    install -Dm0644 /tmp/aresos-ci-control/fixture-ca.crt /etc/pki/ca-trust/source/anchors/aresos-ci-mail-fixture.crt && \
    update-ca-trust extract && \
    cat /tmp/aresos-ci-control/hosts >> /etc/hosts && \
    grep -qx '10.0.2.2 greenmail dovecot' /etc/hosts && \
    rm -rf /tmp/aresos-ci-control && \
    bootc container lint
