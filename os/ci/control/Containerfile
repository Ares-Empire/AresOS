# Package 18c, B2: the Control test layer. Only the check_build=control disk
# uses it; the release and the CI layer's own pass stay without it.
# Built by os/ci/control/runner.sh (podman build --no-hosts) from the checkout.
FROM localhost/aresos:vm
COPY os/ci/control/actions.py /usr/libexec/aresos-ci/actions.d/control.py
# Check 8's file search (tree_scan.py) runs as root and, for a FUSE mount, as its owner: readable by every user.
COPY os/ci/control/release_checks.py os/ci/control/own-mcp.py os/ci/control/tree_scan.py /usr/libexec/aresos-ci/control/
# Step 2b: the Claude Code sessions with B1's terminal driver and model double (unchanged), his own hooks, and Mail's
# flows from control/ci/image/.
COPY os/ci/control/sessions.py os/ci/control/own-hook.py control/boundary/interactive_driver.py \
     control/boundary/interactive_model.py control/ci/image/mail_flows.py /usr/libexec/aresos-ci/control/
# The Chrome follow-up: Chrome's storage plan and timing tests (control/chrome_tests, with the Mail suite's storage
# faults) run on the image's own Python and SQLite against the installed code; only the test modules come in here.
COPY control/chrome_tests/*.py /usr/libexec/aresos-ci/control/storage-suite/chrome_tests/
COPY control/response_checks.py /usr/libexec/aresos-ci/control/storage-suite/chrome_tests/
COPY control/mail_tests/storage_faults.py /usr/libexec/aresos-ci/control/storage-suite/mail_tests/
# Brief 18c-b, item 5: the Chrome pass's actions and its test-only pieces, never in a release. chrome_layer.py packs
# the install proof's probe (its own key, policy file and host), lays out an extension as he would load one by hand,
# and packs bundles B and C, each key inside one pack.py call; cdp.py and netlog.py serve the starts that need them.
COPY os/ci/control/chrome_actions.py /usr/libexec/aresos-ci/actions.d/chrome.py
COPY control/chrome/ci/install/cdp.py control/chrome/ci/install/netlog.py /usr/libexec/aresos-ci/control/chrome/
COPY control/chrome/packaging/pack.py control/chrome/packaging/update.xml control/chrome/packaging/policy.json \
     control/chrome/packaging/native-host.json /tmp/aresos-ci-chrome/packaging/
COPY control/chrome/extension /tmp/aresos-ci-chrome/extension
COPY control/chrome/ci/install/probe /tmp/aresos-ci-chrome/probe
COPY control/chrome/ci/install/probe_host.py os/ci/control/chrome_layer.py /tmp/aresos-ci-chrome/
RUN python3 -I -B /tmp/aresos-ci-chrome/chrome_layer.py /tmp/aresos-ci-chrome && test ! -e /tmp/aresos-ci-chrome
# Per run: the pinned Claude Code (checked by runner.sh), the fixture CA
# certificate (never its key) and the fixture servers' names at 10.0.2.2.
COPY vm-work/control-layer/claude vm-work/control-layer/fixture-ca.crt vm-work/control-layer/hosts /tmp/aresos-ci-control/
RUN install -Dm0755 /tmp/aresos-ci-control/claude /usr/libexec/aresos-ci/control/claude-2.1.319 && \
    install -Dm0644 /tmp/aresos-ci-control/fixture-ca.crt /etc/pki/ca-trust/source/anchors/aresos-ci-mail-fixture.crt && \
    update-ca-trust extract && \
    cat /tmp/aresos-ci-control/hosts >> /etc/hosts && \
    grep -qx '10.0.2.2 greenmail dovecot' /etc/hosts && \
    rm -rf /tmp/aresos-ci-control && \
    test -x /usr/bin/tmux && \
    bootc container lint
