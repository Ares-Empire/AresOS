# The client and its build dependencies stay on the check-build path.
FROM registry.fedoraproject.org/fedora@sha256:b02bb57e0e8ec2e057f0826436d2fc58765fa2b3b82d2abd322ece06e39c88f5 AS clients
RUN dnf5 -y -q --setopt=install_weak_deps=False install gcc pkgconf-pkg-config wayland-devel \
    wayland-protocols-devel wlr-protocols-devel libxkbcommon-devel
COPY os/input-portal/harness/clients/ /src/
RUN bash -eu -c ' \
    protocols=$(pkg-config --variable=pkgdatadir wayland-protocols); \
    for xml in "$protocols"/stable/xdg-shell/xdg-shell.xml \
        "$protocols"/unstable/{xdg-decoration,pointer-constraints,relative-pointer}/*.xml \
        /usr/share/wlr-protocols/unstable/{wlr-virtual-pointer,wlr-layer-shell,wlr-output-management}-unstable-v1.xml \
        /src/virtual-keyboard-unstable-v1.xml; do \
        name=$(basename "$xml" .xml); \
        wayland-scanner client-header "$xml" "/tmp/$name-client-protocol.h"; \
        wayland-scanner private-code "$xml" "/tmp/$name-protocol.c"; \
    done; \
    gcc -std=c11 -O1 -Wall -Werror -I/tmp -o /wl-harness /src/wl-harness.c /tmp/*-protocol.c \
        $(pkg-config --cflags --libs wayland-client xkbcommon)'

FROM localhost/aresos:vm
COPY --from=clients /wl-harness /usr/libexec/aresos-ci/wl-harness
COPY os/ci/deskflow/actions.py /usr/libexec/aresos-ci/actions.d/deskflow.py
COPY os/ci/deskflow/session /usr/libexec/aresos-ci/deskflow-session
# The polkit agent otherwise activates the frontend and starts the backend in the control boots.
# The identity check starts the real frontend explicitly, after the DRM comparison.
RUN dnf5 -y -q --setopt=install_weak_deps=False install wlr-randr && dnf5 clean all && \
    rm /usr/share/dbus-1/services/org.freedesktop.portal.Desktop.service && \
    sed -i '/^\[initial_session\]/,+1 s|^command = "/usr/bin/aresos-session"$|command = "/usr/libexec/aresos-ci/deskflow-session"|' /etc/greetd/config.toml && \
    grep -qx 'command = "/usr/libexec/aresos-ci/deskflow-session"' /etc/greetd/config.toml && \
    bootc container lint
