# Only the disk-under-test uses this layer; the release tag stays independent.
FROM localhost/aresos:ci
COPY os/ci/channel.py os/ci/overlay/checks.py os/ci/overlay/pam_check.py os/ci/overlay/updater_regressions.py /usr/libexec/aresos-ci/
COPY os/tests/guest.sh os/tests/power-events.py /usr/libexec/aresos-ci/
COPY os/ci/overlay/aresos-ci.service os/ci/overlay/logind-debug.conf os/ci/overlay/journal-debug.conf /tmp/aresos-ci/
COPY os/ci/overlay/updater-generator os/ci/overlay/static-canary.service /tmp/aresos-ci/
RUN install -Dm0644 /tmp/aresos-ci/aresos-ci.service /usr/lib/systemd/system/aresos-ci.service && \
    install -Dm0644 /tmp/aresos-ci/logind-debug.conf /etc/systemd/system/systemd-logind.service.d/90-aresos-ci.conf && \
    install -Dm0644 /tmp/aresos-ci/journal-debug.conf /etc/systemd/journald.conf.d/99-aresos-ci.conf && \
    install -Dm0755 /tmp/aresos-ci/updater-generator /usr/lib/systemd/system-generators/aresos-ci-updater-regression && \
    install -Dm0644 /tmp/aresos-ci/static-canary.service /etc/systemd/system/aresos-ci-static-canary.service && \
    rm -rf /tmp/aresos-ci && \
    mkdir -p /usr/lib/systemd/system/multi-user.target.wants && \
    ln -s ../aresos-ci.service /usr/lib/systemd/system/multi-user.target.wants/aresos-ci.service && \
    bootc container lint
