FROM ghcr.io/ublue-os/bazzite-nvidia-open@sha256:ed93d2158a1bcba16b226bfb3ab6391446d11466646188c800b982d709435151 AS packages

COPY . /tmp/aresos/
RUN test ! -e /tmp/aresos/ci && bash /tmp/aresos/build.sh packages

# Package 23: every image build builds the AresOS mod jar from this exact source
# revision. The source stage fetches that commit in the pinned base (which has
# curl) and keeps only mod/ (and control/, package 18c); the mod stage runs only Gradle on it, in the
# digest-pinned JDK (minecraft/desktop.lock.json, "builder"; it has no curl or
# wget). The configure step below accepts the jar only with its pinned SHA-256,
# unless os/ci/check-build.sh says this build is thrown away (ARESOS_BUILD_KIND).
FROM ghcr.io/ublue-os/bazzite-nvidia-open@sha256:ed93d2158a1bcba16b226bfb3ab6391446d11466646188c800b982d709435151 AS source
ARG ARESOS_SOURCE_REVISION=unrecorded
COPY build.sh /tmp/aresos-mod/build.sh
RUN bash /tmp/aresos-mod/build.sh source "$ARESOS_SOURCE_REVISION" /source

FROM docker.io/library/eclipse-temurin:25.0.5_8-jdk-noble@sha256:95e350ad1eb738f943e141640f7e3d797e483359a3b33c3864255bfd1ad71f8a AS mod
ARG ARESOS_SOURCE_REVISION=unrecorded
COPY build.sh /tmp/aresos-mod/build.sh
COPY --from=source /source/mod /tmp/aresos-mod/mod
RUN bash /tmp/aresos-mod/build.sh mod /tmp/aresos-mod/mod /out "$ARESOS_SOURCE_REVISION"

FROM packages AS aresos
ARG ARESOS_SOURCE_REVISION=unrecorded
# release: the mod jar must be its pin. Only os/ci/check-build.sh passes throwaway.
ARG ARESOS_BUILD_KIND=release
LABEL org.opencontainers.image.source="https://github.com/Ares-Empire/AresOS" \
      org.opencontainers.image.revision="${ARESOS_SOURCE_REVISION}"
COPY --from=mod /out/aresos.jar /tmp/aresos/minecraft/aresos.jar
# Package 18c: the Control tools from the same commit (the source stage keeps control/).
COPY --from=source /source/control /tmp/aresos/control
RUN cp -a /tmp/aresos/config/. / && \
    cp -a /tmp/aresos/policy /usr/share/aresos/ && \
    install -m 0755 /tmp/aresos/tests/audit.py /usr/libexec/aresos-audit && \
    bash /tmp/aresos/build.sh control && \
    bash /tmp/aresos/build.sh configure && bootc container lint
