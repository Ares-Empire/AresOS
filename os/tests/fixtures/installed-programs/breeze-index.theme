[Icon Theme]
Name=Breeze
Comment=A test theme laid out the way Breeze is: <context>/<size> folders described here

Inherits=hicolor
DisplayDepth=32
DesktopDefault=48
DesktopSizes=16,22,32,48,64,128,256
KDE-Extensions=.svg

# Ordered by context, then size, as Breeze orders its own. apps/32@2x is listed here on purpose: a folder at scale 2
# among the plain ones must be left out.
Directories=actions/16,actions/22,apps/16,apps/32,apps/32@2x,apps/48,apps/64,places/64,status/22,status/48
ScaledDirectories=apps/16@2x,apps/32@2x

# Fixed size, monochrome
[actions/16]
Size=16
Context=Actions
Type=Fixed

[actions/22]
Size=22
Context=Actions
Type=Fixed

[apps/16]
Size=16
Context=Applications
Type=Fixed

[apps/16@2x]
Size=16
Scale=2
Context=Applications
Type=Fixed

# Fixed size, colour
[apps/32]
Size=32
Context=Applications
Type=Fixed

[apps/32@2x]
Size=32
Scale=2
Context=Applications
Type=Fixed

# Scalable: the application pictures
[apps/48]
Size=48
Context=Applications
Type=Scalable
MinSize=48
MaxSize=256

[apps/64]
Size=64
Context=Applications
Type=Fixed

[places/64]
Size=64
Context=Places
Type=Scalable
MinSize=64
MaxSize=256

[status/22]
Size=22
Context=Status
Type=Fixed

[status/48]
Size=48
Context=Status
Type=Scalable
MinSize=48
MaxSize=256
