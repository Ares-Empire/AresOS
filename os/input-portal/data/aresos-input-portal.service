[Unit]
Description=AresOS InputCapture and Clipboard portal backend for labwc
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=dbus
BusName=org.freedesktop.impl.portal.desktop.aresos-input
ExecStart=/usr/libexec/aresos-input-portal
Restart=on-failure
RestartSec=1
Slice=session.slice
