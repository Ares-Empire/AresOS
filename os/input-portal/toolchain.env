# Package 316: the exact inputs the input portal is built and audited with.
# build.sh and dev/container.sh read this file with bash's `source`: plain NAME=value lines only, no commands.
# Changing a value is a reviewed change: build.sh refuses a compiler other than RUSTC_COMMIT.

# The builder: Docker's official Rust image rust:1.99.1-slim-trixie (Debian 13), by the digest of its image index.
# Its linux/amd64 image is sha256:e97df055c54a05160e7c67ba3b2963de6ddb95903911baf8922dbcd1b394f698.
BUILDER_IMAGE=docker.io/library/rust@sha256:f6c4a35d21dbb3c89d7a8d056c193e94fc09037f2b58dd858b09c39a47dd02d7
# What that image must hold (`rustc -vV`: release and commit-hash).
RUSTC_RELEASE=1.99.1
RUSTC_COMMIT=58cf8f9c35b355199727627d07ae34a4e2846d67

# What the build needs and the image lacks: libxkbcommon, which smithay-client-toolkit links through the xkbcommon
# crate, and pkg-config, which its build script finds the library with. Exact Debian versions, from the archive
# snapshot the image itself was built from (its /etc/apt/sources.list.d names it). The library is linked
# dynamically, so none of it ends up in the binary.
DEBIAN_SNAPSHOT=20261104T212339Z
DEBIAN_PACKAGES='libxkbcommon-dev=1.7.0-2 pkgconf=1.8.1-4'

# cargo audit: RustSec's own release build (static, runs in the builder image with no network), and the advisory
# database at one commit (2026-11-19 08:55 UTC).
CARGO_AUDIT_VERSION=0.23.0
CARGO_AUDIT_URL=https://github.com/rustsec/rustsec/releases/download/cargo-audit%2Fv0.23.0/cargo-audit-x86_64-unknown-linux-musl-v0.23.0.tgz
CARGO_AUDIT_SHA256=4f01c74ed84b2dffd0b1d37012a62cdf2a92c96e25bdf8eec7fcc0d4d3eb7811
ADVISORY_DB_URL=https://github.com/RustSec/advisory-db
ADVISORY_DB_COMMIT=7133866a6b44d6d3e1994ae6a48a296553c3c3da
