  "mixins": [{"config": "aresos.client.mixins.json", "environment": "client"}],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": ">=0.161.0+26.2"
  }
