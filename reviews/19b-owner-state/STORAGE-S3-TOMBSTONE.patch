+        self.store.confirm_restore()
+        self.assertIsNone(self.store.get('op:' + op['id']))
+        self.assertTrue(self.store.get('notice:warning')['ack'])
+        before = dict(self.store.owner_projection.iter_items())
+        self.store.close()
