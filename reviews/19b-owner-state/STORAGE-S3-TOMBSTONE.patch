diff --git a/control/aresos_control/owner_projection.py b/control/aresos_control/owner_projection.py
new file mode 100644
index 00000000..8a255796
--- /dev/null
+++ b/control/aresos_control/owner_projection.py
@@ -0,0 +1,414 @@
+"""Compact owner-state references, published by the existing journal commits.
+
+This candidate is a secondary read model, never authority to replay an effect.
+The SQLite records keep wording and complete contexts. Here only identities,
+fingerprints and small state codes survive. Archival separates resolved keys
+from live work; it preserves their independent commit provenance in history.
+"""
+import hashlib
+import heapq
+import json
+import os
+from pathlib import Path
+import struct
+import zlib
+
+from .common import Refused, canonical, cleanup, digest, storage_stream
+
+MAGIC = b'AO19B3\0\n'
+HEADER = struct.Struct('>IQ')  # compressed length, existing journal sequence
+STATES = {s: i for i, s in enumerate(('reserved', 'submitting', 'started', 'unknown',
+          'partial', 'done', 'failed', 'refused', 'open', 'checked', 'saved'))}
+PREFIXES = ('op:', 'intent:', 'export:', 'notice:', 'mail:filing:', 'mail:rename:',
+            'mail:account:', 'archived:', 'archive:')
+KEYS = {'generation', 'restore_pending'}
+
+
+def selected(key):
+    return key in KEYS or key.startswith(PREFIXES)
+
+
+def fact(key, value):
+    """The compact semantic contract. No authored text or complete contexts."""
+    if value is None:
+        return None
+    if key in KEYS:
+        return {'v': value}
+    result = {}
+    for field, code in (('id', 'i'), ('app', 'a'), ('source_key', 'k'),
+                        ('evidence_fingerprint', 'f'), ('repair_of', 'r')):
+        if field in value:
+            result[code] = value[field]
+    if 'state' in value:
+        result['s'] = STATES[value['state']]
+    for field, code in (('notice', 'n'), ('ack', 'x'), ('check_open', 'o'),
+                        ('onboarded', 'b'), ('ready', 'y'), ('context_version', 'v')):
+        if field in value:
+            result[code] = int(value[field])
+    if 'expires' in value:
+        result['e'] = value['expires']
+    # Each hash binds the corresponding committed structured evidence. This
+    # avoids copying remote text, approval input or large identity collections.
+    for field, code in (('context', 'c'), ('stages', 't'), ('reason', 'q'),
+                        ('warning_checks', 'w'), ('sent_copy_check', 'j'),
+                        ('roles_before', 'l'), ('qualification', 'u'),
+                        ('untrusted_content', 'd')):
+        if field in value:
+            result[code] = digest(value[field])
+    # These remaining source values contain identities/evidence rather than
+    # prose. Binding the whole source catches new qualification/source fields.
+    if not key.startswith(('op:', 'intent:', 'notice:')):
+        result['h'] = digest(value)
+    return result
+
+
+def delta(old, new):
+    if new is None:
+        return None
+    return {key: new.get(key) for key in old.keys() | new.keys()
+            if old.get(key) != new.get(key)}
+
+
+def apply(old, patch):
+    if patch is None:
+        return None
+    return {k: v for k, v in {**(old or {}), **patch}.items() if v is not None}
+
+
+class OwnerProjection:
+    def __init__(self, store):
+        self.store = store
+        self.path = store.evidence_dir / 'owner-state.bin'
+        self.directory = store.evidence_dir / 'owner-history'
+        self.tombstones = store.evidence_dir / 'owner-tombstones.bin'
+        self.previous = bytes(32)
+        self._recover_tail()
+
+    def _fences(self):
+        for record in self.store.events:
+            yield record['seq'], bytes.fromhex(record['hash'])
+
+    def _records(self, path, repair=False):
+        with storage_stream(open(path, 'rb' if not repair else 'r+b')) as stream:
+            if stream.read(len(MAGIC)) != MAGIC:
+                raise Refused('evidence_corrupt', 'Owner projection format is damaged.')
+            previous, last = bytes(32), 0
+            fences = iter(self._fences())
+            fence = next(fences, None)
+            while True:
+                offset = stream.tell()
+                header = stream.read(HEADER.size)
+                if not header:
+                    return
+                if len(header) != HEADER.size:
+                    if repair:
+                        stream.truncate(offset)
+                        os.fsync(stream.fileno())
+                        return
+                    return  # A partial final append cannot have a fence.
+                length, seq = HEADER.unpack(header)
+                if length > 16 * 1024 * 1024 or seq < last:
+                    raise Refused('evidence_corrupt', 'Owner projection record bound/order is damaged.')
+                payload, claimed = stream.read(length), stream.read(32)
+                while fence and fence[0] < seq:
+                    fence = next(fences, None)
+                if len(payload) != length or len(claimed) != 32 or fence is None or fence[0] != seq:
+                    if repair:
+                        stream.truncate(offset)
+                        os.fsync(stream.fileno())
+                        return
+                    if fence is None or fence[0] != seq:
+                        return  # Complete but unpublished tail before a fence.
+                    raise Refused('evidence_corrupt', 'Owner projection has no complete journal fence.')
+                expected = hashlib.sha256(previous + header + payload + fence[1]).digest()
+                if claimed != expected:
+                    raise Refused('evidence_corrupt', 'Owner projection chain is damaged.')
+                try:
+                    data = json.loads(zlib.decompress(payload))
+                except (ValueError, zlib.error) as exc:
+                    raise Refused('evidence_corrupt', 'Owner projection payload is damaged.') from exc
+                previous, last = claimed, seq
+                yield seq, data, claimed, HEADER.size + length + 32
+
+    def _recover_tail(self):
+        if not self.path.exists():
+            self.store.ledger.admit(65536)
+            fd = os.open(self.path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
+            with storage_stream(os.fdopen(fd, 'wb')) as stream:
+                stream.write(MAGIC)
+                stream.flush()
+                os.fsync(stream.fileno())
+            from .storage import sync_directory
+            sync_directory(self.store.evidence_dir)
+        for _, _, chain, _ in self._records(self.path, repair=True):
+            self.previous = chain
+
+    def _append(self, path, seq, changes, previous):
+        payload = zlib.compress(canonical(changes).encode(), 9)
+        header = HEADER.pack(len(payload), seq)
+        # There is only one stored hash: the predecessor is implicit and the
+        # existing permanent journal supplies the transaction identity.
+        fence = self.store.head_hash if seq == self.store.sequence else self.store.events[seq - 1]['hash']
+        chain = hashlib.sha256(previous + header + payload + bytes.fromhex(fence)).digest()
+        fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_NOFOLLOW)
+        with storage_stream(os.fdopen(fd, 'ab', buffering=0)) as stream:
+            data = header + payload + chain
+            if stream.write(data) != len(data):
+                raise OSError(28, 'Short owner projection write')
+            os.fsync(stream.fileno())
+        return chain
+
+    def prepare(self, event):
+        changes = {}
+        restored = dict(self.iter_items()) if event.get('space', {}).get('restoring') else None
+        for key, value in event['set'].items():
+            if selected(key):
+                # A restored working database can be older than this stream.
+                # Diff restore replacements against the independent facts so
+                # removed fields do not linger in the derived view.
+                old = restored.get(key) if restored is not None else fact(key, self.store.get(key))
+                new = fact(key, value)
+                if old != new:
+                    changes[key] = delta(old or {}, new)
+        if changes:
+            # The fence is about to be appended, so its hash is not yet in the
+            # journal. Encoding uses that exact already-validated identity.
+            payload = zlib.compress(canonical(changes).encode(), 9)
+            header = HEADER.pack(len(payload), event['seq'])
+            chain = hashlib.sha256(self.previous + header + payload + bytes.fromhex(event['record']['hash'])).digest()
+            fd = os.open(self.path, os.O_WRONLY | os.O_APPEND | os.O_NOFOLLOW)
+            with storage_stream(os.fdopen(fd, 'ab', buffering=0)) as stream:
+                data = header + payload + chain
+                if stream.write(data) != len(data):
+                    raise OSError(28, 'Short owner projection write')
+                os.fsync(stream.fileno())
+            self.previous = chain
+
+    def seed(self):
+        # A pre-projection store keeps its existing history untouched. Import
+        # only surviving facts and charge their physical cost before writing.
+        if self.path.stat().st_size == len(MAGIC) and self.store.committed:
+            data = {k: fact(k, v) for k, v in self.store.iter_items('') if selected(k)}
+            self.store.ledger.admit(len(canonical(data).encode()) * 3 + 65536)
+            self.previous = self._append(self.path, self.store.committed, data, self.previous)
+
+    def records(self):
+        committed = 0
+        with storage_stream(open(self.store.journal.name, 'rb')) as stream:
+            for line in stream:
+                if not line.endswith(b'\n'):
+                    break
+                record = json.loads(line)
+                if 'commit' in record:
+                    committed = record['commit']
+        streams = [((seq, data) for seq, data, _, _ in self._records(self.path)), self.retired()]
+        for seq, data in heapq.merge(*streams, key=lambda row: row[0]):
+            if seq <= committed:
+                yield seq, data
+
+    def iter_items(self, prefix=''):
+        cursor = ''
+        while True:
+            batch = {}
+            for _, changes in self.records():
+                for key, patch in changes.items():
+                    if key <= cursor or not key.startswith(prefix):
+                        continue
+                    if key not in batch and len(batch) == 32:
+                        largest = max(batch)
+                        if key > largest:
+                            continue
+                        del batch[largest]
+                    batch[key] = apply(batch.get(key), patch)
+            if not batch:
+                return
+            for key in sorted(batch):
+                if batch[key] is not None:
+                    yield key, batch[key]
+            cursor = max(batch)
+
+    def _export(self, name, checksum):
+        """Re-read the whole published export before trusting any entry in it."""
+        if Path(name).name != name:
+            raise Refused('evidence_corrupt', 'Owner tombstone export identity is damaged.')
+        path = self.store.evidence_dir / 'archives' / name
+        actual = hashlib.sha256()
+        try:
+            with storage_stream(open(path, 'rb')) as stream:
+                for line in stream:
+                    actual.update(line)
+            if actual.hexdigest() != checksum:
+                raise ValueError('archive checksum')
+            with storage_stream(open(path, 'rb')) as stream:
+                for line in stream:
+                    yield json.loads(line)
+        except (OSError, ValueError) as exc:
+            raise Refused('evidence_corrupt', 'Owner tombstone archive is missing or damaged.') from exc
+
+    def retired(self, full=False, path=None):
+        path = path or self.tombstones
+        if not path.exists():
+            return
+        for seq, data, _, _ in self._records(path):
+            name, manifest, tombstones = data
+            rows, entries = {}, {}
+            keys = {t[0] for t in tombstones}
+            keys.update('notice:' + identity for t in tombstones for identity in t[2])
+            for entry in self._export(name, manifest['sha256']):
+                if 'event' in entry:
+                    for key, value in entry['event']['set'].items():
+                        if key in keys:
+                            rows[key], entries[key] = value, entry
+                elif entry.get('key') in keys:
+                    rows[entry['key']], entries[entry['key']] = entry['value'], entry
+            changes = {'archive:' + name: manifest if full else fact('archive:' + name, manifest)}
+            for key, state, acknowledgements, entry_hash in tombstones:
+                if key not in entries or digest(entries[key]) != entry_hash:
+                    raise Refused('evidence_corrupt', 'Owner tombstone export entry is missing or damaged.')
+                value = rows[key]
+                if value is not None and STATES.get(value.get('state')) != state:
+                    raise Refused('evidence_corrupt', 'Owner tombstone final state differs from its export.')
+                if key.startswith('op:'):
+                    changes[key] = None
+                    archived = 'archived:' + key[3:]
+                    changes[archived] = {'seq': seq} if full else fact(archived, {'seq': seq})
+                else:
+                    changes[key] = value if full else fact(key, value)
+                for identity in acknowledgements:
+                    notice = rows.get('notice:' + identity)
+                    if notice is None or not notice.get('ack'):
+                        raise Refused('evidence_corrupt', 'Owner tombstone acknowledgement differs from its export.')
+                    changes['notice:' + identity] = notice if full else fact('notice:' + identity, notice)
+            if not full:
+                yield seq, {key: None for key in changes}
+            yield seq, changes
+
+    def compact(self):
+        """Retire resolved keys; unresolved sources never leave the live file.
+
+        Retire only to an existing, re-read archive. The tombstone chain binds
+        both its final identity/state and the exact full archive entry.
+        """
+        notices = self.store.items('notice:')
+        def resolved(key):
+            if key in KEYS:
+                return False
+            value = self.store.get(key)
+            if value is None:
+                return True
+            if key.startswith('notice:'):
+                return bool(value.get('ack'))
+            if any(not n.get('ack') and (n.get('source_key') == key or
+                   n.get('untrusted_content', {}).get('operation_id') == value.get('id')) for _, n in notices):
+                return False
+            if value.get('check_open') or value.get('sent_copy_check', {}).get('state') == 'open':
+                return False
+            if key.startswith(('op:', 'mail:filing:', 'mail:rename:')):
+                return value.get('state') in {'done', 'failed', 'refused'} and (not value.get('notice') or value.get('ack'))
+            return key.startswith(('archived:', 'archive:'))
+        # Every retired key needs its latest value in the confirmed export.
+        # A newer value which has not yet been exported must stay live.
+        active = list(self._records(self.path))
+        required = {}
+        for seq, data, _, _ in active:
+            for key in data:
+                required.setdefault(key, set()).add(seq)
+        available = {}
+        for key, manifest in self.store.items('archive:'):
+            name = key[8:]
+            rows, entries, coverage = {}, {}, {}
+            for entry in self._export(name, manifest['sha256']):
+                if 'event' in entry:
+                    for source, value in entry['event']['set'].items():
+                        rows[source], entries[source] = value, entry
+                        coverage.setdefault(source, set()).add(entry['event']['seq'])
+                elif 'key' in entry:
+                    rows[entry['key']], entries[entry['key']] = entry['value'], entry
+            for source, value in rows.items():
+                if not selected(source) or not resolved(source):
+                    continue
+                current = self.store.get(source)
+                archived_op = source.startswith('op:') and current is None and self.store.get('archived:' + source[3:])
+                covered = coverage.get(source, set())
+                if archived_op:
+                    covered = covered | {archived_op['seq']}
+                if not required.get(source, set()) <= covered:
+                    continue
+                if value == current or archived_op and value and value.get('state') in {'done', 'failed', 'refused'}:
+                    available[source] = (name, manifest, value, entries[source])
+        retired_keys = set(available)
+        for key in list(retired_keys):
+            if key.startswith('op:'):
+                retired_keys.add('archived:' + key[3:])
+            retired_keys.add('archive:' + available[key][0])
+        live, retired = [], []
+        for seq, data, _, _ in active:
+            if seq > self.store.committed:
+                raise Refused('journal_incomplete', 'An unpublished owner projection cannot be archived.')
+            groups = ({}, {})
+            for key, patch in data.items():
+                groups[int(key in retired_keys)][key] = patch
+            for group, output in zip(groups, (live, retired)):
+                if group:
+                    output.append((seq, group))
+        if not retired:
+            return
+        self.store.ledger.admit(self.path.stat().st_size * 3 +
+                               (self.tombstones.stat().st_size if self.tombstones.exists() else 0) + 65536)
+        from .storage import sync_directory
+        temporary = self.path.with_suffix('.partial')
+        tombstone_temporary = self.tombstones.with_suffix('.partial')
+        try:
+            existing = {(key, entry_hash) for _, data, _, _ in self._records(self.tombstones)
+                        for key, _, _, entry_hash in data[2]} if self.tombstones.exists() else set()
+            affected = {key for _, data in retired for key in data}
+            associated = {}
+            for key in affected & set(available):
+                name, _, value, _ = available[key]
+                if key.startswith('notice:') and value and value.get('ack'):
+                    owner = value.get('source_key') or 'op:' + value.get('untrusted_content', {}).get('operation_id', '')
+                    if owner.startswith('op:') and owner in affected and owner in available and available[owner][0] == name:
+                        associated.setdefault(owner, []).append(key)
+            groups = {}
+            for key in sorted(affected & set(available)):
+                name, manifest, value, entry = available[key]
+                if (key, digest(entry)) in existing or any(key in keys for keys in associated.values()):
+                    continue
+                state = STATES.get(value.get('state')) if isinstance(value, dict) else None
+                ack = [value['id']] if key.startswith('notice:') and value and value.get('ack') else []
+                ack += sorted(available[n][2]['id'] for n in associated.get(key, []))
+                groups.setdefault(name, (manifest, []))[1].append([key, state, ack, digest(entry)])
+            fd = os.open(tombstone_temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
+            with storage_stream(os.fdopen(fd, 'wb')) as stream:
+                if self.tombstones.exists():
+                    with storage_stream(open(self.tombstones, 'rb')) as old:
+                        while block := old.read(65536):
+                            stream.write(block)
+                else:
+                    stream.write(MAGIC)
+                stream.flush()
+                os.fsync(stream.fileno())
+            previous = bytes(32)
+            for _, _, chain, _ in self._records(tombstone_temporary):
+                previous = chain
+            for name, (manifest, stones) in groups.items():
+                previous = self._append(tombstone_temporary, self.store.committed, [name, manifest, stones], previous)
+            # Publish and verify tombstones before replacing the live file.
+            list(self.retired(path=tombstone_temporary))
+            os.replace(tombstone_temporary, self.tombstones)
+            sync_directory(self.store.evidence_dir)
+            fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
+            with storage_stream(os.fdopen(fd, 'wb')) as stream:
+                stream.write(MAGIC)
+                stream.flush()
+                os.fsync(stream.fileno())
+            previous = bytes(32)
+            for seq, data in live:
+                previous = self._append(temporary, seq, data, previous)
+            os.replace(temporary, self.path)
+            sync_directory(self.store.evidence_dir)
+            self.previous = previous
+        finally:
+            with cleanup('owner projection archive temporary cleanup'):
+                temporary.unlink(missing_ok=True)
+                tombstone_temporary.unlink(missing_ok=True)
