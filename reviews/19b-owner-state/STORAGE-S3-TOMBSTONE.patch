@@ -0,0 +1,143 @@
+"""Readable committed evidence behind compact owner references.
+
+The working journal keeps source records while they are live. Owner archive
+retires only byte-equivalent, re-read records to the existing qualified export.
+The permanent restore fence is never rewritten, and this reader never replays
+an adapter action.
+"""
+import hashlib
+import heapq
+import json
+import os
+import zlib
+
+from .common import Refused, canonical, cleanup, storage_stream
+from .owner_projection import OwnerProjection, MAGIC, HEADER
+
+
+class OwnerSource(OwnerProjection):
+    def __init__(self, store):
+        self.store = store
+        self.path = store.evidence_dir / 'owner-source.bin'
+        self.previous = bytes(32)
+        self._recover_tail()
+
+    def prepare(self, event):
+        payload = zlib.compress(canonical(event).encode(), 9)
+        header = HEADER.pack(len(payload), event['seq'])
+        chain = hashlib.sha256(self.previous + header + payload + bytes.fromhex(event['record']['hash'])).digest()
+        fd = os.open(self.path, os.O_WRONLY | os.O_APPEND | os.O_NOFOLLOW)
+        with storage_stream(os.fdopen(fd, 'ab', buffering=0)) as stream:
+            data = header + payload + chain
+            if stream.write(data) != len(data):
+                raise OSError(28, 'Short owner source write')
+            os.fsync(stream.fileno())
+        self.previous = chain
+
+    def seed(self):
+        if self.path.stat().st_size == len(MAGIC) and self.store.committed:
+            for event in self.store.iter_audit():
+                self.store.ledger.admit(len(canonical(event).encode()) * 3 + 65536)
+                self.previous = self._append(self.path, event['seq'], event, self.previous)
+
+    def live_events(self):
+        for seq, event, _, _ in self._records(self.path):
+            if seq <= self.store.committed:
+                yield event
+
+    def events(self):
+        # The active journal carries archive publications. A publication may in
+        # turn have moved into a later export; follow only verified manifests.
+        manifests, visited = {}, set()
+        for event in self.live_events():
+            for key, value in event['set'].items():
+                if key.startswith('archive:') and value:
+                    manifests[key[8:]] = value
+        projection = self.store.owner_projection
+        if projection and projection.tombstones.exists():
+            for _, data, _, _ in projection._records(projection.tombstones):
+                manifests[data[0]] = data[1]
+        archives = {}
+        while manifests:
+            name, manifest = manifests.popitem()
+            if name in visited:
+                continue
+            visited.add(name)
+            rows = []
+            for entry in self._export(name, manifest['sha256']):
+                if 'event' not in entry:
+                    continue
+                event = entry['event']
+                seq = event['seq']
+                fence = next((r for r in self.store.events if r['seq'] == seq), None)
+                if event['record'] != fence:
+                    raise Refused('evidence_corrupt', 'Owner source export differs from its independent fence.')
+                rows.append(event)
+                for key, value in event['set'].items():
+                    if key.startswith('archive:') and value and key[8:] not in visited:
+                        manifests[key[8:]] = value
+            archives[name] = rows
+        previous = 0
+        streams = [self.live_events(), *(iter(rows) for rows in archives.values())]
+        for event in heapq.merge(*streams, key=lambda e: e['seq']):
+            if event['seq'] != previous and event['seq'] <= self.store.committed:
+                yield event
+            previous = event['seq']
+
+    def iter_items(self, prefix=''):
+        cursor = ''
+        while True:
+            batch = {}
+            for event in self.events():
+                for key, value in event['set'].items():
+                    if key <= cursor or not key.startswith(prefix):
+                        continue
+                    if key not in batch and len(batch) == 32:
+                        largest = max(batch)
+                        if key > largest:
+                            continue
+                        del batch[largest]
+                    batch[key] = value
+            if not batch:
+                return
+            for key in sorted(batch):
+                if batch[key] is not None:
+                    yield key, batch[key]
+            cursor = max(batch)
+
+    def get(self, key, default=None):
+        return next((v for k, v in self.iter_items(key) if k == key), default)
+
+    def created(self, key):
+        created = None
+        for event in self.events():
+            if key in event['set']:
+                if event['set'][key] is None:
+                    created = None
+                elif created is None:
+                    created = event['time']
+        return created or 0
+
+    def compact(self, manifest):
+        exported = {entry['event']['seq']: entry['event'] for entry in self._export(
+            os.path.basename(manifest['path']), manifest['sha256']) if 'event' in entry}
+        self.store.ledger.admit(self.path.stat().st_size * 2 + 65536)
+        temporary = self.path.with_suffix('.partial')
+        from .storage import sync_directory
+        try:
+            fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
+            with storage_stream(os.fdopen(fd, 'wb')) as stream:
+                stream.write(MAGIC)
+                stream.flush()
+                os.fsync(stream.fileno())
+            previous = bytes(32)
+            for seq, event, _, _ in self._records(self.path):
+                if exported.get(seq) == event:
+                    continue
+                previous = self._append(temporary, seq, event, previous)
+            os.replace(temporary, self.path)
+            sync_directory(self.store.evidence_dir)
+            self.previous = previous
+        finally:
+            with cleanup('owner source retirement temporary cleanup'):
+                temporary.unlink(missing_ok=True)
