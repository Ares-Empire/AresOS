+        return 0
+
+    def inflate(self, key, row):
+        if not isinstance(row, dict):
+            return row
+        row = dict(row)
+        row.pop('reason_code', None)
+        reason_kind = row.pop('reason_kind', None)
+        if key.startswith('mail:account:'):
