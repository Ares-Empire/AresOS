+            kind = record_kind(event, key, value)
+            data[key] = {'kind': kind, 'facts': new}
+        if data:
+            for key,value in event['set'].items():
+                if selected(key) and key not in data:
+                    data[key] = {'kind': record_kind(event, key, value), 'facts': fact(key,value)}
