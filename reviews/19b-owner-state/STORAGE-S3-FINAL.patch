+                        largest = max(batch)
+                        if key > largest:
+                            continue
+                        del batch[largest]
+                    batch[key] = value
+            if not batch:
+                return
+            for key in sorted(batch):
+                if batch[key] is not None:
+                    yield key, batch[key]
+            cursor = max(batch)
