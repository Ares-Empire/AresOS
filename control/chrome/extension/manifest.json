{
  "manifest_version":3,"name":"AresOS Chrome","version":"1.0.0",
  "permissions":["debugger","tabs","tabGroups","nativeMessaging","scripting","dom","webNavigation","downloads","bookmarks","history","declarativeNetRequest"],
  "host_permissions":["http://*/*","https://*/*"],
  "background":{"service_worker":"background.js","type":"module"},
  "action":{"default_popup":"popup.html","default_title":"AresOS Chrome: Stop control"},
  "options_page":"details.html",
  "content_scripts":[
    {"matches":["http://*/*","https://*/*"],"all_frames":true,"match_origin_as_fallback":true,"run_at":"document_start","world":"MAIN","js":["page.js"]},
    {"matches":["http://*/*","https://*/*"],"all_frames":true,"match_origin_as_fallback":true,"run_at":"document_start","js":["reader.js"]}
  ]
}
