{
  "manifest_version": 3,
  "name": "AresOS Chrome",
  "version": "1.0.0",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "nativeMessaging",
    "scripting",
    "dom",
    "webNavigation",
    "webRequest",
    "downloads",
    "bookmarks",
    "history",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AresOS Chrome: Stop control"
  },
  "options_page": "details.html"
}
