{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [],
    "enableWeakerNestedSandbox": false,
    "allowNestedUserNamespaces": false,
    "bwrapPath": "/usr/bin/bwrap",
    "socatPath": "/usr/bin/socat",
    "ripgrep": {
      "command": "/usr/bin/rg",
      "args": []
    },
    "ignoreViolations": {},
    "credentials": {
      "files": [],
      "envVars": [],
      "allowPlaintextInject": false,
      "awsPairs": [],
      "sigv4": {
        "streaming": "deny",
        "presigned": "deny",
        "sigv4a": "deny"
      }
    },
    "network": {
      "strictAllowlist": true,
      "allowedDomains": [],
      "deniedDomains": [],
      "allowAllUnixSockets": false,
      "allowLocalBinding": false,
      "allowUnixSockets": [],
      "allowMachLookup": []
    },
    "filesystem": {
      "disabled": false,
      "denyRead": [
        "/home",
        "/root",
        "/run/aresos-tools",
        "/var/lib/aresos-tools",
        "/run/user",
        "/tmp/.X11-unix"
      ],
      "allowRead": [
        "/home/assistant/work"
      ],
      "allowWrite": [
        "/home/assistant/work"
      ],
      "denyWrite": [
        "~/.bashrc",
        "~/.bash_profile",
        "~/.bash_login",
        "~/.profile",
        "~/.zshrc",
        "~/.zprofile",
        "~/.zshenv",
        "~/.gitconfig",
        "~/.config",
        "~/.local",
        "~/.claude",
        "~/.claude.json",
        "/etc/claude-code",
        "/opt/aresos-control",
        "/home/assistant/work"
      ]
    }
  }
}
