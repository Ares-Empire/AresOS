# The OS base is Linux, so keep LF everywhere except Windows scripts.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.png binary
*.jpg binary
*.jar binary
*.zip binary
# Keep the bundled upstream font licence byte for byte, including its CRLFs.
/os/config/usr/share/fonts/aresos/OFL-SpaceGrotesk.txt -text
